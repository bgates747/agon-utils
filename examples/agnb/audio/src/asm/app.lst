0406D1 3A DB 00 04 1015*       ld a,(agnb_state+agnb_state_file_offset+3)
0406D5 21 CF 00 04 1016*       ld hl,agnb_state+agnb_state_list_end+3
0406D9 BE          1017*       cp (hl)
0406DA 20 0A       1018*       jr nz,@bad_bounds
0406DC AF          1019*       xor a
0406DD 32 F7 00 04 1020*       ld (agnb_last_error),a
0406E1 C9          1021*       ret
0406E2             1022*   
0406E2             1023*   @bad_chunk:
0406E2 3E 07       1024*       ld a,agnb_error_chunk
0406E4 18 02       1025*       jr @error
0406E6             1026*   @bad_bounds:
0406E6 3E 08       1027*       ld a,agnb_error_bounds
0406E8             1028*   @error:
0406E8 32 F7 00 04 1029*       ld (agnb_last_error),a
0406EC B7          1030*       or a
0406ED C9          1031*       ret
0406EE             1032*   
0406EE             1033*   ; Skip an unknown or deliberately ignored chunk, including alignment padding,
0406EE             1034*   ; without crossing the active enclosing boundary.
0406EE             1035*   agnb_skip_chunk:
0406EE C3 F6 06 04 1036*       jp agnb_not_implemented
