0408CE 20 63       0240*       jr nz,@bad_chunk
0408D0             0241*   
0408D0 2A D0 00 04 0242*       ld hl,(agnb_state+agnb_state_chunk_size)
0408D4 11 03 00 00 0243*       ld de,agnb_audi_payload_size
0408D8 B7          0244*       or a
0408D9 ED 52       0245*       sbc hl,de
0408DB 20 52       0246*       jr nz,@bad_metadata
0408DD 3A D3 00 04 0247*       ld a,(agnb_state+agnb_state_chunk_size+3)
0408E1 B7          0248*       or a
0408E2 20 4B       0249*       jr nz,@bad_metadata
0408E4             0250*   
0408E4 01 04 00 00 0251*       ld bc,4
0408E8 11 F9 00 04 0252*       ld de,agnb_header
0408EC CD FD 01 04 0253*       call agnb_read_exact
0408F0 C0          0254*       ret nz
0408F1 3A F9 00 04 0255*       ld a,(agnb_header+agnb_audi_format)
0408F5 FE 09       0256*       cp agnb_audio_vdp_format
0408F7 20 36       0257*       jr nz,@bad_metadata
0408F9 32 0D 07 04 0258*       ld (agnb_audio_metadata+agnb_audio_meta_format),a
0408FD             0259*   
0408FD             0260*   ; Sample rate must be nonzero. Its u16 storage already enforces the VDP limit.
0408FD 3A FA 00 04 0261*       ld a,(agnb_header+agnb_audi_sample_rate)
040901 21 FB 00 04 0262*       ld hl,agnb_header+agnb_audi_sample_rate+1
040905 B6          0263*       or (hl)
040906 28 27       0264*       jr z,@bad_metadata
040908 3A FA 00 04 0265*       ld a,(agnb_header+agnb_audi_sample_rate)
04090C 32 0E 07 04 0266*       ld (agnb_audio_metadata+agnb_audio_meta_rate),a
040910 3A FB 00 04 0267*       ld a,(agnb_header+agnb_audi_sample_rate+1)
040914 32 0F 07 04 0268*       ld (agnb_audio_metadata+agnb_audio_meta_rate+1),a
040918             0269*   
040918 3A FC 00 04 0270*       ld a,(agnb_header+3)
04091C B7          0271*       or a
04091D 20 14       0272*       jr nz,@bad_chunk
04091F 3A F6 00 04 0273*       ld a,(agnb_record_flags)
040923 F6 02       0274*       or 1<<agnb_record_has_imag ; descriptor-present bit is shared with IMAG
040925 32 F6 00 04 0275*       ld (agnb_record_flags),a
040929 AF          0276*       xor a
04092A 32 F7 00 04 0277*       ld (agnb_last_error),a
04092E C9          0278*       ret
04092F             0279*   
04092F             0280*   @bad_metadata:
04092F 3E 0A       0281*       ld a,agnb_error_metadata
040931 18 02       0282*       jr @error
040933             0283*   @bad_chunk:
040933 3E 07       0284*       ld a,agnb_error_chunk
040935             0285*   @error:
040935 32 F7 00 04 0286*       ld (agnb_last_error),a
040939 B7          0287*       or a
04093A C9          0288*       ret
04093B             0289*   
04093B             0290*   ; Audio DATA must be nonempty and fit the generic loader's u24 stream counter.
04093B             0291*   agnb_validate_audio_data:
04093B 3A 13 07 04 0292*       ld a,(agnb_audio_metadata+agnb_audio_meta_data_size+3)
04093F B7          0293*       or a
040940 20 13       0294*       jr nz,@bad_size
040942 2A 10 07 04 0295*       ld hl,(agnb_audio_metadata+agnb_audio_meta_data_size)
040946 11 00 00 00 0296*       ld de,0
04094A B7          0297*       or a
04094B ED 52       0298*       sbc hl,de
04094D 28 06       0299*       jr z,@bad_size
04094F AF          0300*       xor a
040950 32 F7 00 04 0301*       ld (agnb_last_error),a
040954 C9          0302*       ret
040955             0303*   @bad_size:
040955 3E 0B       0304*       ld a,agnb_error_data_size
040957 32 F7 00 04 0305*       ld (agnb_last_error),a
04095B B7          0306*       or a
04095C C9          0307*       ret
04095D             0308*   
04095D             0309*   ; Convert the consolidated buffer to a VDP audio sample using the retained
04095D             0310*   ; writer-specified bufferId, unsigned base format, and explicit sample rate.
04095D             0311*   agnb_finalize_audio:
04095D 2A 0B 07 04 0312*       ld hl,(agnb_audio_metadata+agnb_audio_meta_bufferId)
040961 2B          0313*       dec hl
040962 52 23       0314*       inc.s hl ; preserve u16 bufferId and clear HLU
040964 ED 5B 0E 07 0315*       ld de,(agnb_audio_metadata+agnb_audio_meta_rate)
       04          
040969 1B          0316*       dec de
04096A 52 13       0317*       inc.s de ; preserve u16 sample rate and clear DEU
04096C 3A 0D 07 04 0318*       ld a,(agnb_audio_metadata+agnb_audio_meta_format)
040970 E6 07       0319*       and $07 ; vdu_buffer_to_sound adds the sample-rate-present bit itself
040972 CD B5 0B 04 0320*       call vdu_buffer_to_sound
040976 AF          0321*       xor a
040977 32 F7 00 04 0322*       ld (agnb_last_error),a
04097B C9          0323*       ret
04097C             0034        include "includes.inc"
04097C             0001*   ; Routines selected from loose/src/asm/functions.inc
04097C             0002*   ; Retained in their original source-file order.
04097C             0003*   
04097C             0004*   ; Print a zero-terminated string
04097C             0005*   ; HL: Pointer to string
04097C             0006*   printString:
04097C C5          0007*       PUSH BC
04097D 01 00 00 00 0008*       LD BC,0
040981 3E 00       0009*       LD A,0
040983 5B DF       0010*       RST.LIL 18h
040985 C1          0011*       POP BC
040986 C9          0012*       RET
040987             0013*   
040987             0014*   ; Prints the right justified decimal value in HL without leading zeroes
040987             0015*   ; HL : Value to print
040987             0016*   ; preserves all registers and flags
040987             0017*   printDec:
040987             0018*   ; BEGIN MY CODE
040987             0019*   ; back up all the things
040987 F5          0020*       push af
040988 C5          0021*       push bc
040989 D5          0022*       push de
04098A E5          0023*       push hl
04098B             0024*   ; END MY CODE
04098B 11 B3 09 04 0025*       LD DE, _printDecBuffer
04098F CD 3E 11 04 0026*       CALL u24_to_ascii
040993             0027*   ; BEGIN MY CODE
040993             0028*   ; replace leading zeroes with spaces
040993 21 B3 09 04 0029*       LD HL, _printDecBuffer
040997 06 07       0030*       ld B, 7 ; if HL was 0, we want to keep the final zero
040999             0031*   @loop:
040999 7E          0032*       LD A, (HL)
04099A FE 30       0033*       CP '0'
04099C C2 A6 09 04 0034*       JP NZ, @done
0409A0 3E 20       0035*       LD A, ' '
0409A2 77          0036*       LD (HL), A
0409A3 23          0037*       INC HL
0409A4             0038*       ; CALL vdu_cursor_forward
0409A4 10 F3       0039*       DJNZ @loop
0409A6             0040*   @done:
0409A6             0041*   ; END MY CODE
0409A6 21 B3 09 04 0042*       LD HL, _printDecBuffer
0409AA CD 7C 09 04 0043*       CALL printString
0409AE             0044*   ; BEGIN MY CODE
0409AE             0045*   ; restore all the things
0409AE E1          0046*       pop hl
0409AF D1          0047*       pop de
0409B0 C1          0048*       pop bc
0409B1 F1          0049*       pop af
0409B2             0050*   ; END MY CODE
0409B2 C9          0051*       RET
0409B3 00 00 00 00 0052*   _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0409C3             0053*   
0409C3             0054*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
0409C3             0055*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
0409C3             0056*   ; so it will allways be 8 characters length
0409C3             0057*   ; HL : Value to convert to string
0409C3             0058*   ; DE : pointer to buffer, at least 8 byte + 0
0409C3             0059*   ; u24_to_ascii:
0409C3             0060*   ;     LD BC,-10000000
0409C3             0061*   ;     CALL @one_digit
0409C3             0062*   ;     LD BC,-1000000
0409C3             0063*   ;     CALL @one_digit
0409C3             0064*   ;     LD BC,-100000
0409C3             0065*   ;     CALL @one_digit
0409C3             0066*   ;     LD BC,-10000
0409C3             0067*   ;     CALL @one_digit
0409C3             0068*   ;     LD BC,-1000
0409C3             0069*   ;     CALL @one_digit
0409C3             0070*   ;     LD BC,-100
0409C3             0071*   ;     CALL @one_digit
0409C3             0072*   ;     LD C,-10
0409C3             0073*   ;     CALL @one_digit
0409C3             0074*   ;     LD C,B
0409C3             0075*   ; @one_digit:
0409C3             0076*   ;     LD A,'0'-1
0409C3             0077*   ; @divide_me:
0409C3             0078*   ;     INC A
0409C3             0079*   ;     ADD HL,BC
0409C3             0080*   ;     JR C,@divide_me
0409C3             0081*   ;     SBC HL,BC
0409C3             0082*   ;     LD (DE),A
0409C3             0083*   ;     INC DE
0409C3             0084*   ;     RET
0409C3             0085*   
0409C3             0086*   
0409C3             0087*   ; Routines and constants selected from loose/src/asm/vdu.inc
0409C3             0088*   ; Retained in their original source-file order.
0409C3             0089*   
0409C3             0090*   ; &E8-&EF 	232-239 	Bitmap plot §
0409C3             0091*   plot_bmp: equ 0xE8
0409C3             0092*   ; 5 	Plot absolute in current foreground colour
0409C3             0093*   dr_abs_fg: equ 5
0409C3             0094*   
0409C3             0095*   cursor_on:
0409C3 21 CE 09 04 0096*   	ld hl,@cmd
0409C7 01 03 00 00 0097*   	ld bc,@end-@cmd
0409CB 5B DF       0098*   	rst.lil $18
0409CD C9          0099*   	ret
0409CE             0100*   @cmd:
0409CE 17 01 01    0101*   	db 23,1,1
0409D1             0102*   @end:
0409D1             0103*   
0409D1             0104*   cursor_off:
0409D1 21 DC 09 04 0105*   	ld hl,@cmd
0409D5 01 03 00 00 0106*   	ld bc,@end-@cmd
