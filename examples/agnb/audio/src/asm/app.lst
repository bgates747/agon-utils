0414AF 52 09       0282*       add.s hl,bc		; 11
0414B1 52 DD 2B    0283*       dec.s ix		; 10
0414B4             0284*   @cansub:
0414B4 EB          0285*       ex de,hl		; 4
0414B5 3D          0286*       dec a		; 4
0414B6 20 E4       0287*       jr nz,@loop	; 12/7
0414B8 C9          0288*       ret			; 10
0414B9             0289*   ; end udiv3216
0414B9             0290*   
0414B9             0291*   ; https://discord.com/channels/1158535358624039014/1282290921815408681/1329274504022720512
0414B9             0292*   ; calc84maniac's 32-bit by 23-bit division routine
0414B9             0293*   ; This divides AUIX by UDE (maximum 23 bits)
0414B9             0294*   ; The result is stored in AUIX, the remainder in UHL
0414B9             0295*   ; UDE, C are unmodified
0414B9             0296*   ; B is 0
0414B9             0297*   udiv3223:
0414B9 B7          0298*       or a,a         ; 1
0414BA ED 62       0299*       sbc hl,hl      ; 2
0414BC 06 20       0300*       ld b,32        ; 2
0414BE             0301*   @loop:
0414BE DD 29       0302*       add ix,ix      ; 2
0414C0 8F          0303*       adc a,a        ; 1
0414C1 ED 6A       0304*       adc hl,hl      ; 2
0414C3 ED 52       0305*       sbc hl,de      ; 2
0414C5 DD 23       0306*       inc ix         ; 2
0414C7 30 03       0307*       jr nc,@cansub  ; 2/4
0414C9 19          0308*       add hl,de      ; 1
0414CA DD 2B       0309*       dec ix         ; 2
0414CC             0310*   @cansub:
0414CC 10 F0       0311*       djnz @loop     ; 2/4
0414CE C9          0312*       ret            ; 10
0414CF             0313*   ; end udiv3223
0414CF             0314*   
0414CF             0315*   ; calc84maniac https://discord.com/channels/1158535358624039014/1282290921815408681/1330991583369101322
0414CF             0316*   ; add uhl to signed integer a
0414CF             0317*   add_uhl_a_signed:
0414CF D5          0318*       push de    ; 4 cycles
0414D0 EB          0319*       ex de, hl  ; 1 cycle  UDE = UHL
0414D1 07          0320*       rlca       ; 1 cycle  CF = signbit(A)
0414D2 ED 62       0321*       sbc hl, hl ; 2 cycles UHL = -signbit(A)
0414D4 0F          0322*       rrca       ; 1 cycle  Restore A
0414D5 6F          0323*       ld l, a    ; 1 cycle  UHL = signext(A)
0414D6 19          0324*       add hl, de ; 1 cycle  UHL = UDE + signext(A)
0414D7 D1          0325*       pop de     ; 4 cycles
0414D8             0326*                  ; 15 cycles total
0414D8 C9          0327*       ret
0414D9             0328*   ; end hlu_add_a_signed
0414D9             0329*   
0414D9             0330*   ;------------------------------------------------------------------------
0414D9             0331*   ; umul24: HL = HL * DE (unsigned, low 24 bits)
0414D9             0332*   ; Preserves AF, BC, DE
0414D9             0333*   ; Copyright (c) Shawn Sijnstra 2024, MIT license
0414D9             0334*   ; Imported from AgonVideo/src/asm/arith24.inc.
0414D9             0335*   ;------------------------------------------------------------------------
0414D9             0336*   umul24:
0414D9 D5          0337*       push de
0414DA C5          0338*       push bc
0414DB F5          0339*       push af
0414DC E5          0340*       push hl
0414DD C1          0341*       pop bc
0414DE 3E 18       0342*       ld a,24
0414E0 21 00 00 00 0343*       ld hl,0
0414E4             0344*   @loop:
0414E4 29          0345*       add hl,hl
0414E5 EB          0346*       ex de,hl
0414E6 29          0347*       add hl,hl
0414E7 EB          0348*       ex de,hl
0414E8 30 01       0349*       jr nc,@no_add
0414EA 09          0350*       add hl,bc
0414EB             0351*   @no_add:
0414EB 3D          0352*       dec a
0414EC 20 F6       0353*       jr nz,@loop
0414EE F1          0354*       pop af
0414EF C1          0355*       pop bc
0414F0 D1          0356*       pop de
0414F1 C9          0357*       ret
0414F2             0039    
0414F2             0040    init:
0414F2             0041    ; No application initialization is required yet. Screen, input, timer, and
0414F2             0042    ; slideshow setup belonged to the image test application and was removed.
0414F2 C9          0043        ret
0414F3             0044    
0414F3             0045    main:
0414F3             0046    ; Load, finalize, and interactively play every audio record in sfx.agnb.
0414F3 CD 14 07 04 0047        call agnb_load_audio
0414F7 C9          0048        ret
