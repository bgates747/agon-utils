040628 2A EF 00 04 0918*       ld hl,(agnb_stream_remaining)
04062C ED 5B F2 00 0919*       ld de,(agnb_stream_block_size)
       04          
040631 B7          0920*       or a
040632 ED 52       0921*       sbc hl,de
