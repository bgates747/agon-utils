0412A4             0478*   
0412A4             0479*   ; print the binary representation of the 8-bit value in a
0412A4             0480*   ; destroys a, hl, bc
0412A4             0481*   printBin8:
0412A4 06 08       0482*       ld b,8 ; loop counter for 8 bits
0412A6 21 C1 12 04 0483*       ld hl,@cmd ; set hl to the low byte of the output string
0412AA             0484*       ; (which will be the high bit of the value in a)
0412AA             0485*   @loop:
0412AA 07          0486*       rlca ; put the next highest bit into carry
0412AB 38 04       0487*       jr c,@one
0412AD 36 30       0488*       ld (hl),'0'
0412AF 18 02       0489*       jr @next_bit
0412B1             0490*   @one:
0412B1 36 31       0491*       ld (hl),'1'
0412B3             0492*   @next_bit:
0412B3 23          0493*       inc hl
0412B4 10 F4       0494*       djnz @loop
0412B6             0495*   ; print it
0412B6 21 C1 12 04 0496*       ld hl,@cmd
0412BA 01 08 00 00 0497*       ld bc,@end-@cmd
0412BE 5B DF       0498*       rst.lil $18
0412C0 C9          0499*       ret
0412C1             0500*   @cmd: ds 8 ; eight bytes for eight bits
0412C9             0501*   @end:
0412C9             0502*   
0412C9             0503*   ; print the binary representation of the 8-bit value in a
0412C9             0504*   ; in reverse order (lsb first)
0412C9             0505*   ; destroys a, hl, bc
0412C9             0506*   printBin8Rev:
       FF FF FF FF 
       FF FF FF FF 
0412C9 06 08       0507*       ld b,8 ; loop counter for 8 bits
0412CB 21 E6 12 04 0508*       ld hl,@cmd ; set hl to the low byte of the output string
0412CF             0509*       ; (which will be the high bit of the value in a)
0412CF             0510*   @loop:
0412CF 0F          0511*       rrca ; put the next lowest bit into carry
0412D0 38 04       0512*       jr c,@one
0412D2 36 30       0513*       ld (hl),'0'
0412D4 18 02       0514*       jr @next_bit
0412D6             0515*   @one:
0412D6 36 31       0516*       ld (hl),'1'
0412D8             0517*   @next_bit:
0412D8 23          0518*       inc hl
0412D9 10 F4       0519*       djnz @loop
0412DB             0520*   ; print it
0412DB 21 E6 12 04 0521*       ld hl,@cmd
0412DF 01 08 00 00 0522*       ld bc,@end-@cmd
0412E3 5B DF       0523*       rst.lil $18
0412E5 C9          0524*       ret
0412E6             0525*   @cmd: ds 8 ; eight bytes for eight bits
0412EE             0526*   @end:
