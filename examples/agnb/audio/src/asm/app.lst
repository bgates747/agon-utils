04113E             0252*   ; This routine converts the unsigned 24-bit value in HLU into its ASCII representation,
04113E             0253*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
04113E             0254*   ; so it will allways be 8 characters length
04113E             0255*   ; HL : Value to convert to string
04113E             0256*   ; DE : pointer to buffer, at least 8 byte + 0
04113E             0257*   u24_to_ascii:
04113E 01 80 69 67 0258*       LD BC,-10000000
041142 CD 75 11 04 0259*       CALL one_digit
041146 01 C0 BD F0 0260*       LD BC,-1000000
04114A CD 75 11 04 0261*       CALL one_digit
04114E 01 60 79 FE 0262*       LD BC,-100000
041152 CD 75 11 04 0263*       CALL one_digit
041156 01 F0 D8 FF 0264*       LD BC,-10000
04115A CD 75 11 04 0265*       CALL one_digit
04115E             0266*   u8_to_ascii: ; same arguments but hl <= 255, uhl and h = 0
04115E 01 18 FC FF 0267*       LD BC,-1000
041162 CD 75 11 04 0268*       CALL one_digit
041166 01 9C FF FF 0269*       LD BC,-100
04116A CD 75 11 04 0270*       CALL one_digit
04116E 0E F6       0271*       LD C,-10
041170 CD 75 11 04 0272*       CALL one_digit
041174 48          0273*       LD C,B
041175             0274*   one_digit:
041175 3E 2F       0275*       LD A,'0'-1
041177             0276*   @divide_me:
041177 3C          0277*       INC A
041178 09          0278*       ADD HL,BC
041179 38 FC       0279*       JR C,@divide_me
04117B ED 42       0280*       SBC HL,BC
04117D 12          0281*       LD (DE),A
04117E 13          0282*       INC DE
04117F C9          0283*       RET
041180             0284*   
041180             0285*   print_u24:
041180 D5          0286*       push de
041181 E5          0287*       push hl
041182 11 B3 09 04 0288*       ld de,_printDecBuffer
041186 CD 3E 11 04 0289*       call u24_to_ascii
04118A 21 B3 09 04 0290*       ld hl,_printDecBuffer
04118E CD 7C 09 04 0291*       call printString
041192 3E 20       0292*       ld a,' '
041194 5B D7       0293*       rst.lil 10h
