04060F CD FD 01 04 0906*       call agnb_read_exact
040613 C0          0907*       ret nz
040614             0908*   
040614             0909*   ; Append the complete block to the same writer-specified VDP buffer.
040614 ED 4B F2 00 0910*       ld bc,(agnb_stream_block_size)
       04          
040619 11 00 E0 B7 0911*       ld de,agnb_io_buffer
04061D 2A E0 00 04 0912*       ld hl,(agnb_metadata+agnb_meta_bufferId)
040621 2B          0913*       dec hl
040622 52 23       0914*       inc.s hl ; undocumented: preserves bufferId in HL and clears HLU
040624 CD 6E 0A 04 0915*       call vdu_load_buffer
