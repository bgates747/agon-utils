041062             0005*   ;
041062             0006*   ; Destroys: HL,AF
041062             0007*   printInline:
041062 E1          0008*       pop hl ; get the return address = pointer to start of string
041063 CD 7C 09 04 0009*       call printString ; HL advances to end of string
041067 E5          0010*       push hl ; restore the return address = pointer to end of string
041068 C9          0011*       ret
