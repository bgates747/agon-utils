0410EA             0201*   ; initialize hl to 0 and load it with a
0410EA 21 00 00 00 0202*       ld hl,0
0410EE 6F          0203*       ld l,a
0410EF             0204*   ; convert l to ascii
0410EF 11 17 11 04 0205*       LD DE, _printDec8Buffer
0410F3 CD 5E 11 04 0206*       CALL u8_to_ascii
