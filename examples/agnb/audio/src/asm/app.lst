04141D             0102*   ; ; floor(value,n)
04141D             0103*   ; ; inputs: hl = value to floor, de = n
04141D             0104*   ; ; outputs: hl = value floored to n
04141D             0105*   ; ; destroys: af, hl, bc, de
04141D             0106*   ; hlu_floor:
04141D             0107*   ;     push de ; save n
04141D             0108*   ;     call udiv24 ; de = quotient, hl = remainder
04141D             0109*   ;     pop hl ; get n back (was de)
04141D             0110*   ;     call umul24 ; hl = n * quotient
04141D             0111*   ;     ret
04141D             0112*   ; ; end hlu_floor
04141D             0113*   
04141D             0114*   ; Not needed by the AGNB test harness. Retained as comments from AgonVideo.
04141D             0115*   ; ; ceil(value,n)
04141D             0116*   ; ; inputs: hl = value to ceil, de = n
04141D             0117*   ; ; outputs: hl = value ceiled to n
04141D             0118*   ; ; destroys: af, hl, bc, de
04141D             0119*   ; hlu_ceiling:
04141D             0120*   ;     push de ; save n
04141D             0121*   ;     call udiv24 ; de = quotient, hl = remainder
04141D             0122*   ;     SIGN_UHL ; test remaider for zero
04141D             0123*   ;     jp z,@F ; if zero, nothing to add
04141D             0124*   ;     inc de ; add 1 to quotient for the ceiling
04141D             0125*   ; @@:
04141D             0126*   ;     pop hl ; get n back (was de)
04141D             0127*   ;     call umul24 ; hl = n * quotient
04141D             0128*   ;     ret
04141D             0129*   ; ; end hlu_ceiling
