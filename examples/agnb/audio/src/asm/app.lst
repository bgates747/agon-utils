0406FE             0033        include "audio.inc"  ; audio-container scaffold
0406FE             0001*   ; AGNB 0.2 audio loader
0406FE             0002*   ; =====================
0406FE             0003*   ;
0406FE             0004*   ; The generic RIFF/AGNB file, chunk, bounds, streaming, buffer-clear, buffer-
0406FE             0005*   ; load, and buffer-consolidation routines remain in agnb.inc. This file adds
0406FE             0006*   ; the audio-specific record path for:
0406FE             0007*   ;
0406FE             0008*   ;     LIST BUFR
0406FE             0009*   ;       BHDR  u16 bufferId
0406FE             0010*   ;       AUDI  u8 vdpFormat=0x09; u16 sampleRate
0406FE             0011*   ;       DATA  unsigned 8-bit mono PCM bytes
0406FE             0012*   ;
0406FE             0013*   ; AUDI format 0x09 means VDP base format 1 (unsigned 8-bit mono) with bit 3
0406FE             0014*   ; set to record that an explicit u16 sample rate follows. vdu_buffer_to_sound
0406FE             0015*   ; accepts the base format and adds bit 3 itself, so finalization masks it off.
0406FE             0016*   
0406FE             0017*   agnb_audio_version_major:  equ 0
0406FE             0018*   agnb_audio_version_minor:  equ 2
0406FE             0019*   
0406FE             0020*   agnb_audi_format:          equ 0 ; u8 VDP sample format byte
0406FE             0021*   agnb_audi_sample_rate:     equ 1 ; u16 Hz
0406FE             0022*   agnb_audi_payload_size:    equ 3
0406FE             0023*   
0406FE             0024*   agnb_audio_vdp_format:     equ 0x09 ; unsigned 8-bit mono + sample rate follows
0406FE             0025*   
0406FE 41 55 44 49 0026*   agnb_id_audi:              db "AUDI"
040702             0027*   
040702             0028*   agnb_audio_filename:
040702 73 66 78 2E 0029*       asciz "sfx.agnb"
       61 67 6E 62 
       00          
04070B             0030*   
04070B             0031*   ; Normalized metadata retained until DATA has been validated and streamed.
04070B             0032*   agnb_audio_meta_bufferId:  equ 0 ; u16 writer-specified VDP bufferId
04070B             0033*   agnb_audio_meta_format:    equ 2 ; u8 VDP format; version 0.2 requires 0x09
04070B             0034*   agnb_audio_meta_rate:      equ 3 ; u16 sample rate in Hz
04070B             0035*   agnb_audio_meta_data_size: equ 5 ; u32 DATA payload size
04070B             0036*   agnb_audio_meta_size:      equ 9
04070B             0037*   
04070B             0038*   agnb_audio_metadata:
04070B 00 00 00 00 0039*       blkb agnb_audio_meta_size,0
       00 00 00 00 
       00          
040714             0040*   
040714             0041*   ; Open sfx.agnb, load every valid audio record at its explicit bufferId, play
040714             0042*   ; it once, and wait for a keypress before advancing to the next record.
040714             0043*   ; outputs: A=0/Z after the complete container; error code/NZ on failure
040714             0044*   ; destroys: AF, BC, DE, HL, IX
040714             0045*   agnb_load_audio:
040714 11 02 07 04 0046*       ld de,agnb_audio_filename
040718 CD 22 01 04 0047*       call agnb_open
04071C C0          0048*       ret nz
04071D             0049*   
04071D CD 72 02 04 0050*       call agnb_read_riff_header
040721 20 56       0051*       jr nz,@load_error
040723 CD 89 07 04 0052*       call agnb_read_audio_vers
040727 20 50       0053*       jr nz,@load_error
040729             0054*   
040729             0055*   @next_record:
040729             0056*   ; Stop only at the exact declared RIFF boundary.
040729 3A DB 00 04 0057*       ld a,(agnb_state+agnb_state_file_offset+3)
04072D 21 CB 00 04 0058*       ld hl,agnb_state+agnb_state_riff_end+3
040731 BE          0059*       cp (hl)
040732 38 12       0060*       jr c,@read_record
040734 20 3D       0061*       jr nz,@bad_bounds
040736 2A D8 00 04 0062*       ld hl,(agnb_state+agnb_state_file_offset)
04073A ED 5B C8 00 0063*       ld de,(agnb_state+agnb_state_riff_end)
       04          
04073F B7          0064*       or a
040740 ED 52       0065*       sbc hl,de
040742 28 41       0066*       jr z,@success
040744 30 2D       0067*       jr nc,@bad_bounds
040746             0068*   
040746             0069*   @read_record:
040746 CD F4 07 04 0070*       call agnb_read_audio_buffer_list
04074A 20 2D       0071*       jr nz,@load_error
04074C CD CE 05 04 0072*       call agnb_stream_data
040750 20 27       0073*       jr nz,@load_error
040752 CD 5D 09 04 0074*       call agnb_finalize_audio
040756 20 21       0075*       jr nz,@load_error
040758             0076*   
040758             0077*   ; Duration zero means play the complete sample exactly once. waitKeypress is
040758             0078*   ; the same simple application-test idiom used elsewhere in this repository.
040758 2A E0 00 04 0079*       ld hl,(agnb_metadata+agnb_meta_bufferId)
04075C 2B          0080*       dec hl
04075D 52 23       0081*       inc.s hl ; preserve the u16 bufferId and clear HLU
04075F 01 00 00 00 0082*       ld bc,0
040763 CD F8 0B 04 0083*       call vdu_play_sfx
040767 CD 90 13 04 0084*       call waitKeypress
04076B             0085*   
04076B CD 97 06 04 0086*       call agnb_finish_buffer_list
04076F 20 08       0087*       jr nz,@load_error
040771 18 B6       0088*       jr @next_record
040773             0089*   
040773             0090*   @bad_bounds:
040773 3E 08       0091*       ld a,agnb_error_bounds
040775 32 F7 00 04 0092*       ld (agnb_last_error),a
