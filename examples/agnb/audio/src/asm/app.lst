041436             0162*   
041436             0163*   ; BCD addition
041436             0164*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
041436             0165*   ;       a is the number of bytes holding each number (number of places/2)
041436             0166*   ; outputs: (hl) + (de) --> (hl)
041436             0167*   ; destroys: a,b,de,hl
041436             0168*   add_bcd:
041436 47          0169*       ld b,a ; loop counter
041437 AF          0170*       xor a ; reset a, clear carry flag
041438             0171*   adcec:
041438 1A          0172*       ld a,(de) ; addend to acc
041439 8E          0173*       adc a,(hl) ; add (hl) to acc
04143A 27          0174*       daa ; adjust result to bcd
04143B 77          0175*       ld (hl),a ; store result
04143C 23          0176*       inc hl ; advance memory pointers
04143D 13          0177*       inc de
04143E 10 F8       0178*       djnz adcec ; loop until b == 0
041440 C9          0179*       ret
041441             0180*   
041441             0181*   ; BCD subtraction
041441             0182*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
041441             0183*   ;       a is the number of bytes holding each number (number of places/2)
041441             0184*   ; outputs: (hl) - (de) --> (hl)
041441             0185*   ; destroys: a,b,de,hl
041441             0186*   sub_bcd:
041441 47          0187*       ld b,a ; loop counter
041442 AF          0188*       xor a ; reset a,clear carry flag
041443             0189*   subdec:
041443 1A          0190*       ld a,(de) ; subtrahend to acc
041444 9E          0191*       sbc a,(hl) ; subtract (hl) from acc
041445 27          0192*       daa ; adjust result to bcd
041446 77          0193*       ld (hl),a ; store result
041447 23          0194*       inc hl ; advance memory pointers
041448 13          0195*       inc de
041449 10 F8       0196*       djnz subdec ; loop until b == 0
04144B C9          0197*       ret
