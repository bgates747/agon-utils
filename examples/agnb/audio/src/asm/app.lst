041199             0297*   
041199             0298*   ; u168_to_ascii: Converts an unsigned 16.8 fixed-point value in HL to an ASCII string.
041199             0299*   ; HL : Value to convert to string (integer part in H, fractional part in L)
041199             0300*   ; DE : Pointer to buffer, requires at least 11 bytes (8 digits, sign, decimal point, and null terminator)
041199             0301*   u168_to_ascii:
041199             0302*   ; add a leading space to make room for sign flag if needed
041199 3E 20       0303*       ld a,' '
04119B 12          0304*       ld (de),a
04119C 13          0305*       inc de
04119D             0306*   ; Convert integer part
04119D E5          0307*       push hl ; Save HL (we’ll need the fractional part later)
04119E             0308*       ; call hlu_udiv256 ; Shift to get integer portion in HL
04119E             0309*       SRL_UHL ; Shift to get integer portion in HL
                       M1 Args: none
04119E 3B          0001*M1     dec sp ; 1 cycle
04119F E5          0002*M1     push hl ; 4 cycles
0411A0 33          0003*M1     inc sp ; 1 cycle
0411A1 E1          0004*M1     pop hl ; 4 cycles
0411A2 23          0005*M1     inc hl ; 1 cycle
0411A3 52 2B       0006*M1     dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
0411A5             0007*M1     ; 13 cycles total
0411A5 01 F0 D8 FF 0310*       ld bc, -10000
0411A9 CD CC 11 04 0311*       call @one_int
0411AD 01 18 FC FF 0312*       ld bc, -1000
0411B1 CD CC 11 04 0313*       call @one_int
0411B5 01 9C FF FF 0314*       ld bc, -100
0411B9 CD CC 11 04 0315*       call @one_int
0411BD 0E F6       0316*       ld c, -10
0411BF CD CC 11 04 0317*       call @one_int
0411C3 48          0318*       ld c, b
0411C4 CD CC 11 04 0319*       call @one_int
0411C8 C3 D7 11 04 0320*       jp @frac ; Jump to fractional part conversion
0411CC             0321*   @one_int:
0411CC 3E 2F       0322*       ld a, '0' - 1 ; Start ASCII character at '0'
0411CE             0323*   @divide_me:
0411CE 3C          0324*       inc a
0411CF 09          0325*       add hl, bc ; Accumulate until overflow
0411D0 38 FC       0326*       jr c, @divide_me
0411D2 ED 42       0327*       sbc hl, bc ; Remove excess after overflow
0411D4 12          0328*       ld (de), a ; Store ASCII digit
0411D5 13          0329*       inc de
0411D6 C9          0330*       ret
0411D7             0331*   ; Convert fractional part
0411D7             0332*   @frac:
0411D7 3E 2E       0333*       ld a, '.' ; Decimal point
0411D9 12          0334*       ld (de), a
0411DA 13          0335*       inc de
0411DB E1          0336*       pop hl ; Restore HL with original fraction
0411DC 06 03       0337*       ld b, 3 ; Loop counter for 3 fractional digits
0411DE             0338*   @frac_loop:
0411DE 26 0A       0339*       ld h, 10 ; Load multiplier for fractional part
0411E0 ED 6C       0340*       mlt hl ; Multiply by 10, result in HL (H holds the integer part)
0411E2 3E 30       0341*       ld a, '0'
0411E4 84          0342*       add a, h ; Convert integer part to ASCII
0411E5 12          0343*       ld (de), a
0411E6 13          0344*       inc de
0411E7 10 F5       0345*       djnz @frac_loop ; Repeat for each fractional digit
0411E9             0346*   ; Add null terminator
0411E9 AF          0347*       xor a ; Null terminator
0411EA 12          0348*       ld (de), a
0411EB C9          0349*       ret
0411EC             0350*   
