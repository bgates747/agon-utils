040640 ED 5B D4 00 0930*       ld de,(agnb_state+agnb_state_chunk_end)
       04          
040645 B7          0931*       or a
040646 ED 52       0932*       sbc hl,de
040648 20 1C       0933*       jr nz,@bad_bounds
04064A 3A DB 00 04 0934*       ld a,(agnb_state+agnb_state_file_offset+3)
04064E 21 D7 00 04 0935*       ld hl,agnb_state+agnb_state_chunk_end+3
040652 BE          0936*       cp (hl)
040653 20 11       0937*       jr nz,@bad_bounds
040655             0938*   
040655             0939*   ; Only a complete, exactly bounded transfer may be consolidated.
040655 2A E0 00 04 0940*       ld hl,(agnb_metadata+agnb_meta_bufferId)
040659 2B          0941*       dec hl
04065A 52 23       0942*       inc.s hl ; undocumented: preserves bufferId in HL and clears HLU
04065C CD B5 0A 04 0943*       call vdu_consolidate_buffer
040660             0944*   
040660 AF          0945*       xor a
040661 32 F7 00 04 0946*       ld (agnb_last_error),a
040665 C9          0947*       ret
040666             0948*   
040666             0949*   @bad_bounds:
040666 3E 08       0950*       ld a,agnb_error_bounds
040668 32 F7 00 04 0951*       ld (agnb_last_error),a
04066C B7          0952*       or a
04066D C9          0953*       ret
04066E             0954*   
04066E             0955*   ; Create an image bitmap from the successfully streamed and consolidated
04066E             0956*   ; buffer using the retained IMAG metadata.
04066E             0957*   ; outputs: A=0 and Z set
04066E             0958*   ; destroys: AF, BC, DE, HL
04066E             0959*   agnb_finalize_image:
04066E             0960*   ; Select the exact writer-specified buffer as the bitmap source.
04066E 2A E0 00 04 0961*       ld hl,(agnb_metadata+agnb_meta_bufferId)
040672 2B          0962*       dec hl
