040789             0104*   
040789             0105*   ; Read and validate the single VERS chunk for the provisional audio layout.
040789             0106*   agnb_read_audio_vers:
040789 DD 21 C8 00 0107*       ld ix,agnb_state+agnb_state_riff_end
       04          
04078E CD F0 02 04 0108*       call agnb_read_chunk_header
040792 C0          0109*       ret nz
040793             0110*   
040793 21 F9 00 04 0111*       ld hl,agnb_header+agnb_chunk_id
040797 11 88 00 04 0112*       ld de,agnb_id_vers
04079B CD 11 01 04 0113*       call agnb_compare_fourcc
04079F C2 EC 07 04 0114*       jp nz,@bad_chunk
0407A3             0115*   
0407A3 2A D0 00 04 0116*       ld hl,(agnb_state+agnb_state_chunk_size)
0407A7 11 02 00 00 0117*       ld de,agnb_vers_payload_size
0407AB B7          0118*       or a
0407AC ED 52       0119*       sbc hl,de
0407AE 20 38       0120*       jr nz,@bad_version
