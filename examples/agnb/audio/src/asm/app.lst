04140A             0089*   ; hlu 1 byte right shift, unsigned
04140A             0090*   ; returns: hlu / 256, fractional portion in a
04140A             0091*   ; destroys: af
04140A             0092*   hlu_udiv256:
       FF FF FF FF 
