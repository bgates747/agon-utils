0407C3 C0          0129*       ret nz
0407C4 3A F9 00 04 0130*       ld a,(agnb_header+agnb_vers_major)
0407C8 FE 00       0131*       cp agnb_audio_version_major
0407CA 20 1C       0132*       jr nz,@bad_version
0407CC 3A FA 00 04 0133*       ld a,(agnb_header+agnb_vers_minor)
0407D0 FE 02       0134*       cp agnb_audio_version_minor
0407D2 20 14       0135*       jr nz,@bad_version
