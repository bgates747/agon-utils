041380             0583*   ; set all the bits in the flag register
041380             0584*   ; more of an academic exercise than anything useful
041380             0585*   ; inputs; none
041380             0586*   ; outputs; a=0,f=255
041380             0587*   ; destroys: flags, hl
041380             0588*   ; preserves: a, because why not
041380             0589*   setAllFlags:
041380 21 FF 00 00 0590*       ld hl,255
041384 67          0591*       ld h,a ; four cycles to preserve a is cheap
041385 E5          0592*       push hl
041386 F1          0593*       pop af
041387 C9          0594*       ret
041388             0595*   
041388             0596*   ; reset all the bits in the flag register
041388             0597*   ; unlike its inverse counterpart, this may actually be useful
041388             0598*   ; inputs; none
041388             0599*   ; outputs; a=0,f=0
041388             0600*   ; destroys: flags, hl
041388             0601*   ; preserves: a, because why not
