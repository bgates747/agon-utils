0407DB 3A FC 00 04 0139*       ld a,(agnb_header+3)
0407DF B7          0140*       or a
0407E0 20 0A       0141*       jr nz,@bad_chunk
0407E2 AF          0142*       xor a
0407E3 32 F7 00 04 0143*       ld (agnb_last_error),a
0407E7 C9          0144*       ret
0407E8             0145*   
0407E8             0146*   @bad_version:
0407E8 3E 06       0147*       ld a,agnb_error_version
0407EA 18 02       0148*       jr @error
0407EC             0149*   @bad_chunk:
0407EC 3E 07       0150*       ld a,agnb_error_chunk
0407EE             0151*   @error:
0407EE 32 F7 00 04 0152*       ld (agnb_last_error),a
0407F2 B7          0153*       or a
0407F3 C9          0154*       ret
0407F4             0155*   
0407F4             0156*   ; Parse one LIST BUFR and require BHDR, AUDI, DATA in that order. All metadata,
0407F4             0157*   ; DATA size, and enclosing bounds validate before any PCM payload is read.
0407F4             0158*   agnb_read_audio_buffer_list:
