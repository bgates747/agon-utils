040601             0899*   @use_remaining:
040601 ED 4B EF 00 0900*       ld bc,(agnb_stream_remaining)
       04          
040606             0901*   @read_block:
040606 ED 43 F2 00 0902*       ld (agnb_stream_block_size),bc
       04          
