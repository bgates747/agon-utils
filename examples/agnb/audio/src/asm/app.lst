040CAF C5          0033*       push bc
040CB0 CD 8C 10 04 0034*       call printHex8
040CB4 3E 2E       0035*       ld a,'.'
040CB6 5B D7       0036*       rst.lil 10h
040CB8 CD 7E 10 04 0037*       call printHex24
040CBC 3E 20       0038*       ld a,' '
040CBE 5B D7       0039*       rst.lil 10h
040CC0 C1          0040*       pop bc
040CC1 F1          0041*       pop af
040CC2 C9          0042*       ret
040CC3             0043*   
040CC3             0044*   printHexABHL:
040CC3             0045*   ; preserve registers
040CC3 C5          0046*       push bc ; b will be ok c will not
040CC4 F5          0047*       push af ; will get totally destroyed
040CC5             0048*   ; print a
040CC5 CD 8C 10 04 0049*       call printHex8
040CC9             0050*   ; print b
040CC9 78          0051*       ld a,b
040CCA CD 8C 10 04 0052*       call printHex8
040CCE             0053*   ; print hl
040CCE CD 86 10 04 0054*       call printHex16
040CD2             0055*   ; restore registers
040CD2 F1          0056*       pop af
040CD3 C1          0057*       pop bc
040CD4 C9          0058*       ret
040CD5             0059*   
040CD5             0060*   printHexBHL:
040CD5             0061*   ; preserve registers
040CD5 C5          0062*       push bc ; b will be ok c will not
040CD6 F5          0063*       push af ; will get totally destroyed
040CD7             0064*   ; print b
040CD7 78          0065*       ld a,b
040CD8 CD 8C 10 04 0066*       call printHex8
040CDC             0067*   ; print hl
040CDC CD 86 10 04 0068*       call printHex16
040CE0             0069*   ; restore registers
040CE0 F1          0070*       pop af
040CE1 C1          0071*       pop bc
040CE2 C9          0072*       ret
040CE3             0073*   
040CE3             0074*   printHexCDE:
040CE3             0075*   ; preserve registers
040CE3 C5          0076*       push bc ; b will be ok c will not
040CE4 F5          0077*       push af ; will get totally destroyed
040CE5             0078*   ; print c
040CE5 79          0079*       ld a,c
040CE6 CD 8C 10 04 0080*       call printHex8
040CEA             0081*   ; print de
040CEA EB          0082*       ex de,hl
040CEB CD 86 10 04 0083*       call printHex16
040CEF EB          0084*       ex de,hl
040CF0             0085*   ; restore registers
040CF0 F1          0086*       pop af
040CF1 C1          0087*       pop bc
040CF2 C9          0088*       ret
040CF3             0089*   
040CF3             0090*   printHexUIX:
040CF3             0091*   ; store everything in scratch
040CF3 22 6B 13 04 0092*       ld (uhl),hl
040CF7 ED 43 6E 13 0093*       ld (ubc),bc
       04          
040CFC ED 53 71 13 0094*       ld (ude),de
       04          
040D01 DD 22 74 13 0095*       ld (uix),ix
       04          
040D06 FD 22 77 13 0096*       ld (uiy),iy
       04          
040D0B F5          0097*       push af ; fml
040D0C             0098*   
040D0C 21 02 13 04 0099*       ld hl,str_ixu
040D10 CD 7C 09 04 0100*       call printString
040D14 2A 74 13 04 0101*       ld hl,(uix)
040D18 CD 7E 10 04 0102*       call printHex24
040D1C CD 73 10 04 0103*       call printNewLine
040D20             0104*   
040D20             0105*   ; restore everything
040D20 2A 6B 13 04 0106*       ld hl, (uhl)
040D24 ED 4B 6E 13 0107*       ld bc, (ubc)
       04          
040D29 ED 5B 71 13 0108*       ld de, (ude)
       04          
040D2E DD 2A 74 13 0109*       ld ix, (uix)
       04          
040D33 FD 2A 77 13 0110*       ld iy, (uiy)
       04          
040D38 F1          0111*       pop af
040D39             0112*   ; all done
040D39 C9          0113*       ret
040D3A             0114*   
040D3A             0115*   
040D3A             0116*   ; print registers to screen in hexidecimal format
040D3A             0117*   ; inputs: none
040D3A             0118*   ; outputs: values of every register printed to screen
040D3A             0119*   ;    values of each register in global scratch memory
040D3A             0120*   ; destroys: nothing
040D3A             0121*   stepRegistersHex:
040D3A             0122*   ; store everything in scratch
040D3A 22 6B 13 04 0123*       ld (uhl),hl
040D3E ED 43 6E 13 0124*       ld (ubc),bc
       04          
040D43 ED 53 71 13 0125*       ld (ude),de
       04          
040D48 DD 22 74 13 0126*       ld (uix),ix
       04          
040D4D FD 22 77 13 0127*       ld (uiy),iy
       04          
040D52 F5          0128*       push af ; fml
040D53 E1          0129*       pop hl ; thanks, zilog
040D54 22 68 13 04 0130*       ld (uaf),hl
040D58 F5          0131*       push af ; dammit
