040779             0094*   ; Preserve the parser/transport error while still closing the file.
040779 F5          0095*       push af
04077A CD 60 01 04 0096*       call agnb_close
04077E F1          0097*       pop af
04077F 32 F7 00 04 0098*       ld (agnb_last_error),a
040783 B7          0099*       or a
040784 C9          0100*       ret
