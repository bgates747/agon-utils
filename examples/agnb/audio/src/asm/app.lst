0410F7 21 17 11 04 0208*       LD HL, _printDec8Buffer
0410FB 06 03       0209*       ld B, 3 ; if A was 0, we want to keep the final zero
0410FD             0210*   @loop:
0410FD 7E          0211*       LD A, (HL)
0410FE FE 30       0212*       CP '0'
041100 C2 0A 11 04 0213*       JP NZ, @done
041104 3E 20       0214*       LD A, ' '
041106 77          0215*       LD (HL), A
041107 23          0216*       INC HL
041108 10 F3       0217*       DJNZ @loop
04110A             0218*   @done:
04110A 21 17 11 04 0219*       LD HL, _printDec8Buffer
04110E CD 7C 09 04 0220*       CALL printString
041112             0221*   ; restore all the things
