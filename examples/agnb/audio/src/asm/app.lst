0406BC 7E          1003*       ld a,(hl)
0406BD B7          1004*       or a
0406BE 20 22       1005*       jr nz,@bad_chunk
0406C0 23          1006*       inc hl
0406C1 10 F9       1007*       djnz @check_padding
0406C3             1008*   
0406C3             1009*   @check_list_end:
0406C3 2A D8 00 04 1010*       ld hl,(agnb_state+agnb_state_file_offset)
0406C7 ED 5B CC 00 1011*       ld de,(agnb_state+agnb_state_list_end)
       04          
0406CC B7          1012*       or a
0406CD ED 52       1013*       sbc hl,de
