       04          
04067E 0B          0969*       dec bc
04067F 52 03       0970*       inc.s bc ; preserve width in BC and clear BCU
040681 ED 5B E4 00 0971*       ld de,(agnb_metadata+agnb_meta_height)
       04          
040686 1B          0972*       dec de
040687 52 13       0973*       inc.s de ; preserve height in DE and clear DEU
040689 3A E6 00 04 0974*       ld a,(agnb_metadata+agnb_meta_format)
04068D CD 31 0A 04 0975*       call vdu_bmp_create
040691 AF          0976*       xor a
040692 32 F7 00 04 0977*       ld (agnb_last_error),a
040696 C9          0978*       ret
040697             0979*   
040697             0980*   ; Consume the current DATA chunk's zero alignment padding and require the
040697             0981*   ; resulting position to equal the enclosing LIST payload end exactly.
040697             0982*   ; outputs: A=0 and Z set on success; error code and NZ on failure
040697             0983*   ; destroys: AF, BC, DE, HL
040697             0984*   agnb_finish_buffer_list:
040697             0985*   ; padding = (-payload_size) & 3
040697 3A E7 00 04 0986*       ld a,(agnb_metadata+agnb_meta_data_size)
04069B ED 44       0987*       neg
04069D E6 03       0988*       and 3
04069F 32 F5 00 04 0989*       ld (agnb_padding_size),a
0406A3 28 1E       0990*       jr z,@check_list_end
0406A5             0991*   
0406A5 01 00 00 00 0992*       ld bc,0
0406A9 4F          0993*       ld c,a
0406AA 11 F9 00 04 0994*       ld de,agnb_header
