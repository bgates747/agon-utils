0413BE             0044*   hlu_div2:
0413BE 22 9D 13 04 0045*       ld (scratch1),hl
0413C2 21 9F 13 04 0046*       ld hl,scratch1+2
0413C6 CB 1E       0047*       rr (hl)
0413C8 2B          0048*       dec hl
0413C9 CB 1E       0049*       rr (hl)
0413CB 2B          0050*       dec hl
0413CC CB 1E       0051*       rr (hl)
0413CE 23          0052*       inc hl
0413CF 23          0053*       inc hl
0413D0 2A 9D 13 04 0054*       ld hl,(scratch1)
0413D4 C9          0055*       ret
0413D5             0056*   
0413D5             0057*   ; this is my little hack to divide by 16
0413D5             0058*   hlu_div16:
0413D5 AF          0059*       xor a
0413D6 29          0060*       add hl,hl
0413D7 17          0061*       rla
0413D8 29          0062*       add hl,hl
0413D9 17          0063*       rla
0413DA 29          0064*       add hl,hl
0413DB 17          0065*       rla
0413DC 29          0066*       add hl,hl
0413DD 17          0067*       rla
0413DE 22 EB 13 04 0068*       ld (@scratch),hl
0413E2 32 EE 13 04 0069*       ld (@scratch+3),a
0413E6 2A EC 13 04 0070*       ld hl,(@scratch+1)
0413EA C9          0071*       ret
0413EB             0072*   @scratch: ds 4
