0409DB C9          0108*   	ret
0409DC             0109*   @cmd:
0409DC 17 01 00    0110*   	db 23,1,0
0409DF             0111*   @end:
0409DF             0112*   
0409DF             0113*   ; VDU 31, x, y: Move text cursor to x, y text position (TAB(x, y))
0409DF             0114*   ; inputs: c=x, b=y 8-bit unsigned integers
0409DF             0115*   vdu_move_cursor:
0409DF ED 43 F0 09 0116*       ld (@x0),bc
       04          
0409E4 21 EF 09 04 0117*   	ld hl,@cmd
0409E8 01 03 00 00 0118*   	ld bc,@end-@cmd
0409EC 5B DF       0119*   	rst.lil $18
0409EE C9          0120*   	ret
0409EF 1F          0121*   @cmd: 	db 31
0409F0 00          0122*   @x0:	db 0
0409F1 00          0123*   @y0: 	db 0
0409F2 00          0124*   @end: 	db 0 ; padding
0409F3             0125*   
0409F3             0126*   ; VDU 12: Clear text area (CLS)
0409F3             0127*   vdu_cls:
0409F3 3E 0C       0128*       ld a,12
0409F5 5B D7       0129*   	rst.lil $10
0409F7 C9          0130*   	ret
0409F8             0131*   
0409F8             0132*   vdu_set_screen_mode:
0409F8 32 08 0A 04 0133*   	ld (@arg),a
0409FC 21 07 0A 04 0134*   	ld hl,@cmd
040A00 01 02 00 00 0135*   	ld bc,@end-@cmd
040A04 5B DF       0136*   	rst.lil $18
040A06 C9          0137*   	ret
040A07 16          0138*   @cmd: db 22 ; set screen mode
040A08 00          0139*   @arg: db 0  ; screen mode parameter
040A09             0140*   @end:
040A09             0141*   
040A09             0142*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
040A09             0143*   ; inputs: a is scaling mode, 1=on, 0=off
040A09             0144*   ; note: default setting on boot is scaling ON
040A09             0145*   vdu_set_scaling:
040A09 32 1B 0A 04 0146*   	ld (@arg),a
040A0D 21 18 0A 04 0147*   	ld hl,@cmd
040A11 01 04 00 00 0148*   	ld bc,@end-@cmd
040A15 5B DF       0149*   	rst.lil $18
040A17 C9          0150*   	ret
040A18 17 00 C0    0151*   @cmd: db 23,0,0xC0
040A1B 00          0152*   @arg: db 0  ; scaling on/off
040A1C             0153*   @end:
040A1C             0154*   
040A1C             0155*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
040A1C             0156*   ; inputs: hl=bufferId
040A1C             0157*   
040A1C             0158*   vdu_buff_select:
040A1C 22 2E 0A 04 0159*   	ld (@bufferId),hl
040A20 21 2B 0A 04 0160*   	ld hl,@cmd
040A24 01 05 00 00 0161*   	ld bc,@end-@cmd
040A28 5B DF       0162*   	rst.lil $18
040A2A C9          0163*   	ret
040A2B 17 1B 20    0164*   @cmd: db 23,27,0x20
040A2E 00 00       0165*   @bufferId: dw 0x0000
040A30 00          0166*   @end: db 0x00 ; padding
040A31             0167*   
040A31             0168*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
040A31             0169*   ; inputs: a=format; bc=width; de=height
040A31             0170*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
040A31             0171*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
040A31             0172*   ; 0 	RGBA8888 (4-bytes per pixel)
040A31             0173*   ; 1 	RGBA2222 (1-bytes per pixel)
040A31             0174*   ; 2 	Mono/Mask (1-bit per pixel)
040A31             0175*   ; 3 	Reserved for internal use by VDP (“native” format)
040A31             0176*   
040A31             0177*   vdu_bmp_create:
040A31 ED 43 4D 0A 0178*       ld (@width),bc
       04          
040A36 ED 53 4F 0A 0179*       ld (@height),de
       04          
040A3B 32 51 0A 04 0180*       ld (@fmt),a
040A3F 21 4A 0A 04 0181*   	ld hl,@cmd
040A43 01 08 00 00 0182*   	ld bc,@end-@cmd
040A47 5B DF       0183*   	rst.lil $18
040A49 C9          0184*   	ret
040A4A 17 1B 21    0185*   @cmd:       db 23,27,0x21
040A4D 00 00       0186*   @width:     dw 0x0000
040A4F 00 00       0187*   @height:    dw 0x0000
040A51 00          0188*   @fmt:       db 0x00
040A52             0189*   @end:
040A52             0190*   
040A52             0191*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
040A52             0192*   ; &E8-&EF 	232-239 	Bitmap plot §
040A52             0193*   ; VDU 25, mode, x; y;: PLOT command
040A52             0194*   ; inputs: bc=x0, de=y0
040A52             0195*   ; prerequisites: vdu_buff_select
040A52             0196*   vdu_plot_bmp:
040A52 ED 43 69 0A 0197*       ld (@x0),bc
       04          
040A57 ED 53 6B 0A 0198*       ld (@y0),de
       04          
040A5C 21 67 0A 04 0199*   	ld hl,@cmd
040A60 01 06 00 00 0200*   	ld bc,@end-@cmd
040A64 5B DF       0201*   	rst.lil $18
040A66 C9          0202*   	ret
040A67 19          0203*   @cmd:   db 25
040A68 ED          0204*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
040A69 00 00       0205*   @x0: 	dw 0x0000
040A6B 00 00       0206*   @y0: 	dw 0x0000
040A6D 00          0207*   @end:   db 0x00 ; padding
040A6E             0208*   
040A6E             0209*   ; load a vdu buffer from local memory
040A6E             0210*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
040A6E             0211*   
040A6E             0212*   vdu_load_buffer:
040A6E ED 43 97 0A 0213*       ld (@length),bc
       04          
040A73 D5          0214*       push de ; save data pointer
040A74             0215*   ; send the vdu command string
040A74 7D          0216*       ld a,l
040A75 32 94 0A 04 0217*       ld (@bufferId),a
040A79 7C          0218*       ld a,h
040A7A 32 95 0A 04 0219*       ld (@bufferId+1),a
040A7E 21 91 0A 04 0220*       ld hl,@cmd
040A82 01 08 00 00 0221*       ld bc,@end-@cmd
040A86 5B DF       0222*       rst.lil $18
040A88             0223*   ; send the buffer data
040A88 E1          0224*       pop hl ; pointer to data
040A89 ED 4B 97 0A 0225*       ld bc,(@length)
       04          
040A8E 5B DF       0226*       rst.lil $18 ; send it
040A90 C9          0227*       ret
040A91             0228*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
040A91 17 00 A0    0229*   @cmd:       db 23,0,0xA0
040A94 00 00       0230*   @bufferId:	dw 0x0000
040A96 00          0231*   		    db 0 ; load buffer
040A97 00 00       0232*   @length:	dw 0x0000
040A99 00          0233*   @end: db 0 ; padding
040A9A             0234*   
040A9A             0235*   ; clear a buffer
040A9A             0236*   ; inputs: hl = bufferId
040A9A             0237*   
040A9A             0238*   vdu_clear_buffer:
040A9A 7D          0239*       ld a,l
040A9B 32 B2 0A 04 0240*       ld (@bufferId),a
040A9F 7C          0241*       ld a,h
040AA0 32 B3 0A 04 0242*       ld (@bufferId+1),a
040AA4 21 AF 0A 04 0243*       ld hl,@cmd
040AA8 01 06 00 00 0244*       ld bc,@end-@cmd
040AAC 5B DF       0245*       rst.lil $18
040AAE C9          0246*       ret
040AAF 17 00 A0    0247*   @cmd:       db 23,0,0xA0
040AB2 00 00       0248*   @bufferId:	dw 0x0000
040AB4 02          0249*   		    db 2 ; clear buffer
040AB5             0250*   @end:
040AB5             0251*   
040AB5             0252*   ; Command 14: Consolidate blocks in a buffer
040AB5             0253*   
040AB5             0254*   vdu_consolidate_buffer:
040AB5             0255*   ; set parameters for vdu call
040AB5 7D          0256*       ld a,l
040AB6 32 CD 0A 04 0257*       ld (@bufferId),a
040ABA 7C          0258*       ld a,h
040ABB 32 CE 0A 04 0259*       ld (@bufferId+1),a
040ABF 21 CA 0A 04 0260*       ld hl,@beg
040AC3 01 06 00 00 0261*       ld bc,@end-@beg
040AC7 5B DF       0262*       rst.lil $18
040AC9 C9          0263*       ret
