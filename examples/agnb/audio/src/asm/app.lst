0413A3             0006*   
0413A3             0007*   ; absolute value of hlu
0413A3             0008*   ; returns: abs(hlu), flags set according to the incoming sign of hlu:
0413A3             0009*   ;         s1,z0,pv0,n1,c0 if hlu was negative
0413A3             0010*   ;         s0,z1,pv0,n1,c0 if hlu was zero
0413A3             0011*   ;         s0,z0,pv0,n1,c0 if hlu was positive
0413A3             0012*   ; destroys: a
0413A3             0013*   hlu_abs:
0413A3 19          0014*       add hl,de
0413A4 B7          0015*       or a
0413A5 ED 52       0016*       sbc hl,de
0413A7 FA AC 13 04 0017*       jp m,@is_neg
0413AB C9          0018*       ret ; hlu is positive or zero so we're done
0413AC             0019*   @is_neg:
0413AC F5          0020*       push af ; otherwise, save current flags for return
0413AD CD B3 13 04 0021*       call neg_hlu ; negate hlu
0413B1 F1          0022*       pop af ; get back flags
0413B2 C9          0023*       ret
0413B3             0024*   
0413B3             0025*   ; flip the sign of hlu
0413B3             0026*   ; inputs: hlu
0413B3             0027*   ; returns: 0-hlu, flags set appropriately for the result:
0413B3             0028*   ;         s1,z0,pv0,n1,c1 if result is negative
0413B3             0029*   ;         s0,z1,pv0,n1,c0 if result is zero
0413B3             0030*   ;         s0,z0,pv0,n1,c1 if result is positive
0413B3             0031*   ; destroys a
0413B3             0032*   neg_hlu:
0413B3 D5          0033*       push de ; save de
0413B4 EB          0034*       ex de,hl ; put hl into de
0413B5 21 00 00 00 0035*       ld hl,0 ; clear hl
0413B9 AF          0036*       xor a ; clear carry
0413BA ED 52       0037*       sbc hl,de ; 0-hlu = -hlu
0413BC D1          0038*       pop de ; get de back
0413BD C9          0039*       ret ; easy peasy
