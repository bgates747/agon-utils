04028E C0          0472*       ret nz
04028F             0473*   
04028F             0474*   ; validate the RIFF container identifier
04028F 21 F9 00 04 0475*       ld hl,agnb_header+agnb_riff_id
040293 11 80 00 04 0476*       ld de,agnb_id_riff
040297 CD 11 01 04 0477*       call agnb_compare_fourcc
04029B 20 43       0478*       jr nz,@bad_riff_id
04029D             0479*   
04029D             0480*   ; validate that this RIFF contains the AGNB form
04029D 21 01 01 04 0481*       ld hl,agnb_header+agnb_riff_form
0402A1 11 84 00 04 0482*       ld de,agnb_id_agnb
0402A5 CD 11 01 04 0483*       call agnb_compare_fourcc
0402A9 20 39       0484*       jr nz,@bad_riff_form
