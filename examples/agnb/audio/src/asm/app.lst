0410AA             0124*   ; Prints the right justified decimal value in HL without leading zeroes
0410AA             0125*   ; HL : Value to print
0410AA             0126*   ; preserves all registers and flags
0410AA             0127*   ; printDec:
0410AA             0128*   ; ; back up all the things
0410AA             0129*   ;     push af
0410AA             0130*   ;     push bc
0410AA             0131*   ;     push de
0410AA             0132*   ;     push hl
0410AA             0133*   ;     LD DE, _printDecBuffer
0410AA             0134*   ;     CALL u24_to_ascii
0410AA             0135*   ; ; replace leading zeroes with spaces
0410AA             0136*   ;     LD HL, _printDecBuffer
0410AA             0137*   ;     ld B, 7 ; if HL was 0, we want to keep the final zero
0410AA             0138*   ; @loop:
0410AA             0139*   ;     LD A, (HL)
0410AA             0140*   ;     CP '0'
0410AA             0141*   ;     JP NZ, @done
0410AA             0142*   ;     LD A, ' '
0410AA             0143*   ;     LD (HL), A
0410AA             0144*   ;     INC HL
0410AA             0145*   ;     DJNZ @loop
0410AA             0146*   ; @done:
0410AA             0147*   ;     LD HL, _printDecBuffer
0410AA             0148*   ;     CALL printString
0410AA             0149*   ; ; restore all the things
0410AA             0150*   ;     pop hl
0410AA             0151*   ;     pop de
0410AA             0152*   ;     pop bc
0410AA             0153*   ;     pop af
0410AA             0154*   ;     RET
0410AA             0155*   ; _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
0410AA             0156*   
0410AA             0157*   ; same as printDec but signed
0410AA             0158*   printDecS:
0410AA             0159*   ; back up all the things
0410AA F5          0160*       push af
0410AB C5          0161*       push bc
0410AC D5          0162*       push de
0410AD E5          0163*       push hl
0410AE CD A3 13 04 0164*       call hlu_abs ; abs(hl), sign flag set if negative
0410B2 F5          0165*       push af ; save sign flag
0410B3 11 B3 09 04 0166*       LD DE, _printDecBuffer
0410B7 CD 3E 11 04 0167*       CALL u24_to_ascii
0410BB             0168*   ; replace leading zeroes with spaces
0410BB 21 B3 09 04 0169*       LD HL, _printDecBuffer
0410BF 06 07       0170*       ld B, 7 ; if HL was 0, we want to keep the final zero
0410C1 F1          0171*       pop af ; restore sign flag
0410C2 3E 20       0172*       ld a,' ' ; assume positive
0410C4 F2 CA 10 04 0173*       jp p,@print
0410C8 3E 2D       0174*       ld a,'-'
0410CA             0175*   @print:
0410CA 5B D7       0176*       rst.lil 10h
0410CC             0177*   @loop:
0410CC 7E          0178*       LD A, (HL)
0410CD FE 30       0179*       CP '0'
0410CF C2 D9 10 04 0180*       JP NZ, @done
0410D3 3E 20       0181*       LD A, ' '
0410D5 77          0182*       LD (HL), A
0410D6 23          0183*       INC HL
0410D7 10 F3       0184*       DJNZ @loop
0410D9             0185*   @done:
0410D9 21 B3 09 04 0186*       LD HL, _printDecBuffer
0410DD CD 7C 09 04 0187*       CALL printString
0410E1             0188*   ; restore all the things
0410E1 E1          0189*       pop hl
0410E2 D1          0190*       pop de
0410E3 C1          0191*       pop bc
0410E4 F1          0192*       pop af
0410E5 C9          0193*       RET
