040813             0170*   ; LIST must contain its type and three nested chunk headers at minimum.
040813 2A D0 00 04 0171*       ld hl,(agnb_state+agnb_state_chunk_size)
040817 11 1C 00 00 0172*       ld de,3*agnb_chunk_header_size+agnb_list_type_size
04081B B7          0173*       or a
04081C ED 52       0174*       sbc hl,de
