040AD0             0035        include "vdu_sound.inc"
040AD0             0001*   ; enable sound channels
040AD0             0002*   ; inputs: a = total num channels to be enabled
040AD0             0003*   ; returns: nothing
040AD0             0004*   ; destroys: af, bc, hl
040AD0             0005*   vdu_enable_channels:
040AD0 3D          0006*       dec a ; channels are zero-based
040AD1             0007*   @loop:
040AD1 32 EA 0A 04 0008*       ld (@channel),a
040AD5 21 E7 0A 04 0009*       ld hl,@beg
040AD9 01 05 00 00 0010*       ld bc,@end-@beg
040ADD F5          0011*       push af
040ADE 5B DF       0012*       rst.lil $18
040AE0 F1          0013*       pop af
040AE1 3D          0014*       dec a
040AE2 C2 D1 0A 04 0015*       jp nz,@loop
040AE6 C9          0016*       ret
040AE7             0017*   @beg:
040AE7 17 00 85    0018*               db 23, 0, $85
040AEA 00          0019*   @channel:   db 0
040AEB 08          0020*               db 8 ; command 8: enable channel
040AEC             0021*   @end:
040AEC             0022*   
040AEC             0023*   ; disable all but the three default sound channels
040AEC             0024*   ; inputs: max_channels set
040AEC             0025*   ; outputs: none
040AEC             0026*   ; destroys: ah,hl,bc
040AEC             0027*   vdu_disable_channels:
040AEC 3E 01       0028*       ld a,max_channels
040AEE D6 03       0029*       sub 3 ; subtract number of default channels already enabled
040AF0 F2 F7 0A 04 0030*       jp p,@loop
040AF4 C9          0031*       ret
040AF5 3E 03       0032*       ld a,3 ; first non-default channel
040AF7             0033*   @loop:
040AF7 32 12 0B 04 0034*       ld (@channel),a
040AFB 21 0F 0B 04 0035*       ld hl,@beg
040AFF 01 05 00 00 0036*       ld bc,@end-@beg
040B03 F5          0037*       push af
040B04 5B DF       0038*       rst.lil $18
040B06 F1          0039*       pop af
040B07 3C          0040*       inc a
040B08 FE 01       0041*       cp max_channels
040B0A C2 F7 0A 04 0042*       jp nz,@loop
040B0E C9          0043*       ret
040B0F             0044*   @beg:
040B0F 17 00 85    0045*       db 23, 0, $85
040B12 00          0046*   @channel: db 0
040B13 09          0047*       db 9 ; command 9: disable channel
040B14             0048*   @end:
040B14             0049*   
040B14             0050*   
040B14             0051*   ; ############################################################
040B14             0052*   ; VDU SOUND API
040B14             0053*   ; ############################################################
040B14             0054*   ; Command 0: Play note
040B14             0055*   ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
040B14             0056*       MACRO PLAY_NOTE channel, volume, frequency, duration
040B14             0057*       ld hl, @PLAY_NOTE_CMD        ; Start of command block
040B14             0058*       ld bc, @PLAY_NOTE_END - @PLAY_NOTE_CMD  ; Command block size
040B14             0059*       rst.lil $18
040B14             0060*       jr @PLAY_NOTE_END
040B14             0061*   @PLAY_NOTE_CMD:  db 23, 0, 0x85               ; Command header
040B14             0062*                    db channel                  ; Channel, 0 (commented out)
040B14             0063*                    db 0                        ; Play note command
040B14             0064*                    db volume                   ; Volume
040B14             0065*                    dw frequency                ; Frequency
040B14             0066*                    dw duration                 ; Duration
040B14             0067*   @PLAY_NOTE_END:
040B14             0068*       ENDMACRO
040B14             0069*   
040B14             0070*       MACRO MUTE_CHANNEL channel
040B14             0071*       ld hl, @MUTE_CHANNEL_CMD     ; Start of command block
040B14             0072*       ld bc, @MUTE_CHANNEL_END - @MUTE_CHANNEL_CMD  ; Command block size
040B14             0073*       rst.lil $18
040B14             0074*       jr @MUTE_CHANNEL_END
040B14             0075*   @MUTE_CHANNEL_CMD: db 23, 0, 0x85             ; Command header
040B14             0076*                      db channel                ; Channel, 0 (commented out)
040B14             0077*                      db 2                      ; Set volume command
040B14             0078*                      db 0                      ; Volume (mute)
040B14             0079*   @MUTE_CHANNEL_END:
040B14             0080*       ENDMACRO
040B14             0081*   
040B14             0082*   ; inputs: c = channel, b = volume, hl = frequency; de = duration;
040B14             0083*   vdu_play_note:
040B14 79          0084*       ld a,c
040B15 32 35 0B 04 0085*       ld (@channel),a
040B19 78          0086*       ld a,b
040B1A 32 37 0B 04 0087*       ld (@volume),a
040B1E 22 38 0B 04 0088*       ld (@frequency),hl
040B22 ED 53 3A 0B 0089*       ld (@duration),de
       04          
040B27 21 32 0B 04 0090*       ld hl,@cmd
040B2B 01 0A 00 00 0091*       ld bc,@end-@cmd
040B2F 5B DF       0092*       rst.lil $18
040B31 C9          0093*       ret
040B32 17 00 85    0094*   @cmd:       db 23, 0, 0x85
040B35 00          0095*   @channel:   db 0x00
040B36 00          0096*               db 0x00 ; play note command
040B37 00          0097*   @volume:    db 0x00
040B38 00 00       0098*   @frequency: dw 0x0000
040B3A 00 00       0099*   @duration:  dw 0x0000
040B3C 00          0100*   @end:       db 0x00 ; padding
040B3D             0101*   
040B3D             0102*   ; Command 1: Status
040B3D             0103*   ; VDU 23, 0, &85, channel, 1
040B3D             0104*   ; inputs: a = channel
040B3D             0105*   ; Returns a bit mask indicating the status of the specified channel, or 255 if the channel is not valid, or has been disabled. The bit mask is as follows:
040B3D             0106*   ; Bit 	Name 	Meaning
040B3D             0107*   ; 0 	Active 	When set this indicates the channel is in use (has an active waveform)
040B3D             0108*   ; 1 	Playing 	Indicates the channel is actively playing a note, and thus will reject calls to play a new note
040B3D             0109*   ; 2 	Indefinite 	Set if the channel is playing an indefinite duration note
040B3D             0110*   ; 3 	Has Volume Envelope 	Set if the channel has a volume envelope
040B3D             0111*   ; 4 	Has Frequency Envelope 	Set if the channel has a frequency envelope
040B3D             0112*   
040B3D             0113*   ; Bits 5-7 are reserved for future use and, for enabled channels, will currently always be zero.
040B3D             0114*   vdu_channel_status:
040B3D 32 4F 0B 04 0115*       ld (@channel),a
040B41 21 4C 0B 04 0116*       ld hl,@cmd
040B45 01 05 00 00 0117*       ld bc,@end-@cmd
040B49 5B DF       0118*       rst.lil $18
040B4B C9          0119*       ret
040B4C 17 00 85    0120*   @cmd:       db 23, 0, 0x85
040B4F 00          0121*   @channel:   db 0x00
040B50 01          0122*               db 0x01 ; get channel status command
040B51             0123*   @end:
040B51             0124*   
040B51             0125*   ; VDU 23, 0, &85, channel, 2, volume
040B51             0126*   ; inputs: c = channel, b = volume
040B51             0127*   ; Sets the volume of the specified channel. The volume is a value from 0 to 127, where 0 is silent and 127 is full volume. Values over 127 will be treated as 127 (with one exception described later).
040B51             0128*   
040B51             0129*   ; Specifying a channel of -1 (or 255) will set the global sound system volume level. (Requires Console8 VDP 2.5.0 or later.)
040B51             0130*   
040B51             0131*   ; Using this command provides more direct control over a channel than the play note command. It can be used to adjust the volume of a channel that is already playing a note.
040B51             0132*   vdu_channel_volume:
040B51 79          0133*       ld a,c
040B52 32 69 0B 04 0134*       ld (@channel),a
040B56 78          0135*       ld a,b
040B57 32 6B 0B 04 0136*       ld (@volume),a
040B5B 21 66 0B 04 0137*       ld hl,@cmd
040B5F 01 06 00 00 0138*       ld bc,@end-@cmd
040B63 5B DF       0139*       rst.lil $18
040B65 C9          0140*       ret
040B66 17 00 85    0141*   @cmd:       db 23, 0, 0x85
040B69 00          0142*   @channel:   db 0x00
040B6A 02          0143*               db 0x02 ; set volume command
040B6B 00          0144*   @volume:    db 0x00
040B6C             0145*   @end:
040B6C             0146*   
040B6C             0147*   ; VDU 23, 0, &85, channel, 3, frequency;
040B6C             0148*   
040B6C             0149*   ; Sets the frequency of the specified channel. The frequency is a 16-bit value specifying in Hz the frequency of the note to be played.
040B6C             0150*   
040B6C             0151*   ; Using this command provides more direct control over a channel than the play note command. It can be used to adjust the frequency of a channel that is already playing a note.
040B6C             0152*   
040B6C             0153*   ; Returns 1 on success, 0 for failure.
040B6C             0154*   vdu_channel_frequency:
040B6C 79          0155*       ld a,c
040B6D 32 84 0B 04 0156*       ld (@channel),a
040B71 ED 53 86 0B 0157*       ld (@frequency),de
       04          
040B76 21 81 0B 04 0158*       ld hl,@cmd
040B7A 01 07 00 00 0159*       ld bc,@end-@cmd
040B7E 5B DF       0160*       rst.lil $18
040B80 C9          0161*       ret
040B81 17 00 85    0162*   @cmd:       db 23, 0, 0x85
040B84 00          0163*   @channel:   db 0x00
040B85 03          0164*               db 0x03 ; set frequency command
040B86 00 00       0165*   @frequency: dw 0x0000
040B88 00          0166*   @end:       db 0x00 ; padding
040B89             0167*   
040B89             0168*   
040B89             0169*   ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
040B89             0170*   ; inputs: c = channel, b = waveformOrSample, [hl = bufferId]
040B89             0171*   ; Sets the waveform type for a channel to use. The waveformOrSample value is a single byte treated as a signed value.
040B89             0172*   
040B89             0173*   ; Using a negative value for the waveform indicates that a sample should be used instead. For more information see the documentation for the sample command.
040B89             0174*   
040B89             0175*   ; By default a channel is set to use waveform 0 (square wave).
040B89             0176*   
040B89             0177*   ; Valid waveform values are as follows:
040B89             0178*   ; Value 	Waveform
040B89             0179*   ; 0 	Square wave
040B89             0180*   ; 1 	Triangle wave
040B89             0181*   ; 2 	Sawtooth wave
040B89             0182*   ; 3 	Sine wave
040B89             0183*   ; 4 	Noise (simple white noise with no frequency support)
040B89             0184*   ; 5 	VIC Noise (emulates a VIC6561; supports frequency)
040B89             0185*   ; 8 	Sample (specifying a 16-bit buffer ID for sample data)
040B89             0186*   
040B89             0187*   vdu_channel_waveform:
040B89 79          0188*       ld a,c
040B8A 32 AF 0B 04 0189*       ld (@channel),a
040B8E 78          0190*       ld a,b
040B8F 32 B1 0B 04 0191*       ld (@waveform),a
040B93 FE 08       0192*       cp 8 ; check if the waveform is a sample
040B95 28 06       0193*       jr z, @sample
040B97 01 06 00 00 0194*       ld bc,@bufferId-@cmd
040B9B 18 08       0195*       jr @sendToVdu
040B9D             0196*   @sample:
040B9D 22 B2 0B 04 0197*       ld (@bufferId),hl
040BA1 01 08 00 00 0198*       ld bc,@end-@cmd
040BA5             0199*   @sendToVdu:
040BA5 21 AC 0B 04 0200*       ld hl,@cmd
040BA9 5B DF       0201*       rst.lil $18
040BAB C9          0202*       ret
040BAC 17 00 85    0203*   @cmd:       db 23, 0, 0x85
040BAF 00          0204*   @channel:   db 0x00
040BB0 04          0205*               db 0x04 ; set waveform command
040BB1 00          0206*   @waveform:  db 0x00
040BB2 00 00       0207*   @bufferId:  dw 0x0000
040BB4 00          0208*   @end:       db 0x00 ; padding
040BB5             0209*   
040BB5             0210*   ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
040BB5             0211*   ; inputs: hl = bufferId; a = format, de = sample rate in Hz
040BB5             0212*   ; The format is a single byte giving the format of the sample data. The following formats are supported:
040BB5             0213*   ; Value	Description
040BB5             0214*   ; 0	8-bit signed
040BB5             0215*   ; 1	8-bit unsigned
040BB5             0216*   ; The format value can also have modifier bits set to modify the behaviour of the sample. The following modifier bits are supported:
040BB5             0217*   ; Value	Description
040BB5             0218*   ; 8	sample rate is sent in the next 16-bits
040BB5             0219*   ; 16	sample is tuneable
040BB5             0220*   ; The default sample rate for samples on the VDP is 16kHz (actually 16.384kHz to be precise).
040BB5             0221*   vdu_buffer_to_sound:
040BB5 22 D5 0B 04 0222*       ld (@bufferId),hl
040BB9 C6 08       0223*       add a,8 ; modify format byte to indicate sample rate argument is given
040BBB 32 D7 0B 04 0224*       ld (@format),a
040BBF ED 53 D8 0B 0225*       ld (@sampleRate),de
       04          
040BC4 21 CF 0B 04 0226*       ld hl,@cmd
040BC8 01 0B 00 00 0227*       ld bc,@end-@cmd
040BCC 5B DF       0228*       rst.lil $18
040BCE C9          0229*       ret
040BCF 17 00 85    0230*   @cmd:       db 23, 0, 0x85
040BD2 00          0231*   @channel:   db 0x00 ; ignored
040BD3 05          0232*               db 0x05 ; buffer to sound command
040BD4 02          0233*               db 0x02 ; command 2 create sample
040BD5 00 00       0234*   @bufferId:  dw 0x0000
040BD7 00          0235*   @format:    db 0x00
040BD8 00 00       0236*   @sampleRate: dw 0x0000
040BDA 00          0237*   @end:       db 0x00 ; padding
040BDB             0238*   
040BDB             0239*   ; Command 13: Set sample rate
040BDB             0240*   ; VDU 23, 0, &85, channel, 13, sampleRate;
040BDB             0241*   ; inputs: c = channel, hl = sampleRate (Hz)
040BDB             0242*   vdu_set_sample_rate:
040BDB 79          0243*       ld a,c
040BDC 32 F2 0B 04 0244*       ld (@channel),a
040BE0 22 F4 0B 04 0245*       ld (@sampleRate),hl
040BE4 21 EF 0B 04 0246*       ld hl,@cmd
040BE8 01 07 00 00 0247*       ld bc,@end-@cmd
040BEC 5B DF       0248*       rst.lil $18
040BEE C9          0249*       ret
040BEF 17 00 85    0250*   @cmd:       db 23, 0, 0x85
040BF2 00          0251*   @channel:   db 0x00
040BF3 0D          0252*               db 13 ; set sample rate command
040BF4 00 00       0253*   @sampleRate: dw 0x0000
040BF6 00          0254*   @end:       db 0x00 ; padding
040BF7             0255*   
040BF7 00          0256*   last_channel: db 0
040BF8             0257*   max_channels: equ 1
040BF8             0258*   
040BF8             0259*   ; play a sound effect from an already loaded buffer
040BF8             0260*   ; inputs: hl = bufferId ; bc = duration in milliseconds
040BF8             0261*   vdu_play_sfx:
040BF8 22 30 0C 04 0262*       ld (@bufferId),hl
040BFC ED 43 3A 0C 0263*       ld (@duration),bc
       04          
040C01 3E 17       0264*       ld a,23
040C03 32 32 0C 04 0265*       ld (@bufferId+2),a
040C07 3A F7 0B 04 0266*       ld a,(last_channel)
040C0B 3C          0267*       inc a
040C0C             0268*       ; and 31 ; modulo 32
040C0C FE 01       0269*       cp max_channels
040C0E C2 13 0C 04 0270*       jp nz,@load_channel
040C12 AF          0271*       xor a
040C13             0272*   @load_channel:
040C13 32 F7 0B 04 0273*       ld (last_channel),a
040C17 32 2D 0C 04 0274*       ld (@channel0),a
040C1B 32 35 0C 04 0275*       ld (@channel1),a
040C1F 21 2A 0C 04 0276*       ld hl, @sample
040C23 01 12 00 00 0277*       ld bc, @sample_end - @sample
040C27 5B DF       0278*       rst.lil $18
040C29 C9          0279*       ret
040C2A             0280*   @sample:
040C2A             0281*   ; Command 4: Set waveform
040C2A             0282*   ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
040C2A 17 00 85    0283*       .db 23,0,$85                        ; do sound
040C2D             0284*   @channel0:
040C2D 00 04 08    0285*       .db 0,4,8 ; channel, command, waveform
040C30             0286*   @bufferId:
040C30 00 00       0287*       .dw 0x0000
040C32             0288*   ; Command 0: Play note
040C32             0289*   ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
040C32 17 00 85    0290*       .db 23,0,$85                        ; do sound
040C35             0291*   @channel1:
040C35 00 00 7F    0292*       .db 0,0,127                ; channel, volume
040C38 00 00       0293*       .dw 0
040C3A             0294*   @duration:                              ; freq (tuneable samples only)
040C3A 00 00       0295*       .dw 0x0000                        ; duration
040C3C             0296*   @sample_end:
040C3C 00          0297*       .db 0x00 ; padding
040C3D             0298*   
040C3D             0299*   ; inputs: c = channel, b = volume, de = sample rate; hl = bufferId;
040C3D             0300*   vdu_play_sample:
040C3D             0301*       ; populate input parameters
040C3D 79          0302*       ld a,c
040C3E 32 70 0C 04 0303*       ld (@channel0),a
040C42 32 78 0C 04 0304*       ld (@channel1),a
040C46 32 7F 0C 04 0305*       ld (@channel2),a
040C4A 78          0306*       ld a,b
040C4B 32 81 0C 04 0307*       ld (@volume),a
040C4F ED 53 7A 0C 0308*       ld (@sampleRate),de
       04          
040C54 22 73 0C 04 0309*       ld (@bufferId),hl
040C58 3E 17       0310*       ld a,23
040C5A 32 75 0C 04 0311*       ld (@cmd1),a
040C5E 32 7C 0C 04 0312*       ld (@cmd2),a
040C62             0313*       ; prep the vdu command string
040C62 21 6D 0C 04 0314*       ld hl, @cmd0
040C66 01 19 00 00 0315*       ld bc, @end - @cmd0
040C6A 5B DF       0316*       rst.lil $18
040C6C C9          0317*       ret
040C6D             0318*   ; set waveform command
040C6D 17 00 85    0319*   @cmd0:       db 23, 0, 0x85
040C70 00          0320*   @channel0:   db 0x00
040C71 04          0321*                db 0x04 ; set waveform command
040C72 08          0322*   @waveform:   db 0x08 ; sample
040C73 00 00       0323*   @bufferId:   dw 0x0000
040C75             0324*   ; set sample rate command
040C75 17 00 85    0325*   @cmd1:       db 23, 0, 0x85
040C78 00          0326*   @channel1:   db 0x00
040C79 0D          0327*               db 13 ; set sample rate command
040C7A 00 00       0328*   @sampleRate: dw 0x0000
040C7C             0329*   ; play note command
040C7C 17 00 85    0330*   @cmd2:       db 23, 0, 0x85
040C7F 00          0331*   @channel2:   db 0x00
040C80 00          0332*                db 0x00 ; play note command
040C81 00          0333*   @volume:     db 0x00
040C82 00 00       0334*   @frequency:  dw 0x00 ; no effect unless buffer has been set to tuneable sample
040C84 00 00       0335*   @duration:   dw 0x0000 ; milliseconds: set to -1 to loop indefinitely, 0 to play full duration once
040C86 00          0336*   @end:        db 0x00 ; padding
040C87             0036        include "debug.inc"  ; retained dependency of the copied AGNB API
040C87             0001*   printHexA:
040C87 F5          0002*       push af
040C88 C5          0003*       push bc
040C89 CD 8C 10 04 0004*       call printHex8
040C8D 3E 20       0005*       ld a,' '
040C8F 5B D7       0006*       rst.lil 10h
040C91 C1          0007*       pop bc
040C92 F1          0008*       pop af
040C93 C9          0009*       ret
040C94             0010*   
040C94             0011*   printHexHL:
040C94 F5          0012*       push af
040C95 C5          0013*       push bc
040C96 CD 86 10 04 0014*       call printHex16
040C9A 3E 20       0015*       ld a,' '
040C9C 5B D7       0016*       rst.lil 10h
040C9E C1          0017*       pop bc
040C9F F1          0018*       pop af
040CA0 C9          0019*       ret
040CA1             0020*   
