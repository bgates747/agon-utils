0406B2 C0          0996*       ret nz
0406B3             0997*   
0406B3             0998*   ; Version 0.1 writers emit only zero-valued alignment padding.
0406B3 3A F5 00 04 0999*       ld a,(agnb_padding_size)
0406B7 47          1000*       ld b,a
0406B8 21 F9 00 04 1001*       ld hl,agnb_header
