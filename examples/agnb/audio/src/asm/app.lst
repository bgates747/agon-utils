0407F9             0161*   
0407F9 DD 21 C8 00 0162*       ld ix,agnb_state+agnb_state_riff_end
       04          
0407FE CD F0 02 04 0163*       call agnb_read_chunk_header
040802 C0          0164*       ret nz
040803 21 F9 00 04 0165*       ld hl,agnb_header+agnb_chunk_id
040807 11 8C 00 04 0166*       ld de,agnb_id_list
04080B CD 11 01 04 0167*       call agnb_compare_fourcc
