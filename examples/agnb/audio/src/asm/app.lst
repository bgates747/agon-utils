040CA2 C5          0023*       push bc
040CA3 CD 7E 10 04 0024*       call printHex24
040CA7 3E 20       0025*       ld a,' '
040CA9 5B D7       0026*       rst.lil 10h
040CAB C1          0027*       pop bc
040CAC F1          0028*       pop af
040CAD C9          0029*       ret
040CAE             0030*   
040CAE             0031*   printHexAUHL:
