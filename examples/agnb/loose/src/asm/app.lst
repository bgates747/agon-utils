0424C7             0376*   ; delay routine
0424C7             0377*   ; Author: Richard Turrnidge
0424C7             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
0424C7             0379*   ; routine waits a fixed time,then returns
0424C7             0380*   ; arrive with A =  the delay byte. One bit to be set only.
0424C7             0381*   ; eg. ld A,00000100b
0424C7             0382*   
0424C7             0383*   multiPurposeDelay:
       FF FF FF 
0424C7 F5          0384*       push af
0424C8 C5          0385*       push bc
0424C9 DD E5       0386*       push ix
0424CB 47          0387*       ld b,a
0424CC 3E 08       0388*       ld a,$08
0424CE 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
0424D0             0390*   
0424D0             0391*   waitLoop:
0424D0             0392*   
0424D0 DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0424D3             0394*   
0424D3             0395*                                   ;   we check if bit set is same as last time we checked.
0424D3             0396*                                   ;   bit 0 - don't use
0424D3             0397*                                   ;   bit 1 - changes 64 times per second
0424D3             0398*                                   ;   bit 2 - changes 32 times per second
0424D3             0399*                                   ;   bit 3 - changes 16 times per second
0424D3             0400*   
0424D3             0401*                                   ;   bit 4 - changes 8 times per second
0424D3             0402*                                   ;   bit 5 - changes 4 times per second
0424D3             0403*                                   ;   bit 6 - changes 2 times per second
0424D3             0404*                                   ;   bit 7 - changes 1 times per second
0424D3 A0          0405*       and b
0424D4 4F          0406*       ld c,a
0424D5 3A E6 24 04 0407*       ld a,(oldTimeStamp)
0424D9 B9          0408*       cp c                        ; is A same as last value?
0424DA 28 F4       0409*       jr z,waitLoop              ; loop here if it is
0424DC 79          0410*       ld a,c
0424DD 32 E6 24 04 0411*       ld (oldTimeStamp),a        ; set new value
0424E1             0412*   
0424E1 DD E1       0413*       pop ix
0424E3 C1          0414*       pop bc
0424E4 F1          0415*       pop af
0424E5 C9          0416*       ret
0424E6             0417*   
0424E6 00          0418*   oldTimeStamp:   .db 00h
