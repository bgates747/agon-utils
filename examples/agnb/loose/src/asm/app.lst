0402DD CD 95 02 04 0411*       call u24_to_ascii
0402E1 21 85 02 04 0412*       ld hl,_printDecBuffer
0402E5 CD 5A 01 04 0413*       call printString
0402E9 3E 20       0414*       ld a,' '
0402EB 5B D7       0415*       rst.lil 10h
