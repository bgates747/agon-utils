04258C             0109*   ; VDU 9: Move cursor forward one character
04258C             0110*   
04258C             0111*   vdu_move_cursor:
04258C ED 43 9D 25 0112*       ld (@x0),bc
       04          
042591 21 9C 25 04 0113*   	ld hl,@cmd
042595 01 03 00 00 0114*   	ld bc,@end-@cmd
042599 5B DF       0115*   	rst.lil $18
04259B C9          0116*   	ret
04259C 1F          0117*   @cmd: 	db 31
04259D 00          0118*   @x0:	db 0
04259E 00          0119*   @y0: 	db 0
04259F 00          0120*   @end: 	db 0 ; padding
0425A0             0121*   
0425A0             0122*   ; VDU 12: Clear text area (CLS)
0425A0             0123*   
0425A0             0124*   vdu_cls:
