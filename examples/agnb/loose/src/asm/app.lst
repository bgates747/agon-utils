04241B             0253*   ; set a countdown timer
04241B             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04241B             0255*   ; returns: hl = current time
04241B             0256*   tmr_set:
04241B FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
04241E             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04241E 3E 08       0001*M1 			LD	A, function
042420 5B CF       0002*M1 			RST.LIL	08h
042422 DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
042425 FD 2F 00    0260*       ld (iy+0),hl            ; set start time
042428 C9          0261*       ret
042429             0262*   
042429             0263*   ; gets time remaining on a countdown timer
042429             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
042429             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
042429             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
042429             0267*   tmr_get:
042429             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
042429 3E 08       0001*M1 			LD	A, function
04242B 5B CF       0002*M1 			RST.LIL	08h
04242D DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
042430 FD 27 00    0270*       ld hl,(iy+0)            ; get start time
042433 AF          0271*       xor a                   ; clear carry
042434 ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
042436 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
042439 AF          0274*       xor a                   ; clear carry
04243A ED 5A       0275*       adc hl,de               ; hl = time remaining
04243C             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04243C C9          0277*       ret
04243D             0278*   
04243D 00 00 00    0279*   timestamp_now: dl 0
042440 00 00 00    0280*   timestamp_old: dl 0
042443 00 00 00    0281*   timestamp_chg: dl 0
042446             0282*   
042446             0283*   ; update the global timestamp from the system clock
042446             0284*   ; inputs: none
042446             0285*   ; returns: hl = time elapsed in 1/120ths of a second
042446             0286*   ;          de = current time
042446             0287*   ;          ix = pointer to syvars table
042446             0288*   ; destroys: af,hl,de,ix
042446             0289*   timestamp_tick:
042446 ED 5B 3D 24 0290*       ld de,(timestamp_now)   ; get previous time
       04          
04244B ED 53 40 24 0291*       ld (timestamp_old),de   ; save previous time
       04          
042450             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
042450 3E 08       0001*M1 			LD	A, function
042452 5B CF       0002*M1 			RST.LIL	08h
042454 DD 27 00    0293*       ld hl,(ix+sysvar_time)  ; get current time
042457 22 3D 24 04 0294*       ld (timestamp_now),hl   ; save current time
04245B AF          0295*       xor a                   ; clear carry
04245C ED 52       0296*       sbc hl,de               ; hl = time elapsed
04245E 22 43 24 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
042462 C9          0298*       ret
042463             0299*   
042463             0300*   ; set a countdown timer
042463             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
042463             0302*   ; requires: timestamp_tick to be called at least once before this function
042463             0303*   ; returns: hl = current time
042463             0304*   ; destroys: hl
042463             0305*   timestamp_tmr_set:
