0444F9             0001*   temp:
0444F9 21 80 00 00 0002*       ld hl,128 ; random bufferId
0444FD 01 28 00 00 0003*       ld bc,@temp_string_end-@temp_string
044501 11 15 45 04 0004*       ld de,@temp_string
044505 CD 44 0B 04 0005*       call vdu_load_buffer
044509             0006*   
044509 21 15 45 04 0007*       ld hl,@temp_string
04450D CD 5A 01 04 0008*       call printString
044511 C3 54 00 04 0009*       jp exit
