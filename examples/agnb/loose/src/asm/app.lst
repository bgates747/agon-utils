       00 00 00 00 
04252E             0050*   
04252E             0051*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
04252E             0052*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
04252E             0053*   ; so it will allways be 8 characters length
04252E             0054*   ; HL : Value to convert to string
04252E             0055*   ; DE : pointer to buffer, at least 8 byte + 0
04252E             0056*   
04252E             0057*   u24_to_ascii:
04252E 01 80 69 67 0058*       LD BC,-10000000
042532 CD 65 25 04 0059*       CALL @one_digit
042536 01 C0 BD F0 0060*       LD BC,-1000000
04253A CD 65 25 04 0061*       CALL @one_digit
04253E 01 60 79 FE 0062*       LD BC,-100000
042542 CD 65 25 04 0063*       CALL @one_digit
042546 01 F0 D8 FF 0064*       LD BC,-10000
04254A CD 65 25 04 0065*       CALL @one_digit
04254E 01 18 FC FF 0066*       LD BC,-1000
042552 CD 65 25 04 0067*       CALL @one_digit
042556 01 9C FF FF 0068*       LD BC,-100
04255A CD 65 25 04 0069*       CALL @one_digit
04255E 0E F6       0070*       LD C,-10
042560 CD 65 25 04 0071*       CALL @one_digit
042564 48          0072*       LD C,B
042565             0073*   @one_digit:
042565 3E 2F       0074*       LD A,'0'-1
042567             0075*   @divide_me:
042567 3C          0076*       INC A
042568 09          0077*       ADD HL,BC
042569 38 FC       0078*       JR C,@divide_me
04256B ED 42       0079*       SBC HL,BC
04256D 12          0080*       LD (DE),A
04256E 13          0081*       INC DE
04256F C9          0082*       RET
042570             0083*   
042570             0084*   
042570             0085*   ; Routines, constants, and private data selected from vdu.inc
042570             0086*   ; Retained in original source-file order.
042570             0087*   
042570             0088*   plot_bmp: equ 0xE8
042570             0089*   dr_abs_fg: equ 5
042570             0090*   
042570             0091*   cursor_on:
042570 21 7B 25 04 0092*   	ld hl,@cmd
042574 01 03 00 00 0093*   	ld bc,@end-@cmd
