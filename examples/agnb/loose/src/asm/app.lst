040060             0001*   ; https://github.com/envenomator/Agon/blob/master/ez80asm%20examples%20(annotated)/mos_api.inc
040060             0002*   ;
040060             0003*   ; Title:	AGON MOS - API for user projects
040060             0004*   ; Author:	Dean Belfield
040060             0005*   ;			Adapted for agon-ez80asm by Jeroen Venema
040060             0006*   ;			Added MOS error codes for return in HL
040060             0007*   ; Created:	03/08/2022
040060             0008*   ; Last Updated:	10/08/2023
040060             0009*   ;
040060             0010*   ; Modinfo:
040060             0011*   ; 05/08/2022:	Added mos_feof
040060             0012*   ; 09/08/2022:	Added system variables: cursorX, cursorY
040060             0013*   ; 18/08/2022:	Added system variables: scrchar, scrpixel, audioChannel, audioSuccess, vpd_pflags
040060             0014*   ; 05/09/2022:	Added mos_ren, vdp_pflag_mode
040060             0015*   ; 24/09/2022:	Added mos_getError, mos_mkdir
040060             0016*   ; 13/10/2022:	Added mos_oscli
040060             0017*   ; 23/02/2023:	Added more sysvars, fixed typo in sysvar_audioSuccess, offsets for sysvar_scrCols, sysvar_scrRows
040060             0018*   ; 04/03/2023:	Added sysvar_scrpixelIndex
040060             0019*   ; 08/03/2023:	Renamed sysvar_keycode to sysvar_keyascii, added sysvar_vkeycode
040060             0020*   ; 15/03/2023:	Added mos_copy, mos_getrtc, mos_setrtc, rtc, vdp_pflag_rtc
040060             0021*   ; 21/03/2023:	Added mos_setintvector, sysvars for keyboard status, vdu codes for vdp
040060             0022*   ; 22/03/2023:	The VDP commands are now indexed from 0x80
040060             0023*   ; 29/03/2023:	Added mos_uopen, mos_uclose, mos_ugetc, mos_uputc
040060             0024*   ; 13/04/2023:	Added FatFS file structures (FFOBJID, FIL, DIR, FILINFO)
040060             0025*   ; 15/04/2023:	Added mos_getfil, mos_fread, mos_fwrite and mos_flseek
040060             0026*   ; 19/05/2023:	Added sysvar_scrMode
040060             0027*   ; 05/06/2023:	Added sysvar_rtcEnable
040060             0028*   ; 03/08/2023:	Added mos_setkbvector
040060             0029*   ; 10/08/2023:	Added mos_getkbmap
040060             0030*   
040060             0031*   ; VDP control (VDU 23, 0, n)
040060             0032*   ;
040060             0033*   vdp_gp:				EQU 80h
040060             0034*   vdp_keycode:		EQU 81h
040060             0035*   vdp_cursor:			EQU	82h
040060             0036*   vdp_scrchar:		EQU	83h
040060             0037*   vdp_scrpixel:		EQU	84h
040060             0038*   vdp_audio:			EQU	85h
040060             0039*   vdp_mode:			EQU	86h
040060             0040*   vdp_rtc:			EQU	87h
040060             0041*   vdp_keystate:		EQU	88h
040060             0042*   vdp_logicalcoords:	EQU	C0h
040060             0043*   vdp_terminalmode:	EQU	FFh
040060             0044*   
040060             0045*   ;
040060             0046*   ; Macro for calling the API
040060             0047*   ; Parameters:
040060             0048*   ; - function: One of the function numbers listed below
040060             0049*   ;
040060             0050*   	MACRO	MOSCALL	function
040060             0051*   			LD	A, function
040060             0052*   			RST.LIL	08h
040060             0053*   	ENDMACRO
040060             0054*   
040060             0055*   ;
040060             0056*   ; Same as above but keeps IY safe on FFS calls
040060             0057*   ; (can be use for regular MOS calls as well)
040060             0058*   ;
040060             0059*   	MACRO	FFSCALL	function
040060             0060*   			PUSH IY
040060             0061*   			LD	A, function
040060             0062*   			RST.LIL	08h
040060             0063*   			POP IY
040060             0064*   	ENDMACRO
040060             0065*   
040060             0066*   ; MOS high level functions
040060             0067*   ;
040060             0068*   ; Get keycode
040060             0069*   ; Returns:
040060             0070*   ;  A: ASCII code of key pressed, or 0 if no key pressed
040060             0071*   mos_getkey:			EQU	00h
040060             0072*   
040060             0073*   ; Load an area of memory from a file.
040060             0074*   ; HLU: Address of filename (zero terminated)
040060             0075*   ; DEU: Address at which to load
040060             0076*   ; BCU: Maximum allowed size (bytes)
040060             0077*   ; Returns:
040060             0078*   ; - A: File error, or 0 if OK
040060             0079*   ; - F: Carry reset indicates no room for file.
040060             0080*   mos_load:			EQU	01h
040060             0081*   
040060             0082*   ; Save a file to the SD card from RAM
040060             0083*   ; HLU: Address of filename (zero terminated)
040060             0084*   ; DEU: Address to save from
040060             0085*   ; BCU: Number of bytes to save
040060             0086*   ; Returns:
040060             0087*   ; - A: File error, or 0 if OK
040060             0088*   ; - F: Carry reset indicates no room for file
040060             0089*   mos_save:			EQU	02h
040060             0090*   
040060             0091*   ; Change directory
040060             0092*   ; HLU: Address of path (zero terminated)
040060             0093*   ; Returns:
040060             0094*   ; - A: File error, or 0 if OK
040060             0095*   mos_cd:				EQU	03h
040060             0096*   
040060             0097*   ; Directory listing
040060             0098*   ; HLU: Address of path (zero terminated)
040060             0099*   ; Returns:
040060             0100*   ; - A: File error, or 0 if OK
040060             0101*   mos_dir:			EQU	04h
040060             0102*   
040060             0103*   ; Delete a file from the SD card
040060             0104*   ; HLU: Address of filename (zero terminated)
040060             0105*   ; Returns:
040060             0106*   ; - A: File error, or 0 if OK
040060             0107*   mos_del:			EQU	05h
040060             0108*   
040060             0109*   ; Rename a file on the SD card
040060             0110*   ; HLU: Address of filename1 (zero terminated)
040060             0111*   ; DEU: Address of filename2 (zero terminated)
040060             0112*   ; Returns:
040060             0113*   ; - A: File error, or 0 if OK
040060             0114*   mos_ren:			EQU	06h
040060             0115*   
040060             0116*   ; Make a folder on the SD card
040060             0117*   ; HLU: Address of filename (zero terminated)
040060             0118*   ; Returns:
040060             0119*   ; - A: File error, or 0 if OK
040060             0120*   mos_mkdir:			EQU	07h
040060             0121*   
040060             0122*   ; Get a pointer to a system variable
040060             0123*   ; Returns:
040060             0124*   ; IXU: Pointer to system variables (see mos_api.asm for more details)
040060             0125*   mos_sysvars:		EQU	08h
040060             0126*   
040060             0127*   ; Invoke the line editor
040060             0128*   ; HLU: Address of the buffer
040060             0129*   ; BCU: Buffer length
040060             0130*   ;   E: 0 to not clear buffer, 1 to clear
040060             0131*   ; Returns:
040060             0132*   ;   A: Key that was used to exit the input loop (CR=13, ESC=27)
040060             0133*   mos_editline:		EQU	09h
040060             0134*   
040060             0135*   ; Open a file
040060             0136*   ; HLU: Filename
040060             0137*   ;   C: Mode
040060             0138*   ; Returns:
040060             0139*   ;   A: Filehandle, or 0 if couldn't open
040060             0140*   mos_fopen:			EQU	0Ah
040060             0141*   
040060             0142*   ; Close a file
040060             0143*   ;   C: Filehandle
040060             0144*   ; Returns
040060             0145*   ;   A: Number of files still open
040060             0146*   mos_fclose:			EQU	0Bh
040060             0147*   
040060             0148*   ; Get a character from a file
040060             0149*   ;   C: Filehandle
040060             0150*   ; Returns:
040060             0151*   ;   A: Character read
040060             0152*   ;   F: C set if last character in file, otherwise NC
040060             0153*   mos_fgetc:			EQU	0Ch
040060             0154*   
040060             0155*   ; Write a character to a file
040060             0156*   ;   C: Filehandle
040060             0157*   ;   B: Character to write
040060             0158*   mos_fputc:			EQU	0Dh
040060             0159*   
040060             0160*   ; Check whether we're at the end of the file
040060             0161*   ;   C: Filehandle
040060             0162*   ; Returns:
040060             0163*   ;   A: 1 if at end of file, otherwise 0
040060             0164*   mos_feof:			EQU	0Eh
040060             0165*   
040060             0166*   ; Copy an error message
040060             0167*   ;   E: The error code
040060             0168*   ; HLU: Address of buffer to copy message into
040060             0169*   ; BCU: Size of buffer
040060             0170*   mos_getError:		EQU	0Fh
040060             0171*   
040060             0172*   ; Execute a MOS command
040060             0173*   ; HLU: Pointer the the MOS command string
040060             0174*   ; DEU: Pointer to additional command structure
040060             0175*   ; BCU: Number of additional commands
040060             0176*   ; Returns:
040060             0177*   ;   A: MOS error code
040060             0178*   mos_oscli:			EQU	10h
040060             0179*   
040060             0180*   ; Copy a file on the SD card
040060             0181*   ; HLU: Address of filename1 (zero terminated)
040060             0182*   ; DEU: Address of filename2 (zero terminated)
040060             0183*   ; Returns:
040060             0184*   ; - A: File error, or 0 if OK
040060             0185*   mos_copy:			EQU	11h
040060             0186*   
040060             0187*   ; Fetch a RTC string
040060             0188*   ; HLU: Pointer to a buffer to copy the string to
040060             0189*   ; Returns:
040060             0190*   ;   A: Length of time
040060             0191*   mos_getrtc:			EQU	12h
040060             0192*   
040060             0193*   ; Set the RTC
040060             0194*   ; HLU: Pointer to a buffer with the time data in
040060             0195*   mos_setrtc:			EQU	13h
040060             0196*   
040060             0197*   ; Set an interrupt vector
040060             0198*   ; HLU: Pointer to the interrupt vector (24-bit pointer)
040060             0199*   ;   E: Vector # to set
040060             0200*   ; Returns:
040060             0201*   ; HLU: Pointer to the previous vector
040060             0202*   mos_setintvector:	EQU	14h
040060             0203*   
040060             0204*   ; Open UART1
040060             0205*   ; IXU: Pointer to UART struct
040060             0206*   ;	+0: Baud rate (24-bit, little endian)
040060             0207*   ;	+3: Data bits
040060             0208*   ;	+4: Stop bits
040060             0209*   ;	+5: Parity bits
040060             0210*   ;	+6: Flow control (0: None, 1: Hardware)
040060             0211*   ;	+7: Enabled interrupts
040060             0212*   ; Returns:
040060             0213*   ;   A: Error code (0 = no error)
040060             0214*   mos_uopen:			EQU	15h
040060             0215*   
040060             0216*   ; Close UART1
040060             0217*   mos_uclose:			EQU	16h
040060             0218*   
040060             0219*   ; Get a character from UART1
040060             0220*   ; Returns:
040060             0221*   ;   A: Character read
040060             0222*   ;   F: C if successful
040060             0223*   ;   F: NC if the UART is not open
040060             0224*   mos_ugetc:			EQU	17h
040060             0225*   
040060             0226*   ; Write a character to UART1
040060             0227*   ;   C: Character to write
040060             0228*   ; Returns:
040060             0229*   ;   F: C if successful
040060             0230*   ;   F: NC if the UART is not open
040060             0231*   mos_uputc:			EQU	18h
040060             0232*   
040060             0233*   ; Convert a file handle to a FIL structure pointer
040060             0234*   ;   C: Filehandle
040060             0235*   ; Returns:
040060             0236*   ; HLU: Pointer to a FIL struct
040060             0237*   mos_getfil:			EQU	19h
040060             0238*   
040060             0239*   ; Read a block of data from a file
040060             0240*   ;   C: Filehandle
040060             0241*   ; HLU: Pointer to where to write the data to
040060             0242*   ; DEU: Number of bytes to read
040060             0243*   ; Returns:
040060             0244*   ; DEU: Number of bytes read
040060             0245*   mos_fread:			EQU	1Ah
040060             0246*   
040060             0247*   ; Write a block of data to a file
040060             0248*   ;  C: Filehandle
040060             0249*   ; HLU: Pointer to where the data is
040060             0250*   ; DEU: Number of bytes to write
040060             0251*   ; Returns:
040060             0252*   ; DEU: Number of bytes read
040060             0253*   mos_fwrite:			EQU	1Bh
040060             0254*   
040060             0255*   ; Move the read/write pointer in a file
040060             0256*   ;   C: Filehandle
040060             0257*   ; HLU: Least significant 3 bytes of the offset from the start of the file (DWORD)
040060             0258*   ;   E: Most significant byte of the offset
040060             0259*   ; Returns:
040060             0260*   ;   A: FRESULT
040060             0261*   mos_flseek:			EQU	1Ch
040060             0262*   
040060             0263*   ; Move the read/write pointer in a file relative to the current position
040060             0264*   ;   C: Filehandle
040060             0265*   ; DEU: Signed 24-bit offset
040060             0266*   ; Returns:
040060             0267*   ;   A: FRESULT
040060             0268*   mos_api_flseek_rel:
040060 C5          0269*   	push bc ; back up file handle in c
040061 D5          0270*   	push de ; save offset
040062             0271*   	MOSCALL mos_getfil
                       M1 Args: function=mos_getfil 
040062 3E 19       0001*M1 			LD	A, function
040064 5B CF       0002*M1 			RST.LIL	08h
040066 E5          0272*   	push hl
040067 FD E1       0273*   	pop iy ; iy points to FIL struct
040069 FD 27 11    0274*   	ld hl,(iy+fil_fptr) ; get lowest 3 bytes of current position
04006C AF          0275*   	xor a ; clear carry
04006D D1          0276*   	pop de ; restore offset
04006E ED 5A       0277*   	adc hl,de ; adc the offset because we need sign flag
040070 F2 78 00 04 0278*   	jp p,@not_neg
040074 21 00 00 00 0279*   	ld hl,0 ; seek to beginning of file
040078             0280*   @not_neg:
040078 C1          0281*   	pop bc ; restore file handle to c
040079 1E 00       0282*   	ld e,0 ; highest byte of offset
04007B             0283*   	MOSCALL mos_flseek
                       M1 Args: function=mos_flseek 
04007B 3E 1C       0001*M1 			LD	A, function
04007D 5B CF       0002*M1 			RST.LIL	08h
04007F C9          0284*   	ret
040080             0285*   
040080             0286*   ; Set a VDP keyboard packet receiver callback
040080             0287*   ;   C: If non-zero then set the top byte of HLU(callback address)  to MB (for ADL=0 callers)
040080             0288*   ; HLU: Pointer to callback
040080             0289*   mos_setkbvector:	EQU	1Dh
040080             0290*   
040080             0291*   ; Get the address of the keyboard map
040080             0292*   ; Returns:
040080             0293*   ; IXU: Base address of the keymap
040080             0294*   mos_getkbmap:		EQU	1Eh
040080             0295*   
040080             0296*   ; MOS program exit codes
040080             0297*   ;
040080             0298*   EXIT_OK:				EQU  0;	"OK",
040080             0299*   EXIT_ERROR_SD_ACCESS:	EQU	 1;	"Error accessing SD card",
040080             0300*   EXIT_ERROR_ASSERTION:	EQU  2;	"Assertion failed",
040080             0301*   EXIT_SD_CARDFAILURE:	EQU  3;	"SD card failure",
040080             0302*   EXIT_FILENOTFOUND:		EQU  4;	"Could not find file",
040080             0303*   EXIT_PATHNOTFOUND:		EQU  5;	"Could not find path",
040080             0304*   EXIT_INVALIDPATHNAME:	EQU  6;	"Invalid path name",
040080             0305*   EXIT_ACCESSDENIED_FULL:	EQU  7;	"Access denied or directory full",
040080             0306*   EXIT_ACCESSDENIED:		EQU  8;	"Access denied",
040080             0307*   EXIT_INVALIDOBJECT:		EQU  9;	"Invalid file/directory object",
040080             0308*   EXIT_SD_WRITEPROTECTED:	EQU 10;	"SD card is write protected",
040080             0309*   EXIT_INVALIDDRIVENUMBER:EQU 11;	"Logical drive number is invalid",
040080             0310*   EXIT_NOVOLUMEWORKAREA:	EQU 12;	"Volume has no work area",
040080             0311*   EXIT_NOVALIDFATVOLUME:	EQU 13;	"No valid FAT volume",
040080             0312*   EXIT_ERRORMKFS:			EQU 14;	"Error occurred during mkfs",
040080             0313*   EXIT_VOLUMETIMEOUT:		EQU 15;	"Volume timeout",
040080             0314*   EXIT_VOLUMELOCKED:		EQU 16;	"Volume locked",
040080             0315*   EXIT_LFNALLOCATION:		EQU 17;	"LFN working buffer could not be allocated",
040080             0316*   EXIT_MAXOPENFILES:		EQU 18;	"Too many open files",
040080             0317*   EXIT_INVALIDPARAMETER:	EQU 19;	"Invalid parameter",
040080             0318*   EXIT_INVALIDCOMMAND:	EQU 20;	"Invalid command",
040080             0319*   EXIT_INVALIDEXECUTABLE:	EQU 21;	"Invalid executable",
040080             0320*   
040080             0321*   ; FatFS file access functions
040080             0322*   ;
040080             0323*   ; Open a file
040080             0324*   ; HLU: Pointer to a blank FIL struct
040080             0325*   ; DEU: Pointer to the filename (0 terminated)
040080             0326*   ;   C: File mode
040080             0327*   ; Returns:
040080             0328*   ;   A: FRESULT
040080             0329*   ffs_fopen:			EQU	80h
040080             0330*   
040080             0331*   ; Close a file
040080             0332*   ; HLU: Pointer to a blank FIL struct
040080             0333*   ; Returns:
040080             0334*   ;   A: FRESULT
040080             0335*   ffs_fclose:			EQU	81h
040080             0336*   
040080             0337*   ; Read data from a file
040080             0338*   ; HLU: Pointer to a FIL struct
040080             0339*   ; DEU: Pointer to where to write the file out
040080             0340*   ; BCU: Number of bytes to read
040080             0341*   ; Returns:
040080             0342*   ;   A: FRESULT
040080             0343*   ; BCU: Number of bytes read
040080             0344*   ffs_fread:			EQU	82h
040080             0345*   
040080             0346*   ; Write data to a file
040080             0347*   ; HLU: Pointer to a FIL struct
040080             0348*   ; DEU: Pointer to the data to write out
040080             0349*   ; BCU: Number of bytes to write
040080             0350*   ; Returns:
040080             0351*   ;   A: FRESULT
040080             0352*   ; BCU: Number of bytes written
040080             0353*   ffs_fwrite:			EQU	83h
040080             0354*   
040080             0355*   ; Move the read/write pointer in a file
040080             0356*   ; HLU: Pointer to a FIL struct
040080             0357*   ; DEU: Least significant 3 bytes of the offset from the start of the file (DWORD)
040080             0358*   ;   C: Most significant byte of the offset
040080             0359*   ; Returns:
040080             0360*   ;   A: FRESULT
040080             0361*   ffs_flseek:			EQU	84h
040080             0362*   
040080             0363*   ; not implemented
040080             0364*   ffs_ftruncate:		EQU	85h
040080             0365*   
040080             0366*   ; not implemented
040080             0367*   ffs_fsync:			EQU	86h
040080             0368*   
040080             0369*   ; not implemented
040080             0370*   ffs_fforward:		EQU	87h
040080             0371*   
040080             0372*   ; not implemented
040080             0373*   ffs_fexpand:		EQU	88h
040080             0374*   
040080             0375*   ; not implemented
040080             0376*   ffs_fgets:			EQU	89h
040080             0377*   
040080             0378*   ; not implemented
040080             0379*   ffs_fputc:			EQU	8Ah
040080             0380*   
040080             0381*   ; not implemented
040080             0382*   ffs_fputs:			EQU	8Bh
040080             0383*   
040080             0384*   ; not implemented
040080             0385*   ffs_fprintf:		EQU	8Ch
040080             0386*   
040080             0387*   ; not implemented
040080             0388*   ffs_ftell:			EQU	8Dh
040080             0389*   
040080             0390*   ; Check for EOF
040080             0391*   ; HLU: Pointer to a FILINFO struct
040080             0392*   ; Returns:
040080             0393*   ;   A: 1 if end of file, otherwise 0
040080             0394*   ffs_feof:			EQU	8Eh
040080             0395*   
040080             0396*   ; not implemented
040080             0397*   ffs_fsize:			EQU	8Fh
040080             0398*   
040080             0399*   ; not implemented
040080             0400*   ffs_ferror:			EQU	90h
040080             0401*   
040080             0402*   ; FatFS directory access functions
040080             0403*   ;
040080             0404*   ; Open a directory
040080             0405*   ; HLU: Pointer to a blank DIR struct
040080             0406*   ; DEU: Pointer to the directory path
040080             0407*   ; Returns:
040080             0408*   ; A: FRESULT
040080             0409*   ffs_dopen:			EQU	91h
040080             0410*   
040080             0411*   ; Close a directory
040080             0412*   ; HLU: Pointer to an open DIR struct
040080             0413*   ; Returns:
040080             0414*   ; A: FRESULT
040080             0415*   ffs_dclose:			EQU	92h
040080             0416*   
040080             0417*   ; Read the next FILINFO from an open DIR
040080             0418*   ; HLU: Pointer to an open DIR struct
040080             0419*   ; DEU: Pointer to an empty FILINFO struct
040080             0420*   ; Returns:
040080             0421*   ; A: FRESULT
040080             0422*   ffs_dread:			EQU	93h
040080             0423*   
040080             0424*   ; not implemented
040080             0425*   ffs_dfindfirst:		EQU	94h
040080             0426*   
