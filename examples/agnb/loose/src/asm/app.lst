04453D             0011*   @temp_string_end:
04453D             0040    
04453D             0041    init:
04453D             0042    ; set screen mode
04453D             0043        ; ld a,0 ; 640x480x16 single-buffered
04453D             0044        ; ld a,19 ; 1024x768x4 single-buffered
04453D 3E 08       0045        ld a,8 ; 320x240x64 single-buffered
04453F             0046        ; ld a,20 ; 512x384x64 single-buffered
04453F             0047        ; ld a,23 ; 512x384x2 single-buffered
04453F CD 59 0A 04 0048        call vdu_set_screen_mode
044543             0049    
044543             0050    ; set screen scaling and background colors
044543 21 51 45 04 0051        ld hl,@beg
044547 01 09 00 00 0052        ld bc,@end-@beg
04454B 5B DF       0053        rst.lil $18
04454D C3 5A 45 04 0054        jp @end
044551             0055    @beg:
044551             0056    ;   VDU 23, 0, &C0, 0: Normal coordinates
044551 17 00 C0 00 0057        db 23,0,$C0,0
044555             0058    ;   VDU 17, color : set text background color
044555 11 8C       0059        db 17,12+128 ; blue
044557             0060    ;   VDU 18, color : set gfx background color
044557 12 00 8C    0061        db 18,0,12+128 ; blue
04455A             0062    @end:
04455A CD E0 09 04 0063        call cursor_off
04455E CD 07 0A 04 0064        call vdu_cls
044562             0065    
044562             0066    ; initialize main loop timer
044562             0067    main_loop_timer_reset: equ 60 ; 120ths of a second
044562 21 3C 00 00 0068        ld hl,main_loop_timer_reset
044566 CD 6C 09 04 0069        call tmr_main_loop_set
04456A             0070    
04456A CD 13 08 04 0071        call tmr_slideshow_set
04456E             0072    
04456E C9          0073        ret ; init
04456F             0074    
04456F             0075    main:
04456F 11 00 00 00 0076        ld de, 0
044573 C3 8F 45 04 0077        jp rendbmp
044577             0078    
044577             0079    mainloop:
044577 CD A3 07 04 0080        call reset_keys
04457B             0081    
04457B             0082    waitloop:
04457B CD 88 07 04 0083        call set_keys
04457F CD 80 09 04 0084        call tmr_main_loop_get
044583 CA B3 07 04 0085        jp z, do_input
044587 FA B3 07 04 0086        jp m, do_input
04458B C3 7B 45 04 0087        jp waitloop
04458F             0088    
04458F             0089    rendbmp:
04458F             0090    ; test de for wraparound
04458F 21 00 00 00 0091        ld hl,0
044593 AF          0092        xor a ; clear carry
044594 ED 52       0093        sbc hl,de
044596 CA A6 45 04 0094        jp z,@not_neg
04459A FA A6 45 04 0095        jp m,@not_neg
04459E 11 97 01 00 0096        ld de,num_images-1
0445A2 C3 B5 45 04 0097        jp @load_image
0445A6             0098    @not_neg:
0445A6 21 97 01 00 0099        ld hl,num_images-1
0445AA AF          0100        xor a ; clear carry
0445AB ED 52       0101        sbc hl,de
0445AD F2 B5 45 04 0102        jp p,@load_image
0445B1 11 00 00 00 0103        ld de,0
0445B5             0104    @load_image:
0445B5 ED 53 75 07 0105        ld (current_image_index),de
       04          
0445BA 16 0F       0106        ld d,image_record_size
0445BC ED 5C       0107        mlt de
0445BE FD 21 31 0D 0108        ld iy,image_list
       04          
0445C3 FD 19       0109        add iy,de
0445C5 FD 7E 00    0110        ld a,(iy+image_type) ; get image type
0445C8 FD 07 03    0111        ld bc,(iy+image_width) ; get image width
0445CB FD 17 06    0112        ld de,(iy+image_height) ; get image height
0445CE FD 31 09    0113        ld ix,(iy+image_filesize) ; get image file size
0445D1 FD 27 0C    0114        ld hl,(iy+image_filename) ; get image filename
0445D4 E5          0115        push hl
0445D5 FD E1       0116        pop iy
0445D7 21 00 01 00 0117        ld hl,256 ; set image bufferId
0445DB CD A6 0B 04 0118        call vdu_load_img
0445DF             0119    ; plot image
0445DF CD 07 0A 04 0120        call vdu_cls
0445E3 01 00 00 00 0121        ld bc,0 ; x
0445E7 11 00 00 00 0122        ld de,0 ; y
0445EB CD B3 0A 04 0123        call vdu_plot_bmp
0445EF             0124    
0445EF             0125    no_move:
0445EF 21 3C 00 00 0126        ld hl,main_loop_timer_reset
0445F3 CD 6C 09 04 0127        call tmr_main_loop_set
0445F7 C3 77 45 04 0128        jp mainloop
0445FB             0129    
0445FB             0130    main_end:
0445FB             0131    ; exit program gracefully
0445FB AF          0132        xor a ; 640x480x16 single-buffered
0445FC CD 59 0A 04 0133        call vdu_set_screen_mode
044600 3E 01       0134        ld a,1 ; scaling on
044602 CD 6A 0A 04 0135        call vdu_set_scaling
044606 CD D2 09 04 0136        call cursor_on
04460A C9          0137        ret
04460B             0138    
04460B             0139    ; load to onboard 8k sram
04460B             0140    filedata: equ 0xB7E000
