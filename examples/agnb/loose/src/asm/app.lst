040153             0066*       ;     inc sp
040153             0067*       ; ENDMACRO
040153             0068*   
040153             0069*       MACRO PUSH_ALL
040153             0070*       ex af,af'
040153             0071*       exx
040153             0072*       push af
040153             0073*       push hl
040153             0074*       push bc
040153             0075*       push de
040153             0076*   
040153             0077*       ex af,af'
040153             0078*       exx
040153             0079*       push af
040153             0080*       push hl
