0425A2 5B D7       0126*   	rst.lil $10
0425A4 C9          0127*   	ret
0425A5             0128*   
0425A5             0129*   vdu_set_screen_mode:
0425A5 32 B5 25 04 0130*   	ld (@arg),a
0425A9 21 B4 25 04 0131*   	ld hl,@cmd
0425AD 01 02 00 00 0132*   	ld bc,@end-@cmd
0425B1 5B DF       0133*   	rst.lil $18
0425B3 C9          0134*   	ret
0425B4 16          0135*   @cmd: db 22 ; set screen mode
0425B5 00          0136*   @arg: db 0  ; screen mode parameter
0425B6             0137*   @end:
0425B6             0138*   
0425B6             0139*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
0425B6             0140*   ; inputs: a is scaling mode, 1=on, 0=off
0425B6             0141*   ; note: default setting on boot is scaling ON
0425B6             0142*   
0425B6             0143*   vdu_set_scaling:
0425B6 32 C8 25 04 0144*   	ld (@arg),a
0425BA 21 C5 25 04 0145*   	ld hl,@cmd
0425BE 01 04 00 00 0146*   	ld bc,@end-@cmd
0425C2 5B DF       0147*   	rst.lil $18
0425C4 C9          0148*   	ret
0425C5 17 00 C0    0149*   @cmd: db 23,0,0xC0
0425C8 00          0150*   @arg: db 0  ; scaling on/off
0425C9             0151*   @end:
0425C9             0152*   
0425C9             0153*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
0425C9             0154*   ; inputs: hl=bufferId
0425C9             0155*   
0425C9             0156*   vdu_buff_select:
0425C9 22 DB 25 04 0157*   	ld (@bufferId),hl
0425CD 21 D8 25 04 0158*   	ld hl,@cmd
0425D1 01 05 00 00 0159*   	ld bc,@end-@cmd
0425D5 5B DF       0160*   	rst.lil $18
0425D7 C9          0161*   	ret
0425D8 17 1B 20    0162*   @cmd: db 23,27,0x20
0425DB 00 00       0163*   @bufferId: dw 0x0000
0425DD 00          0164*   @end: db 0x00 ; padding
0425DE             0165*   
0425DE             0166*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
0425DE             0167*   ; inputs: a=format; bc=width; de=height
0425DE             0168*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
0425DE             0169*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
0425DE             0170*   ; 0 	RGBA8888 (4-bytes per pixel)
0425DE             0171*   ; 1 	RGBA2222 (1-bytes per pixel)
0425DE             0172*   ; 2 	Mono/Mask (1-bit per pixel)
0425DE             0173*   ; 3 	Reserved for internal use by VDP (“native” format)
0425DE             0174*   
0425DE             0175*   vdu_bmp_create:
0425DE ED 43 FA 25 0176*       ld (@width),bc
       04          
0425E3 ED 53 FC 25 0177*       ld (@height),de
       04          
0425E8 32 FE 25 04 0178*       ld (@fmt),a
0425EC 21 F7 25 04 0179*   	ld hl,@cmd
0425F0 01 08 00 00 0180*   	ld bc,@end-@cmd
0425F4 5B DF       0181*   	rst.lil $18
0425F6 C9          0182*   	ret
0425F7 17 1B 21    0183*   @cmd:       db 23,27,0x21
0425FA 00 00       0184*   @width:     dw 0x0000
0425FC 00 00       0185*   @height:    dw 0x0000
0425FE 00          0186*   @fmt:       db 0x00
0425FF             0187*   @end:
0425FF             0188*   
0425FF             0189*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
0425FF             0190*   ; &E8-&EF 	232-239 	Bitmap plot §
0425FF             0191*   ; VDU 25, mode, x; y;: PLOT command
0425FF             0192*   ; inputs: bc=x0, de=y0
0425FF             0193*   ; prerequisites: vdu_buff_select
0425FF             0194*   
0425FF             0195*   vdu_plot_bmp:
0425FF ED 43 16 26 0196*       ld (@x0),bc
       04          
042604 ED 53 18 26 0197*       ld (@y0),de
       04          
042609 21 14 26 04 0198*   	ld hl,@cmd
04260D 01 06 00 00 0199*   	ld bc,@end-@cmd
042611 5B DF       0200*   	rst.lil $18
042613 C9          0201*   	ret
042614 19          0202*   @cmd:   db 25
042615 ED          0203*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
042616 00 00       0204*   @x0: 	dw 0x0000
042618 00 00       0205*   @y0: 	dw 0x0000
04261A 00          0206*   @end:   db 0x00 ; padding
04261B             0207*   
04261B             0208*   ; scratch variables
04261B 00 00 00    0209*   bufferId0: dl 0x000000
04261E 00 00 00    0210*   bufferId1: dl 0x000000
042621             0211*   
042621             0212*   ; load a vdu buffer from local memory
042621             0213*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
042621             0214*   
042621             0215*   vdu_load_buffer:
042621 ED 43 4A 26 0216*       ld (@length),bc
       04          
042626 D5          0217*       push de ; save data pointer
042627             0218*   ; send the vdu command string
042627 7D          0219*       ld a,l
042628 32 47 26 04 0220*       ld (@bufferId),a
04262C 7C          0221*       ld a,h
04262D 32 48 26 04 0222*       ld (@bufferId+1),a
042631 21 44 26 04 0223*       ld hl,@cmd
042635 01 08 00 00 0224*       ld bc,@end-@cmd
042639 5B DF       0225*       rst.lil $18
04263B             0226*   ; send the buffer data
04263B E1          0227*       pop hl ; pointer to data
04263C ED 4B 4A 26 0228*       ld bc,(@length)
       04          
042641 5B DF       0229*       rst.lil $18 ; send it
042643 C9          0230*       ret
042644             0231*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
042644 17 00 A0    0232*   @cmd:       db 23,0,0xA0
042647 00 00       0233*   @bufferId:	dw 0x0000
042649 00          0234*   		    db 0 ; load buffer
04264A 00 00       0235*   @length:	dw 0x0000
04264C 00          0236*   @end: db 0 ; padding
04264D             0237*   
04264D             0238*   ; clear a buffer
04264D             0239*   ; inputs: hl = bufferId
04264D             0240*   
04264D             0241*   vdu_clear_buffer:
04264D 7D          0242*       ld a,l
04264E 32 65 26 04 0243*       ld (@bufferId),a
042652 7C          0244*       ld a,h
042653 32 66 26 04 0245*       ld (@bufferId+1),a
042657 21 62 26 04 0246*       ld hl,@cmd
04265B 01 06 00 00 0247*       ld bc,@end-@cmd
04265F 5B DF       0248*       rst.lil $18
042661 C9          0249*       ret
042662 17 00 A0    0250*   @cmd:       db 23,0,0xA0
042665 00 00       0251*   @bufferId:	dw 0x0000
042667 02          0252*   		    db 2 ; clear buffer
042668             0253*   @end:
042668             0254*   
042668             0255*   ; Command 14: Consolidate blocks in a buffer
042668             0256*   
042668             0257*   vdu_consolidate_buffer:
042668             0258*   ; set parameters for vdu call
042668 7D          0259*       ld a,l
042669 32 80 26 04 0260*       ld (@bufferId),a
04266D 7C          0261*       ld a,h
04266E 32 81 26 04 0262*       ld (@bufferId+1),a
042672 21 7D 26 04 0263*       ld hl,@beg
042676 01 06 00 00 0264*       ld bc,@end-@beg
04267A 5B DF       0265*       rst.lil $18
04267C C9          0266*       ret
04267D             0267*   ; VDU 23, 0, &A0, bufferId; 14
04267D 17 00 A0    0268*   @beg: db 23,0,0xA0
042680 00 00       0269*   @bufferId: dw 0x0000
042682 0E          0270*              db 14
042683             0271*   @end:
042683             0272*   
042683             0273*   ; load an image file to a buffer and make it a bitmap
042683             0274*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
042683             0275*   
042683             0276*   vdu_load_img:
042683             0277*   ; back up image type and dimension parameters
042683 22 1B 26 04 0278*       ld (bufferId0),hl
042687 F5          0279*       push af
042688 C5          0280*   	push bc
042689 D5          0281*   	push de
04268A             0282*   ; load the image
04268A CD A5 26 04 0283*   	call vdu_load_buffer_from_file
04268E             0284*   ; now make it a bitmap
04268E 2A 1B 26 04 0285*       ld hl,(bufferId0)
042692 CD 68 26 04 0286*       call vdu_consolidate_buffer
042696 2A 1B 26 04 0287*       ld hl,(bufferId0)
04269A CD C9 25 04 0288*       call vdu_buff_select
04269E D1          0289*   	pop de ; image height
04269F C1          0290*   	pop bc ; image width
0426A0 F1          0291*   	pop af ; image type
0426A1 C3 DE 25 04 0292*   	jp vdu_bmp_create ; will return to caller from there
0426A5             0293*   
0426A5             0294*   ; inputs: hl = bufferId; iy = pointer to filename
0426A5             0295*   
0426A5             0296*   vdu_load_buffer_from_file:
0426A5 22 1B 26 04 0297*       ld (bufferId0),hl
0426A9             0298*   
0426A9             0299*   ; clear target buffer
0426A9 CD 4D 26 04 0300*       call vdu_clear_buffer
0426AD             0301*   
0426AD             0302*   ; open the file in read mode
0426AD             0303*   ; Open a file
0426AD             0304*   ; HLU: Filename
0426AD             0305*   ;   C: Mode
0426AD             0306*   ; Returns:
0426AD             0307*   ;   A: Filehandle, or 0 if couldn't open
0426AD FD E5       0308*   	push iy ; pointer to filename
0426AF E1          0309*   	pop hl
0426B0 0E 01       0310*   	ld c,fa_read
0426B2             0311*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
0426B2 3E 0A       0001*M1 			LD	A, function
0426B4 5B CF       0002*M1 			RST.LIL	08h
0426B6 32 F1 26 04 0312*       ld (@filehandle),a
0426BA             0313*   
0426BA             0314*   @read_file:
0426BA             0315*   ; Read a block of data from a file
0426BA             0316*   ;   C: Filehandle
0426BA             0317*   ; HLU: Pointer to where to write the data to
0426BA             0318*   ; DEU: Number of bytes to read
0426BA             0319*   ; Returns:
0426BA             0320*   ; DEU: Number of bytes read
0426BA 3A F1 26 04 0321*       ld a,(@filehandle)
0426BE 4F          0322*       ld c,a
0426BF 21 00 E0 B7 0323*       ld hl,filedata
0426C3 11 00 20 00 0324*       ld de,8192 ; max we can read into onboard sram at one time
0426C7             0325*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
0426C7 3E 1A       0001*M1 			LD	A, function
0426C9 5B CF       0002*M1 			RST.LIL	08h
0426CB             0326*   
0426CB             0327*   ; test de for zero bytes read
0426CB 21 00 00 00 0328*       ld hl,0
0426CF AF          0329*       xor a ; clear carry
0426D0 ED 52       0330*       sbc hl,de
0426D2 CA E8 26 04 0331*       jp z,@close_file
0426D6             0332*   
0426D6             0333*   ; load a vdu buffer from local memory
0426D6             0334*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0426D6 2A 1B 26 04 0335*       ld hl,(bufferId0)
0426DA D5          0336*       push de ; chunksize
0426DB C1          0337*       pop bc
0426DC 11 00 E0 B7 0338*       ld de,filedata
0426E0 CD 21 26 04 0339*       call vdu_load_buffer
0426E4             0340*   
0426E4             0341*   ; ; print progress breadcrumbs
0426E4             0342*   ;     ld a,'.'
0426E4             0343*   ;     rst.lil 10h
0426E4             0344*   
0426E4             0345*   ; read the next block
0426E4 C3 BA 26 04 0346*       jp @read_file
0426E8             0347*   
0426E8             0348*   ; close the file
0426E8             0349*   @close_file:
0426E8 3A F1 26 04 0350*       ld a,(@filehandle)
0426EC             0351*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
0426EC 3E 0B       0001*M1 			LD	A, function
0426EE 5B CF       0002*M1 			RST.LIL	08h
0426F0 C9          0352*       ret ; vdu_load_buffer_from_file
0426F1             0353*   
0426F1 00          0354*   @filehandle: db 0 ; file handle
0426F2 00 00 00    0355*   @fil: dl 0 ; pointer to FIL struct
0426F5             0356*   
0426F5 00 00 00    0357*   @chunkpointer: dl 0 ; pointer to current chunk
0426F8             0037    
0426F8             0038    init:
0426F8             0039    ; set screen mode
0426F8             0040        ; ld a,0 ; 640x480x16 single-buffered
0426F8             0041        ; ld a,19 ; 1024x768x4 single-buffered
0426F8 3E 08       0042        ld a,8 ; 320x240x64 single-buffered
0426FA             0043        ; ld a,20 ; 512x384x64 single-buffered
0426FA             0044        ; ld a,23 ; 512x384x2 single-buffered
0426FA CD A5 25 04 0045        call vdu_set_screen_mode
0426FE             0046    
0426FE             0047    ; set screen scaling and background colors
0426FE 21 0C 27 04 0048        ld hl,@beg
042702 01 09 00 00 0049        ld bc,@end-@beg
042706 5B DF       0050        rst.lil $18
042708 C3 15 27 04 0051        jp @end
04270C             0052    @beg:
04270C             0053    ;   VDU 23, 0, &C0, 0: Normal coordinates
04270C 17 00 C0 00 0054        db 23,0,$C0,0
042710             0055    ;   VDU 17, color : set text background color
042710 11 8C       0056        db 17,12+128 ; blue
042712             0057    ;   VDU 18, color : set gfx background color
042712 12 00 8C    0058        db 18,0,12+128 ; blue
042715             0059    @end:
042715 CD 7E 25 04 0060        call cursor_off
042719 CD A0 25 04 0061        call vdu_cls
04271D             0062    
04271D             0063    ; initialize main loop timer
04271D             0064    main_loop_timer_reset: equ 60 ; 120ths of a second
04271D 21 3C 00 00 0065        ld hl,main_loop_timer_reset
042721 CD 86 24 04 0066        call tmr_main_loop_set
042725             0067    
042725 CD 22 01 04 0068        call tmr_slideshow_set
042729             0069    
042729 C9          0070        ret ; init
04272A             0071    
04272A             0072    main:
04272A 11 00 00 00 0073        ld de, 0
04272E C3 4A 27 04 0074        jp rendbmp
042732             0075    
042732             0076    mainloop:
042732 CD B2 00 04 0077        call reset_keys
042736             0078    
042736             0079    waitloop:
042736 CD 97 00 04 0080        call set_keys
04273A CD 9A 24 04 0081        call tmr_main_loop_get
04273E CA C2 00 04 0082        jp z, do_input
042742 FA C2 00 04 0083        jp m, do_input
042746 C3 36 27 04 0084        jp waitloop
04274A             0085    
04274A             0086    rendbmp:
04274A             0087    ; test de for wraparound
04274A 21 00 00 00 0088        ld hl,0
04274E AF          0089        xor a ; clear carry
04274F ED 52       0090        sbc hl,de
042751 CA 61 27 04 0091        jp z,@not_neg
042755 FA 61 27 04 0092        jp m,@not_neg
042759 11 F8 00 00 0093        ld de,num_images-1
04275D C3 70 27 04 0094        jp @load_image
042761             0095    @not_neg:
042761 21 F8 00 00 0096        ld hl,num_images-1
042765 AF          0097        xor a ; clear carry
042766 ED 52       0098        sbc hl,de
042768 F2 70 27 04 0099        jp p,@load_image
04276C 11 00 00 00 0100        ld de,0
042770             0101    @load_image:
042770 ED 53 84 00 0102        ld (current_image_index),de
       04          
042775 16 0F       0103        ld d,image_record_size
042777 ED 5C       0104        mlt de
042779 FD 21 48 01 0105        ld iy,image_list
       04          
04277E FD 19       0106        add iy,de
042780 FD 7E 00    0107        ld a,(iy+image_type) ; get image type
042783 FD 07 03    0108        ld bc,(iy+image_width) ; get image width
042786 FD 17 06    0109        ld de,(iy+image_height) ; get image height
042789 FD 31 09    0110        ld ix,(iy+image_filesize) ; get image file size
04278C FD 27 0C    0111        ld hl,(iy+image_filename) ; get image filename
04278F E5          0112        push hl
042790 FD E1       0113        pop iy
042792 21 00 01 00 0114        ld hl,256 ; set image bufferId
042796 CD 83 26 04 0115        call vdu_load_img
04279A             0116    ; plot image
04279A CD A0 25 04 0117        call vdu_cls
04279E 01 00 00 00 0118        ld bc,0 ; x
0427A2 11 00 00 00 0119        ld de,0 ; y
0427A6 CD FF 25 04 0120        call vdu_plot_bmp
0427AA             0121    
0427AA             0122    no_move:
0427AA 21 3C 00 00 0123        ld hl,main_loop_timer_reset
0427AE CD 86 24 04 0124        call tmr_main_loop_set
0427B2 C3 32 27 04 0125        jp mainloop
0427B6             0126    
0427B6             0127    main_end:
0427B6             0128    ; exit program gracefully
0427B6 AF          0129        xor a ; 640x480x16 single-buffered
0427B7 CD A5 25 04 0130        call vdu_set_screen_mode
0427BB 3E 01       0131        ld a,1 ; scaling on
0427BD CD B6 25 04 0132        call vdu_set_scaling
0427C1 CD 70 25 04 0133        call cursor_on
0427C5 C9          0134        ret
0427C6             0135    
0427C6             0136    ; load to onboard 8k sram
0427C6             0137    filedata: equ 0xB7E000
