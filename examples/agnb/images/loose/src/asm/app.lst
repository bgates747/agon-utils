04271B             0037    
04271B             0038    init:
04271B             0039    ; set screen mode
04271B             0040        ; ld a,0 ; 640x480x16 single-buffered
04271B             0041        ; ld a,19 ; 1024x768x4 single-buffered
04271B 3E 08       0042        ld a,8 ; 320x240x64 single-buffered
04271D             0043        ; ld a,20 ; 512x384x64 single-buffered
04271D             0044        ; ld a,23 ; 512x384x2 single-buffered
04271D CD C8 25 04 0045        call vdu_set_screen_mode
042721             0046    
042721             0047    ; set screen scaling and background colors
042721 21 2F 27 04 0048        ld hl,@beg
042725 01 09 00 00 0049        ld bc,@end-@beg
042729 5B DF       0050        rst.lil $18
04272B C3 38 27 04 0051        jp @end
04272F             0052    @beg:
04272F             0053    ;   VDU 23, 0, &C0, 0: Normal coordinates
04272F 17 00 C0 00 0054        db 23,0,$C0,0
042733             0055    ;   VDU 17, color : set text background color
042733 11 8C       0056        db 17,12+128 ; blue
042735             0057    ;   VDU 18, color : set gfx background color
042735 12 00 8C    0058        db 18,0,12+128 ; blue
042738             0059    @end:
042738 CD A1 25 04 0060        call cursor_off
04273C CD C3 25 04 0061        call vdu_cls
042740             0062    
042740             0063    ; initialize main loop timer
042740             0064    main_loop_timer_reset: equ 60 ; 120ths of a second
042740 21 3C 00 00 0065        ld hl,main_loop_timer_reset
042744 CD A9 24 04 0066        call tmr_main_loop_set
042748             0067    
042748 CD 22 01 04 0068        call tmr_slideshow_set
04274C             0069    
04274C C9          0070        ret ; init
04274D             0071    
04274D             0072    main:
04274D 11 00 00 00 0073        ld de, 0
042751 C3 6D 27 04 0074        jp rendbmp
042755             0075    
042755             0076    mainloop:
042755 CD B2 00 04 0077        call reset_keys
042759             0078    
042759             0079    waitloop:
042759 CD 97 00 04 0080        call set_keys
04275D CD BD 24 04 0081        call tmr_main_loop_get
042761 CA C2 00 04 0082        jp z, do_input
042765 FA C2 00 04 0083        jp m, do_input
042769 C3 59 27 04 0084        jp waitloop
04276D             0085    
04276D             0086    rendbmp:
04276D             0087    ; test de for wraparound
04276D 21 00 00 00 0088        ld hl,0
042771 AF          0089        xor a ; clear carry
042772 ED 52       0090        sbc hl,de
042774 CA 84 27 04 0091        jp z,@not_neg
042778 FA 84 27 04 0092        jp m,@not_neg
04277C 11 F9 00 00 0093        ld de,num_images-1
042780 C3 93 27 04 0094        jp @load_image
042784             0095    @not_neg:
042784 21 F9 00 00 0096        ld hl,num_images-1
042788 AF          0097        xor a ; clear carry
042789 ED 52       0098        sbc hl,de
04278B F2 93 27 04 0099        jp p,@load_image
04278F 11 00 00 00 0100        ld de,0
042793             0101    @load_image:
042793 ED 53 84 00 0102        ld (current_image_index),de
       04          
042798 16 0F       0103        ld d,image_record_size
04279A ED 5C       0104        mlt de
04279C FD 21 48 01 0105        ld iy,image_list
       04          
0427A1 FD 19       0106        add iy,de
0427A3 FD 7E 00    0107        ld a,(iy+image_type) ; get image type
0427A6 FD 07 03    0108        ld bc,(iy+image_width) ; get image width
0427A9 FD 17 06    0109        ld de,(iy+image_height) ; get image height
0427AC FD 31 09    0110        ld ix,(iy+image_filesize) ; get image file size
0427AF FD 27 0C    0111        ld hl,(iy+image_filename) ; get image filename
0427B2 E5          0112        push hl
0427B3 FD E1       0113        pop iy
0427B5 21 00 01 00 0114        ld hl,256 ; set image bufferId
0427B9 CD A6 26 04 0115        call vdu_load_img
0427BD             0116    ; plot image
0427BD CD C3 25 04 0117        call vdu_cls
0427C1 01 00 00 00 0118        ld bc,0 ; x
0427C5 11 00 00 00 0119        ld de,0 ; y
0427C9 CD 22 26 04 0120        call vdu_plot_bmp
0427CD             0121    
0427CD             0122    no_move:
0427CD 21 3C 00 00 0123        ld hl,main_loop_timer_reset
0427D1 CD A9 24 04 0124        call tmr_main_loop_set
0427D5 C3 55 27 04 0125        jp mainloop
0427D9             0126    
0427D9             0127    main_end:
0427D9             0128    ; exit program gracefully
0427D9 AF          0129        xor a ; 640x480x16 single-buffered
0427DA CD C8 25 04 0130        call vdu_set_screen_mode
0427DE 3E 01       0131        ld a,1 ; scaling on
0427E0 CD D9 25 04 0132        call vdu_set_scaling
0427E4 CD 93 25 04 0133        call cursor_on
0427E8 C9          0134        ret
