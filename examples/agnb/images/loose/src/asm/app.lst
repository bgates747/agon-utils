042379             0117*   ;     ld hl,on_hardware ; default message for running on hardware
042379             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
042379             0119*   ;     ret m ; negative result means we're on hardware
042379             0120*   ;     inc a ; we're on emulator
042379             0121*   ;     ld (is_emulator),a
