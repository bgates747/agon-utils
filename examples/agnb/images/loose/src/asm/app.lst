0424EA             0376*   ; delay routine
0424EA             0377*   ; Author: Richard Turrnidge
0424EA             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
0424EA             0379*   ; routine waits a fixed time,then returns
0424EA             0380*   ; arrive with A =  the delay byte. One bit to be set only.
0424EA             0381*   ; eg. ld A,00000100b
0424EA             0382*   
0424EA             0383*   multiPurposeDelay:
       FF FF FF 
0424EA F5          0384*       push af
0424EB C5          0385*       push bc
0424EC DD E5       0386*       push ix
0424EE 47          0387*       ld b,a
0424EF 3E 08       0388*       ld a,$08
0424F1 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
0424F3             0390*   
0424F3             0391*   waitLoop:
0424F3             0392*   
0424F3 DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0424F6             0394*   
0424F6             0395*                                   ;   we check if bit set is same as last time we checked.
0424F6             0396*                                   ;   bit 0 - don't use
0424F6             0397*                                   ;   bit 1 - changes 64 times per second
0424F6             0398*                                   ;   bit 2 - changes 32 times per second
0424F6             0399*                                   ;   bit 3 - changes 16 times per second
0424F6             0400*   
0424F6             0401*                                   ;   bit 4 - changes 8 times per second
0424F6             0402*                                   ;   bit 5 - changes 4 times per second
0424F6             0403*                                   ;   bit 6 - changes 2 times per second
0424F6             0404*                                   ;   bit 7 - changes 1 times per second
0424F6 A0          0405*       and b
0424F7 4F          0406*       ld c,a
0424F8 3A 09 25 04 0407*       ld a,(oldTimeStamp)
0424FC B9          0408*       cp c                        ; is A same as last value?
0424FD 28 F4       0409*       jr z,waitLoop              ; loop here if it is
0424FF 79          0410*       ld a,c
042500 32 09 25 04 0411*       ld (oldTimeStamp),a        ; set new value
042504             0412*   
042504 DD E1       0413*       pop ix
042506 C1          0414*       pop bc
042507 F1          0415*       pop af
042508 C9          0416*       ret
