0426EC 5B CF       0002*M1 			RST.LIL	08h
0426EE             0326*   
0426EE             0327*   ; test de for zero bytes read
0426EE 21 00 00 00 0328*       ld hl,0
0426F2 AF          0329*       xor a ; clear carry
0426F3 ED 52       0330*       sbc hl,de
0426F5 CA 0B 27 04 0331*       jp z,@close_file
0426F9             0332*   
0426F9             0333*   ; load a vdu buffer from local memory
