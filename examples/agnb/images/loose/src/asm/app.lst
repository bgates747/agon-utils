042690 7C          0261*       ld a,h
042691 32 A4 26 04 0262*       ld (@bufferId+1),a
042695 21 A0 26 04 0263*       ld hl,@beg
042699 01 06 00 00 0264*       ld bc,@end-@beg
04269D 5B DF       0265*       rst.lil $18
