       04          
042496 FD 27 00    0319*       ld hl,(iy+0)            ; get start time
042499 AF          0320*       xor a                   ; clear carry
04249A ED 52       0321*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
04249C FD 17 03    0322*       ld de,(iy+3)            ; get timer set value
04249F AF          0323*       xor a                   ; clear carry
0424A0 ED 5A       0324*       adc hl,de               ; hl = time remaining
0424A2             0325*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0424A2 C9          0326*       ret
