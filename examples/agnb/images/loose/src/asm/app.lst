04264A 7D          0219*       ld a,l
04264B 32 6A 26 04 0220*       ld (@bufferId),a
04264F 7C          0221*       ld a,h
042650 32 6B 26 04 0222*       ld (@bufferId+1),a
042654 21 67 26 04 0223*       ld hl,@cmd
042658 01 08 00 00 0224*       ld bc,@end-@cmd
04265C 5B DF       0225*       rst.lil $18
