04243E             0253*   ; set a countdown timer
04243E             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04243E             0255*   ; returns: hl = current time
04243E             0256*   tmr_set:
04243E FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
042441             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
042441 3E 08       0001*M1 			LD	A, function
042443 5B CF       0002*M1 			RST.LIL	08h
042445 DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
042448 FD 2F 00    0260*       ld (iy+0),hl            ; set start time
04244B C9          0261*       ret
04244C             0262*   
04244C             0263*   ; gets time remaining on a countdown timer
04244C             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04244C             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04244C             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
04244C             0267*   tmr_get:
04244C             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04244C 3E 08       0001*M1 			LD	A, function
04244E 5B CF       0002*M1 			RST.LIL	08h
042450 DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
042453 FD 27 00    0270*       ld hl,(iy+0)            ; get start time
042456 AF          0271*       xor a                   ; clear carry
042457 ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
042459 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
04245C AF          0274*       xor a                   ; clear carry
04245D ED 5A       0275*       adc hl,de               ; hl = time remaining
04245F             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04245F C9          0277*       ret
042460             0278*   
042460 00 00 00    0279*   timestamp_now: dl 0
042463 00 00 00    0280*   timestamp_old: dl 0
042466 00 00 00    0281*   timestamp_chg: dl 0
042469             0282*   
042469             0283*   ; update the global timestamp from the system clock
042469             0284*   ; inputs: none
042469             0285*   ; returns: hl = time elapsed in 1/120ths of a second
042469             0286*   ;          de = current time
042469             0287*   ;          ix = pointer to syvars table
042469             0288*   ; destroys: af,hl,de,ix
042469             0289*   timestamp_tick:
042469 ED 5B 60 24 0290*       ld de,(timestamp_now)   ; get previous time
       04          
04246E ED 53 63 24 0291*       ld (timestamp_old),de   ; save previous time
       04          
042473             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
042473 3E 08       0001*M1 			LD	A, function
042475 5B CF       0002*M1 			RST.LIL	08h
042477 DD 27 00    0293*       ld hl,(ix+sysvar_time)  ; get current time
04247A 22 60 24 04 0294*       ld (timestamp_now),hl   ; save current time
04247E AF          0295*       xor a                   ; clear carry
04247F ED 52       0296*       sbc hl,de               ; hl = time elapsed
042481 22 66 24 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
042485 C9          0298*       ret
042486             0299*   
042486             0300*   ; set a countdown timer
042486             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
042486             0302*   ; requires: timestamp_tick to be called at least once before this function
042486             0303*   ; returns: hl = current time
042486             0304*   ; destroys: hl
042486             0305*   timestamp_tmr_set:
042486 FD 2F 03    0306*       ld (iy+3),hl            ; set time remaining
042489 2A 60 24 04 0307*       ld hl,(timestamp_now)   ; get current timestamp
04248D FD 2F 00    0308*       ld (iy+0),hl            ; set start time
042490 C9          0309*       ret
042491             0310*   
042491             0311*   ; gets time remaining on a countdown timer following the global timestamp
042491             0312*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
042491             0313*   ; requires: timestamp_tick to be called at least once before this function
042491             0314*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
042491             0315*   ;          sign flags: pos = time not expired,zero or neg = time expired
042491             0316*   ; destroys: af,hl,de
042491             0317*   timestamp_tmr_get:
