042379             0107*   ;     jp m,@done ; time past expiration (negative),so quit
042379             0108*   ;     jr @loop
042379             0109*   ; @done:
042379             0110*   ;     ld de,(prt_irq_counter)
042379             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
042379             0112*   ;     ld (prt_reload),bc
