042376             0084*   
042376             0085*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
042376             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
042376 00 00 00    0087*   prt_reload: dl 0x000000
042379             0088*   
042379             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
042379             0090*   ; ;          de = number PRT interrupts during test interval
