040080             0535*   ;
040080             0536*   vdp_pflag_cursor:		EQU	00000001b
040080             0537*   vdp_pflag_scrchar:		EQU	00000010b
040080             0538*   vdp_pflag_point:		EQU	00000100b
040080             0539*   vdp_pflag_audio:		EQU	00001000b
040080             0540*   vdp_pflag_mode:			EQU	00010000b
040080             0541*   vdp_pflag_rtc:			EQU	00100000b
