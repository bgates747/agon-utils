0426A6             0273*   ; load an image file to a buffer and make it a bitmap
0426A6             0274*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
0426A6             0275*   
0426A6             0276*   vdu_load_img:
0426A6             0277*   ; back up image type and dimension parameters
0426A6 22 3E 26 04 0278*       ld (bufferId0),hl
0426AA F5          0279*       push af
0426AB C5          0280*   	push bc
0426AC D5          0281*   	push de
0426AD             0282*   ; load the image
0426AD CD C8 26 04 0283*   	call vdu_load_buffer_from_file
