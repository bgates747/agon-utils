042551             0050*   
042551             0051*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
042551             0052*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
042551             0053*   ; so it will allways be 8 characters length
042551             0054*   ; HL : Value to convert to string
042551             0055*   ; DE : pointer to buffer, at least 8 byte + 0
042551             0056*   
042551             0057*   u24_to_ascii:
042551 01 80 69 67 0058*       LD BC,-10000000
042555 CD 88 25 04 0059*       CALL @one_digit
042559 01 C0 BD F0 0060*       LD BC,-1000000
04255D CD 88 25 04 0061*       CALL @one_digit
042561 01 60 79 FE 0062*       LD BC,-100000
042565 CD 88 25 04 0063*       CALL @one_digit
042569 01 F0 D8 FF 0064*       LD BC,-10000
04256D CD 88 25 04 0065*       CALL @one_digit
042571 01 18 FC FF 0066*       LD BC,-1000
042575 CD 88 25 04 0067*       CALL @one_digit
042579 01 9C FF FF 0068*       LD BC,-100
04257D CD 88 25 04 0069*       CALL @one_digit
042581 0E F6       0070*       LD C,-10
042583 CD 88 25 04 0071*       CALL @one_digit
042587 48          0072*       LD C,B
042588             0073*   @one_digit:
042588 3E 2F       0074*       LD A,'0'-1
04258A             0075*   @divide_me:
04258A 3C          0076*       INC A
04258B 09          0077*       ADD HL,BC
04258C 38 FC       0078*       JR C,@divide_me
04258E ED 42       0079*       SBC HL,BC
042590 12          0080*       LD (DE),A
042591 13          0081*       INC DE
042592 C9          0082*       RET
