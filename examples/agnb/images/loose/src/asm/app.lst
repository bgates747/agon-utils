                       M1 Args: function=mos_fopen 
0426D5 3E 0A       0001*M1 			LD	A, function
0426D7 5B CF       0002*M1 			RST.LIL	08h
0426D9 32 14 27 04 0312*       ld (@filehandle),a
0426DD             0313*   
0426DD             0314*   @read_file:
0426DD             0315*   ; Read a block of data from a file
0426DD             0316*   ;   C: Filehandle
0426DD             0317*   ; HLU: Pointer to where to write the data to
0426DD             0318*   ; DEU: Number of bytes to read
0426DD             0319*   ; Returns:
0426DD             0320*   ; DEU: Number of bytes read
0426DD 3A 14 27 04 0321*       ld a,(@filehandle)
0426E1 4F          0322*       ld c,a
0426E2 21 00 E0 B7 0323*       ld hl,filedata
0426E6 11 00 20 00 0324*       ld de,8192 ; max we can read into onboard sram at one time
0426EA             0325*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
