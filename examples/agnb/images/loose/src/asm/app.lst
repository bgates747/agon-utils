040080             0543*   ;
040080             0544*   ; FatFS structures
040080             0545*   ; These mirror the structures contained in src_fatfs/ff.h in the MOS project
040080             0546*   ;
040080             0547*   ; Object ID and allocation information (FFOBJID)
040080             0548*   ;
040080             0549*   ; Indexes into FFOBJID structure
040080             0550*   ffobjid_fs:			EQU	0	; 3: Pointer to the hosting volume of this object
040080             0551*   ffobjid_id:			EQU	3	; 2: Hosting volume mount ID
040080             0552*   ffobjid_attr:		EQU	5	; 1: Object attribute
040080             0553*   ffobjid_stat:		EQU	6	; 1: Object chain status (b1-0: =0:not contiguous, =2:contiguous, =3:fragmented in this session, b2:sub-directory stretched)
040080             0554*   ffobjid_sclust:		EQU	7	; 4: Object data start cluster (0:no cluster or root directory)
040080             0555*   ffobjid_objsize:	EQU	11	; 4: Object size (valid when sclust != 0)
040080             0556*   ;
040080             0557*   ; File object structure (FIL)
040080             0558*   ;
040080             0559*   ; Indexes into FIL structure
040080             0560*   fil_obj:		EQU 0	; 15: Object identifier
040080             0561*   fil_flag:		EQU	15 	;  1: File status flags
040080             0562*   fil_err:		EQU	16	;  1: Abort flag (error code)
040080             0563*   fil_fptr:		EQU	17	;  4: File read/write pointer (Zeroed on file open)
040080             0564*   fil_clust:		EQU	21	;  4: Current cluster of fpter (invalid when fptr is 0)
040080             0565*   fil_sect:		EQU	25	;  4: Sector number appearing in buf[] (0:invalid)
040080             0566*   fil_dir_sect:	EQU	29	;  4: Sector number containing the directory entry
040080             0567*   fil_dir_ptr:	EQU	33	;  3: Pointer to the directory entry in the win[]
040080             0568*   ;
040080             0569*   ; Directory object structure (DIR)
040080             0570*   ; Indexes into DIR structure
040080             0571*   dir_obj:		EQU  0	; 15: Object identifier
040080             0572*   dir_dptr:		EQU	15	;  4: Current read/write offset
040080             0573*   dir_clust:		EQU	19	;  4: Current cluster
040080             0574*   dir_sect:		EQU	23	;  4: Current sector (0:Read operation has terminated)
040080             0575*   dir_dir:		EQU	27	;  3: Pointer to the directory item in the win[]
040080             0576*   dir_fn:			EQU	30	; 12: SFN (in/out) {body[8],ext[3],status[1]}
040080             0577*   dir_blk_ofs:	EQU	42	;  4: Offset of current entry block being processed (0xFFFFFFFF:Invalid)
040080             0578*   ;
040080             0579*   ; File information structure (FILINFO)
040080             0580*   ;
040080             0581*   ; Indexes into FILINFO structure
040080             0582*   filinfo_fsize:		EQU 0	;   4: File size
040080             0583*   filinfo_fdate:		EQU	4	;   2: Modified date
040080             0584*   filinfo_ftime:		EQU	6	;   2: Modified time
040080             0585*   filinfo_fattrib:	EQU	8	;   1: File attribute
040080             0586*   filinfo_altname:	EQU	9	;  13: Alternative file name
040080             0587*   filinfo_fname:		EQU	22	; 256: Primary file name
040080             0033        include "input.inc"
040080 00          0001*   dithering_type: db 0x00 ; 0=none, 1=bayer ordered matrix, 2=floyd-steinberg
040081 00 01 00    0002*   current_image_id: dl 256 ; buffer_id of the current image
040084 00 00 00    0003*   current_image_index: dl 0 ; index of the current image
040087             0004*   
040087             0005*   keyboard_masks: ds 16 ; 16 bytes for the keyboard masks
040097             0006*   
040097             0007*   ; check system virtual keyboard map for keys down and or them with local keyboard masks
040097             0008*   ; inputs: none
040097             0009*   ; outputs: none
040097             0010*   ; clobbers: a, b, ix, iy
040097             0011*   set_keys:
040097             0012*       MOSCALL mos_getkbmap ; ix points to the virtual keyboard map
                       M1 Args: function=mos_getkbmap 
       FF FF FF FF 
       FF FF FF FF 
       FF FF FF FF 
       FF FF FF FF 
040097 3E 1E       0001*M1 			LD	A, function
040099 5B CF       0002*M1 			RST.LIL	08h
04009B FD 21 87 00 0013*       ld iy,keyboard_masks
       04          
0400A0 06 10       0014*       ld b,16 ; loop counter
0400A2             0015*   @loop:
0400A2 DD 7E 00    0016*       ld a,(ix)
0400A5 FD B6 00    0017*       or (iy)
0400A8 FD 77 00    0018*       ld (iy),a
0400AB DD 23       0019*       inc ix
0400AD FD 23       0020*       inc iy
0400AF 10 F1       0021*       djnz @loop
0400B1 C9          0022*       ret
0400B2             0023*   
0400B2             0024*   ; reset the local keyboard masks to zero
0400B2             0025*   ; inputs: none
0400B2             0026*   ; outputs: none
0400B2             0027*   ; clobbers: a, b, iy
0400B2             0028*   reset_keys:
0400B2 FD 21 87 00 0029*       ld iy,keyboard_masks
       04          
0400B7 AF          0030*       xor a
0400B8 06 10       0031*       ld b,16 ; loop counter
0400BA             0032*   @loop:
0400BA FD 77 00    0033*       ld (iy),a
0400BD FD 23       0034*       inc iy
0400BF 10 F9       0035*       djnz @loop
0400C1 C9          0036*       ret
0400C2             0037*   
0400C2             0038*   ; ============ KEYBOARD INPUT ============
0400C2             0039*   do_input:
0400C2             0040*   ; get user keyboard input
0400C2 DD 21 87 00 0041*       ld ix,keyboard_masks
       04          
0400C7 3E FF       0042*       ld a,-1 ; anything non-zero to indicates no key pressed
0400C9             0043*   
0400C9             0044*   ; ------ QUIT ------
0400C9             0045*   ; 113 Escape
0400C9 DD CB 0E 46 0046*       bit 0,(ix+14)
0400CD C2 D9 27 04 0047*   	jp nz,main_end
0400D1             0048*   
0400D1             0049*   ; ------ RENDERING OPTIONS ------
0400D1             0050*   ; ; 99 Space cycle through dithering types
0400D1             0051*   ;     bit 2,(ix+12)
0400D1             0052*   ;     call nz,cycle_dithering
0400D1             0053*   ;     xor a
0400D1             0054*   
0400D1             0055*   ; 26 Left
0400D1 DD CB 03 4E 0056*       bit 1,(ix+3)
0400D5 CA E5 00 04 0057*       jp z,@Left
0400D9 ED 5B 84 00 0058*       ld de,(current_image_index)
       04          
0400DE 1B          0059*       dec de
0400DF ED 53 84 00 0060*       ld (current_image_index),de
       04          
0400E4 AF          0061*       xor a
0400E5             0062*   @Left:
0400E5             0063*   
0400E5             0064*   ; 122 Right
0400E5 DD CB 0F 4E 0065*       bit 1,(ix+15)
0400E9 CA F9 00 04 0066*       jp z,@Right
0400ED ED 5B 84 00 0067*       ld de,(current_image_index)
       04          
0400F2 13          0068*       inc de
0400F3 ED 53 84 00 0069*       ld (current_image_index),de
       04          
0400F8 AF          0070*       xor a
0400F9             0071*   @Right:
0400F9             0072*   ; check keypress flag and branch accordingly
0400F9 A7          0073*       and a
0400FA CA 6D 27 04 0074*       jp z,rendbmp
0400FE             0075*   
0400FE             0076*   ; check slideshow timer and branch accordingly
0400FE CD 3A 01 04 0077*       call tmr_slideshow_get
040102 F2 CD 27 04 0078*       jp p,no_move
040106 CD 22 01 04 0079*       call tmr_slideshow_set
04010A ED 5B 84 00 0080*       ld de,(current_image_index)
       04          
04010F 13          0081*       inc de
040110 ED 53 84 00 0082*       ld (current_image_index),de
       04          
040115 C3 6D 27 04 0083*       jp rendbmp
040119             0084*   
040119             0085*   ; slideshow timer routines
040119             0086*   tmr_slideshow: ds 6 ; buffer to hold slideshow timer
       FF FF FF FF 
       FF FF 
04011F 01 00 00    0087*   tmr_slideshow_reset: dl 1; 1*120
040122             0088*   
040122             0089*   ; set a countdown timer for the slideshow using the timestamp timer
040122             0090*   ; returns: hl = current time
040122             0091*   ; destroys: af,hl,de,ix,iy
040122             0092*   tmr_slideshow_set:
040122 FD 21 19 01 0093*       ld iy,tmr_slideshow
       04          
040127 2A 1F 01 04 0094*       ld hl,(tmr_slideshow_reset)
04012B FD 2F 03    0095*       ld (iy+3),hl ; set time remaining
04012E CD 69 24 04 0096*       call timestamp_tick
040132 2A 60 24 04 0097*       ld hl,(timestamp_now)   ; get current timestamp
040136 FD 2F 00    0098*       ld (iy+0),hl ; set start time
040139 C9          0099*       ret
04013A             0100*   
04013A             0101*   ; gets time remaining on the slideshow countdown timer following the global timestamp
04013A             0102*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04013A             0103*   ;          sign flags: pos = time not expired,zero or neg = time expired
04013A             0104*   ; destroys: af,hl,de,ix,iy
04013A             0105*   tmr_slideshow_get:
04013A CD 69 24 04 0106*       call timestamp_tick
04013E FD 21 19 01 0107*       ld iy,tmr_slideshow
       04          
040143 CD 91 24 04 0108*       call timestamp_tmr_get
040147 C9          0109*       ret
