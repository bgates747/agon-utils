041928             0250*   ; ===============================================
041928             0251*   ; Timer functions
041928             0252*   ; -----------------------------------------------
041928             0253*   ; set a countdown timer
041928             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041928             0255*   ; returns: hl = current time
041928             0256*   tmr_set:
041928 FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
04192B             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04192B 3E 08       0001*M1 			LD	A, function
04192D 5B CF       0002*M1 			RST.LIL	08h
04192F DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
041932 FD 2F 00    0260*       ld (iy+0),hl            ; set start time
041935 C9          0261*       ret
041936             0262*   
041936             0263*   ; gets time remaining on a countdown timer
041936             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041936             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041936             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
041936             0267*   tmr_get:
041936             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041936 3E 08       0001*M1 			LD	A, function
041938 5B CF       0002*M1 			RST.LIL	08h
04193A DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
04193D FD 27 00    0270*       ld hl,(iy+0)            ; get start time
041940 AF          0271*       xor a                   ; clear carry
041941 ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041943 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
041946 AF          0274*       xor a                   ; clear carry
041947 ED 5A       0275*       adc hl,de               ; hl = time remaining
041949             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041949 C9          0277*       ret
04194A             0278*   
04194A 00 00 00    0279*   timestamp_now: dl 0
04194D 00 00 00    0280*   timestamp_old: dl 0
041950 00 00 00    0281*   timestamp_chg: dl 0
041953             0282*   
041953             0283*   ; update the global timestamp from the system clock
041953             0284*   ; inputs: none
041953             0285*   ; returns: hl = time elapsed in 1/120ths of a second
041953             0286*   ;          de = current time
041953             0287*   ;          ix = pointer to syvars table
041953             0288*   ; destroys: af,hl,de,ix
041953             0289*   timestamp_tick:
041953 ED 5B 4A 19 0290*       ld de,(timestamp_now)   ; get previous time
       04          
041958 ED 53 4D 19 0291*       ld (timestamp_old),de   ; save previous time
       04          
04195D             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04195D 3E 08       0001*M1 			LD	A, function
04195F 5B CF       0002*M1 			RST.LIL	08h
041961 DD 27 00    0293*       ld hl,(ix+sysvar_time)  ; get current time
041964 22 4A 19 04 0294*       ld (timestamp_now),hl   ; save current time
041968 AF          0295*       xor a                   ; clear carry
041969 ED 52       0296*       sbc hl,de               ; hl = time elapsed
04196B 22 50 19 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
04196F C9          0298*       ret
041970             0299*   
041970             0300*   ; set a countdown timer
041970             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041970             0302*   ; requires: timestamp_tick to be called at least once before this function
041970             0303*   ; returns: hl = current time
041970             0304*   ; destroys: hl
041970             0305*   timestamp_tmr_set:
041970 FD 2F 03    0306*       ld (iy+3),hl            ; set time remaining
041973 2A 4A 19 04 0307*       ld hl,(timestamp_now)   ; get current timestamp
041977 FD 2F 00    0308*       ld (iy+0),hl            ; set start time
04197A C9          0309*       ret
04197B             0310*   
04197B             0311*   ; gets time remaining on a countdown timer following the global timestamp
04197B             0312*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04197B             0313*   ; requires: timestamp_tick to be called at least once before this function
04197B             0314*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04197B             0315*   ;          sign flags: pos = time not expired,zero or neg = time expired
04197B             0316*   ; destroys: af,hl,de
04197B             0317*   timestamp_tmr_get:
04197B ED 5B 4A 19 0318*       ld de,(timestamp_now)   ; get current timestamp
       04          
041980 FD 27 00    0319*       ld hl,(iy+0)            ; get start time
041983 AF          0320*       xor a                   ; clear carry
041984 ED 52       0321*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041986 FD 17 03    0322*       ld de,(iy+3)            ; get timer set value
041989 AF          0323*       xor a                   ; clear carry
04198A ED 5A       0324*       adc hl,de               ; hl = time remaining
04198C             0325*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04198C C9          0326*       ret
04198D             0327*   
04198D             0328*   ; main loop timer functions
04198D             0329*   tmr_main_loop: ds 6 ; buffer to hold main loop timer
041993             0330*   
041993             0331*   ; set a countdown timer for the main loop using the timestamp timer
041993             0332*   ; inputs: hl = time to set in 1/120ths of a second
041993             0333*   ; returns: hl = current time
041993             0334*   ; destroys: af,hl,de,ix,iy
041993             0335*   tmr_main_loop_set:
       FF FF FF FF 
       FF FF 
041993 FD 21 8D 19 0336*       ld iy,tmr_main_loop
       04          
041998 FD 2F 03    0337*       ld (iy+3),hl ; set time remaining
04199B CD 53 19 04 0338*       call timestamp_tick
04199F 2A 4A 19 04 0339*       ld hl,(timestamp_now)   ; get current timestamp
0419A3 FD 2F 00    0340*       ld (iy+0),hl ; set start time
0419A6 C9          0341*       ret
0419A7             0342*   
0419A7             0343*   ; gets time remaining on the main loop countdown timer following the global timestamp
0419A7             0344*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0419A7             0345*   ;          sign flags: pos = time not expired,zero or neg = time expired
0419A7             0346*   ; destroys: af,hl,de,ix,iy
0419A7             0347*   tmr_main_loop_get:
0419A7 CD 53 19 04 0348*       call timestamp_tick
0419AB FD 21 8D 19 0349*       ld iy,tmr_main_loop
       04          
0419B0 CD 7B 19 04 0350*       call timestamp_tmr_get
0419B4 C9          0351*       ret
0419B5             0352*   
0419B5             0353*   ; set a stopwatch
0419B5             0354*   ; returns: hl = start time
0419B5             0355*   ; destroys: hl,ix
0419B5             0356*   stopwatch_set:
0419B5             0357*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0419B5 3E 08       0001*M1 			LD	A, function
0419B7 5B CF       0002*M1 			RST.LIL	08h
0419B9 DD 27 00    0358*       ld hl,(ix+sysvar_time)  ; get current time
0419BC 22 D1 19 04 0359*       ld (stopwatch_started),hl            ; set start time
0419C0 C9          0360*       ret
0419C1             0361*   
0419C1             0362*   ; gets time elapsed on a stopwatch
0419C1             0363*   ; returns: hl = time elapsed in 1/120ths of a second
0419C1             0364*   ; destroys: af,hl,de,ix
0419C1             0365*   stopwatch_get:
0419C1             0366*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0419C1 3E 08       0001*M1 			LD	A, function
0419C3 5B CF       0002*M1 			RST.LIL	08h
0419C5 DD 27 00    0367*       ld hl,(ix+sysvar_time)  ; get current time
0419C8 ED 5B D1 19 0368*       ld de,(stopwatch_started)            ; get start time
       04          
0419CD AF          0369*       xor a                   ; clear carry
0419CE ED 52       0370*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
0419D0 C9          0371*       ret
0419D1             0372*   
0419D1             0373*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
0419D4             0374*   
0419D4             0375*   ; ------------------
0419D4             0376*   ; delay routine
0419D4             0377*   ; Author: Richard Turrnidge
0419D4             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
0419D4             0379*   ; routine waits a fixed time,then returns
0419D4             0380*   ; arrive with A =  the delay byte. One bit to be set only.
0419D4             0381*   ; eg. ld A,00000100b
0419D4             0382*   
0419D4             0383*   multiPurposeDelay:
       FF FF FF 
0419D4 F5          0384*       push af
0419D5 C5          0385*       push bc
0419D6 DD E5       0386*       push ix
0419D8 47          0387*       ld b,a
0419D9 3E 08       0388*       ld a,$08
0419DB 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
0419DD             0390*   
0419DD             0391*   waitLoop:
0419DD             0392*   
0419DD DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0419E0             0394*   
0419E0             0395*                                   ;   we check if bit set is same as last time we checked.
0419E0             0396*                                   ;   bit 0 - don't use
0419E0             0397*                                   ;   bit 1 - changes 64 times per second
0419E0             0398*                                   ;   bit 2 - changes 32 times per second
0419E0             0399*                                   ;   bit 3 - changes 16 times per second
0419E0             0400*   
0419E0             0401*                                   ;   bit 4 - changes 8 times per second
0419E0             0402*                                   ;   bit 5 - changes 4 times per second
0419E0             0403*                                   ;   bit 6 - changes 2 times per second
0419E0             0404*                                   ;   bit 7 - changes 1 times per second
0419E0 A0          0405*       and b
0419E1 4F          0406*       ld c,a
0419E2 3A F3 19 04 0407*       ld a,(oldTimeStamp)
0419E6 B9          0408*       cp c                        ; is A same as last value?
0419E7 28 F4       0409*       jr z,waitLoop              ; loop here if it is
0419E9 79          0410*       ld a,c
0419EA 32 F3 19 04 0411*       ld (oldTimeStamp),a        ; set new value
0419EE             0412*   
0419EE DD E1       0413*       pop ix
0419F0 C1          0414*       pop bc
0419F1 F1          0415*       pop af
0419F2 C9          0416*       ret
0419F3             0417*   
0419F3 00          0418*   oldTimeStamp:   .db 00h
0419F4             0038        include "includes.inc"
0419F4             0001*   ; Routines selected from loose/src/asm/functions.inc
0419F4             0002*   ; Retained in their original source-file order.
0419F4             0003*   
0419F4             0004*   ; Print a zero-terminated string
0419F4             0005*   ; HL: Pointer to string
0419F4             0006*   printString:
0419F4 C5          0007*       PUSH BC
0419F5 01 00 00 00 0008*       LD BC,0
0419F9 3E 00       0009*       LD A,0
0419FB 5B DF       0010*       RST.LIL 18h
0419FD C1          0011*       POP BC
0419FE C9          0012*       RET
0419FF             0013*   
0419FF             0014*   ; Prints the right justified decimal value in HL without leading zeroes
0419FF             0015*   ; HL : Value to print
0419FF             0016*   ; preserves all registers and flags
0419FF             0017*   printDec:
0419FF             0018*   ; BEGIN MY CODE
0419FF             0019*   ; back up all the things
0419FF F5          0020*       push af
041A00 C5          0021*       push bc
041A01 D5          0022*       push de
041A02 E5          0023*       push hl
041A03             0024*   ; END MY CODE
041A03 11 2B 1A 04 0025*       LD DE, _printDecBuffer
041A07 CD FF 1F 04 0026*       CALL u24_to_ascii
041A0B             0027*   ; BEGIN MY CODE
041A0B             0028*   ; replace leading zeroes with spaces
041A0B 21 2B 1A 04 0029*       LD HL, _printDecBuffer
041A0F 06 07       0030*       ld B, 7 ; if HL was 0, we want to keep the final zero
041A11             0031*   @loop:
041A11 7E          0032*       LD A, (HL)
041A12 FE 30       0033*       CP '0'
041A14 C2 1E 1A 04 0034*       JP NZ, @done
041A18 3E 20       0035*       LD A, ' '
041A1A 77          0036*       LD (HL), A
041A1B 23          0037*       INC HL
041A1C             0038*       ; CALL vdu_cursor_forward
041A1C 10 F3       0039*       DJNZ @loop
041A1E             0040*   @done:
041A1E             0041*   ; END MY CODE
041A1E 21 2B 1A 04 0042*       LD HL, _printDecBuffer
041A22 CD F4 19 04 0043*       CALL printString
041A26             0044*   ; BEGIN MY CODE
041A26             0045*   ; restore all the things
041A26 E1          0046*       pop hl
041A27 D1          0047*       pop de
041A28 C1          0048*       pop bc
041A29 F1          0049*       pop af
041A2A             0050*   ; END MY CODE
041A2A C9          0051*       RET
041A2B 00 00 00 00 0052*   _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041A3B             0053*   
041A3B             0054*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
041A3B             0055*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
041A3B             0056*   ; so it will allways be 8 characters length
041A3B             0057*   ; HL : Value to convert to string
041A3B             0058*   ; DE : pointer to buffer, at least 8 byte + 0
041A3B             0059*   ; u24_to_ascii:
041A3B             0060*   ;     LD BC,-10000000
041A3B             0061*   ;     CALL @one_digit
041A3B             0062*   ;     LD BC,-1000000
041A3B             0063*   ;     CALL @one_digit
041A3B             0064*   ;     LD BC,-100000
041A3B             0065*   ;     CALL @one_digit
041A3B             0066*   ;     LD BC,-10000
041A3B             0067*   ;     CALL @one_digit
041A3B             0068*   ;     LD BC,-1000
041A3B             0069*   ;     CALL @one_digit
041A3B             0070*   ;     LD BC,-100
041A3B             0071*   ;     CALL @one_digit
041A3B             0072*   ;     LD C,-10
041A3B             0073*   ;     CALL @one_digit
041A3B             0074*   ;     LD C,B
041A3B             0075*   ; @one_digit:
041A3B             0076*   ;     LD A,'0'-1
041A3B             0077*   ; @divide_me:
041A3B             0078*   ;     INC A
041A3B             0079*   ;     ADD HL,BC
041A3B             0080*   ;     JR C,@divide_me
041A3B             0081*   ;     SBC HL,BC
041A3B             0082*   ;     LD (DE),A
041A3B             0083*   ;     INC DE
041A3B             0084*   ;     RET
