041880             0144*   ; ===============================================
041880             0145*   ; PRT Timer Interrupt Handling
041880             0146*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.inc
041880             0147*   ; -----------------------------------------------
041880             0148*   prt_irq_init:
041880             0149*       ; set up interrupt vector table 2
041880 21 00 00 00 0150*   	ld hl,0
041884 3A 0C 01 00 0151*   	ld a,($10c)
041888 6F          0152*   	ld l,a
041889 3A 0D 01 00 0153*   	ld a,($10d)
04188D 67          0154*   	ld h,a
04188E             0155*   
04188E             0156*   	; skip over CALL ($c3)
04188E 23          0157*   	inc hl
04188F             0158*   	; load address of jump into vector table 2 (in ram)
04188F ED 27       0159*   	ld hl,(hl)
041891             0160*   
041891             0161*   	; write CALL prt_irq_handler to vector table 2
041891 3E C3       0162*   	ld a,$c3
041893 77          0163*   	ld (hl),a
041894 23          0164*   	inc hl
041895 11 9C 18 04 0165*   	ld de,prt_irq_handler
041899 ED 1F       0166*   	ld (hl),de
04189B             0167*   
04189B C9          0168*       ret
04189C             0169*   
04189C             0170*   prt_irq_handler:
04189C F3          0171*   	di
04189D F5          0172*   	push af
04189E E5          0173*       push hl
04189F ED 38 83    0174*   	in0 a,($83)
0418A2 2A B1 18 04 0175*   	ld hl,(prt_irq_counter)
0418A6 23          0176*   	inc hl
0418A7 22 B1 18 04 0177*   	ld (prt_irq_counter),hl
0418AB E1          0178*       pop hl
0418AC F1          0179*   	pop af
0418AD FB          0180*   	ei
0418AE 5B ED 4D    0181*   	reti.l
0418B1             0182*   
0418B1             0183*   prt_irq_counter:
0418B1 00 00 00    0184*   	.dl 0
0418B4             0185*   prt_irq_counter_saved:
0418B4 00 00 00    0186*       .dl 0
0418B7             0187*   
0418B7             0188*   prt_loop_reset:
0418B7 E5          0189*       push hl
0418B8 21 00 00 00 0190*   	ld hl,0
0418BC 22 B1 18 04 0191*   	ld (prt_irq_counter),hl
0418C0 22 22 19 04 0192*       ld (prt_loop_counter),hl
0418C4 22 25 19 04 0193*       ld (prt_loops),hl
0418C8 CD 63 18 04 0194*       call prt_set
0418CC E1          0195*       pop hl
0418CD C9          0196*       ret
0418CE             0197*   
0418CE             0198*   prt_loop_start:
0418CE E5          0199*       push hl
0418CF 21 00 00 00 0200*   	ld hl,0
0418D3 22 B1 18 04 0201*   	ld (prt_irq_counter),hl
0418D7 E1          0202*       pop hl
0418D8 C9          0203*       ret
0418D9             0204*   
0418D9             0205*   prt_loop_stop:
0418D9 E5          0206*       push hl
0418DA D5          0207*       push de
0418DB 2A B1 18 04 0208*       ld hl,(prt_irq_counter)
0418DF ED 5B 22 19 0209*       ld de,(prt_loop_counter)
       04          
0418E4 19          0210*       add hl,de
0418E5 22 22 19 04 0211*       ld (prt_loop_counter),hl
0418E9 21 00 00 00 0212*       ld hl,0
0418ED 22 B1 18 04 0213*       ld (prt_irq_counter),hl
0418F1 2A 25 19 04 0214*       ld hl,(prt_loops)
0418F5 23          0215*       inc hl
0418F6 22 25 19 04 0216*       ld (prt_loops),hl
0418FA D1          0217*       pop de
0418FB E1          0218*       pop hl
0418FC C9          0219*       ret
0418FD             0220*   
0418FD             0221*   ; inputs: bc = y,x text coordinates to print
0418FD             0222*   prt_loop_print:
0418FD F5          0223*       push af
0418FE E5          0224*       push hl
0418FF C5          0225*       push bc
041900 D5          0226*       push de
041901 DD E5       0227*       push ix
041903 FD E5       0228*       push iy
041905 CD 57 1A 04 0229*       call vdu_move_cursor
041909             0230*   
041909 2A 22 19 04 0231*       ld hl,(prt_loop_counter)
04190D CD FF 19 04 0232*       call printDec
041911             0233*   
041911 2A 25 19 04 0234*       ld hl,(prt_loops)
041915 CD FF 19 04 0235*       call printDec
041919             0236*   
041919 FD E1       0237*       pop iy
04191B DD E1       0238*       pop ix
04191D D1          0239*       pop de
04191E C1          0240*       pop bc
04191F E1          0241*       pop hl
041920 F1          0242*       pop af
041921 C9          0243*       ret
