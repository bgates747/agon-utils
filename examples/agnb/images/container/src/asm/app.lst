042190             0509*       ; (which will be the high bit of the value in a)
042190             0510*   @loop:
042190 0F          0511*       rrca ; put the next lowest bit into carry
042191 38 04       0512*       jr c,@one
042193 36 30       0513*       ld (hl),'0'
042195 18 02       0514*       jr @next_bit
042197             0515*   @one:
