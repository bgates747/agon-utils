0423B3             0043    init:
0423B3             0044    ; set screen mode
0423B3             0045        ; ld a,0 ; 640x480x16 single-buffered
0423B3             0046        ; ld a,19 ; 1024x768x4 single-buffered
0423B3             0047        ; ld a,8 ; 320x240x64 single-buffered
0423B3 3E 14       0048        ld a,20 ; 512x384x64 single-buffered
0423B5             0049        ; ld a,23 ; 512x384x2 single-buffered
0423B5 CD 70 1A 04 0050        call vdu_set_screen_mode
0423B9             0051    
0423B9             0052    ; set screen scaling and background colors
0423B9 21 C7 23 04 0053        ld hl,@beg
0423BD 01 09 00 00 0054        ld bc,@end-@beg
0423C1 5B DF       0055        rst.lil $18
0423C3 C3 D0 23 04 0056        jp @end
0423C7             0057    @beg:
0423C7             0058    ;   VDU 23, 0, &C0, 0: Normal coordinates
0423C7 17 00 C0 00 0059        db 23,0,$C0,0
0423CB             0060    ;   VDU 17, color : set text background color
0423CB 11 8C       0061        db 17,12+128 ; blue
0423CD             0062    ;   VDU 18, color : set gfx background color
0423CD 12 00 8C    0063        db 18,0,12+128 ; blue
0423D0             0064    @end:
0423D0 CD 49 1A 04 0065        call cursor_off
0423D4 CD 6B 1A 04 0066        call vdu_cls
0423D8             0067    
