0422F7             0163*   ; BCD addition
0422F7             0164*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
0422F7             0165*   ;       a is the number of bytes holding each number (number of places/2)
0422F7             0166*   ; outputs: (hl) + (de) --> (hl)
0422F7             0167*   ; destroys: a,b,de,hl
0422F7             0168*   add_bcd:
0422F7 47          0169*       ld b,a ; loop counter
0422F8 AF          0170*       xor a ; reset a, clear carry flag
0422F9             0171*   adcec:
0422F9 1A          0172*       ld a,(de) ; addend to acc
0422FA 8E          0173*       adc a,(hl) ; add (hl) to acc
0422FB 27          0174*       daa ; adjust result to bcd
0422FC 77          0175*       ld (hl),a ; store result
0422FD 23          0176*       inc hl ; advance memory pointers
0422FE 13          0177*       inc de
0422FF 10 F8       0178*       djnz adcec ; loop until b == 0
042301 C9          0179*       ret
042302             0180*   
042302             0181*   ; BCD subtraction
042302             0182*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
042302             0183*   ;       a is the number of bytes holding each number (number of places/2)
042302             0184*   ; outputs: (hl) - (de) --> (hl)
042302             0185*   ; destroys: a,b,de,hl
042302             0186*   sub_bcd:
042302 47          0187*       ld b,a ; loop counter
042303 AF          0188*       xor a ; reset a,clear carry flag
042304             0189*   subdec:
042304 1A          0190*       ld a,(de) ; subtrahend to acc
042305 9E          0191*       sbc a,(hl) ; subtract (hl) from acc
042306 27          0192*       daa ; adjust result to bcd
042307 77          0193*       ld (hl),a ; store result
042308 23          0194*       inc hl ; advance memory pointers
042309 13          0195*       inc de
04230A 10 F8       0196*       djnz subdec ; loop until b == 0
04230C C9          0197*       ret
