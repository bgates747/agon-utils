04237F DD 29       0302*       add ix,ix      ; 2
042381 8F          0303*       adc a,a        ; 1
042382 ED 6A       0304*       adc hl,hl      ; 2
042384 ED 52       0305*       sbc hl,de      ; 2
042386 DD 23       0306*       inc ix         ; 2
042388 30 03       0307*       jr nc,@cansub  ; 2/4
