042165             0479*   ; print the binary representation of the 8-bit value in a
042165             0480*   ; destroys a, hl, bc
042165             0481*   printBin8:
042165 06 08       0482*       ld b,8 ; loop counter for 8 bits
042167 21 82 21 04 0483*       ld hl,@cmd ; set hl to the low byte of the output string
04216B             0484*       ; (which will be the high bit of the value in a)
04216B             0485*   @loop:
04216B 07          0486*       rlca ; put the next highest bit into carry
04216C 38 04       0487*       jr c,@one
04216E 36 30       0488*       ld (hl),'0'
042170 18 02       0489*       jr @next_bit
042172             0490*   @one:
042172 36 31       0491*       ld (hl),'1'
042174             0492*   @next_bit:
042174 23          0493*       inc hl
042175 10 F4       0494*       djnz @loop
042177             0495*   ; print it
042177 21 82 21 04 0496*       ld hl,@cmd
04217B 01 08 00 00 0497*       ld bc,@end-@cmd
04217F 5B DF       0498*       rst.lil $18
042181 C9          0499*       ret
042182             0500*   @cmd: ds 8 ; eight bytes for eight bits
04218A             0501*   @end:
04218A             0502*   
04218A             0503*   ; print the binary representation of the 8-bit value in a
