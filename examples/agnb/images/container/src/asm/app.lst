041860             0037        include "timer.inc"
041860             0001*   ; Table 32. Timer Control Registers
041860             0002*   ; this constant is the base address of the timer control registers
041860             0003*   ; each timer takes three bytes:
041860             0004*   ;   0: control register
041860             0005*   ;   1: low byte of timer reset value
041860             0006*   ;   2: high byte of timer reset value
041860             0007*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
041860             0008*   ; which correctly force the high and upper bytes of the address bus to zero
041860             0009*   TMR_CTL:     equ 80h
041860             0010*   
041860             0011*   ; Timer Control Register Bit Definitions
041860             0012*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
041860             0013*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
041860             0014*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
041860             0015*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
041860             0016*                               ; the TMRx_CTL register is read.
041860             0017*   
041860             0018*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
041860             0019*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
041860             0020*   
041860             0021*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
041860             0022*                               ;  0,and counting stops when the end-of-count value is reached.
041860             0023*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
041860             0024*                               ; written to the counter when the end-of-count value is reached.
041860             0025*   
041860             0026*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
041860             0027*   CLK_DIV_256:  equ %00001100 ;
041860             0028*   CLK_DIV_64:   equ %00001000 ;
041860             0029*   CLK_DIV_16:   equ %00000100 ;
041860             0030*   CLK_DIV_4:    equ %00000000 ;
041860             0031*   
041860             0032*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
041860             0033*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
041860             0034*                               ; When a 1 is written to this bit,the values in the reload registers
041860             0035*                               ;  are loaded into the downcounter when the timer restarts. The
041860             0036*                               ; programmer must ensure that this bit is set to 1 each time
041860             0037*                               ; SINGLE-PASS mode is used.
041860             0038*   
041860             0039*   ; disable/enable the programmable reload timer
041860             0040*   PRT_EN_0:     equ %00000000 ;
041860             0041*   PRT_EN_1:     equ %00000001 ;
041860             0042*   
041860             0043*   ; Table 37. Timer Input Source Select Register
041860             0044*   ; Each of the 4 timers are allocated two bits of the 8-bit register
041860             0045*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
041860             0046*   ;   00: System clock / CLK_DIV
041860             0047*   ;   01: RTC / CLK_DIV
041860             0048*   ;   NOTE: these are the values given in the manual,but it may be a typo
041860             0049*   ;   10: GPIO port B pin 1.
041860             0050*   ;   11: GPIO port B pin 1.
041860             0051*   TMR_ISS:   equ 92h ; register address
041860             0052*   
041860             0053*   ; Table 51. Real-Time Clock Control Register
041860             0054*   RTC_CTRL: equ EDh ; register address
041860             0055*   
041860             0056*   ; alarm interrupt disable/enable
041860             0057*   RTC_ALARM_0:    equ %00000000
041860             0058*   RTC_ALARM_1:    equ %10000000
041860             0059*   
041860             0060*   ; interrupt on alarm disable/enable
041860             0061*   RTC_INT_ENT_0:  equ %00000000
041860             0062*   RTC_INT_ENT_1:  equ %01000000
041860             0063*   
041860             0064*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
041860             0065*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
041860             0066*   
041860             0067*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
041860             0068*                                   ; On-chip 32768 Hz oscillator is enabled.
041860             0069*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
041860             0070*                                   ; On-chip 32768 Hz oscillator is disabled.
041860             0071*   
041860             0072*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
041860             0073*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
041860             0074*   
041860             0075*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
041860             0076*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
041860             0077*   
041860             0078*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
041860             0079*                                   ; RTC counter is enabled.
041860             0080*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
041860             0081*                                   ; RTC counter is disabled.
041860             0082*   
041860             0083*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
041860             0084*   
041860             0085*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
041860             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
041860 00 00 00    0087*   prt_reload: dl 0x000000
041863             0088*   
041863             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
041863             0090*   ; ;          de = number PRT interrupts during test interval
041863             0091*   ; prt_calibrate:
041863             0092*   ;     call vdu_vblank
041863             0093*   ; ; set a MOS timer
041863             0094*   ;     ld hl,120*1 ; 1 second
041863             0095*   ;     ld iy,tmr_test
041863             0096*   ;     call tmr_set
041863             0097*   ; ; set a PRT timer
041863             0098*   ;     ; ld hl,prt_reload_hardware
041863             0099*   ;     ; ld hl,prt_reload_emulator
041863             0100*   ;     ld hl,prt_reload_emulator + prt_reload_hardware / 2
041863             0101*   ;     ld (prt_reload),hl
041863             0102*   ;     call prt_set
041863             0103*   ; @loop:
041863             0104*   ; ; check time remaining on MOS timer
041863             0105*   ;     call tmr_get
041863             0106*   ;     jp z,@done ; time expired,so quit
041863             0107*   ;     jp m,@done ; time past expiration (negative),so quit
041863             0108*   ;     jr @loop
041863             0109*   ; @done:
041863             0110*   ;     ld de,(prt_irq_counter)
041863             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
041863             0112*   ;     ld (prt_reload),bc
041863             0113*   ;     ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041863             0114*   ;     xor a ; clear carry,zero is default value for running on hardware
041863             0115*   ;     ld (is_emulator),a
041863             0116*   ;     sbc hl,de
041863             0117*   ;     ld hl,on_hardware ; default message for running on hardware
041863             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
041863             0119*   ;     ret m ; negative result means we're on hardware
041863             0120*   ;     inc a ; we're on emulator
041863             0121*   ;     ld (is_emulator),a
041863             0122*   ;     ld bc,prt_reload_emulator
041863             0123*   ;     ld (prt_reload),bc
041863             0124*   ;     ld hl,on_emulator
041863             0125*   ;     ret
041863             0126*   
041863             0127*   ; calibrating_timer: defb "Calibrating timer\r\n",0
041863             0128*   
041863             0129*   ; set PRT timer
041863             0130*   prt_set:
041863 21 00 00 00 0131*       ld hl,0
041867 22 B1 18 04 0132*       ld (prt_irq_counter),hl
04186B 2A 60 18 04 0133*       ld hl,(prt_reload)
04186F ED 29 84    0134*       out0 ($84),l
041872 ED 21 85    0135*   	out0 ($85),h
041875             0136*   ; disable timer
041875 3E 06       0137*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
041877 ED 39 83    0138*   	out0 ($83),a
04187A             0139*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
04187A 3E 57       0140*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
04187C ED 39 83    0141*   	out0 ($83),a
04187F C9          0142*       ret
