0423DC CD 93 19 04 0071        call tmr_main_loop_set
0423E0 CD A0 07 04 0072        call tmr_slideshow_set
0423E4 C9          0073        ret ; init
0423E5             0074    
0423E5             0075    main:
0423E5             0076    ; Preload and finalize every image in the container before entering the same
0423E5             0077    ; slideshow loop used by the loose-file harness. Load it twice deliberately:
0423E5             0078    ; the second traversal is the regression test for per-open reader-state reset.
0423E5 CD 87 01 04 0079        call agnb_load_images
0423E9 C2 6D 24 04 0080        jp nz,main_end
0423ED CD 87 01 04 0081        call agnb_load_images
0423F1 C2 6D 24 04 0082        jp nz,main_end
0423F5 11 00 00 00 0083        ld de, 0
0423F9 C3 15 24 04 0084        jp rendbmp
