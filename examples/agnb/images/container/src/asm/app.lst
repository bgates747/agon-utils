040080             0504*   ; System variable indexes for api_sysvars
040080             0505*   ; Index into _sysvars in globals.asm
040080             0506*   ;
040080             0507*   sysvar_time:			EQU	00h	; 4: Clock timer in centiseconds (incremented by 2 every VBLANK)
040080             0508*   sysvar_vpd_pflags:		EQU	04h	; 1: Flags to indicate completion of VDP commands
040080             0509*   sysvar_keyascii:		EQU	05h	; 1: ASCII keycode, or 0 if no key is pressed
040080             0510*   sysvar_keymods:			EQU	06h	; 1: Keycode modifiers
040080             0511*   sysvar_cursorX:			EQU	07h	; 1: Cursor X position
040080             0512*   sysvar_cursorY:			EQU	08h	; 1: Cursor Y position
040080             0513*   sysvar_scrchar:			EQU	09h	; 1: Character read from screen
040080             0514*   sysvar_scrpixel:		EQU	0Ah	; 3: Pixel data read from screen (R,B,G)
040080             0515*   sysvar_audioChannel:	EQU	0Dh	; 1: Audio channel
040080             0516*   sysvar_audioSuccess:	EQU	0Eh	; 1: Audio channel note queued (0 = no, 1 = yes)
040080             0517*   sysvar_scrWidth:		EQU	0Fh	; 2: Screen width in pixels
040080             0518*   sysvar_scrHeight:		EQU	11h	; 2: Screen height in pixels
040080             0519*   sysvar_scrCols:			EQU	13h	; 1: Screen columns in characters
040080             0520*   sysvar_scrRows:			EQU	14h	; 1: Screen rows in characters
040080             0521*   sysvar_scrColours:		EQU	15h	; 1: Number of colours displayed
040080             0522*   sysvar_scrpixelIndex:	EQU	16h	; 1: Index of pixel data read from screen
040080             0523*   sysvar_vkeycode:		EQU	17h	; 1: Virtual key code from FabGL
040080             0524*   sysvar_vkeydown:		EQU	18h	; 1: Virtual key state from FabGL (0=up, 1=down)
040080             0525*   sysvar_vkeycount:		EQU	19h	; 1: Incremented every time a key packet is received
040080             0526*   sysvar_rtc:				EQU	1Ah	; 6: Real time clock data
040080             0527*   sysvar_spare:			EQU	20h	; 2: Spare, previously used by rtc
040080             0528*   sysvar_keydelay:		EQU	22h	; 2: Keyboard repeat delay
040080             0529*   sysvar_keyrate:			EQU	24h	; 2: Keyboard repeat reat
040080             0530*   sysvar_keyled:			EQU	26h	; 1: Keyboard LED status
040080             0531*   sysvar_scrMode:			EQU	27h	; 1: Screen mode
040080             0532*   sysvar_rtcEnable:		EQU	28h	; 1: RTC enable flag (0: disabled, 1: use ESP32 RTC)
