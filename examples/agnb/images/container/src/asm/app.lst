042390             0317*   add_uhl_a_signed:
042390 D5          0318*       push de    ; 4 cycles
042391 EB          0319*       ex de, hl  ; 1 cycle  UDE = UHL
042392 07          0320*       rlca       ; 1 cycle  CF = signbit(A)
042393 ED 62       0321*       sbc hl, hl ; 2 cycles UHL = -signbit(A)
042395 0F          0322*       rrca       ; 1 cycle  Restore A
042396 6F          0323*       ld l, a    ; 1 cycle  UHL = signext(A)
042397 19          0324*       add hl, de ; 1 cycle  UHL = UDE + signext(A)
042398 D1          0325*       pop de     ; 4 cycles
042399             0326*                  ; 15 cycles total
042399 C9          0327*       ret
04239A             0328*   ; end hlu_add_a_signed
