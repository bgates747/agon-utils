042264             0006*   
042264             0007*   ; absolute value of hlu
042264             0008*   ; returns: abs(hlu), flags set according to the incoming sign of hlu:
042264             0009*   ;         s1,z0,pv0,n1,c0 if hlu was negative
042264             0010*   ;         s0,z1,pv0,n1,c0 if hlu was zero
042264             0011*   ;         s0,z0,pv0,n1,c0 if hlu was positive
042264             0012*   ; destroys: a
042264             0013*   hlu_abs:
042264 19          0014*       add hl,de
042265 B7          0015*       or a
042266 ED 52       0016*       sbc hl,de
042268 FA 6D 22 04 0017*       jp m,@is_neg
04226C C9          0018*       ret ; hlu is positive or zero so we're done
04226D             0019*   @is_neg:
04226D F5          0020*       push af ; otherwise, save current flags for return
04226E CD 74 22 04 0021*       call neg_hlu ; negate hlu
042272 F1          0022*       pop af ; get back flags
042273 C9          0023*       ret
042274             0024*   
042274             0025*   ; flip the sign of hlu
042274             0026*   ; inputs: hlu
042274             0027*   ; returns: 0-hlu, flags set appropriately for the result:
042274             0028*   ;         s1,z0,pv0,n1,c1 if result is negative
042274             0029*   ;         s0,z1,pv0,n1,c0 if result is zero
042274             0030*   ;         s0,z0,pv0,n1,c1 if result is positive
042274             0031*   ; destroys a
042274             0032*   neg_hlu:
042274 D5          0033*       push de ; save de
042275 EB          0034*       ex de,hl ; put hl into de
042276 21 00 00 00 0035*       ld hl,0 ; clear hl
04227A AF          0036*       xor a ; clear carry
04227B ED 52       0037*       sbc hl,de ; 0-hlu = -hlu
04227D D1          0038*       pop de ; get de back
04227E C9          0039*       ret ; easy peasy
