0422DE             0102*   ; ; floor(value,n)
0422DE             0103*   ; ; inputs: hl = value to floor, de = n
0422DE             0104*   ; ; outputs: hl = value floored to n
0422DE             0105*   ; ; destroys: af, hl, bc, de
0422DE             0106*   ; hlu_floor:
0422DE             0107*   ;     push de ; save n
0422DE             0108*   ;     call udiv24 ; de = quotient, hl = remainder
0422DE             0109*   ;     pop hl ; get n back (was de)
0422DE             0110*   ;     call umul24 ; hl = n * quotient
0422DE             0111*   ;     ret
0422DE             0112*   ; ; end hlu_floor
0422DE             0113*   
0422DE             0114*   ; Not needed by the AGNB test harness. Retained as comments from AgonVideo.
0422DE             0115*   ; ; ceil(value,n)
0422DE             0116*   ; ; inputs: hl = value to ceil, de = n
0422DE             0117*   ; ; outputs: hl = value ceiled to n
0422DE             0118*   ; ; destroys: af, hl, bc, de
0422DE             0119*   ; hlu_ceiling:
0422DE             0120*   ;     push de ; save n
0422DE             0121*   ;     call udiv24 ; de = quotient, hl = remainder
0422DE             0122*   ;     SIGN_UHL ; test remaider for zero
0422DE             0123*   ;     jp z,@F ; if zero, nothing to add
0422DE             0124*   ;     inc de ; add 1 to quotient for the ceiling
0422DE             0125*   ; @@:
0422DE             0126*   ;     pop hl ; get n back (was de)
0422DE             0127*   ;     call umul24 ; hl = n * quotient
