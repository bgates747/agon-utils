041FFF             0252*   ; This routine converts the unsigned 24-bit value in HLU into its ASCII representation,
041FFF             0253*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
041FFF             0254*   ; so it will allways be 8 characters length
041FFF             0255*   ; HL : Value to convert to string
041FFF             0256*   ; DE : pointer to buffer, at least 8 byte + 0
041FFF             0257*   u24_to_ascii:
041FFF 01 80 69 67 0258*       LD BC,-10000000
042003 CD 36 20 04 0259*       CALL one_digit
042007 01 C0 BD F0 0260*       LD BC,-1000000
04200B CD 36 20 04 0261*       CALL one_digit
04200F 01 60 79 FE 0262*       LD BC,-100000
042013 CD 36 20 04 0263*       CALL one_digit
042017 01 F0 D8 FF 0264*       LD BC,-10000
04201B CD 36 20 04 0265*       CALL one_digit
04201F             0266*   u8_to_ascii: ; same arguments but hl <= 255, uhl and h = 0
04201F 01 18 FC FF 0267*       LD BC,-1000
042023 CD 36 20 04 0268*       CALL one_digit
042027 01 9C FF FF 0269*       LD BC,-100
04202B CD 36 20 04 0270*       CALL one_digit
04202F 0E F6       0271*       LD C,-10
042031 CD 36 20 04 0272*       CALL one_digit
042035 48          0273*       LD C,B
042036             0274*   one_digit:
042036 3E 2F       0275*       LD A,'0'-1
042038             0276*   @divide_me:
