04205A             0298*   ; u168_to_ascii: Converts an unsigned 16.8 fixed-point value in HL to an ASCII string.
04205A             0299*   ; HL : Value to convert to string (integer part in H, fractional part in L)
04205A             0300*   ; DE : Pointer to buffer, requires at least 11 bytes (8 digits, sign, decimal point, and null terminator)
04205A             0301*   u168_to_ascii:
04205A             0302*   ; add a leading space to make room for sign flag if needed
04205A 3E 20       0303*       ld a,' '
04205C 12          0304*       ld (de),a
04205D 13          0305*       inc de
04205E             0306*   ; Convert integer part
04205E E5          0307*       push hl ; Save HL (we’ll need the fractional part later)
04205F             0308*       ; call hlu_udiv256 ; Shift to get integer portion in HL
04205F             0309*       SRL_UHL ; Shift to get integer portion in HL
                       M1 Args: none
04205F 3B          0001*M1     dec sp ; 1 cycle
