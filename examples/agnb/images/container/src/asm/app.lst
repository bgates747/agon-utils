0402AB             0486*   ; RIFF stores file size minus eight. Add the omitted bytes as u32, using the
0402AB             0487*   ; native 24-bit ALU for the low three bytes and A for the high byte.
0402AB 2A FD 00 04 0488*       ld hl,(agnb_header+agnb_riff_size)
0402AF 3A 00 01 04 0489*       ld a,(agnb_header+agnb_riff_size+3)
0402B3 11 08 00 00 0490*       ld de,8
0402B7 19          0491*       add hl,de
0402B8 30 03       0492*       jr nc,@riff_end_ready
