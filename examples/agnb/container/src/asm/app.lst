       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041769             0053*   
041769             0054*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
041769             0055*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
041769             0056*   ; so it will allways be 8 characters length
041769             0057*   ; HL : Value to convert to string
041769             0058*   ; DE : pointer to buffer, at least 8 byte + 0
041769             0059*   ; u24_to_ascii:
041769             0060*   ;     LD BC,-10000000
041769             0061*   ;     CALL @one_digit
041769             0062*   ;     LD BC,-1000000
041769             0063*   ;     CALL @one_digit
041769             0064*   ;     LD BC,-100000
041769             0065*   ;     CALL @one_digit
041769             0066*   ;     LD BC,-10000
041769             0067*   ;     CALL @one_digit
041769             0068*   ;     LD BC,-1000
041769             0069*   ;     CALL @one_digit
041769             0070*   ;     LD BC,-100
041769             0071*   ;     CALL @one_digit
041769             0072*   ;     LD C,-10
041769             0073*   ;     CALL @one_digit
041769             0074*   ;     LD C,B
041769             0075*   ; @one_digit:
041769             0076*   ;     LD A,'0'-1
041769             0077*   ; @divide_me:
041769             0078*   ;     INC A
041769             0079*   ;     ADD HL,BC
041769             0080*   ;     JR C,@divide_me
041769             0081*   ;     SBC HL,BC
041769             0082*   ;     LD (DE),A
041769             0083*   ;     INC DE
041769             0084*   ;     RET
