041C7E             0317*   add_uhl_a_signed:
041C7E D5          0318*       push de    ; 4 cycles
041C7F EB          0319*       ex de, hl  ; 1 cycle  UDE = UHL
041C80 07          0320*       rlca       ; 1 cycle  CF = signbit(A)
