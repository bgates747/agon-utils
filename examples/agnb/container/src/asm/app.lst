041F92             0006*   
041F92             0007*   ; absolute value of hlu
041F92             0008*   ; returns: abs(hlu), flags set according to the incoming sign of hlu:
041F92             0009*   ;         s1,z0,pv0,n1,c0 if hlu was negative
041F92             0010*   ;         s0,z1,pv0,n1,c0 if hlu was zero
041F92             0011*   ;         s0,z0,pv0,n1,c0 if hlu was positive
041F92             0012*   ; destroys: a
041F92             0013*   hlu_abs:
041F92 19          0014*       add hl,de
041F93 B7          0015*       or a
041F94 ED 52       0016*       sbc hl,de
041F96 FA 9B 1F 04 0017*       jp m,@is_neg
041F9A C9          0018*       ret ; hlu is positive or zero so we're done
041F9B             0019*   @is_neg:
041F9B F5          0020*       push af ; otherwise, save current flags for return
041F9C CD A2 1F 04 0021*       call neg_hlu ; negate hlu
041FA0 F1          0022*       pop af ; get back flags
041FA1 C9          0023*       ret
041FA2             0024*   
041FA2             0025*   ; flip the sign of hlu
041FA2             0026*   ; inputs: hlu
041FA2             0027*   ; returns: 0-hlu, flags set appropriately for the result:
041FA2             0028*   ;         s1,z0,pv0,n1,c1 if result is negative
041FA2             0029*   ;         s0,z1,pv0,n1,c0 if result is zero
041FA2             0030*   ;         s0,z0,pv0,n1,c1 if result is positive
041FA2             0031*   ; destroys a
