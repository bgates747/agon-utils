042250             0006*   
042250             0007*   ; absolute value of hlu
042250             0008*   ; returns: abs(hlu), flags set according to the incoming sign of hlu:
042250             0009*   ;         s1,z0,pv0,n1,c0 if hlu was negative
042250             0010*   ;         s0,z1,pv0,n1,c0 if hlu was zero
042250             0011*   ;         s0,z0,pv0,n1,c0 if hlu was positive
042250             0012*   ; destroys: a
042250             0013*   hlu_abs:
042250 19          0014*       add hl,de
042251 B7          0015*       or a
042252 ED 52       0016*       sbc hl,de
042254 FA 59 22 04 0017*       jp m,@is_neg
042258 C9          0018*       ret ; hlu is positive or zero so we're done
042259             0019*   @is_neg:
042259 F5          0020*       push af ; otherwise, save current flags for return
04225A CD 60 22 04 0021*       call neg_hlu ; negate hlu
04225E F1          0022*       pop af ; get back flags
04225F C9          0023*       ret
042260             0024*   
042260             0025*   ; flip the sign of hlu
042260             0026*   ; inputs: hlu
042260             0027*   ; returns: 0-hlu, flags set appropriately for the result:
042260             0028*   ;         s1,z0,pv0,n1,c1 if result is negative
042260             0029*   ;         s0,z1,pv0,n1,c0 if result is zero
042260             0030*   ;         s0,z0,pv0,n1,c1 if result is positive
042260             0031*   ; destroys a
042260             0032*   neg_hlu:
042260 D5          0033*       push de ; save de
042261 EB          0034*       ex de,hl ; put hl into de
042262 21 00 00 00 0035*       ld hl,0 ; clear hl
042266 AF          0036*       xor a ; clear carry
042267 ED 52       0037*       sbc hl,de ; 0-hlu = -hlu
042269 D1          0038*       pop de ; get de back
04226A C9          0039*       ret ; easy peasy
