0406B9             0086*   tmr_slideshow: ds 6 ; buffer to hold slideshow timer
       FF FF FF FF 
       FF FF 
0406BF 01 00 00    0087*   tmr_slideshow_reset: dl 1; 1*120
0406C2             0088*   
0406C2             0089*   ; set a countdown timer for the slideshow using the timestamp timer
0406C2             0090*   ; returns: hl = current time
0406C2             0091*   ; destroys: af,hl,de,ix,iy
0406C2             0092*   tmr_slideshow_set:
0406C2 FD 21 B9 06 0093*       ld iy,tmr_slideshow
       04          
0406C7 2A BF 06 04 0094*       ld hl,(tmr_slideshow_reset)
0406CB FD 2F 03    0095*       ld (iy+3),hl ; set time remaining
0406CE CD 81 16 04 0096*       call timestamp_tick
0406D2 2A 78 16 04 0097*       ld hl,(timestamp_now)   ; get current timestamp
0406D6 FD 2F 00    0098*       ld (iy+0),hl ; set start time
0406D9 C9          0099*       ret
0406DA             0100*   
0406DA             0101*   ; gets time remaining on the slideshow countdown timer following the global timestamp
0406DA             0102*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0406DA             0103*   ;          sign flags: pos = time not expired,zero or neg = time expired
0406DA             0104*   ; destroys: af,hl,de,ix,iy
0406DA             0105*   tmr_slideshow_get:
0406DA CD 81 16 04 0106*       call timestamp_tick
0406DE FD 21 B9 06 0107*       ld iy,tmr_slideshow
       04          
0406E3 CD A9 16 04 0108*       call timestamp_tmr_get
0406E7 C9          0109*       ret
