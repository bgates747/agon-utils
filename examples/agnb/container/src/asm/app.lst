0422CA             0116*   ; ; inputs: hl = value to ceil, de = n
0422CA             0117*   ; ; outputs: hl = value ceiled to n
0422CA             0118*   ; ; destroys: af, hl, bc, de
0422CA             0119*   ; hlu_ceiling:
0422CA             0120*   ;     push de ; save n
0422CA             0121*   ;     call udiv24 ; de = quotient, hl = remainder
0422CA             0122*   ;     SIGN_UHL ; test remaider for zero
