041739 21 59 17 04 0029*       LD HL, _printDecBuffer
04173D 06 07       0030*       ld B, 7 ; if HL was 0, we want to keep the final zero
04173F             0031*   @loop:
04173F 7E          0032*       LD A, (HL)
041740 FE 30       0033*       CP '0'
041742 C2 4C 17 04 0034*       JP NZ, @done
041746 3E 20       0035*       LD A, ' '
041748 77          0036*       LD (HL), A
041749 23          0037*       INC HL
04174A             0038*       ; CALL vdu_cursor_forward
04174A 10 F3       0039*       DJNZ @loop
04174C             0040*   @done:
04174C             0041*   ; END MY CODE
04174C 21 59 17 04 0042*       LD HL, _printDecBuffer
041750 CD 22 17 04 0043*       CALL printString
041754             0044*   ; BEGIN MY CODE
