0422CA             0124*   ;     inc de ; add 1 to quotient for the ceiling
0422CA             0125*   ; @@:
0422CA             0126*   ;     pop hl ; get n back (was de)
0422CA             0127*   ;     call umul24 ; hl = n * quotient
0422CA             0128*   ;     ret
0422CA             0129*   ; ; end hlu_ceiling
