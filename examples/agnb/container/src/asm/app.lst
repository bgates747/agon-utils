041003 3A 0C 01 00 0151*   	ld a,($10c)
041007 6F          0152*   	ld l,a
041008 3A 0D 01 00 0153*   	ld a,($10d)
04100C 67          0154*   	ld h,a
04100D             0155*   
04100D             0156*   	; skip over CALL ($c3)
04100D 23          0157*   	inc hl
