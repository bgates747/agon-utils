040080             0543*   ;
040080             0544*   ; FatFS structures
040080             0545*   ; These mirror the structures contained in src_fatfs/ff.h in the MOS project
040080             0546*   ;
040080             0547*   ; Object ID and allocation information (FFOBJID)
040080             0548*   ;
040080             0549*   ; Indexes into FFOBJID structure
040080             0550*   ffobjid_fs:			EQU	0	; 3: Pointer to the hosting volume of this object
040080             0551*   ffobjid_id:			EQU	3	; 2: Hosting volume mount ID
040080             0552*   ffobjid_attr:		EQU	5	; 1: Object attribute
040080             0553*   ffobjid_stat:		EQU	6	; 1: Object chain status (b1-0: =0:not contiguous, =2:contiguous, =3:fragmented in this session, b2:sub-directory stretched)
040080             0554*   ffobjid_sclust:		EQU	7	; 4: Object data start cluster (0:no cluster or root directory)
040080             0555*   ffobjid_objsize:	EQU	11	; 4: Object size (valid when sclust != 0)
040080             0556*   ;
040080             0557*   ; File object structure (FIL)
040080             0558*   ;
040080             0559*   ; Indexes into FIL structure
040080             0560*   fil_obj:		EQU 0	; 15: Object identifier
040080             0561*   fil_flag:		EQU	15 	;  1: File status flags
040080             0562*   fil_err:		EQU	16	;  1: Abort flag (error code)
040080             0563*   fil_fptr:		EQU	17	;  4: File read/write pointer (Zeroed on file open)
040080             0564*   fil_clust:		EQU	21	;  4: Current cluster of fpter (invalid when fptr is 0)
040080             0565*   fil_sect:		EQU	25	;  4: Sector number appearing in buf[] (0:invalid)
040080             0566*   fil_dir_sect:	EQU	29	;  4: Sector number containing the directory entry
040080             0567*   fil_dir_ptr:	EQU	33	;  3: Pointer to the directory entry in the win[]
040080             0568*   ;
040080             0569*   ; Directory object structure (DIR)
040080             0570*   ; Indexes into DIR structure
040080             0571*   dir_obj:		EQU  0	; 15: Object identifier
040080             0572*   dir_dptr:		EQU	15	;  4: Current read/write offset
040080             0573*   dir_clust:		EQU	19	;  4: Current cluster
040080             0574*   dir_sect:		EQU	23	;  4: Current sector (0:Read operation has terminated)
040080             0575*   dir_dir:		EQU	27	;  3: Pointer to the directory item in the win[]
040080             0576*   dir_fn:			EQU	30	; 12: SFN (in/out) {body[8],ext[3],status[1]}
040080             0577*   dir_blk_ofs:	EQU	42	;  4: Offset of current entry block being processed (0xFFFFFFFF:Invalid)
040080             0578*   ;
040080             0579*   ; File information structure (FILINFO)
040080             0580*   ;
040080             0581*   ; Indexes into FILINFO structure
040080             0582*   filinfo_fsize:		EQU 0	;   4: File size
040080             0583*   filinfo_fdate:		EQU	4	;   2: Modified date
040080             0584*   filinfo_ftime:		EQU	6	;   2: Modified time
040080             0585*   filinfo_fattrib:	EQU	8	;   1: File attribute
040080             0586*   filinfo_altname:	EQU	9	;  13: Alternative file name
040080             0587*   filinfo_fname:		EQU	22	; 256: Primary file name
040080             0033        include "macros.inc" ; needs to be above any other includes that use these macros
040080             0001*   
040080             0002*   ; test the sign of HL
040080             0003*   ; inputs: HL obviously
040080             0004*   ; outputs: sign flag set if HL is negative, zero flag set if HL is zero
040080             0005*   ; destroys: flags
040080             0006*       MACRO SIGN_UHL
040080             0007*       add hl,de ; 1 cycle
040080             0008*       or a ; clear flags ; 1 cycle
040080             0009*       sbc hl,de ; 2 cycles
040080             0010*       ; 4 cycles total
040080             0011*       ENDMACRO
040080             0012*   
040080             0013*   ; put the value in A into HLU
040080             0014*   ; affects: HLU
040080             0015*   ; destroys: nothing
040080             0016*   ; note: $ instead of @@ b/c anon labels deprecated in ez80asm
040080             0017*       MACRO A_TO_HLU
040080             0018*       xor a ; 1 cycle
040080             0019*       ld ($+8+1),hl ; 7 cycles
040080             0020*       ld ($+4+3),a ; 5 cycles
040080             0021*       ld hl,0x000000 ; 4 cycles
040080             0022*       ; 17 cycles total
040080             0023*       ENDMACRO
040080             0024*   
040080             0025*   ; alternative: https://discord.com/channels/1158535358624039014/1282290921815408681/1318315567102300220
040080             0026*   ; one cycle less but burns flags
040080             0027*       MACRO A_TO_HLU_ALT
040080             0028*       push hl ; 4 cycles
040080             0029*       ld hl,2 ; 4 cycles
040080             0030*       add hl,sp ; 1 cycle
040080             0031*       ld (hl),a ; 2 cycles
040080             0032*       pop hl ; 4 cycles
040080             0033*       ; 15 cycles total
040080             0034*       ENDMACRO
040080             0035*   
040080             0036*       MACRO hlu_mul256
040080             0037*       add hl,hl ; * 2
040080             0038*       add hl,hl ; * 4
040080             0039*       add hl,hl ; * 8
040080             0040*       add hl,hl ; * 16
040080             0041*       add hl,hl ; * 32
040080             0042*       add hl,hl ; * 64
040080             0043*       add hl,hl ; * 128
040080             0044*       add hl,hl ; * 256
040080             0045*       ENDMACRO
040080             0046*   
040080             0047*   ; https://discord.com/channels/1158535358624039014/1282290921815408681/1317793870070812715
040080             0048*       MACRO SRL_UHL
040080             0049*       dec sp ; 1 cycle
040080             0050*       push hl ; 4 cycles
040080             0051*       inc sp ; 1 cycle
040080             0052*       pop hl ; 4 cycles
040080             0053*       inc hl ; 1 cycle
040080             0054*       dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
040080             0055*       ; 13 cycles total
040080             0056*       ENDMACRO
040080             0057*   
040080             0058*       MACRO printChar char
040080             0059*       LD A, char
040080             0060*       RST.LIL 10h
040080             0061*       ENDMACRO
040080             0062*   
040080             0063*   ; Simulated call to subroutine at HL
040080             0064*   ; inputs: HL pointing to the subroutine address plus whatever the called function expects
040080             0065*   ; outputs: whatever the subroutine does, including HL and BC
040080             0066*   ; destroys: only what the subroutine does, but always BC
040080             0067*       MACRO CALL_HL
040080             0068*       ld bc,$+6 ; Address of first instruction after the jump
040080             0069*       push bc ; which constitutes the return address
040080             0070*       jp (hl) ; Jump to the address in HL
040080             0071*       ENDMACRO
040080             0072*   
040080             0073*   ; Simulated call to subroutine at IX
040080             0074*   ; inputs: IX pointing to the subroutine address plus whatever the called function expects
040080             0075*   ; outputs: whatever the subroutine does, including IX and BC
040080             0076*   ; destroys: only what the subroutine does, but always BC
040080             0077*       MACRO CALL_IX
040080             0078*       ld bc,$+6 ; Address of first instruction after the jump
040080             0079*       push bc ; which constitutes the return address
040080             0080*       jp (ix) ; Jump to the address in IX
040080             0081*       ENDMACRO
040080             0082*   
040080             0083*   ; Simulated call to soubroutinte at IY
040080             0084*   ; inputs: IY pointing to the subroutine address plus whatever the called function expects
040080             0085*   ; outputs: whatever the subroutine does, including IY and BC
040080             0086*   ; destroys: only what the subroutine does, but always BC
040080             0087*       MACRO CALL_IY
040080             0088*       ld bc,$+6 ; Address of first instruction after the jump
040080             0089*       push bc ; which constitutes the return address
040080             0090*       jp (iy) ; Jump to the address in IY
040080             0091*       ENDMACRO
040080             0092*   
040080             0093*   ; put the value in HLU into A
040080             0094*   ; destroys: af
040080             0095*       MACRO HLU_TO_A
040080             0096*       dec sp ; 1 cycle
040080             0097*       push hl ; 4 cycles
040080             0098*       inc sp ; 1 cycle
040080             0099*       pop af ; 4 cycles
040080             0100*       ; 10 cycles total
040080             0101*       ENDMACRO
040080             0102*   
040080             0103*       MACRO PUSH_ALL
040080             0104*       ex af,af'
040080             0105*       exx
040080             0106*       push af
040080             0107*       push hl
040080             0108*       push bc
040080             0109*       push de
040080             0110*   
040080             0111*       ex af,af'
040080             0112*       exx
040080             0113*       push af
040080             0114*       push hl
040080             0115*       push bc
040080             0116*       push de
040080             0117*       push ix
040080             0118*       push iy
040080             0119*       ENDMACRO
040080             0120*   
040080             0121*       MACRO POP_ALL
040080             0122*       pop iy
040080             0123*       pop ix
040080             0124*       pop de
040080             0125*       pop bc
040080             0126*       pop hl
040080             0127*       pop af
040080             0128*       ex af,af'
040080             0129*       exx
040080             0130*   
040080             0131*       pop de
040080             0132*       pop bc
040080             0133*       pop hl
040080             0134*       pop af
040080             0135*       ex af,af'
040080             0136*       exx
040080             0137*       ENDMACRO
040080             0138*   
040080             0139*       ; load hl with the 16-bit value at addr
040080             0140*       MACRO LD_HL_mn addr
040080             0141*       ld hl,(addr)
040080             0142*       dec hl
040080             0143*       inc.s hl ; zeros hlu
040080             0144*       ENDMACRO
040080             0145*   
040080             0146*       ; load bc with the 16-bit value at addr
040080             0147*       MACRO LD_BC_mn addr
040080             0148*       ld bc,(addr)
040080             0149*       dec bc
040080             0150*       inc.s bc ; zeros bcu
040080             0151*       ENDMACRO
040080             0152*   
040080             0153*       ; load de with the 16-bit value at addr
040080             0154*       MACRO LD_DE_mn addr
040080             0155*       ld de,(addr)
040080             0156*       dec de
040080             0157*       inc.s de ; zeros deu
040080             0158*       ENDMACRO
040080             0159*   
040080             0160*       ; load ix with the 16-bit value at addr
040080             0161*       MACRO LD_IX_mn addr
040080             0162*       ld ix,(addr)
040080             0163*       dec ix
040080             0164*       inc.s ix ; zeros ixu
040080             0165*       ENDMACRO
040080             0166*   
040080             0167*       ; load iy with the 16-bit value at addr
040080             0168*       MACRO LD_IY_mn addr
040080             0169*       ld iy,(addr)
040080             0170*       dec iy
040080             0171*       inc.s iy ; zeros iyu
040080             0172*       ENDMACRO
040080             0034        include "agnb.inc"
040080             0001*   ; AGNB 0.1 image-container layout
040080             0002*   ; ===============================
040080             0003*   ;
040080             0004*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
040080             0005*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
040080             0006*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
040080             0007*   ; The stored chunk size excludes its eight-byte header and alignment padding.
040080             0008*   ;
040080             0009*   ;     RIFF  u32(file size - 8)  AGNB
040080             0010*   ;       VERS  size=2
040080             0011*   ;         u8 major=0
040080             0012*   ;         u8 minor=1
040080             0013*   ;       LIST  type=BUFR
040080             0014*   ;         BHDR  size=2
040080             0015*   ;           u16 bufferId
040080             0016*   ;         IMAG  size=5
040080             0017*   ;           u16 width
040080             0018*   ;           u16 height
040080             0019*   ;           u8  format=1        ; RGBA2222
040080             0020*   ;         DATA  size=width*height
040080             0021*   ;           u8 pixels[]         ; row-major, no row padding
040080             0022*   ;
040080             0023*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
040080             0024*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
040080             0025*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
040080             0026*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
040080             0027*   ; reading or uploading DATA. Chunk traversal advances by:
040080             0028*   ;
040080             0029*   ;     8 + ((payload_size + 3) & ~3)
040080             0030*   ;
040080             0031*   ; The offsets below are indices from the beginning of the named header or
040080             0032*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
040080             0033*   ; 24-bit, so their high byte must not be silently discarded during validation.
040080             0034*   
040080             0035*   ; RIFF file header: "RIFF", u32 size, "AGNB"
040080             0036*   agnb_riff_id:              equ 0
040080             0037*   agnb_riff_size:            equ 4
040080             0038*   agnb_riff_form:            equ 8
040080             0039*   agnb_riff_header_size:     equ 12
040080             0040*   
040080             0041*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
040080             0042*   agnb_chunk_id:             equ 0
040080             0043*   agnb_chunk_size:           equ 4
040080             0044*   agnb_chunk_data:           equ 8
040080             0045*   agnb_chunk_header_size:    equ 8
040080             0046*   
040080             0047*   ; VERS payload
040080             0048*   agnb_vers_major:           equ 0
040080             0049*   agnb_vers_minor:           equ 1
040080             0050*   agnb_vers_payload_size:    equ 2
040080             0051*   
040080             0052*   ; LIST BUFR payload
040080             0053*   agnb_list_type:            equ 0
040080             0054*   agnb_list_chunks:          equ 4
040080             0055*   agnb_list_type_size:       equ 4
040080             0056*   
040080             0057*   ; BHDR payload
040080             0058*   agnb_bhdr_bufferId:        equ 0
040080             0059*   agnb_bhdr_payload_size:    equ 2
040080             0060*   
040080             0061*   ; IMAG payload
040080             0062*   agnb_imag_width:           equ 0
040080             0063*   agnb_imag_height:          equ 2
040080             0064*   agnb_imag_format:          equ 4
040080             0065*   agnb_imag_payload_size:    equ 5
040080             0066*   
040080             0067*   ; DATA payload
040080             0068*   agnb_data_pixels:          equ 0
040080             0069*   
040080             0070*   ; Values supported by the version 0.1 image loader
040080             0071*   agnb_version_major:        equ 0
040080             0072*   agnb_version_minor:        equ 1
040080             0073*   agnb_image_rgba2222:       equ 1
040080             0074*   
040080             0075*   
040080             0076*   ; FourCC constants
040080             0077*   ; ----------------
040080             0078*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
040080             0079*   ; compares one of these tables with four bytes read from the container.
040080             0080*   
040080 52 49 46 46 0081*   agnb_id_riff:              db "RIFF"
040084 41 47 4E 42 0082*   agnb_id_agnb:              db "AGNB"
040088 56 45 52 53 0083*   agnb_id_vers:              db "VERS"
04008C 4C 49 53 54 0084*   agnb_id_list:              db "LIST"
040090 42 55 46 52 0085*   agnb_id_bufr:              db "BUFR"
040094 42 48 44 52 0086*   agnb_id_bhdr:              db "BHDR"
040098 49 4D 41 47 0087*   agnb_id_imag:              db "IMAG"
04009C 44 41 54 41 0088*   agnb_id_data:              db "DATA"
0400A0             0089*   
0400A0             0090*   
0400A0             0091*   ; Reader result codes
0400A0             0092*   ; -------------------
0400A0             0093*   ; Public routines will return A=0 with Z set on success, or one of these
0400A0             0094*   ; nonzero values with NZ set on failure. The same value is stored in
0400A0             0095*   ; agnb_last_error.
0400A0             0096*   
0400A0             0097*   agnb_error_ok:             equ 0
0400A0             0098*   agnb_error_open:           equ 1
0400A0             0099*   agnb_error_read:           equ 2
0400A0             0100*   agnb_error_seek:           equ 3
0400A0             0101*   agnb_error_riff_id:        equ 4
0400A0             0102*   agnb_error_riff_form:      equ 5
0400A0             0103*   agnb_error_version:        equ 6
0400A0             0104*   agnb_error_chunk:          equ 7
0400A0             0105*   agnb_error_bounds:         equ 8
0400A0             0106*   agnb_error_bufferId:       equ 9
0400A0             0107*   agnb_error_metadata:       equ 10
0400A0             0108*   agnb_error_data_size:      equ 11
0400A0             0109*   agnb_error_vdp:            equ 12
0400A0             0110*   agnb_error_eof:            equ 13
0400A0             0111*   agnb_error_not_implemented: equ 255
0400A0             0112*   
0400A0             0113*   
0400A0             0114*   ; FatFS file structure
0400A0             0115*   ; --------------------
0400A0             0116*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
0400A0             0117*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
0400A0             0118*   ; the single known container filename.
0400A0             0119*   
0400A0             0120*   agnb_fil_size:             equ fil_dir_ptr+3
0400A0             0121*   agnb_fil:
0400A0 00 00 00 00 0122*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400C4             0123*   
0400C4             0124*   
0400C4             0125*   ; Reader-state structure
0400C4             0126*   ; ----------------------
0400C4             0127*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
0400C4             0128*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
0400C4             0129*   ; checks and FatFS seeks.
0400C4             0130*   
0400C4             0131*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
0400C4             0132*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
0400C4             0133*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
0400C4             0134*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
0400C4             0135*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
0400C4             0136*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
0400C4             0137*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
0400C4             0138*   agnb_state_size:           equ 28
0400C4             0139*   
0400C4             0140*   agnb_state:
0400C4 00 00 00 00 0141*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400E0             0142*   
0400E0             0143*   
0400E0             0144*   ; Normalized image metadata
0400E0             0145*   ; -------------------------
0400E0             0146*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
0400E0             0147*   
0400E0             0148*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
0400E0             0149*   agnb_meta_width:           equ 2  ; u16 pixels
0400E0             0150*   agnb_meta_height:          equ 4  ; u16 pixels
0400E0             0151*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
0400E0             0152*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
0400E0             0153*   agnb_meta_size:            equ 11
0400E0             0154*   
0400E0             0155*   agnb_metadata:
0400E0 00 00 00 00 0156*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
0400EB             0157*   
0400EB             0158*   ; Retained u32 result from agnb_calculate_image_data_size for validation and
0400EB             0159*   ; temporary test inspection. The high byte is zero for the 24-bit product.
0400EB             0160*   agnb_expected_data_size:
0400EB 00 00 00 00 0161*       blkb 4,0
0400EF             0162*   
0400EF             0163*   ; Working counters used by agnb_stream_data. DATA sizes accepted by the image
0400EF             0164*   ; loader have already been constrained to 24 bits.
0400EF             0165*   agnb_stream_remaining:
0400EF 00 00 00    0166*       blkb 3,0
0400F2             0167*   agnb_stream_block_size:
0400F2 00 00 00    0168*       blkb 3,0
0400F5             0169*   agnb_padding_size:
0400F5 00          0170*       db 0
0400F6             0171*   
0400F6             0172*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
0400F6             0173*   agnb_record_has_bhdr:      equ 0
0400F6             0174*   agnb_record_has_imag:      equ 1
0400F6             0175*   agnb_record_has_data:      equ 2
0400F6             0176*   
0400F6 00          0177*   agnb_record_flags:         db 0
0400F7 00          0178*   agnb_last_error:           db agnb_error_ok
0400F8 00          0179*   agnb_file_is_open:         db 0
0400F9             0180*   
0400F9             0181*   
0400F9             0182*   ; Reusable I/O storage
0400F9             0183*   ; --------------------
0400F9             0184*   ; The 12-byte buffer is large enough for either the RIFF file header or a
0400F9             0185*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
0400F9             0186*   ; the application's existing 8 KiB SRAM filedata area.
0400F9             0187*   
0400F9             0188*   agnb_header:
0400F9 00 00 00 00 0189*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
040105             0190*   
040105             0191*   agnb_io_buffer:            equ 0xB7E000 ; same onboard SRAM as app filedata
040105             0192*   agnb_io_buffer_size:       equ 8192
040105             0193*   
040105             0194*   agnb_filename:
040105 69 6D 61 67 0195*       asciz "images.agnb"
       65 73 2E 61 
       67 6E 62 00 
040111             0196*   
040111             0197*   
040111             0198*   ; Reader subroutine interface
040111             0199*   ; ---------------------------
040111             0200*   ; These labels establish the intended decomposition and calling contracts.
040111             0201*   ; They deliberately fail with agnb_error_not_implemented until replaced with
040111             0202*   ; real code, preventing an incomplete loader from reporting false success.
040111             0203*   
040111             0204*   ; Compare two FourCC values.
040111             0205*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
040111             0206*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
040111             0207*   ; preserves: BC, DE, HL
040111             0208*   ; destroys: A
040111             0209*   agnb_compare_fourcc:
040111 C5          0210*       push bc
040112 D5          0211*       push de
040113 E5          0212*       push hl
040114 06 04       0213*       ld b,4
040116             0214*   @loop:
040116 1A          0215*       ld a,(de)
040117 BE          0216*       cp (hl)
040118 20 04       0217*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
04011A 13          0218*       inc de
04011B 23          0219*       inc hl
04011C 10 F8       0220*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
04011E             0221*   @done:
04011E E1          0222*       pop hl
04011F D1          0223*       pop de
040120 C1          0224*       pop bc
040121 C9          0225*       ret
040122             0226*   
040122             0227*   ; Open a container for reading.
040122             0228*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
040122             0229*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
040122             0230*   ;          agnb_fil initialized and agnb_file_is_open set on success
040122             0231*   ; destroys: AF, BC, HL
040122             0232*   agnb_open:
040122             0233*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
040122 AF          0234*       xor a
040123 32 F8 00 04 0235*       ld (agnb_file_is_open),a
040127 32 F7 00 04 0236*       ld (agnb_last_error),a
04012B             0237*   
04012B             0238*   ; open the caller-supplied filename into our single reader-owned FIL
04012B 21 A0 00 04 0239*       ld hl,agnb_fil
04012F 0E 01       0240*       ld c,fa_read
040131             0241*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
040131 FD E5       0001*M1 			PUSH IY
040133 3E 80       0002*M1 			LD	A, function
040135 5B CF       0003*M1 			RST.LIL	08h
040137 FD E1       0004*M1 			POP IY
040139 B7          0242*       or a
04013A 20 08       0243*       jr nz,@error
04013C             0244*   
04013C             0245*   ; ffs_fopen succeeded
04013C 3E 01       0246*       ld a,1
04013E 32 F8 00 04 0247*       ld (agnb_file_is_open),a
040142 AF          0248*       xor a
040143 C9          0249*       ret
040144             0250*   
040144             0251*   @error:
040144 3E 01       0252*       ld a,agnb_error_open
040146 32 F7 00 04 0253*       ld (agnb_last_error),a
04014A B7          0254*       or a
04014B C9          0255*       ret
04014C             0256*   
04014C             0257*   ; Close agnb_fil if open and clear agnb_file_is_open.
04014C             0258*   ; outputs: A=0 and Z set if closed or already closed
04014C             0259*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
04014C             0260*   ; destroys: HL
04014C             0261*   agnb_close:
04014C             0262*   ; An unopened file is already in the requested state.
04014C 3A F8 00 04 0263*       ld a,(agnb_file_is_open)
040150 B7          0264*       or a
040151 28 14       0265*       jr z,@success
040153             0266*   
040153             0267*   ; Close our single reader-owned FIL.
040153 21 A0 00 04 0268*       ld hl,agnb_fil
040157             0269*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
040157 FD E5       0001*M1 			PUSH IY
040159 3E 81       0002*M1 			LD	A, function
04015B 5B CF       0003*M1 			RST.LIL	08h
04015D FD E1       0004*M1 			POP IY
04015F B7          0270*       or a
040160 20 0B       0271*       jr nz,agnb_error_close
040162             0272*   
040162             0273*   ; Only clear the open flag after FatFS confirms the close.
040162 AF          0274*       xor a
040163 32 F8 00 04 0275*       ld (agnb_file_is_open),a
040167             0276*   @success:
040167 AF          0277*       xor a
040168 32 F7 00 04 0278*       ld (agnb_last_error),a
04016C C9          0279*       ret
04016D             0280*   
04016D             0281*   agnb_error_close:
04016D             0282*   ; Placeholder in case we determine that close failures need a dedicated AGNB
04016D             0283*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
04016D             0284*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
04016D 32 F7 00 04 0285*       ld (agnb_last_error),a
040171 B7          0286*       or a
040172 C9          0287*       ret
040173             0288*   
040173             0289*   ; Top-level image load operation.
040173             0290*   ; inputs:  none; uses agnb_filename
040173             0291*   ; outputs: A=0 and Z set after all valid LIST BUFR image records are uploaded
040173             0292*   ;          and finalized at their explicit IDs; nonzero error and NZ otherwise
040173             0293*   ; destroys: AF, BC, DE, HL, IX
040173             0294*   agnb_load_images:
040173 11 05 01 04 0295*       ld de,agnb_filename
040177 CD 22 01 04 0296*       call agnb_open
04017B C0          0297*       ret nz
04017C             0298*   
04017C CD 5E 02 04 0299*       call agnb_read_riff_header
040180 20 57       0300*       jr nz,@load_error
040182 CD 32 03 04 0301*       call agnb_read_vers
040186 20 51       0302*       jr nz,@load_error
040188             0303*   
040188             0304*   @next_record:
040188             0305*   ; End only at the exact declared RIFF boundary. A position beyond it is an
040188             0306*   ; internal bounds failure; a position before it must begin another LIST BUFR.
040188 3A DB 00 04 0307*       ld a,(agnb_state+agnb_state_file_offset+3)
04018C 21 CB 00 04 0308*       ld hl,agnb_state+agnb_state_riff_end+3
040190 BE          0309*       cp (hl)
040191 38 12       0310*       jr c,@read_record
040193 20 3E       0311*       jr nz,@bad_bounds
040195 2A D8 00 04 0312*       ld hl,(agnb_state+agnb_state_file_offset)
040199 ED 5B C8 00 0313*       ld de,(agnb_state+agnb_state_riff_end)
       04          
04019E B7          0314*       or a
04019F ED 52       0315*       sbc hl,de
0401A1 28 42       0316*       jr z,@success
0401A3 30 2E       0317*       jr nc,@bad_bounds
0401A5             0318*   
0401A5             0319*   @read_record:
0401A5 CD 9D 03 04 0320*       call agnb_read_buffer_list
0401A9 20 2E       0321*       jr nz,@load_error
0401AB CD BA 05 04 0322*       call agnb_stream_data
0401AF 20 28       0323*       jr nz,@load_error
0401B1 CD 5A 06 04 0324*       call agnb_finalize_image
0401B5 20 22       0325*       jr nz,@load_error
0401B7             0326*   
0401B7             0327*   ; TEMPORARY TRAVERSAL DIAGNOSTIC: display each image immediately after it is
0401B7             0328*   ; loaded and finalized, then wait for a key before parsing the next record.
0401B7             0329*   ; agnb_finalize_image leaves the current writer-specified buffer selected.
0401B7 CD 57 1A 04 0330*       call vdu_cls
0401BB 01 00 00 00 0331*       ld bc,0
0401BF 11 00 00 00 0332*       ld de,0
0401C3 CD B6 1A 04 0333*       call vdu_plot_bmp
0401C7 CD C0 1E 04 0334*       call DEBUG_WAITKEYPRESS
0401CB             0335*   
0401CB CD 83 06 04 0336*       call agnb_finish_buffer_list
0401CF 20 08       0337*       jr nz,@load_error
0401D1 18 B5       0338*       jr @next_record
0401D3             0339*   
0401D3             0340*   @bad_bounds:
0401D3 3E 08       0341*       ld a,agnb_error_bounds
0401D5 32 F7 00 04 0342*       ld (agnb_last_error),a
0401D9             0343*   @load_error:
0401D9             0344*   ; Preserve the parser/transport error while still closing the open file.
0401D9 F5          0345*       push af
0401DA CD 4C 01 04 0346*       call agnb_close
0401DE F1          0347*       pop af
0401DF 32 F7 00 04 0348*       ld (agnb_last_error),a
0401E3 B7          0349*       or a
0401E4 C9          0350*       ret
0401E5             0351*   
0401E5             0352*   @success:
0401E5 C3 4C 01 04 0353*       jp agnb_close
0401E9             0354*   
0401E9             0355*   ; Read exactly BC bytes from agnb_fil into DE.
0401E9             0356*   ; inputs:  BC = requested u24 length, DE = destination
0401E9             0357*   ; outputs: A=0 and Z set after the complete request is satisfied
0401E9             0358*   ;          nonzero error code and NZ set on FatFS error or premature EOF
0401E9             0359*   ;          state offset/count updated after every successful FatFS read
0401E9             0360*   ; destroys: BC, DE, HL
0401E9             0361*   agnb_read_exact:
0401E9             0362*   ; A zero-length request is already complete.
0401E9 21 00 00 00 0363*       ld hl,0
0401ED B7          0364*       or a
0401EE ED 42       0365*       sbc hl,bc
0401F0 28 62       0366*       jr z,@success
0401F2             0367*   
0401F2             0368*   @read:
0401F2             0369*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
0401F2             0370*   ; remaining request on the stack. It preserves DE, our current destination.
0401F2 C5          0371*       push bc
0401F3 21 A0 00 04 0372*       ld hl,agnb_fil
0401F7             0373*       FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
0401F7 FD E5       0001*M1 			PUSH IY
0401F9 3E 82       0002*M1 			LD	A, function
0401FB 5B CF       0003*M1 			RST.LIL	08h
0401FD FD E1       0004*M1 			POP IY
0401FF B7          0374*       or a
040200 20 40       0375*       jr nz,@fatfs_error
040202             0376*   
040202             0377*   ; Advance the u32 logical position by the returned u24 byte count.
040202 2A D8 00 04 0378*       ld hl,(agnb_state+agnb_state_file_offset)
040206 09          0379*       add hl,bc
040207 22 D8 00 04 0380*       ld (agnb_state+agnb_state_file_offset),hl
04020B 3A DB 00 04 0381*       ld a,(agnb_state+agnb_state_file_offset+3)
04020F CE 00       0382*       adc a,0
040211 38 34       0383*       jr c,@offset_overflow
040213 32 DB 00 04 0384*       ld (agnb_state+agnb_state_file_offset+3),a
040217             0385*   
040217             0386*   ; Retain the count returned by this individual FatFS read.
040217 ED 43 DC 00 0387*       ld (agnb_state+agnb_state_bytes_read),bc
       04          
04021C AF          0388*       xor a
04021D 32 DF 00 04 0389*       ld (agnb_state+agnb_state_bytes_read+3),a
040221             0390*   
040221             0391*   ; Recover the remaining request and reject zero bytes as premature EOF.
040221 E1          0392*       pop hl
040222 E5          0393*       push hl
040223 21 00 00 00 0394*       ld hl,0
040227 B7          0395*       or a
040228 ED 42       0396*       sbc hl,bc
04022A E1          0397*       pop hl
04022B 28 1F       0398*       jr z,@eof
04022D             0399*   
04022D             0400*   ; Subtract the returned count from the remaining request. FatFS must never
04022D             0401*   ; report more bytes than were requested.
04022D B7          0402*       or a
04022E ED 42       0403*       sbc hl,bc
040230 38 11       0404*       jr c,@read_error
040232             0405*   
040232             0406*   ; Advance the destination by the returned byte count.
040232 EB          0407*       ex de,hl
040233 09          0408*       add hl,bc
040234 EB          0409*       ex de,hl
040235             0410*   
040235             0411*   ; Continue after a short read, or return once the request is satisfied.
040235 01 00 00 00 0412*       ld bc,0
040239 B7          0413*       or a
04023A ED 42       0414*       sbc hl,bc
04023C 28 16       0415*       jr z,@success
04023E E5          0416*       push hl
04023F C1          0417*       pop bc
040240 18 B0       0418*       jr @read
040242             0419*   
040242             0420*   @fatfs_error:
040242 C1          0421*       pop bc
040243             0422*   @read_error:
040243 3E 02       0423*       ld a,agnb_error_read
040245 18 07       0424*       jr @error
040247             0425*   @offset_overflow:
040247 C1          0426*       pop bc
040248 3E 08       0427*       ld a,agnb_error_bounds
04024A 18 02       0428*       jr @error
04024C             0429*   @eof:
04024C 3E 0D       0430*       ld a,agnb_error_eof
04024E             0431*   @error:
04024E 32 F7 00 04 0432*       ld (agnb_last_error),a
040252 B7          0433*       or a
040253 C9          0434*       ret
040254             0435*   
040254             0436*   @success:
040254 AF          0437*       xor a
040255 32 F7 00 04 0438*       ld (agnb_last_error),a
040259 C9          0439*       ret
04025A             0440*   
04025A             0441*   ; Seek to a u32 absolute file offset.
04025A             0442*   ; inputs:  C = most-significant byte, DE = low 24 bits
04025A             0443*   ; outputs: agnb_state_file_offset updated on success
04025A             0444*   agnb_seek_absolute:
04025A C3 E2 06 04 0445*       jp agnb_not_implemented
04025E             0446*   
04025E             0447*   ; Read and validate RIFF size/form, establishing physical and RIFF bounds.
04025E             0448*   ; inputs:  agnb_fil is open and positioned at byte zero
04025E             0449*   ; outputs: A=0 and Z set on success; nonzero error code and NZ set on failure
04025E             0450*   ;          file size and RIFF end stored in agnb_state
04025E             0451*   ; destroys: BC, DE, HL
04025E             0452*   agnb_read_riff_header:
04025E             0453*   ; retain the physical u32 file size recorded by FatFS in the FIL object
04025E 2A AB 00 04 0454*       ld hl,(agnb_fil+fil_obj+ffobjid_objsize)
040262 22 C4 00 04 0455*       ld (agnb_state+agnb_state_file_size),hl
040266 3A AE 00 04 0456*       ld a,(agnb_fil+fil_obj+ffobjid_objsize+3)
04026A 32 C7 00 04 0457*       ld (agnb_state+agnb_state_file_size+3),a
04026E             0458*   
04026E             0459*   ; read the complete fixed-size RIFF header before inspecting any field
04026E 01 0C 00 00 0460*       ld bc,agnb_riff_header_size
040272 11 F9 00 04 0461*       ld de,agnb_header
040276 CD E9 01 04 0462*       call agnb_read_exact
04027A C0          0463*       ret nz
04027B             0464*   
04027B             0465*   ; validate the RIFF container identifier
04027B 21 F9 00 04 0466*       ld hl,agnb_header+agnb_riff_id
04027F 11 80 00 04 0467*       ld de,agnb_id_riff
040283 CD 11 01 04 0468*       call agnb_compare_fourcc
040287 20 43       0469*       jr nz,@bad_riff_id
040289             0470*   
040289             0471*   ; validate that this RIFF contains the AGNB form
040289 21 01 01 04 0472*       ld hl,agnb_header+agnb_riff_form
04028D 11 84 00 04 0473*       ld de,agnb_id_agnb
040291 CD 11 01 04 0474*       call agnb_compare_fourcc
040295 20 39       0475*       jr nz,@bad_riff_form
040297             0476*   
040297             0477*   ; RIFF stores file size minus eight. Add the omitted bytes as u32, using the
040297             0478*   ; native 24-bit ALU for the low three bytes and A for the high byte.
040297 2A FD 00 04 0479*       ld hl,(agnb_header+agnb_riff_size)
04029B 3A 00 01 04 0480*       ld a,(agnb_header+agnb_riff_size+3)
04029F 11 08 00 00 0481*       ld de,8
0402A3 19          0482*       add hl,de
0402A4 30 03       0483*       jr nc,@riff_end_ready
0402A6 3C          0484*       inc a
0402A7 28 2B       0485*       jr z,@bad_bounds             ; u32 addition overflowed
0402A9             0486*   @riff_end_ready:
0402A9 22 C8 00 04 0487*       ld (agnb_state+agnb_state_riff_end),hl
0402AD 32 CB 00 04 0488*       ld (agnb_state+agnb_state_riff_end+3),a
0402B1             0489*   
0402B1             0490*   ; Version 0.1 requires RIFF size to equal the physical file size minus eight.
0402B1 ED 5B C4 00 0491*       ld de,(agnb_state+agnb_state_file_size)
       04          
0402B6 B7          0492*       or a
0402B7 ED 52       0493*       sbc hl,de
0402B9 20 19       0494*       jr nz,@bad_bounds
0402BB 3A CB 00 04 0495*       ld a,(agnb_state+agnb_state_riff_end+3)
0402BF 21 C7 00 04 0496*       ld hl,agnb_state+agnb_state_file_size+3
0402C3 BE          0497*       cp (hl)
0402C4 20 0E       0498*       jr nz,@bad_bounds
0402C6             0499*   
0402C6             0500*   ; valid RIFF/AGNB header
0402C6 AF          0501*       xor a
0402C7 32 F7 00 04 0502*       ld (agnb_last_error),a
0402CB C9          0503*       ret
0402CC             0504*   
