041BD5             0135*   
041BD5             0136*   ; set bcd values in a scratch memory address from registers bcde
041BD5             0137*   ; input: hl; scratch address,bcde; 8-place bcd number
041BD5             0138*   ; destroys ; hl
041BD5             0139*   set_bcd:
041BD5 73          0140*       ld (hl),e
041BD6 23          0141*       inc hl
041BD7 72          0142*       ld (hl),d
041BD8 23          0143*       inc hl
041BD9 71          0144*       ld (hl),c
041BDA 23          0145*       inc hl
041BDB 70          0146*       ld (hl),b
041BDC C9          0147*       ret
041BDD             0148*   
041BDD             0149*   ; load bcd values from a scratch memory address to bcde
041BDD             0150*   ; input: hl; scratch address
041BDD             0151*   ; output: bcde; 8-place bcd number
041BDD             0152*   ; destroys: hl
041BDD             0153*   get_bcd:
041BDD 5E          0154*       ld e,(hl)
041BDE 23          0155*       inc hl
041BDF 56          0156*       ld d,(hl)
041BE0 23          0157*       inc hl
041BE1 4E          0158*       ld c,(hl)
041BE2 23          0159*       inc hl
041BE3 46          0160*       ld b,(hl)
041BE4 C9          0161*       ret
041BE5             0162*   
041BE5             0163*   ; BCD addition
041BE5             0164*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
041BE5             0165*   ;       a is the number of bytes holding each number (number of places/2)
041BE5             0166*   ; outputs: (hl) + (de) --> (hl)
041BE5             0167*   ; destroys: a,b,de,hl
041BE5             0168*   add_bcd:
041BE5 47          0169*       ld b,a ; loop counter
041BE6 AF          0170*       xor a ; reset a, clear carry flag
041BE7             0171*   adcec:
041BE7 1A          0172*       ld a,(de) ; addend to acc
041BE8 8E          0173*       adc a,(hl) ; add (hl) to acc
041BE9 27          0174*       daa ; adjust result to bcd
041BEA 77          0175*       ld (hl),a ; store result
041BEB 23          0176*       inc hl ; advance memory pointers
041BEC 13          0177*       inc de
041BED 10 F8       0178*       djnz adcec ; loop until b == 0
041BEF C9          0179*       ret
041BF0             0180*   
041BF0             0181*   ; BCD subtraction
041BF0             0182*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
041BF0             0183*   ;       a is the number of bytes holding each number (number of places/2)
041BF0             0184*   ; outputs: (hl) - (de) --> (hl)
041BF0             0185*   ; destroys: a,b,de,hl
041BF0             0186*   sub_bcd:
041BF0 47          0187*       ld b,a ; loop counter
041BF1 AF          0188*       xor a ; reset a,clear carry flag
041BF2             0189*   subdec:
041BF2 1A          0190*       ld a,(de) ; subtrahend to acc
041BF3 9E          0191*       sbc a,(hl) ; subtract (hl) from acc
041BF4 27          0192*       daa ; adjust result to bcd
041BF5 77          0193*       ld (hl),a ; store result
041BF6 23          0194*       inc hl ; advance memory pointers
041BF7 13          0195*       inc de
041BF8 10 F8       0196*       djnz subdec ; loop until b == 0
041BFA C9          0197*       ret
