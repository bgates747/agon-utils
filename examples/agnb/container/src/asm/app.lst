0402F0 CA 00 03 04 0066*       jp z,@Right
0402F4 ED 5B 8B 02 0067*       ld de,(current_image_index)
       04          
0402F9 13          0068*       inc de
0402FA ED 53 8B 02 0069*       ld (current_image_index),de
       04          
0402FF AF          0070*       xor a
