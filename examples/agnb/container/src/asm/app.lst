                       M1 Args: function=mos_sysvars 
041140 3E 08       0001*M1 			LD	A, function
041142 5B CF       0002*M1 			RST.LIL	08h
041144 DD 27 00    0367*       ld hl,(ix+sysvar_time)  ; get current time
041147 ED 5B 50 11 0368*       ld de,(stopwatch_started)            ; get start time
       04          
04114C AF          0369*       xor a                   ; clear carry
04114D ED 52       0370*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
04114F C9          0371*       ret
041150             0372*   
