041664             0262*   
041664             0263*   ; gets time remaining on a countdown timer
041664             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041664             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041664             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
041664             0267*   tmr_get:
