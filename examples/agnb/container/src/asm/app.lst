042046             0298*   ; u168_to_ascii: Converts an unsigned 16.8 fixed-point value in HL to an ASCII string.
042046             0299*   ; HL : Value to convert to string (integer part in H, fractional part in L)
042046             0300*   ; DE : Pointer to buffer, requires at least 11 bytes (8 digits, sign, decimal point, and null terminator)
042046             0301*   u168_to_ascii:
042046             0302*   ; add a leading space to make room for sign flag if needed
042046 3E 20       0303*       ld a,' '
042048 12          0304*       ld (de),a
042049 13          0305*       inc de
04204A             0306*   ; Convert integer part
04204A E5          0307*       push hl ; Save HL (we’ll need the fractional part later)
04204B             0308*       ; call hlu_udiv256 ; Shift to get integer portion in HL
04204B             0309*       SRL_UHL ; Shift to get integer portion in HL
                       M1 Args: none
04204B 3B          0001*M1     dec sp ; 1 cycle
04204C E5          0002*M1     push hl ; 4 cycles
04204D 33          0003*M1     inc sp ; 1 cycle
04204E E1          0004*M1     pop hl ; 4 cycles
04204F 23          0005*M1     inc hl ; 1 cycle
042050 52 2B       0006*M1     dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
042052             0007*M1     ; 13 cycles total
042052 01 F0 D8 FF 0310*       ld bc, -10000
042056 CD 79 20 04 0311*       call @one_int
04205A 01 18 FC FF 0312*       ld bc, -1000
04205E CD 79 20 04 0313*       call @one_int
042062 01 9C FF FF 0314*       ld bc, -100
042066 CD 79 20 04 0315*       call @one_int
04206A 0E F6       0316*       ld c, -10
04206C CD 79 20 04 0317*       call @one_int
042070 48          0318*       ld c, b
042071 CD 79 20 04 0319*       call @one_int
042075 C3 84 20 04 0320*       jp @frac ; Jump to fractional part conversion
042079             0321*   @one_int:
042079 3E 2F       0322*       ld a, '0' - 1 ; Start ASCII character at '0'
04207B             0323*   @divide_me:
04207B 3C          0324*       inc a
