041153             0374*   
041153             0375*   ; ------------------
041153             0376*   ; delay routine
041153             0377*   ; Author: Richard Turrnidge
041153             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
041153             0379*   ; routine waits a fixed time,then returns
041153             0380*   ; arrive with A =  the delay byte. One bit to be set only.
041153             0381*   ; eg. ld A,00000100b
041153             0382*   
041153             0383*   multiPurposeDelay:
       FF FF FF 
041153 F5          0384*       push af
041154 C5          0385*       push bc
041155 DD E5       0386*       push ix
041157 47          0387*       ld b,a
041158 3E 08       0388*       ld a,$08
04115A 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
04115C             0390*   
04115C             0391*   waitLoop:
04115C             0392*   
04115C DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04115F             0394*   
04115F             0395*                                   ;   we check if bit set is same as last time we checked.
04115F             0396*                                   ;   bit 0 - don't use
04115F             0397*                                   ;   bit 1 - changes 64 times per second
04115F             0398*                                   ;   bit 2 - changes 32 times per second
04115F             0399*                                   ;   bit 3 - changes 16 times per second
04115F             0400*   
04115F             0401*                                   ;   bit 4 - changes 8 times per second
04115F             0402*                                   ;   bit 5 - changes 4 times per second
04115F             0403*                                   ;   bit 6 - changes 2 times per second
04115F             0404*                                   ;   bit 7 - changes 1 times per second
04115F A0          0405*       and b
041160 4F          0406*       ld c,a
041161 3A 72 11 04 0407*       ld a,(oldTimeStamp)
041165 B9          0408*       cp c                        ; is A same as last value?
041166 28 F4       0409*       jr z,waitLoop              ; loop here if it is
041168 79          0410*       ld a,c
041169 32 72 11 04 0411*       ld (oldTimeStamp),a        ; set new value
04116D             0412*   
04116D DD E1       0413*       pop ix
04116F C1          0414*       pop bc
041170 F1          0415*       pop af
041171 C9          0416*       ret
041172             0417*   
041172 00          0418*   oldTimeStamp:   .db 00h
041173             0036        include "includes.inc"
041173             0001*   ; Routines selected from loose/src/asm/functions.inc
041173             0002*   ; Retained in their original source-file order.
041173             0003*   
041173             0004*   ; Print a zero-terminated string
041173             0005*   ; HL: Pointer to string
041173             0006*   printString:
041173 C5          0007*       PUSH BC
041174 01 00 00 00 0008*       LD BC,0
041178 3E 00       0009*       LD A,0
04117A 5B DF       0010*       RST.LIL 18h
04117C C1          0011*       POP BC
04117D C9          0012*       RET
04117E             0013*   
04117E             0014*   ; Prints the right justified decimal value in HL without leading zeroes
04117E             0015*   ; HL : Value to print
04117E             0016*   ; preserves all registers and flags
04117E             0017*   printDec:
04117E             0018*   ; BEGIN MY CODE
04117E             0019*   ; back up all the things
04117E F5          0020*       push af
04117F C5          0021*       push bc
041180 D5          0022*       push de
041181 E5          0023*       push hl
041182             0024*   ; END MY CODE
041182 11 AA 11 04 0025*       LD DE, _printDecBuffer
041186 CD BA 11 04 0026*       CALL u24_to_ascii
04118A             0027*   ; BEGIN MY CODE
04118A             0028*   ; replace leading zeroes with spaces
04118A 21 AA 11 04 0029*       LD HL, _printDecBuffer
04118E 06 07       0030*       ld B, 7 ; if HL was 0, we want to keep the final zero
041190             0031*   @loop:
041190 7E          0032*       LD A, (HL)
041191 FE 30       0033*       CP '0'
041193 C2 9D 11 04 0034*       JP NZ, @done
041197 3E 20       0035*       LD A, ' '
041199 77          0036*       LD (HL), A
04119A 23          0037*       INC HL
04119B             0038*       ; CALL vdu_cursor_forward
04119B 10 F3       0039*       DJNZ @loop
04119D             0040*   @done:
04119D             0041*   ; END MY CODE
04119D 21 AA 11 04 0042*       LD HL, _printDecBuffer
0411A1 CD 73 11 04 0043*       CALL printString
0411A5             0044*   ; BEGIN MY CODE
0411A5             0045*   ; restore all the things
0411A5 E1          0046*       pop hl
0411A6 D1          0047*       pop de
0411A7 C1          0048*       pop bc
0411A8 F1          0049*       pop af
0411A9             0050*   ; END MY CODE
0411A9 C9          0051*       RET
0411AA 00 00 00 00 0052*   _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0411BA             0053*   
0411BA             0054*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
0411BA             0055*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
0411BA             0056*   ; so it will allways be 8 characters length
0411BA             0057*   ; HL : Value to convert to string
0411BA             0058*   ; DE : pointer to buffer, at least 8 byte + 0
0411BA             0059*   u24_to_ascii:
0411BA 01 80 69 67 0060*       LD BC,-10000000
0411BE CD F1 11 04 0061*       CALL @one_digit
0411C2 01 C0 BD F0 0062*       LD BC,-1000000
0411C6 CD F1 11 04 0063*       CALL @one_digit
0411CA 01 60 79 FE 0064*       LD BC,-100000
0411CE CD F1 11 04 0065*       CALL @one_digit
0411D2 01 F0 D8 FF 0066*       LD BC,-10000
0411D6 CD F1 11 04 0067*       CALL @one_digit
0411DA 01 18 FC FF 0068*       LD BC,-1000
0411DE CD F1 11 04 0069*       CALL @one_digit
0411E2 01 9C FF FF 0070*       LD BC,-100
0411E6 CD F1 11 04 0071*       CALL @one_digit
0411EA 0E F6       0072*       LD C,-10
0411EC CD F1 11 04 0073*       CALL @one_digit
0411F0 48          0074*       LD C,B
0411F1             0075*   @one_digit:
0411F1 3E 2F       0076*       LD A,'0'-1
0411F3             0077*   @divide_me:
0411F3 3C          0078*       INC A
0411F4 09          0079*       ADD HL,BC
0411F5 38 FC       0080*       JR C,@divide_me
0411F7 ED 42       0081*       SBC HL,BC
0411F9 12          0082*       LD (DE),A
0411FA 13          0083*       INC DE
0411FB C9          0084*       RET
0411FC             0085*   
0411FC             0086*   
0411FC             0087*   ; Routines and constants selected from loose/src/asm/vdu.inc
0411FC             0088*   ; Retained in their original source-file order.
0411FC             0089*   
0411FC             0090*   ; &E8-&EF 	232-239 	Bitmap plot §
0411FC             0091*   plot_bmp: equ 0xE8
0411FC             0092*   ; 5 	Plot absolute in current foreground colour
0411FC             0093*   dr_abs_fg: equ 5
0411FC             0094*   
0411FC             0095*   cursor_on:
0411FC 21 07 12 04 0096*   	ld hl,@cmd
041200 01 03 00 00 0097*   	ld bc,@end-@cmd
041204 5B DF       0098*   	rst.lil $18
041206 C9          0099*   	ret
041207             0100*   @cmd:
041207 17 01 01    0101*   	db 23,1,1
04120A             0102*   @end:
04120A             0103*   
04120A             0104*   cursor_off:
04120A 21 15 12 04 0105*   	ld hl,@cmd
04120E 01 03 00 00 0106*   	ld bc,@end-@cmd
041212 5B DF       0107*   	rst.lil $18
041214 C9          0108*   	ret
041215             0109*   @cmd:
041215 17 01 00    0110*   	db 23,1,0
041218             0111*   @end:
041218             0112*   
041218             0113*   ; VDU 31, x, y: Move text cursor to x, y text position (TAB(x, y))
041218             0114*   ; inputs: c=x, b=y 8-bit unsigned integers
041218             0115*   vdu_move_cursor:
041218 ED 43 29 12 0116*       ld (@x0),bc
       04          
04121D 21 28 12 04 0117*   	ld hl,@cmd
041221 01 03 00 00 0118*   	ld bc,@end-@cmd
041225 5B DF       0119*   	rst.lil $18
041227 C9          0120*   	ret
041228 1F          0121*   @cmd: 	db 31
041229 00          0122*   @x0:	db 0
04122A 00          0123*   @y0: 	db 0
04122B 00          0124*   @end: 	db 0 ; padding
04122C             0125*   
04122C             0126*   ; VDU 12: Clear text area (CLS)
04122C             0127*   vdu_cls:
04122C 3E 0C       0128*       ld a,12
04122E 5B D7       0129*   	rst.lil $10
041230 C9          0130*   	ret
041231             0131*   
041231             0132*   vdu_set_screen_mode:
041231 32 41 12 04 0133*   	ld (@arg),a
041235 21 40 12 04 0134*   	ld hl,@cmd
041239 01 02 00 00 0135*   	ld bc,@end-@cmd
04123D 5B DF       0136*   	rst.lil $18
04123F C9          0137*   	ret
041240 16          0138*   @cmd: db 22 ; set screen mode
041241 00          0139*   @arg: db 0  ; screen mode parameter
041242             0140*   @end:
041242             0141*   
041242             0142*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041242             0143*   ; inputs: a is scaling mode, 1=on, 0=off
041242             0144*   ; note: default setting on boot is scaling ON
041242             0145*   vdu_set_scaling:
041242 32 54 12 04 0146*   	ld (@arg),a
041246 21 51 12 04 0147*   	ld hl,@cmd
04124A 01 04 00 00 0148*   	ld bc,@end-@cmd
04124E 5B DF       0149*   	rst.lil $18
041250 C9          0150*   	ret
041251 17 00 C0    0151*   @cmd: db 23,0,0xC0
041254 00          0152*   @arg: db 0  ; scaling on/off
041255             0153*   @end:
041255             0154*   
041255             0155*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041255             0156*   ; &E8-&EF 	232-239 	Bitmap plot §
041255             0157*   ; VDU 25, mode, x; y;: PLOT command
041255             0158*   ; inputs: bc=x0, de=y0
041255             0159*   ; prerequisites: vdu_buff_select
041255             0160*   vdu_plot_bmp:
041255 ED 43 6C 12 0161*       ld (@x0),bc
       04          
04125A ED 53 6E 12 0162*       ld (@y0),de
       04          
04125F 21 6A 12 04 0163*   	ld hl,@cmd
041263 01 06 00 00 0164*   	ld bc,@end-@cmd
041267 5B DF       0165*   	rst.lil $18
041269 C9          0166*   	ret
04126A 19          0167*   @cmd:   db 25
04126B ED          0168*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
04126C 00 00       0169*   @x0: 	dw 0x0000
04126E 00 00       0170*   @y0: 	dw 0x0000
041270 00          0171*   @end:   db 0x00 ; padding
041271             0037    
041271             0038    init:
041271             0039    ; set screen mode
041271             0040        ; ld a,0 ; 640x480x16 single-buffered
041271             0041        ; ld a,19 ; 1024x768x4 single-buffered
041271 3E 08       0042        ld a,8 ; 320x240x64 single-buffered
041273             0043        ; ld a,20 ; 512x384x64 single-buffered
041273             0044        ; ld a,23 ; 512x384x2 single-buffered
041273 CD 31 12 04 0045        call vdu_set_screen_mode
041277             0046    
041277             0047    ; set screen scaling and background colors
041277 21 85 12 04 0048        ld hl,@beg
04127B 01 09 00 00 0049        ld bc,@end-@beg
04127F 5B DF       0050        rst.lil $18
041281 C3 8E 12 04 0051        jp @end
041285             0052    @beg:
041285             0053    ;   VDU 23, 0, &C0, 0: Normal coordinates
041285 17 00 C0 00 0054        db 23,0,$C0,0
041289             0055    ;   VDU 17, color : set text background color
041289 11 8C       0056        db 17,12+128 ; blue
04128B             0057    ;   VDU 18, color : set gfx background color
04128B 12 00 8C    0058        db 18,0,12+128 ; blue
04128E             0059    @end:
04128E CD 0A 12 04 0060        call cursor_off
041292 CD 2C 12 04 0061        call vdu_cls
041296             0062    
041296             0063    ; initialize main loop timer
041296             0064    main_loop_timer_reset: equ 60 ; 120ths of a second
041296 21 3C 00 00 0065        ld hl,main_loop_timer_reset
04129A CD 12 11 04 0066        call tmr_main_loop_set
04129E             0067    
04129E CD 22 01 04 0068        call tmr_slideshow_set
0412A2             0069    
0412A2             0070    ; TODO: read container file and load all images
0412A2             0071    
0412A2 C9          0072        ret ; init
0412A3             0073    
0412A3             0074    main:
0412A3 11 00 00 00 0075        ld de, 0
0412A7 C3 C3 12 04 0076        jp rendbmp
0412AB             0077    
0412AB             0078    mainloop:
0412AB CD B2 00 04 0079        call reset_keys
0412AF             0080    
0412AF             0081    waitloop:
0412AF CD 97 00 04 0082        call set_keys
0412B3 CD 26 11 04 0083        call tmr_main_loop_get
0412B7 CA C2 00 04 0084        jp z, do_input
0412BB FA C2 00 04 0085        jp m, do_input
0412BF C3 AF 12 04 0086        jp waitloop
0412C3             0087    
0412C3             0088    rendbmp:
0412C3             0089    ; test de for wraparound
0412C3 21 00 00 00 0090        ld hl,0
0412C7 AF          0091        xor a ; clear carry
0412C8 ED 52       0092        sbc hl,de
0412CA CA DA 12 04 0093        jp z,@not_neg
0412CE FA DA 12 04 0094        jp m,@not_neg
0412D2 11 F8 00 00 0095        ld de,num_images-1
0412D6 C3 E9 12 04 0096        jp @load_image
0412DA             0097    @not_neg:
0412DA 21 F8 00 00 0098        ld hl,num_images-1
0412DE AF          0099        xor a ; clear carry
0412DF ED 52       0100        sbc hl,de
0412E1 F2 E9 12 04 0101        jp p,@load_image
0412E5 11 00 00 00 0102        ld de,0
0412E9             0103    @load_image:
0412E9 ED 53 84 00 0104        ld (current_image_index),de
       04          
0412EE 16 0F       0105        ld d,image_record_size
0412F0 ED 5C       0106        mlt de
0412F2 FD 21 48 01 0107        ld iy,image_list
       04          
0412F7 FD 19       0108        add iy,de
0412F9 FD 7E 00    0109        ld a,(iy+image_type) ; get image type
0412FC FD 07 03    0110        ld bc,(iy+image_width) ; get image width
0412FF FD 17 06    0111        ld de,(iy+image_height) ; get image height
041302 FD 31 09    0112        ld ix,(iy+image_filesize) ; get image file size
041305             0113    
041305             0114    ; TODO: implement here everything that vdu_load_img does,
041305             0115    ; except loading the image buffers from disk since that is already done in the container loader
041305             0116    
041305             0117    
041305             0118    ; plot image
041305 CD 2C 12 04 0119        call vdu_cls
041309 01 00 00 00 0120        ld bc,0 ; x
04130D 11 00 00 00 0121        ld de,0 ; y
041311 CD 55 12 04 0122        call vdu_plot_bmp
041315             0123    
041315             0124    no_move:
041315 21 3C 00 00 0125        ld hl,main_loop_timer_reset
041319 CD 12 11 04 0126        call tmr_main_loop_set
04131D C3 AB 12 04 0127        jp mainloop
041321             0128    
041321             0129    main_end:
041321             0130    ; exit program gracefully
041321 AF          0131        xor a ; 640x480x16 single-buffered
041322 CD 31 12 04 0132        call vdu_set_screen_mode
041326 3E 01       0133        ld a,1 ; scaling on
041328 CD 42 12 04 0134        call vdu_set_scaling
04132C CD FC 11 04 0135        call cursor_on
041330 C9          0136        ret
