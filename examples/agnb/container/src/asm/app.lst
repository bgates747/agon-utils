040080             0543*   ;
040080             0544*   ; FatFS structures
040080             0545*   ; These mirror the structures contained in src_fatfs/ff.h in the MOS project
040080             0546*   ;
040080             0547*   ; Object ID and allocation information (FFOBJID)
040080             0548*   ;
040080             0549*   ; Indexes into FFOBJID structure
040080             0550*   ffobjid_fs:			EQU	0	; 3: Pointer to the hosting volume of this object
040080             0551*   ffobjid_id:			EQU	3	; 2: Hosting volume mount ID
040080             0552*   ffobjid_attr:		EQU	5	; 1: Object attribute
040080             0553*   ffobjid_stat:		EQU	6	; 1: Object chain status (b1-0: =0:not contiguous, =2:contiguous, =3:fragmented in this session, b2:sub-directory stretched)
040080             0554*   ffobjid_sclust:		EQU	7	; 4: Object data start cluster (0:no cluster or root directory)
040080             0555*   ffobjid_objsize:	EQU	11	; 4: Object size (valid when sclust != 0)
040080             0556*   ;
040080             0557*   ; File object structure (FIL)
040080             0558*   ;
040080             0559*   ; Indexes into FIL structure
040080             0560*   fil_obj:		EQU 0	; 15: Object identifier
040080             0561*   fil_flag:		EQU	15 	;  1: File status flags
040080             0562*   fil_err:		EQU	16	;  1: Abort flag (error code)
040080             0563*   fil_fptr:		EQU	17	;  4: File read/write pointer (Zeroed on file open)
040080             0564*   fil_clust:		EQU	21	;  4: Current cluster of fpter (invalid when fptr is 0)
040080             0565*   fil_sect:		EQU	25	;  4: Sector number appearing in buf[] (0:invalid)
040080             0566*   fil_dir_sect:	EQU	29	;  4: Sector number containing the directory entry
040080             0567*   fil_dir_ptr:	EQU	33	;  3: Pointer to the directory entry in the win[]
040080             0568*   ;
040080             0569*   ; Directory object structure (DIR)
040080             0570*   ; Indexes into DIR structure
040080             0571*   dir_obj:		EQU  0	; 15: Object identifier
040080             0572*   dir_dptr:		EQU	15	;  4: Current read/write offset
040080             0573*   dir_clust:		EQU	19	;  4: Current cluster
040080             0574*   dir_sect:		EQU	23	;  4: Current sector (0:Read operation has terminated)
040080             0575*   dir_dir:		EQU	27	;  3: Pointer to the directory item in the win[]
040080             0576*   dir_fn:			EQU	30	; 12: SFN (in/out) {body[8],ext[3],status[1]}
040080             0577*   dir_blk_ofs:	EQU	42	;  4: Offset of current entry block being processed (0xFFFFFFFF:Invalid)
040080             0578*   ;
040080             0579*   ; File information structure (FILINFO)
040080             0580*   ;
040080             0581*   ; Indexes into FILINFO structure
040080             0582*   filinfo_fsize:		EQU 0	;   4: File size
040080             0583*   filinfo_fdate:		EQU	4	;   2: Modified date
040080             0584*   filinfo_ftime:		EQU	6	;   2: Modified time
040080             0585*   filinfo_fattrib:	EQU	8	;   1: File attribute
040080             0586*   filinfo_altname:	EQU	9	;  13: Alternative file name
040080             0587*   filinfo_fname:		EQU	22	; 256: Primary file name
040080             0033        include "macros.inc" ; needs to be above any other includes that use these macros
040080             0001*   
040080             0002*   ; test the sign of HL
040080             0003*   ; inputs: HL obviously
040080             0004*   ; outputs: sign flag set if HL is negative, zero flag set if HL is zero
040080             0005*   ; destroys: flags
040080             0006*       MACRO SIGN_UHL
040080             0007*       add hl,de ; 1 cycle
040080             0008*       or a ; clear flags ; 1 cycle
040080             0009*       sbc hl,de ; 2 cycles
040080             0010*       ; 4 cycles total
040080             0011*       ENDMACRO
040080             0012*   
040080             0013*   ; put the value in A into HLU
040080             0014*   ; affects: HLU
040080             0015*   ; destroys: nothing
040080             0016*   ; note: $ instead of @@ b/c anon labels deprecated in ez80asm
040080             0017*       MACRO A_TO_HLU
040080             0018*       xor a ; 1 cycle
040080             0019*       ld ($+8+1),hl ; 7 cycles
040080             0020*       ld ($+4+3),a ; 5 cycles
040080             0021*       ld hl,0x000000 ; 4 cycles
040080             0022*       ; 17 cycles total
040080             0023*       ENDMACRO
040080             0024*   
040080             0025*   ; alternative: https://discord.com/channels/1158535358624039014/1282290921815408681/1318315567102300220
040080             0026*   ; one cycle less but burns flags
040080             0027*       MACRO A_TO_HLU_ALT
040080             0028*       push hl ; 4 cycles
040080             0029*       ld hl,2 ; 4 cycles
040080             0030*       add hl,sp ; 1 cycle
040080             0031*       ld (hl),a ; 2 cycles
040080             0032*       pop hl ; 4 cycles
040080             0033*       ; 15 cycles total
040080             0034*       ENDMACRO
040080             0035*   
040080             0036*       MACRO hlu_mul256
040080             0037*       add hl,hl ; * 2
040080             0038*       add hl,hl ; * 4
040080             0039*       add hl,hl ; * 8
040080             0040*       add hl,hl ; * 16
040080             0041*       add hl,hl ; * 32
040080             0042*       add hl,hl ; * 64
040080             0043*       add hl,hl ; * 128
040080             0044*       add hl,hl ; * 256
040080             0045*       ENDMACRO
040080             0046*   
040080             0047*   ; https://discord.com/channels/1158535358624039014/1282290921815408681/1317793870070812715
040080             0048*       MACRO SRL_UHL
040080             0049*       dec sp ; 1 cycle
040080             0050*       push hl ; 4 cycles
040080             0051*       inc sp ; 1 cycle
040080             0052*       pop hl ; 4 cycles
040080             0053*       inc hl ; 1 cycle
040080             0054*       dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
040080             0055*       ; 13 cycles total
040080             0056*       ENDMACRO
040080             0057*   
040080             0058*       MACRO printChar char
040080             0059*       LD A, char
040080             0060*       RST.LIL 10h
040080             0061*       ENDMACRO
040080             0062*   
040080             0063*   ; Simulated call to subroutine at HL
040080             0064*   ; inputs: HL pointing to the subroutine address plus whatever the called function expects
040080             0065*   ; outputs: whatever the subroutine does, including HL and BC
040080             0066*   ; destroys: only what the subroutine does, but always BC
040080             0067*       MACRO CALL_HL
040080             0068*       ld bc,$+6 ; Address of first instruction after the jump
040080             0069*       push bc ; which constitutes the return address
040080             0070*       jp (hl) ; Jump to the address in HL
040080             0071*       ENDMACRO
040080             0072*   
040080             0073*   ; Simulated call to subroutine at IX
040080             0074*   ; inputs: IX pointing to the subroutine address plus whatever the called function expects
040080             0075*   ; outputs: whatever the subroutine does, including IX and BC
040080             0076*   ; destroys: only what the subroutine does, but always BC
040080             0077*       MACRO CALL_IX
040080             0078*       ld bc,$+6 ; Address of first instruction after the jump
040080             0079*       push bc ; which constitutes the return address
040080             0080*       jp (ix) ; Jump to the address in IX
040080             0081*       ENDMACRO
040080             0082*   
040080             0083*   ; Simulated call to soubroutinte at IY
040080             0084*   ; inputs: IY pointing to the subroutine address plus whatever the called function expects
040080             0085*   ; outputs: whatever the subroutine does, including IY and BC
040080             0086*   ; destroys: only what the subroutine does, but always BC
040080             0087*       MACRO CALL_IY
040080             0088*       ld bc,$+6 ; Address of first instruction after the jump
040080             0089*       push bc ; which constitutes the return address
040080             0090*       jp (iy) ; Jump to the address in IY
040080             0091*       ENDMACRO
040080             0092*   
040080             0093*   ; put the value in HLU into A
040080             0094*   ; destroys: af
040080             0095*       MACRO HLU_TO_A
040080             0096*       dec sp ; 1 cycle
040080             0097*       push hl ; 4 cycles
040080             0098*       inc sp ; 1 cycle
040080             0099*       pop af ; 4 cycles
040080             0100*       ; 10 cycles total
040080             0101*       ENDMACRO
040080             0102*   
040080             0103*       MACRO PUSH_ALL
040080             0104*       ex af,af'
040080             0105*       exx
040080             0106*       push af
040080             0107*       push hl
040080             0108*       push bc
040080             0109*       push de
040080             0110*   
040080             0111*       ex af,af'
040080             0112*       exx
040080             0113*       push af
040080             0114*       push hl
040080             0115*       push bc
040080             0116*       push de
040080             0117*       push ix
040080             0118*       push iy
040080             0119*       ENDMACRO
040080             0120*   
040080             0121*       MACRO POP_ALL
040080             0122*       pop iy
040080             0123*       pop ix
040080             0124*       pop de
040080             0125*       pop bc
040080             0126*       pop hl
040080             0127*       pop af
040080             0128*       ex af,af'
040080             0129*       exx
040080             0130*   
040080             0131*       pop de
040080             0132*       pop bc
040080             0133*       pop hl
040080             0134*       pop af
040080             0135*       ex af,af'
040080             0136*       exx
040080             0137*       ENDMACRO
040080             0138*   
040080             0139*       ; load hl with the 16-bit value at addr
040080             0140*       MACRO LD_HL_mn addr
040080             0141*       ld hl,(addr)
040080             0142*       dec hl
040080             0143*       inc.s hl ; zeros hlu
040080             0144*       ENDMACRO
040080             0145*   
040080             0146*       ; load bc with the 16-bit value at addr
040080             0147*       MACRO LD_BC_mn addr
040080             0148*       ld bc,(addr)
040080             0149*       dec bc
040080             0150*       inc.s bc ; zeros bcu
040080             0151*       ENDMACRO
040080             0152*   
040080             0153*       ; load de with the 16-bit value at addr
040080             0154*       MACRO LD_DE_mn addr
040080             0155*       ld de,(addr)
040080             0156*       dec de
040080             0157*       inc.s de ; zeros deu
040080             0158*       ENDMACRO
040080             0159*   
040080             0160*       ; load ix with the 16-bit value at addr
040080             0161*       MACRO LD_IX_mn addr
040080             0162*       ld ix,(addr)
040080             0163*       dec ix
040080             0164*       inc.s ix ; zeros ixu
040080             0165*       ENDMACRO
040080             0166*   
040080             0167*       ; load iy with the 16-bit value at addr
040080             0168*       MACRO LD_IY_mn addr
040080             0169*       ld iy,(addr)
040080             0170*       dec iy
040080             0171*       inc.s iy ; zeros iyu
040080             0172*       ENDMACRO
040080             0034        include "agnb.inc"
040080             0001*   ; AGNB 0.1 image-container layout
040080             0002*   ; ===============================
040080             0003*   ;
040080             0004*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
040080             0005*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
040080             0006*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
040080             0007*   ; The stored chunk size excludes its eight-byte header and alignment padding.
040080             0008*   ;
040080             0009*   ;     RIFF  u32(file size - 8)  AGNB
040080             0010*   ;       VERS  size=2
040080             0011*   ;         u8 major=0
040080             0012*   ;         u8 minor=1
040080             0013*   ;       LIST  type=BUFR
040080             0014*   ;         BHDR  size=2
040080             0015*   ;           u16 bufferId
040080             0016*   ;         IMAG  size=5
040080             0017*   ;           u16 width
040080             0018*   ;           u16 height
040080             0019*   ;           u8  format=1        ; RGBA2222
040080             0020*   ;         DATA  size=width*height
040080             0021*   ;           u8 pixels[]         ; row-major, no row padding
040080             0022*   ;
040080             0023*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
040080             0024*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
040080             0025*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
040080             0026*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
040080             0027*   ; reading or uploading DATA. Chunk traversal advances by:
040080             0028*   ;
040080             0029*   ;     8 + ((payload_size + 3) & ~3)
040080             0030*   ;
040080             0031*   ; The offsets below are indices from the beginning of the named header or
040080             0032*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
040080             0033*   ; 24-bit, so their high byte must not be silently discarded during validation.
040080             0034*   
040080             0035*   ; RIFF file header: "RIFF", u32 size, "AGNB"
040080             0036*   agnb_riff_id:              equ 0
040080             0037*   agnb_riff_size:            equ 4
040080             0038*   agnb_riff_form:            equ 8
040080             0039*   agnb_riff_header_size:     equ 12
040080             0040*   
040080             0041*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
040080             0042*   agnb_chunk_id:             equ 0
040080             0043*   agnb_chunk_size:           equ 4
040080             0044*   agnb_chunk_data:           equ 8
040080             0045*   agnb_chunk_header_size:    equ 8
040080             0046*   
040080             0047*   ; VERS payload
040080             0048*   agnb_vers_major:           equ 0
040080             0049*   agnb_vers_minor:           equ 1
040080             0050*   agnb_vers_payload_size:    equ 2
040080             0051*   
040080             0052*   ; LIST BUFR payload
040080             0053*   agnb_list_type:            equ 0
040080             0054*   agnb_list_chunks:          equ 4
040080             0055*   agnb_list_type_size:       equ 4
040080             0056*   
040080             0057*   ; BHDR payload
040080             0058*   agnb_bhdr_bufferId:        equ 0
040080             0059*   agnb_bhdr_payload_size:    equ 2
040080             0060*   
040080             0061*   ; IMAG payload
040080             0062*   agnb_imag_width:           equ 0
040080             0063*   agnb_imag_height:          equ 2
040080             0064*   agnb_imag_format:          equ 4
040080             0065*   agnb_imag_payload_size:    equ 5
040080             0066*   
040080             0067*   ; DATA payload
040080             0068*   agnb_data_pixels:          equ 0
040080             0069*   
040080             0070*   ; Values supported by the version 0.1 image loader
040080             0071*   agnb_version_major:        equ 0
040080             0072*   agnb_version_minor:        equ 1
040080             0073*   agnb_image_rgba2222:       equ 1
040080             0074*   
040080             0075*   
040080             0076*   ; FourCC constants
040080             0077*   ; ----------------
040080             0078*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
040080             0079*   ; compares one of these tables with four bytes read from the container.
040080             0080*   
040080 52 49 46 46 0081*   agnb_id_riff:              db "RIFF"
040084 41 47 4E 42 0082*   agnb_id_agnb:              db "AGNB"
040088 56 45 52 53 0083*   agnb_id_vers:              db "VERS"
04008C 4C 49 53 54 0084*   agnb_id_list:              db "LIST"
040090 42 55 46 52 0085*   agnb_id_bufr:              db "BUFR"
040094 42 48 44 52 0086*   agnb_id_bhdr:              db "BHDR"
040098 49 4D 41 47 0087*   agnb_id_imag:              db "IMAG"
04009C 44 41 54 41 0088*   agnb_id_data:              db "DATA"
0400A0             0089*   
0400A0             0090*   
0400A0             0091*   ; Reader result codes
0400A0             0092*   ; -------------------
0400A0             0093*   ; Public routines will return A=0 with Z set on success, or one of these
0400A0             0094*   ; nonzero values with NZ set on failure. The same value is stored in
0400A0             0095*   ; agnb_last_error.
0400A0             0096*   
0400A0             0097*   agnb_error_ok:             equ 0
0400A0             0098*   agnb_error_open:           equ 1
0400A0             0099*   agnb_error_read:           equ 2
0400A0             0100*   agnb_error_seek:           equ 3
0400A0             0101*   agnb_error_riff_id:        equ 4
0400A0             0102*   agnb_error_riff_form:      equ 5
0400A0             0103*   agnb_error_version:        equ 6
0400A0             0104*   agnb_error_chunk:          equ 7
0400A0             0105*   agnb_error_bounds:         equ 8
0400A0             0106*   agnb_error_bufferId:       equ 9
0400A0             0107*   agnb_error_metadata:       equ 10
0400A0             0108*   agnb_error_data_size:      equ 11
0400A0             0109*   agnb_error_vdp:            equ 12
0400A0             0110*   agnb_error_eof:            equ 13
0400A0             0111*   agnb_error_not_implemented: equ 255
0400A0             0112*   
0400A0             0113*   
0400A0             0114*   ; FatFS file structure
0400A0             0115*   ; --------------------
0400A0             0116*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
0400A0             0117*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
0400A0             0118*   ; the single known container filename.
0400A0             0119*   
0400A0             0120*   agnb_fil_size:             equ fil_dir_ptr+3
0400A0             0121*   agnb_fil:
0400A0 00 00 00 00 0122*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400C4             0123*   
0400C4             0124*   
0400C4             0125*   ; Reader-state structure
0400C4             0126*   ; ----------------------
0400C4             0127*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
0400C4             0128*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
0400C4             0129*   ; checks and FatFS seeks.
0400C4             0130*   
0400C4             0131*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
0400C4             0132*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
0400C4             0133*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
0400C4             0134*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
0400C4             0135*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
0400C4             0136*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
0400C4             0137*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
0400C4             0138*   agnb_state_size:           equ 28
0400C4             0139*   
0400C4             0140*   agnb_state:
0400C4 00 00 00 00 0141*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400E0             0142*   
0400E0             0143*   
0400E0             0144*   ; Normalized image metadata
0400E0             0145*   ; -------------------------
0400E0             0146*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
0400E0             0147*   
0400E0             0148*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
0400E0             0149*   agnb_meta_width:           equ 2  ; u16 pixels
0400E0             0150*   agnb_meta_height:          equ 4  ; u16 pixels
0400E0             0151*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
0400E0             0152*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
0400E0             0153*   agnb_meta_size:            equ 11
0400E0             0154*   
0400E0             0155*   agnb_metadata:
0400E0 00 00 00 00 0156*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
0400EB             0157*   
0400EB             0158*   ; Retained u32 result from agnb_calculate_image_data_size for validation and
0400EB             0159*   ; temporary test inspection. The high byte is zero for the 24-bit product.
0400EB             0160*   agnb_expected_data_size:
0400EB 00 00 00 00 0161*       blkb 4,0
0400EF             0162*   
0400EF             0163*   ; Working counters used by agnb_stream_data. DATA sizes accepted by the image
0400EF             0164*   ; loader have already been constrained to 24 bits.
0400EF             0165*   agnb_stream_remaining:
0400EF 00 00 00    0166*       blkb 3,0
0400F2             0167*   agnb_stream_block_size:
0400F2 00 00 00    0168*       blkb 3,0
0400F5             0169*   
0400F5             0170*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
0400F5             0171*   agnb_record_has_bhdr:      equ 0
0400F5             0172*   agnb_record_has_imag:      equ 1
0400F5             0173*   agnb_record_has_data:      equ 2
0400F5             0174*   
0400F5 00          0175*   agnb_record_flags:         db 0
0400F6 00          0176*   agnb_last_error:           db agnb_error_ok
0400F7 00          0177*   agnb_file_is_open:         db 0
0400F8             0178*   
0400F8             0179*   
0400F8             0180*   ; Reusable I/O storage
0400F8             0181*   ; --------------------
0400F8             0182*   ; The 12-byte buffer is large enough for either the RIFF file header or a
0400F8             0183*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
0400F8             0184*   ; the application's existing 8 KiB SRAM filedata area.
0400F8             0185*   
0400F8             0186*   agnb_header:
0400F8 00 00 00 00 0187*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
040104             0188*   
040104             0189*   agnb_io_buffer:            equ 0xB7E000 ; same onboard SRAM as app filedata
040104             0190*   agnb_io_buffer_size:       equ 8192
040104             0191*   
040104             0192*   agnb_filename:
040104 69 6D 61 67 0193*       asciz "images.agnb"
       65 73 2E 61 
       67 6E 62 00 
040110             0194*   
040110             0195*   
040110             0196*   ; Reader subroutine interface
040110             0197*   ; ---------------------------
040110             0198*   ; These labels establish the intended decomposition and calling contracts.
040110             0199*   ; They deliberately fail with agnb_error_not_implemented until replaced with
040110             0200*   ; real code, preventing an incomplete loader from reporting false success.
040110             0201*   
040110             0202*   ; Compare two FourCC values.
040110             0203*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
040110             0204*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
040110             0205*   ; preserves: BC, DE, HL
040110             0206*   ; destroys: A
040110             0207*   agnb_compare_fourcc:
040110 C5          0208*       push bc
040111 D5          0209*       push de
040112 E5          0210*       push hl
040113 06 04       0211*       ld b,4
040115             0212*   @loop:
040115 1A          0213*       ld a,(de)
040116 BE          0214*       cp (hl)
040117 20 04       0215*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
040119 13          0216*       inc de
04011A 23          0217*       inc hl
04011B 10 F8       0218*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
04011D             0219*   @done:
04011D E1          0220*       pop hl
04011E D1          0221*       pop de
04011F C1          0222*       pop bc
040120 C9          0223*       ret
040121             0224*   
040121             0225*   ; Open a container for reading.
040121             0226*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
040121             0227*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
040121             0228*   ;          agnb_fil initialized and agnb_file_is_open set on success
040121             0229*   ; destroys: AF, BC, HL
040121             0230*   agnb_open:
040121             0231*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
040121 AF          0232*       xor a
040122 32 F7 00 04 0233*       ld (agnb_file_is_open),a
040126 32 F6 00 04 0234*       ld (agnb_last_error),a
04012A             0235*   
04012A             0236*   ; open the caller-supplied filename into our single reader-owned FIL
04012A 21 A0 00 04 0237*       ld hl,agnb_fil
04012E 0E 01       0238*       ld c,fa_read
040130             0239*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
040130 FD E5       0001*M1 			PUSH IY
040132 3E 80       0002*M1 			LD	A, function
040134 5B CF       0003*M1 			RST.LIL	08h
040136 FD E1       0004*M1 			POP IY
040138 B7          0240*       or a
040139 20 08       0241*       jr nz,@error
04013B             0242*   
04013B             0243*   ; ffs_fopen succeeded
04013B 3E 01       0244*       ld a,1
04013D 32 F7 00 04 0245*       ld (agnb_file_is_open),a
040141 AF          0246*       xor a
040142 C9          0247*       ret
040143             0248*   
040143             0249*   @error:
040143 3E 01       0250*       ld a,agnb_error_open
040145 32 F6 00 04 0251*       ld (agnb_last_error),a
040149 B7          0252*       or a
04014A C9          0253*       ret
04014B             0254*   
04014B             0255*   ; Close agnb_fil if open and clear agnb_file_is_open.
04014B             0256*   ; outputs: A=0 and Z set if closed or already closed
04014B             0257*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
04014B             0258*   ; destroys: HL
04014B             0259*   agnb_close:
04014B             0260*   ; An unopened file is already in the requested state.
04014B 3A F7 00 04 0261*       ld a,(agnb_file_is_open)
04014F B7          0262*       or a
040150 28 14       0263*       jr z,@success
040152             0264*   
040152             0265*   ; Close our single reader-owned FIL.
040152 21 A0 00 04 0266*       ld hl,agnb_fil
040156             0267*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
040156 FD E5       0001*M1 			PUSH IY
040158 3E 81       0002*M1 			LD	A, function
04015A 5B CF       0003*M1 			RST.LIL	08h
04015C FD E1       0004*M1 			POP IY
04015E B7          0268*       or a
04015F 20 0B       0269*       jr nz,agnb_error_close
040161             0270*   
040161             0271*   ; Only clear the open flag after FatFS confirms the close.
040161 AF          0272*       xor a
040162 32 F7 00 04 0273*       ld (agnb_file_is_open),a
040166             0274*   @success:
040166 AF          0275*       xor a
040167 32 F6 00 04 0276*       ld (agnb_last_error),a
04016B C9          0277*       ret
04016C             0278*   
04016C             0279*   agnb_error_close:
04016C             0280*   ; Placeholder in case we determine that close failures need a dedicated AGNB
04016C             0281*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
04016C             0282*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
04016C 32 F6 00 04 0283*       ld (agnb_last_error),a
040170 B7          0284*       or a
040171 C9          0285*       ret
040172             0286*   
040172             0287*   ; Top-level image load operation.
040172             0288*   ; inputs:  none; uses agnb_filename
040172             0289*   ; outputs: all valid LIST BUFR image records uploaded to their explicit IDs
040172             0290*   agnb_load_images:
040172 C3 18 06 04 0291*       jp agnb_not_implemented
040176             0292*   
040176             0293*   ; Read exactly BC bytes from agnb_fil into DE.
040176             0294*   ; inputs:  BC = requested u24 length, DE = destination
040176             0295*   ; outputs: A=0 and Z set after the complete request is satisfied
040176             0296*   ;          nonzero error code and NZ set on FatFS error or premature EOF
040176             0297*   ;          state offset/count updated after every successful FatFS read
040176             0298*   ; destroys: BC, DE, HL
040176             0299*   agnb_read_exact:
040176             0300*   ; A zero-length request is already complete.
040176 21 00 00 00 0301*       ld hl,0
04017A B7          0302*       or a
04017B ED 42       0303*       sbc hl,bc
04017D 28 62       0304*       jr z,@success
04017F             0305*   
04017F             0306*   @read:
04017F             0307*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
04017F             0308*   ; remaining request on the stack. It preserves DE, our current destination.
04017F C5          0309*       push bc
040180 21 A0 00 04 0310*       ld hl,agnb_fil
040184             0311*       FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
040184 FD E5       0001*M1 			PUSH IY
040186 3E 82       0002*M1 			LD	A, function
040188 5B CF       0003*M1 			RST.LIL	08h
04018A FD E1       0004*M1 			POP IY
04018C B7          0312*       or a
04018D 20 40       0313*       jr nz,@fatfs_error
04018F             0314*   
04018F             0315*   ; Advance the u32 logical position by the returned u24 byte count.
04018F 2A D8 00 04 0316*       ld hl,(agnb_state+agnb_state_file_offset)
040193 09          0317*       add hl,bc
040194 22 D8 00 04 0318*       ld (agnb_state+agnb_state_file_offset),hl
040198 3A DB 00 04 0319*       ld a,(agnb_state+agnb_state_file_offset+3)
04019C CE 00       0320*       adc a,0
04019E 38 34       0321*       jr c,@offset_overflow
0401A0 32 DB 00 04 0322*       ld (agnb_state+agnb_state_file_offset+3),a
0401A4             0323*   
0401A4             0324*   ; Retain the count returned by this individual FatFS read.
0401A4 ED 43 DC 00 0325*       ld (agnb_state+agnb_state_bytes_read),bc
       04          
0401A9 AF          0326*       xor a
0401AA 32 DF 00 04 0327*       ld (agnb_state+agnb_state_bytes_read+3),a
0401AE             0328*   
0401AE             0329*   ; Recover the remaining request and reject zero bytes as premature EOF.
0401AE E1          0330*       pop hl
0401AF E5          0331*       push hl
0401B0 21 00 00 00 0332*       ld hl,0
0401B4 B7          0333*       or a
0401B5 ED 42       0334*       sbc hl,bc
0401B7 E1          0335*       pop hl
0401B8 28 1F       0336*       jr z,@eof
0401BA             0337*   
0401BA             0338*   ; Subtract the returned count from the remaining request. FatFS must never
0401BA             0339*   ; report more bytes than were requested.
0401BA B7          0340*       or a
0401BB ED 42       0341*       sbc hl,bc
0401BD 38 11       0342*       jr c,@read_error
0401BF             0343*   
0401BF             0344*   ; Advance the destination by the returned byte count.
0401BF EB          0345*       ex de,hl
0401C0 09          0346*       add hl,bc
0401C1 EB          0347*       ex de,hl
0401C2             0348*   
0401C2             0349*   ; Continue after a short read, or return once the request is satisfied.
0401C2 01 00 00 00 0350*       ld bc,0
0401C6 B7          0351*       or a
0401C7 ED 42       0352*       sbc hl,bc
0401C9 28 16       0353*       jr z,@success
0401CB E5          0354*       push hl
0401CC C1          0355*       pop bc
0401CD 18 B0       0356*       jr @read
0401CF             0357*   
0401CF             0358*   @fatfs_error:
0401CF C1          0359*       pop bc
0401D0             0360*   @read_error:
0401D0 3E 02       0361*       ld a,agnb_error_read
0401D2 18 07       0362*       jr @error
0401D4             0363*   @offset_overflow:
0401D4 C1          0364*       pop bc
0401D5 3E 08       0365*       ld a,agnb_error_bounds
0401D7 18 02       0366*       jr @error
0401D9             0367*   @eof:
0401D9 3E 0D       0368*       ld a,agnb_error_eof
0401DB             0369*   @error:
0401DB 32 F6 00 04 0370*       ld (agnb_last_error),a
0401DF B7          0371*       or a
0401E0 C9          0372*       ret
0401E1             0373*   
0401E1             0374*   @success:
0401E1 AF          0375*       xor a
0401E2 32 F6 00 04 0376*       ld (agnb_last_error),a
0401E6 C9          0377*       ret
0401E7             0378*   
0401E7             0379*   ; Seek to a u32 absolute file offset.
0401E7             0380*   ; inputs:  C = most-significant byte, DE = low 24 bits
0401E7             0381*   ; outputs: agnb_state_file_offset updated on success
0401E7             0382*   agnb_seek_absolute:
0401E7 C3 18 06 04 0383*       jp agnb_not_implemented
0401EB             0384*   
0401EB             0385*   ; Read and validate RIFF size/form, establishing physical and RIFF bounds.
0401EB             0386*   ; inputs:  agnb_fil is open and positioned at byte zero
0401EB             0387*   ; outputs: A=0 and Z set on success; nonzero error code and NZ set on failure
0401EB             0388*   ;          file size and RIFF end stored in agnb_state
0401EB             0389*   ; destroys: BC, DE, HL
0401EB             0390*   agnb_read_riff_header:
0401EB             0391*   ; retain the physical u32 file size recorded by FatFS in the FIL object
0401EB 2A AB 00 04 0392*       ld hl,(agnb_fil+fil_obj+ffobjid_objsize)
0401EF 22 C4 00 04 0393*       ld (agnb_state+agnb_state_file_size),hl
0401F3 3A AE 00 04 0394*       ld a,(agnb_fil+fil_obj+ffobjid_objsize+3)
0401F7 32 C7 00 04 0395*       ld (agnb_state+agnb_state_file_size+3),a
0401FB             0396*   
0401FB             0397*   ; read the complete fixed-size RIFF header before inspecting any field
0401FB 01 0C 00 00 0398*       ld bc,agnb_riff_header_size
0401FF 11 F8 00 04 0399*       ld de,agnb_header
040203 CD 76 01 04 0400*       call agnb_read_exact
040207 C0          0401*       ret nz
040208             0402*   
040208             0403*   ; validate the RIFF container identifier
040208 21 F8 00 04 0404*       ld hl,agnb_header+agnb_riff_id
04020C 11 80 00 04 0405*       ld de,agnb_id_riff
040210 CD 10 01 04 0406*       call agnb_compare_fourcc
040214 20 43       0407*       jr nz,@bad_riff_id
040216             0408*   
040216             0409*   ; validate that this RIFF contains the AGNB form
040216 21 00 01 04 0410*       ld hl,agnb_header+agnb_riff_form
04021A 11 84 00 04 0411*       ld de,agnb_id_agnb
04021E CD 10 01 04 0412*       call agnb_compare_fourcc
040222 20 39       0413*       jr nz,@bad_riff_form
040224             0414*   
040224             0415*   ; RIFF stores file size minus eight. Add the omitted bytes as u32, using the
040224             0416*   ; native 24-bit ALU for the low three bytes and A for the high byte.
040224 2A FC 00 04 0417*       ld hl,(agnb_header+agnb_riff_size)
040228 3A FF 00 04 0418*       ld a,(agnb_header+agnb_riff_size+3)
04022C 11 08 00 00 0419*       ld de,8
040230 19          0420*       add hl,de
040231 30 03       0421*       jr nc,@riff_end_ready
040233 3C          0422*       inc a
040234 28 2B       0423*       jr z,@bad_bounds             ; u32 addition overflowed
040236             0424*   @riff_end_ready:
040236 22 C8 00 04 0425*       ld (agnb_state+agnb_state_riff_end),hl
04023A 32 CB 00 04 0426*       ld (agnb_state+agnb_state_riff_end+3),a
04023E             0427*   
04023E             0428*   ; Version 0.1 requires RIFF size to equal the physical file size minus eight.
04023E ED 5B C4 00 0429*       ld de,(agnb_state+agnb_state_file_size)
       04          
040243 B7          0430*       or a
040244 ED 52       0431*       sbc hl,de
040246 20 19       0432*       jr nz,@bad_bounds
040248 3A CB 00 04 0433*       ld a,(agnb_state+agnb_state_riff_end+3)
04024C 21 C7 00 04 0434*       ld hl,agnb_state+agnb_state_file_size+3
040250 BE          0435*       cp (hl)
040251 20 0E       0436*       jr nz,@bad_bounds
040253             0437*   
040253             0438*   ; valid RIFF/AGNB header
040253 AF          0439*       xor a
040254 32 F6 00 04 0440*       ld (agnb_last_error),a
040258 C9          0441*       ret
040259             0442*   
040259             0443*   @bad_riff_id:
040259 3E 04       0444*       ld a,agnb_error_riff_id
04025B 18 06       0445*       jr @error
04025D             0446*   @bad_riff_form:
04025D 3E 05       0447*       ld a,agnb_error_riff_form
04025F 18 02       0448*       jr @error
040261             0449*   @bad_bounds:
040261 3E 08       0450*       ld a,agnb_error_bounds
040263             0451*   @error:
040263 32 F6 00 04 0452*       ld (agnb_last_error),a
040267 B7          0453*       or a
040268 C9          0454*       ret
040269             0455*   
040269             0456*   ; Read a generic eight-byte chunk header into agnb_header and compute its
040269             0457*   ; aligned payload end without crossing the active RIFF/LIST boundary.
040269             0458*   ; inputs:  IX = pointer to the enclosing u32 end offset
040269             0459*   ; outputs: chunk size/end stored in agnb_state; file positioned at payload
040269             0460*   ; destroys: AF, BC, DE, HL
040269             0461*   agnb_read_chunk_header:
040269 01 08 00 00 0462*       ld bc,agnb_chunk_header_size
04026D 11 F8 00 04 0463*       ld de,agnb_header
040271 CD 76 01 04 0464*       call agnb_read_exact
040275 C0          0465*       ret nz
040276             0466*   
040276             0467*   ; Retain the complete u32 payload size.
040276 2A FC 00 04 0468*       ld hl,(agnb_header+agnb_chunk_size)
04027A 22 D0 00 04 0469*       ld (agnb_state+agnb_state_chunk_size),hl
04027E 3A FF 00 04 0470*       ld a,(agnb_header+agnb_chunk_size+3)
040282 32 D3 00 04 0471*       ld (agnb_state+agnb_state_chunk_size+3),a
040286             0472*   
040286             0473*   ; The first byte after the payload is current file position + payload size.
040286 ED 5B D8 00 0474*       ld de,(agnb_state+agnb_state_file_offset)
       04          
04028B 19          0475*       add hl,de
04028C 22 D4 00 04 0476*       ld (agnb_state+agnb_state_chunk_end),hl
040290 3A FF 00 04 0477*       ld a,(agnb_header+agnb_chunk_size+3)
040294 47          0478*       ld b,a
040295 3A DB 00 04 0479*       ld a,(agnb_state+agnb_state_file_offset+3)
040299 88          0480*       adc a,b
04029A 38 15       0481*       jr c,@bad_bounds
04029C 32 D7 00 04 0482*       ld (agnb_state+agnb_state_chunk_end+3),a
0402A0             0483*   
0402A0             0484*   ; Reject a payload end beyond its enclosing RIFF or LIST boundary.
0402A0 DD BE 03    0485*       cp (ix+3)
0402A3 38 14       0486*       jr c,@success
0402A5 20 0A       0487*       jr nz,@bad_bounds
0402A7 DD 17 00    0488*       ld de,(ix)
0402AA B7          0489*       or a
0402AB ED 52       0490*       sbc hl,de
0402AD 38 0A       0491*       jr c,@success
0402AF 28 08       0492*       jr z,@success
0402B1             0493*   @bad_bounds:
0402B1 3E 08       0494*       ld a,agnb_error_bounds
0402B3 32 F6 00 04 0495*       ld (agnb_last_error),a
0402B7 B7          0496*       or a
0402B8 C9          0497*       ret
0402B9             0498*   @success:
0402B9 AF          0499*       xor a
0402BA 32 F6 00 04 0500*       ld (agnb_last_error),a
0402BE C9          0501*       ret
0402BF             0502*   
0402BF             0503*   ; Validate the single VERS payload and supported version.
