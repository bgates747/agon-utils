0412AE             0250*   ; ===============================================
0412AE             0251*   ; Timer functions
0412AE             0252*   ; -----------------------------------------------
0412AE             0253*   ; set a countdown timer
0412AE             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412AE             0255*   ; returns: hl = current time
0412AE             0256*   tmr_set:
0412AE FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
0412B1             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412B1 3E 08       0001*M1 			LD	A, function
0412B3 5B CF       0002*M1 			RST.LIL	08h
0412B5 DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
0412B8 FD 2F 00    0260*       ld (iy+0),hl            ; set start time
0412BB C9          0261*       ret
0412BC             0262*   
0412BC             0263*   ; gets time remaining on a countdown timer
0412BC             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412BC             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412BC             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412BC             0267*   tmr_get:
0412BC             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412BC 3E 08       0001*M1 			LD	A, function
0412BE 5B CF       0002*M1 			RST.LIL	08h
0412C0 DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
0412C3 FD 27 00    0270*       ld hl,(iy+0)            ; get start time
0412C6 AF          0271*       xor a                   ; clear carry
0412C7 ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412C9 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
0412CC AF          0274*       xor a                   ; clear carry
0412CD ED 5A       0275*       adc hl,de               ; hl = time remaining
0412CF             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412CF C9          0277*       ret
0412D0             0278*   
0412D0 00 00 00    0279*   timestamp_now: dl 0
0412D3 00 00 00    0280*   timestamp_old: dl 0
0412D6 00 00 00    0281*   timestamp_chg: dl 0
0412D9             0282*   
0412D9             0283*   ; update the global timestamp from the system clock
0412D9             0284*   ; inputs: none
0412D9             0285*   ; returns: hl = time elapsed in 1/120ths of a second
0412D9             0286*   ;          de = current time
0412D9             0287*   ;          ix = pointer to syvars table
0412D9             0288*   ; destroys: af,hl,de,ix
0412D9             0289*   timestamp_tick:
0412D9 ED 5B D0 12 0290*       ld de,(timestamp_now)   ; get previous time
       04          
0412DE ED 53 D3 12 0291*       ld (timestamp_old),de   ; save previous time
       04          
0412E3             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412E3 3E 08       0001*M1 			LD	A, function
0412E5 5B CF       0002*M1 			RST.LIL	08h
0412E7 DD 27 00    0293*       ld hl,(ix+sysvar_time)  ; get current time
0412EA 22 D0 12 04 0294*       ld (timestamp_now),hl   ; save current time
0412EE AF          0295*       xor a                   ; clear carry
0412EF ED 52       0296*       sbc hl,de               ; hl = time elapsed
0412F1 22 D6 12 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
0412F5 C9          0298*       ret
0412F6             0299*   
0412F6             0300*   ; set a countdown timer
0412F6             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412F6             0302*   ; requires: timestamp_tick to be called at least once before this function
0412F6             0303*   ; returns: hl = current time
0412F6             0304*   ; destroys: hl
0412F6             0305*   timestamp_tmr_set:
0412F6 FD 2F 03    0306*       ld (iy+3),hl            ; set time remaining
0412F9 2A D0 12 04 0307*       ld hl,(timestamp_now)   ; get current timestamp
0412FD FD 2F 00    0308*       ld (iy+0),hl            ; set start time
041300 C9          0309*       ret
041301             0310*   
041301             0311*   ; gets time remaining on a countdown timer following the global timestamp
041301             0312*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041301             0313*   ; requires: timestamp_tick to be called at least once before this function
041301             0314*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041301             0315*   ;          sign flags: pos = time not expired,zero or neg = time expired
041301             0316*   ; destroys: af,hl,de
041301             0317*   timestamp_tmr_get:
041301 ED 5B D0 12 0318*       ld de,(timestamp_now)   ; get current timestamp
       04          
041306 FD 27 00    0319*       ld hl,(iy+0)            ; get start time
041309 AF          0320*       xor a                   ; clear carry
04130A ED 52       0321*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
04130C FD 17 03    0322*       ld de,(iy+3)            ; get timer set value
04130F AF          0323*       xor a                   ; clear carry
041310 ED 5A       0324*       adc hl,de               ; hl = time remaining
041312             0325*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041312 C9          0326*       ret
041313             0327*   
041313             0328*   ; main loop timer functions
041313             0329*   tmr_main_loop: ds 6 ; buffer to hold main loop timer
041319             0330*   
041319             0331*   ; set a countdown timer for the main loop using the timestamp timer
041319             0332*   ; inputs: hl = time to set in 1/120ths of a second
041319             0333*   ; returns: hl = current time
041319             0334*   ; destroys: af,hl,de,ix,iy
041319             0335*   tmr_main_loop_set:
       FF FF FF FF 
       FF FF 
041319 FD 21 13 13 0336*       ld iy,tmr_main_loop
       04          
04131E FD 2F 03    0337*       ld (iy+3),hl ; set time remaining
041321 CD D9 12 04 0338*       call timestamp_tick
041325 2A D0 12 04 0339*       ld hl,(timestamp_now)   ; get current timestamp
041329 FD 2F 00    0340*       ld (iy+0),hl ; set start time
04132C C9          0341*       ret
04132D             0342*   
04132D             0343*   ; gets time remaining on the main loop countdown timer following the global timestamp
04132D             0344*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04132D             0345*   ;          sign flags: pos = time not expired,zero or neg = time expired
04132D             0346*   ; destroys: af,hl,de,ix,iy
04132D             0347*   tmr_main_loop_get:
