040060             0030*   
040060             0031*   ; VDP control (VDU 23, 0, n)
040060             0032*   ;
040060             0033*   vdp_gp:				EQU 80h
040060             0034*   vdp_keycode:		EQU 81h
040060             0035*   vdp_cursor:			EQU	82h
040060             0036*   vdp_scrchar:		EQU	83h
040060             0037*   vdp_scrpixel:		EQU	84h
040060             0038*   vdp_audio:			EQU	85h
040060             0039*   vdp_mode:			EQU	86h
040060             0040*   vdp_rtc:			EQU	87h
040060             0041*   vdp_keystate:		EQU	88h
040060             0042*   vdp_logicalcoords:	EQU	C0h
040060             0043*   vdp_terminalmode:	EQU	FFh
040060             0044*   
040060             0045*   ;
040060             0046*   ; Macro for calling the API
040060             0047*   ; Parameters:
040060             0048*   ; - function: One of the function numbers listed below
040060             0049*   ;
040060             0050*   	MACRO	MOSCALL	function
040060             0051*   			LD	A, function
040060             0052*   			RST.LIL	08h
040060             0053*   	ENDMACRO
040060             0054*   
040060             0055*   ;
040060             0056*   ; Same as above but keeps IY safe on FFS calls. This was added after some FFS
040060             0057*   ; functions unexpectedly destroyed IY in the emulator; that behavior may since
040060             0058*   ; have been fixed. TODO: test current emulator and hardware MOS builds, then
040060             0059*   ; remove this wrapper if unnecessary: PUSH/POP IY adds avoidable cycles and
040060             0060*   ; index-register stack operations are costlier than their GP-register forms.
040060             0061*   ; (Can be used for regular MOS calls as well.)
040060             0062*   ;
040060             0063*   	MACRO	FFSCALL	function
040060             0064*   			PUSH IY
040060             0065*   			LD	A, function
040060             0066*   			RST.LIL	08h
040060             0067*   			POP IY
040060             0068*   	ENDMACRO
040060             0069*   
040060             0070*   ; MOS high level functions
040060             0071*   ;
040060             0072*   ; Get keycode
040060             0073*   ; Returns:
040060             0074*   ;  A: ASCII code of key pressed, or 0 if no key pressed
040060             0075*   mos_getkey:			EQU	00h
040060             0076*   
040060             0077*   ; Load an area of memory from a file.
040060             0078*   ; HLU: Address of filename (zero terminated)
040060             0079*   ; DEU: Address at which to load
040060             0080*   ; BCU: Maximum allowed size (bytes)
040060             0081*   ; Returns:
040060             0082*   ; - A: File error, or 0 if OK
040060             0083*   ; - F: Carry reset indicates no room for file.
040060             0084*   mos_load:			EQU	01h
040060             0085*   
040060             0086*   ; Save a file to the SD card from RAM
040060             0087*   ; HLU: Address of filename (zero terminated)
040060             0088*   ; DEU: Address to save from
040060             0089*   ; BCU: Number of bytes to save
040060             0090*   ; Returns:
040060             0091*   ; - A: File error, or 0 if OK
040060             0092*   ; - F: Carry reset indicates no room for file
040060             0093*   mos_save:			EQU	02h
040060             0094*   
040060             0095*   ; Change directory
040060             0096*   ; HLU: Address of path (zero terminated)
040060             0097*   ; Returns:
040060             0098*   ; - A: File error, or 0 if OK
040060             0099*   mos_cd:				EQU	03h
040060             0100*   
040060             0101*   ; Directory listing
040060             0102*   ; HLU: Address of path (zero terminated)
040060             0103*   ; Returns:
040060             0104*   ; - A: File error, or 0 if OK
040060             0105*   mos_dir:			EQU	04h
040060             0106*   
040060             0107*   ; Delete a file from the SD card
040060             0108*   ; HLU: Address of filename (zero terminated)
040060             0109*   ; Returns:
040060             0110*   ; - A: File error, or 0 if OK
040060             0111*   mos_del:			EQU	05h
040060             0112*   
040060             0113*   ; Rename a file on the SD card
040060             0114*   ; HLU: Address of filename1 (zero terminated)
040060             0115*   ; DEU: Address of filename2 (zero terminated)
040060             0116*   ; Returns:
040060             0117*   ; - A: File error, or 0 if OK
040060             0118*   mos_ren:			EQU	06h
040060             0119*   
040060             0120*   ; Make a folder on the SD card
040060             0121*   ; HLU: Address of filename (zero terminated)
040060             0122*   ; Returns:
040060             0123*   ; - A: File error, or 0 if OK
040060             0124*   mos_mkdir:			EQU	07h
040060             0125*   
040060             0126*   ; Get a pointer to a system variable
040060             0127*   ; Returns:
040060             0128*   ; IXU: Pointer to system variables (see mos_api.asm for more details)
040060             0129*   mos_sysvars:		EQU	08h
040060             0130*   
040060             0131*   ; Invoke the line editor
040060             0132*   ; HLU: Address of the buffer
040060             0133*   ; BCU: Buffer length
040060             0134*   ;   E: 0 to not clear buffer, 1 to clear
040060             0135*   ; Returns:
040060             0136*   ;   A: Key that was used to exit the input loop (CR=13, ESC=27)
040060             0137*   mos_editline:		EQU	09h
040060             0138*   
040060             0139*   ; Open a file
040060             0140*   ; HLU: Filename
040060             0141*   ;   C: Mode
040060             0142*   ; Returns:
040060             0143*   ;   A: Filehandle, or 0 if couldn't open
040060             0144*   mos_fopen:			EQU	0Ah
040060             0145*   
040060             0146*   ; Close a file
040060             0147*   ;   C: Filehandle
040060             0148*   ; Returns
040060             0149*   ;   A: Number of files still open
040060             0150*   mos_fclose:			EQU	0Bh
040060             0151*   
040060             0152*   ; Get a character from a file
040060             0153*   ;   C: Filehandle
040060             0154*   ; Returns:
040060             0155*   ;   A: Character read
040060             0156*   ;   F: C set if last character in file, otherwise NC
040060             0157*   mos_fgetc:			EQU	0Ch
040060             0158*   
040060             0159*   ; Write a character to a file
040060             0160*   ;   C: Filehandle
040060             0161*   ;   B: Character to write
040060             0162*   mos_fputc:			EQU	0Dh
040060             0163*   
040060             0164*   ; Check whether we're at the end of the file
040060             0165*   ;   C: Filehandle
040060             0166*   ; Returns:
040060             0167*   ;   A: 1 if at end of file, otherwise 0
040060             0168*   mos_feof:			EQU	0Eh
040060             0169*   
040060             0170*   ; Copy an error message
040060             0171*   ;   E: The error code
040060             0172*   ; HLU: Address of buffer to copy message into
040060             0173*   ; BCU: Size of buffer
040060             0174*   mos_getError:		EQU	0Fh
040060             0175*   
040060             0176*   ; Execute a MOS command
040060             0177*   ; HLU: Pointer the the MOS command string
040060             0178*   ; DEU: Pointer to additional command structure
040060             0179*   ; BCU: Number of additional commands
040060             0180*   ; Returns:
040060             0181*   ;   A: MOS error code
040060             0182*   mos_oscli:			EQU	10h
040060             0183*   
040060             0184*   ; Copy a file on the SD card
040060             0185*   ; HLU: Address of filename1 (zero terminated)
040060             0186*   ; DEU: Address of filename2 (zero terminated)
040060             0187*   ; Returns:
040060             0188*   ; - A: File error, or 0 if OK
040060             0189*   mos_copy:			EQU	11h
040060             0190*   
040060             0191*   ; Fetch a RTC string
040060             0192*   ; HLU: Pointer to a buffer to copy the string to
040060             0193*   ; Returns:
040060             0194*   ;   A: Length of time
040060             0195*   mos_getrtc:			EQU	12h
040060             0196*   
040060             0197*   ; Set the RTC
040060             0198*   ; HLU: Pointer to a buffer with the time data in
040060             0199*   mos_setrtc:			EQU	13h
040060             0200*   
040060             0201*   ; Set an interrupt vector
040060             0202*   ; HLU: Pointer to the interrupt vector (24-bit pointer)
040060             0203*   ;   E: Vector # to set
040060             0204*   ; Returns:
040060             0205*   ; HLU: Pointer to the previous vector
040060             0206*   mos_setintvector:	EQU	14h
040060             0207*   
040060             0208*   ; Open UART1
040060             0209*   ; IXU: Pointer to UART struct
040060             0210*   ;	+0: Baud rate (24-bit, little endian)
040060             0211*   ;	+3: Data bits
040060             0212*   ;	+4: Stop bits
040060             0213*   ;	+5: Parity bits
040060             0214*   ;	+6: Flow control (0: None, 1: Hardware)
040060             0215*   ;	+7: Enabled interrupts
040060             0216*   ; Returns:
040060             0217*   ;   A: Error code (0 = no error)
040060             0218*   mos_uopen:			EQU	15h
040060             0219*   
040060             0220*   ; Close UART1
040060             0221*   mos_uclose:			EQU	16h
040060             0222*   
040060             0223*   ; Get a character from UART1
040060             0224*   ; Returns:
040060             0225*   ;   A: Character read
040060             0226*   ;   F: C if successful
040060             0227*   ;   F: NC if the UART is not open
040060             0228*   mos_ugetc:			EQU	17h
040060             0229*   
040060             0230*   ; Write a character to UART1
040060             0231*   ;   C: Character to write
040060             0232*   ; Returns:
040060             0233*   ;   F: C if successful
040060             0234*   ;   F: NC if the UART is not open
040060             0235*   mos_uputc:			EQU	18h
040060             0236*   
040060             0237*   ; Convert a file handle to a FIL structure pointer
040060             0238*   ;   C: Filehandle
040060             0239*   ; Returns:
040060             0240*   ; HLU: Pointer to a FIL struct
040060             0241*   mos_getfil:			EQU	19h
040060             0242*   
040060             0243*   ; Read a block of data from a file
040060             0244*   ;   C: Filehandle
040060             0245*   ; HLU: Pointer to where to write the data to
040060             0246*   ; DEU: Number of bytes to read
040060             0247*   ; Returns:
040060             0248*   ; DEU: Number of bytes read
040060             0249*   mos_fread:			EQU	1Ah
040060             0250*   
040060             0251*   ; Write a block of data to a file
040060             0252*   ;  C: Filehandle
040060             0253*   ; HLU: Pointer to where the data is
040060             0254*   ; DEU: Number of bytes to write
040060             0255*   ; Returns:
040060             0256*   ; DEU: Number of bytes read
040060             0257*   mos_fwrite:			EQU	1Bh
040060             0258*   
040060             0259*   ; Move the read/write pointer in a file
040060             0260*   ;   C: Filehandle
040060             0261*   ; HLU: Least significant 3 bytes of the offset from the start of the file (DWORD)
040060             0262*   ;   E: Most significant byte of the offset
040060             0263*   ; Returns:
040060             0264*   ;   A: FRESULT
040060             0265*   mos_flseek:			EQU	1Ch
040060             0266*   
040060             0267*   ; Move the read/write pointer in a file relative to the current position
040060             0268*   ;   C: Filehandle
040060             0269*   ; DEU: Signed 24-bit offset
040060             0270*   ; Returns:
040060             0271*   ;   A: FRESULT
040060             0272*   mos_api_flseek_rel:
040060 C5          0273*   	push bc ; back up file handle in c
040061 D5          0274*   	push de ; save offset
040062             0275*   	MOSCALL mos_getfil
                       M1 Args: function=mos_getfil 
040062 3E 19       0001*M1 			LD	A, function
040064 5B CF       0002*M1 			RST.LIL	08h
040066 E5          0276*   	push hl
040067 FD E1       0277*   	pop iy ; iy points to FIL struct
040069 FD 27 11    0278*   	ld hl,(iy+fil_fptr) ; get lowest 3 bytes of current position
04006C AF          0279*   	xor a ; clear carry
04006D D1          0280*   	pop de ; restore offset
04006E ED 5A       0281*   	adc hl,de ; adc the offset because we need sign flag
040070 F2 78 00 04 0282*   	jp p,@not_neg
040074 21 00 00 00 0283*   	ld hl,0 ; seek to beginning of file
040078             0284*   @not_neg:
040078 C1          0285*   	pop bc ; restore file handle to c
040079 1E 00       0286*   	ld e,0 ; highest byte of offset
04007B             0287*   	MOSCALL mos_flseek
                       M1 Args: function=mos_flseek 
04007B 3E 1C       0001*M1 			LD	A, function
04007D 5B CF       0002*M1 			RST.LIL	08h
04007F C9          0288*   	ret
040080             0289*   
040080             0290*   ; Set a VDP keyboard packet receiver callback
040080             0291*   ;   C: If non-zero then set the top byte of HLU(callback address)  to MB (for ADL=0 callers)
040080             0292*   ; HLU: Pointer to callback
040080             0293*   mos_setkbvector:	EQU	1Dh
040080             0294*   
040080             0295*   ; Get the address of the keyboard map
040080             0296*   ; Returns:
040080             0297*   ; IXU: Base address of the keymap
040080             0298*   mos_getkbmap:		EQU	1Eh
040080             0299*   
040080             0300*   ; MOS program exit codes
040080             0301*   ;
040080             0302*   EXIT_OK:				EQU  0;	"OK",
040080             0303*   EXIT_ERROR_SD_ACCESS:	EQU	 1;	"Error accessing SD card",
040080             0304*   EXIT_ERROR_ASSERTION:	EQU  2;	"Assertion failed",
040080             0305*   EXIT_SD_CARDFAILURE:	EQU  3;	"SD card failure",
040080             0306*   EXIT_FILENOTFOUND:		EQU  4;	"Could not find file",
040080             0307*   EXIT_PATHNOTFOUND:		EQU  5;	"Could not find path",
040080             0308*   EXIT_INVALIDPATHNAME:	EQU  6;	"Invalid path name",
040080             0309*   EXIT_ACCESSDENIED_FULL:	EQU  7;	"Access denied or directory full",
040080             0310*   EXIT_ACCESSDENIED:		EQU  8;	"Access denied",
040080             0311*   EXIT_INVALIDOBJECT:		EQU  9;	"Invalid file/directory object",
040080             0312*   EXIT_SD_WRITEPROTECTED:	EQU 10;	"SD card is write protected",
040080             0313*   EXIT_INVALIDDRIVENUMBER:EQU 11;	"Logical drive number is invalid",
040080             0314*   EXIT_NOVOLUMEWORKAREA:	EQU 12;	"Volume has no work area",
040080             0315*   EXIT_NOVALIDFATVOLUME:	EQU 13;	"No valid FAT volume",
040080             0316*   EXIT_ERRORMKFS:			EQU 14;	"Error occurred during mkfs",
040080             0317*   EXIT_VOLUMETIMEOUT:		EQU 15;	"Volume timeout",
040080             0318*   EXIT_VOLUMELOCKED:		EQU 16;	"Volume locked",
040080             0319*   EXIT_LFNALLOCATION:		EQU 17;	"LFN working buffer could not be allocated",
040080             0320*   EXIT_MAXOPENFILES:		EQU 18;	"Too many open files",
040080             0321*   EXIT_INVALIDPARAMETER:	EQU 19;	"Invalid parameter",
040080             0322*   EXIT_INVALIDCOMMAND:	EQU 20;	"Invalid command",
040080             0323*   EXIT_INVALIDEXECUTABLE:	EQU 21;	"Invalid executable",
040080             0324*   
040080             0325*   ; FatFS file access functions
040080             0326*   ;
040080             0327*   ; Open a file
040080             0328*   ; HLU: Pointer to a blank FIL struct
040080             0329*   ; DEU: Pointer to the filename (0 terminated)
040080             0330*   ;   C: File mode
040080             0331*   ; Returns:
040080             0332*   ;   A: FRESULT
040080             0333*   ffs_fopen:			EQU	80h
040080             0334*   
040080             0335*   ; Close a file
040080             0336*   ; HLU: Pointer to a blank FIL struct
040080             0337*   ; Returns:
040080             0338*   ;   A: FRESULT
040080             0339*   ffs_fclose:			EQU	81h
040080             0340*   
040080             0341*   ; Read data from a file
040080             0342*   ; HLU: Pointer to a FIL struct
040080             0343*   ; DEU: Pointer to where to write the file out
040080             0344*   ; BCU: Number of bytes to read
040080             0345*   ; Returns:
040080             0346*   ;   A: FRESULT
040080             0347*   ; BCU: Number of bytes read
040080             0348*   ffs_fread:			EQU	82h
040080             0349*   
040080             0350*   ; Write data to a file
040080             0351*   ; HLU: Pointer to a FIL struct
040080             0352*   ; DEU: Pointer to the data to write out
040080             0353*   ; BCU: Number of bytes to write
040080             0354*   ; Returns:
040080             0355*   ;   A: FRESULT
040080             0356*   ; BCU: Number of bytes written
040080             0357*   ffs_fwrite:			EQU	83h
040080             0358*   
040080             0359*   ; Move the read/write pointer in a file
040080             0360*   ; HLU: Pointer to a FIL struct
040080             0361*   ; DEU: Least significant 3 bytes of the offset from the start of the file (DWORD)
040080             0362*   ;   C: Most significant byte of the offset
040080             0363*   ; Returns:
040080             0364*   ;   A: FRESULT
040080             0365*   ffs_flseek:			EQU	84h
040080             0366*   
040080             0367*   ; not implemented
040080             0368*   ffs_ftruncate:		EQU	85h
040080             0369*   
040080             0370*   ; not implemented
040080             0371*   ffs_fsync:			EQU	86h
040080             0372*   
040080             0373*   ; not implemented
040080             0374*   ffs_fforward:		EQU	87h
040080             0375*   
040080             0376*   ; not implemented
040080             0377*   ffs_fexpand:		EQU	88h
040080             0378*   
040080             0379*   ; not implemented
040080             0380*   ffs_fgets:			EQU	89h
040080             0381*   
040080             0382*   ; not implemented
040080             0383*   ffs_fputc:			EQU	8Ah
040080             0384*   
040080             0385*   ; not implemented
040080             0386*   ffs_fputs:			EQU	8Bh
040080             0387*   
040080             0388*   ; not implemented
040080             0389*   ffs_fprintf:		EQU	8Ch
040080             0390*   
040080             0391*   ; not implemented
040080             0392*   ffs_ftell:			EQU	8Dh
040080             0393*   
040080             0394*   ; Check for EOF
040080             0395*   ; HLU: Pointer to a FILINFO struct
040080             0396*   ; Returns:
040080             0397*   ;   A: 1 if end of file, otherwise 0
040080             0398*   ffs_feof:			EQU	8Eh
040080             0399*   
040080             0400*   ; not implemented
040080             0401*   ffs_fsize:			EQU	8Fh
040080             0402*   
040080             0403*   ; not implemented
040080             0404*   ffs_ferror:			EQU	90h
040080             0405*   
040080             0406*   ; FatFS directory access functions
040080             0407*   ;
040080             0408*   ; Open a directory
040080             0409*   ; HLU: Pointer to a blank DIR struct
040080             0410*   ; DEU: Pointer to the directory path
040080             0411*   ; Returns:
040080             0412*   ; A: FRESULT
040080             0413*   ffs_dopen:			EQU	91h
040080             0414*   
040080             0415*   ; Close a directory
040080             0416*   ; HLU: Pointer to an open DIR struct
040080             0417*   ; Returns:
040080             0418*   ; A: FRESULT
040080             0419*   ffs_dclose:			EQU	92h
040080             0420*   
040080             0421*   ; Read the next FILINFO from an open DIR
040080             0422*   ; HLU: Pointer to an open DIR struct
040080             0423*   ; DEU: Pointer to an empty FILINFO struct
040080             0424*   ; Returns:
