041A53             0477*   ; #### new functions added by Brandon R. Gates ####
041A53             0478*   
041A53             0479*   ; print the binary representation of the 8-bit value in a
041A53             0480*   ; destroys a, hl, bc
041A53             0481*   printBin8:
041A53 06 08       0482*       ld b,8 ; loop counter for 8 bits
041A55 21 70 1A 04 0483*       ld hl,@cmd ; set hl to the low byte of the output string
041A59             0484*       ; (which will be the high bit of the value in a)
041A59             0485*   @loop:
041A59 07          0486*       rlca ; put the next highest bit into carry
041A5A 38 04       0487*       jr c,@one
041A5C 36 30       0488*       ld (hl),'0'
041A5E 18 02       0489*       jr @next_bit
041A60             0490*   @one:
041A60 36 31       0491*       ld (hl),'1'
041A62             0492*   @next_bit:
041A62 23          0493*       inc hl
041A63 10 F4       0494*       djnz @loop
041A65             0495*   ; print it
041A65 21 70 1A 04 0496*       ld hl,@cmd
041A69 01 08 00 00 0497*       ld bc,@end-@cmd
041A6D 5B DF       0498*       rst.lil $18
041A6F C9          0499*       ret
041A70             0500*   @cmd: ds 8 ; eight bytes for eight bits
041A78             0501*   @end:
041A78             0502*   
041A78             0503*   ; print the binary representation of the 8-bit value in a
041A78             0504*   ; in reverse order (lsb first)
041A78             0505*   ; destroys a, hl, bc
041A78             0506*   printBin8Rev:
       FF FF FF FF 
       FF FF FF FF 
041A78 06 08       0507*       ld b,8 ; loop counter for 8 bits
041A7A 21 95 1A 04 0508*       ld hl,@cmd ; set hl to the low byte of the output string
041A7E             0509*       ; (which will be the high bit of the value in a)
041A7E             0510*   @loop:
041A7E 0F          0511*       rrca ; put the next lowest bit into carry
041A7F 38 04       0512*       jr c,@one
041A81 36 30       0513*       ld (hl),'0'
041A83 18 02       0514*       jr @next_bit
041A85             0515*   @one:
041A85 36 31       0516*       ld (hl),'1'
041A87             0517*   @next_bit:
041A87 23          0518*       inc hl
041A88 10 F4       0519*       djnz @loop
041A8A             0520*   ; print it
041A8A 21 95 1A 04 0521*       ld hl,@cmd
041A8E 01 08 00 00 0522*       ld bc,@end-@cmd
041A92 5B DF       0523*       rst.lil $18
041A94 C9          0524*       ret
