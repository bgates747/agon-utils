041C51             0001*   ; Print a zero-terminated string inline with code, e.g.:
041C51             0002*   ;
041C51             0003*   ;    call printInline
041C51             0004*   ;    ASCIZ "Hello, world!\r\n"
041C51             0005*   ;
041C51             0006*   ; Destroys: HL,AF
041C51             0007*   printInline:
041C51 E1          0008*       pop hl ; get the return address = pointer to start of string
041C52 CD 22 17 04 0009*       call printString ; HL advances to end of string
041C56 E5          0010*       push hl ; restore the return address = pointer to end of string
041C57 C9          0011*       ret
041C58             0012*   
041C58             0013*   ; Print a zero-terminated string
041C58             0014*   ; IX: Pointer to string, A: signed offset from IX
041C58             0015*   printStringIX:
041C58             0016*   
041C58             0017*   ; https://github.com/envenomator/Agon/blob/master/ez80asm%20examples%20(annotated)/functions.s
041C58             0018*   ; Print a zero-terminated string
041C58             0019*   ; HL: Pointer to string
041C58             0020*   ; returns: hl pointed to character after string terminator
041C58             0021*   ; destroys: af, hl
041C58             0022*   ; printString:
041C58             0023*   ;     PUSH BC
041C58             0024*   ;     LD BC,0
041C58             0025*   ;     LD A,0
041C58             0026*   ;     RST.LIL 18h
041C58             0027*   ;     POP BC
041C58             0028*   ;     RET
041C58             0029*   ; print a VDU sequence
041C58             0030*   ; HL: Pointer to VDU sequence - <1 byte length> <data>
041C58             0031*   sendVDUsequence:
041C58 C5          0032*       PUSH BC
041C59 01 00 00 00 0033*       LD BC, 0
041C5D 4E          0034*       LD C, (HL)
041C5E 5B DF       0035*       RST.LIL 18h
041C60 C1          0036*       POP BC
041C61 C9          0037*       RET
041C62             0038*   ; Print Newline sequence to VDP
