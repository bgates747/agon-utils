04050B 2B          0758*       dec hl
04050C 52 23       0759*       inc.s hl ; undocumented: preserves HL and clears HLU
04050E EB          0760*       ex de,hl
04050F 2A E2 00 04 0761*       ld hl,(agnb_metadata+agnb_meta_width)
040513 2B          0762*       dec hl
040514 52 23       0763*       inc.s hl ; undocumented: preserves HL and clears HLU
040516 CD C8 20 04 0764*       call umul24
04051A 22 EB 00 04 0765*       ld (agnb_expected_data_size),hl
