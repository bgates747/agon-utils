0422E3             0163*   ; BCD addition
0422E3             0164*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
0422E3             0165*   ;       a is the number of bytes holding each number (number of places/2)
0422E3             0166*   ; outputs: (hl) + (de) --> (hl)
0422E3             0167*   ; destroys: a,b,de,hl
0422E3             0168*   add_bcd:
0422E3 47          0169*       ld b,a ; loop counter
0422E4 AF          0170*       xor a ; reset a, clear carry flag
0422E5             0171*   adcec:
0422E5 1A          0172*       ld a,(de) ; addend to acc
0422E6 8E          0173*       adc a,(hl) ; add (hl) to acc
0422E7 27          0174*       daa ; adjust result to bcd
0422E8 77          0175*       ld (hl),a ; store result
0422E9 23          0176*       inc hl ; advance memory pointers
0422EA 13          0177*       inc de
0422EB 10 F8       0178*       djnz adcec ; loop until b == 0
0422ED C9          0179*       ret
0422EE             0180*   
0422EE             0181*   ; BCD subtraction
0422EE             0182*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
0422EE             0183*   ;       a is the number of bytes holding each number (number of places/2)
0422EE             0184*   ; outputs: (hl) - (de) --> (hl)
0422EE             0185*   ; destroys: a,b,de,hl
0422EE             0186*   sub_bcd:
0422EE 47          0187*       ld b,a ; loop counter
0422EF AF          0188*       xor a ; reset a,clear carry flag
0422F0             0189*   subdec:
0422F0 1A          0190*       ld a,(de) ; subtrahend to acc
0422F1 9E          0191*       sbc a,(hl) ; subtract (hl) from acc
0422F2 27          0192*       daa ; adjust result to bcd
0422F3 77          0193*       ld (hl),a ; store result
0422F4 23          0194*       inc hl ; advance memory pointers
0422F5 13          0195*       inc de
0422F6 10 F8       0196*       djnz subdec ; loop until b == 0
0422F8 C9          0197*       ret
