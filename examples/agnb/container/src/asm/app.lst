0410A7             0251*   ; Timer functions
0410A7             0252*   ; -----------------------------------------------
0410A7             0253*   ; set a countdown timer
0410A7             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0410A7             0255*   ; returns: hl = current time
0410A7             0256*   tmr_set:
0410A7 FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
0410AA             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0410AA 3E 08       0001*M1 			LD	A, function
0410AC 5B CF       0002*M1 			RST.LIL	08h
0410AE DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
0410B1 FD 2F 00    0260*       ld (iy+0),hl            ; set start time
0410B4 C9          0261*       ret
0410B5             0262*   
0410B5             0263*   ; gets time remaining on a countdown timer
0410B5             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0410B5             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0410B5             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
0410B5             0267*   tmr_get:
0410B5             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0410B5 3E 08       0001*M1 			LD	A, function
0410B7 5B CF       0002*M1 			RST.LIL	08h
0410B9 DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
0410BC FD 27 00    0270*       ld hl,(iy+0)            ; get start time
0410BF AF          0271*       xor a                   ; clear carry
0410C0 ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0410C2 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
0410C5 AF          0274*       xor a                   ; clear carry
0410C6 ED 5A       0275*       adc hl,de               ; hl = time remaining
0410C8             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0410C8 C9          0277*       ret
0410C9             0278*   
0410C9 00 00 00    0279*   timestamp_now: dl 0
0410CC 00 00 00    0280*   timestamp_old: dl 0
0410CF 00 00 00    0281*   timestamp_chg: dl 0
0410D2             0282*   
0410D2             0283*   ; update the global timestamp from the system clock
0410D2             0284*   ; inputs: none
0410D2             0285*   ; returns: hl = time elapsed in 1/120ths of a second
0410D2             0286*   ;          de = current time
0410D2             0287*   ;          ix = pointer to syvars table
0410D2             0288*   ; destroys: af,hl,de,ix
0410D2             0289*   timestamp_tick:
0410D2 ED 5B C9 10 0290*       ld de,(timestamp_now)   ; get previous time
       04          
0410D7 ED 53 CC 10 0291*       ld (timestamp_old),de   ; save previous time
       04          
0410DC             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0410DC 3E 08       0001*M1 			LD	A, function
0410DE 5B CF       0002*M1 			RST.LIL	08h
0410E0 DD 27 00    0293*       ld hl,(ix+sysvar_time)  ; get current time
0410E3 22 C9 10 04 0294*       ld (timestamp_now),hl   ; save current time
0410E7 AF          0295*       xor a                   ; clear carry
0410E8 ED 52       0296*       sbc hl,de               ; hl = time elapsed
0410EA 22 CF 10 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
0410EE C9          0298*       ret
0410EF             0299*   
0410EF             0300*   ; set a countdown timer
0410EF             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0410EF             0302*   ; requires: timestamp_tick to be called at least once before this function
0410EF             0303*   ; returns: hl = current time
0410EF             0304*   ; destroys: hl
0410EF             0305*   timestamp_tmr_set:
0410EF FD 2F 03    0306*       ld (iy+3),hl            ; set time remaining
0410F2 2A C9 10 04 0307*       ld hl,(timestamp_now)   ; get current timestamp
0410F6 FD 2F 00    0308*       ld (iy+0),hl            ; set start time
0410F9 C9          0309*       ret
0410FA             0310*   
0410FA             0311*   ; gets time remaining on a countdown timer following the global timestamp
0410FA             0312*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0410FA             0313*   ; requires: timestamp_tick to be called at least once before this function
0410FA             0314*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0410FA             0315*   ;          sign flags: pos = time not expired,zero or neg = time expired
0410FA             0316*   ; destroys: af,hl,de
0410FA             0317*   timestamp_tmr_get:
0410FA ED 5B C9 10 0318*       ld de,(timestamp_now)   ; get current timestamp
       04          
0410FF FD 27 00    0319*       ld hl,(iy+0)            ; get start time
041102 AF          0320*       xor a                   ; clear carry
041103 ED 52       0321*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041105 FD 17 03    0322*       ld de,(iy+3)            ; get timer set value
041108 AF          0323*       xor a                   ; clear carry
041109 ED 5A       0324*       adc hl,de               ; hl = time remaining
04110B             0325*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04110B C9          0326*       ret
04110C             0327*   
04110C             0328*   ; main loop timer functions
04110C             0329*   tmr_main_loop: ds 6 ; buffer to hold main loop timer
041112             0330*   
041112             0331*   ; set a countdown timer for the main loop using the timestamp timer
041112             0332*   ; inputs: hl = time to set in 1/120ths of a second
041112             0333*   ; returns: hl = current time
041112             0334*   ; destroys: af,hl,de,ix,iy
041112             0335*   tmr_main_loop_set:
       FF FF FF FF 
       FF FF 
041112 FD 21 0C 11 0336*       ld iy,tmr_main_loop
       04          
041117 FD 2F 03    0337*       ld (iy+3),hl ; set time remaining
04111A CD D2 10 04 0338*       call timestamp_tick
04111E 2A C9 10 04 0339*       ld hl,(timestamp_now)   ; get current timestamp
041122 FD 2F 00    0340*       ld (iy+0),hl ; set start time
041125 C9          0341*       ret
041126             0342*   
041126             0343*   ; gets time remaining on the main loop countdown timer following the global timestamp
041126             0344*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041126             0345*   ;          sign flags: pos = time not expired,zero or neg = time expired
041126             0346*   ; destroys: af,hl,de,ix,iy
041126             0347*   tmr_main_loop_get:
041126 CD D2 10 04 0348*       call timestamp_tick
04112A FD 21 0C 11 0349*       ld iy,tmr_main_loop
       04          
