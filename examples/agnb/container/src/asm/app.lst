041BA3             0080*       SIGN_UHL
                       M1 Args: none
041BA3 19          0001*M1     add hl,de ; 1 cycle
041BA4 B7          0002*M1     or a ; clear flags ; 1 cycle
041BA5 ED 52       0003*M1     sbc hl,de ; 2 cycles
041BA7             0004*M1     ; 4 cycles total
041BA7 F2 AC 1B 04 0081*       jp p,@hl_pos
041BAB 3D          0082*       dec a
041BAC             0083*   @hl_pos:
041BAC 32 B8 1B 04 0084*       ld (@buffer+3),a
041BB0 2A B6 1B 04 0085*       ld hl,(@buffer+1)
