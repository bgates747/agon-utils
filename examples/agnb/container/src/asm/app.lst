040320             0085*   ; slideshow timer routines
040320             0086*   tmr_slideshow: ds 6 ; buffer to hold slideshow timer
       FF FF FF FF 
       FF FF 
040326 01 00 00    0087*   tmr_slideshow_reset: dl 1; 1*120
040329             0088*   
040329             0089*   ; set a countdown timer for the slideshow using the timestamp timer
040329             0090*   ; returns: hl = current time
040329             0091*   ; destroys: af,hl,de,ix,iy
040329             0092*   tmr_slideshow_set:
040329 FD 21 20 03 0093*       ld iy,tmr_slideshow
       04          
04032E 2A 26 03 04 0094*       ld hl,(tmr_slideshow_reset)
040332 FD 2F 03    0095*       ld (iy+3),hl ; set time remaining
040335 CD D9 12 04 0096*       call timestamp_tick
040339 2A D0 12 04 0097*       ld hl,(timestamp_now)   ; get current timestamp
04033D FD 2F 00    0098*       ld (iy+0),hl ; set start time
040340 C9          0099*       ret
040341             0100*   
040341             0101*   ; gets time remaining on the slideshow countdown timer following the global timestamp
040341             0102*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
040341             0103*   ;          sign flags: pos = time not expired,zero or neg = time expired
040341             0104*   ; destroys: af,hl,de,ix,iy
040341             0105*   tmr_slideshow_get:
040341 CD D9 12 04 0106*       call timestamp_tick
040345 FD 21 20 03 0107*       ld iy,tmr_slideshow
       04          
04034A CD 01 13 04 0108*       call timestamp_tmr_get
04034E C9          0109*       ret
