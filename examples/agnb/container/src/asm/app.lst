041C99             0124*   ; Prints the right justified decimal value in HL without leading zeroes
041C99             0125*   ; HL : Value to print
041C99             0126*   ; preserves all registers and flags
041C99             0127*   ; printDec:
041C99             0128*   ; ; back up all the things
041C99             0129*   ;     push af
041C99             0130*   ;     push bc
041C99             0131*   ;     push de
041C99             0132*   ;     push hl
041C99             0133*   ;     LD DE, _printDecBuffer
041C99             0134*   ;     CALL u24_to_ascii
041C99             0135*   ; ; replace leading zeroes with spaces
041C99             0136*   ;     LD HL, _printDecBuffer
041C99             0137*   ;     ld B, 7 ; if HL was 0, we want to keep the final zero
041C99             0138*   ; @loop:
041C99             0139*   ;     LD A, (HL)
041C99             0140*   ;     CP '0'
041C99             0141*   ;     JP NZ, @done
041C99             0142*   ;     LD A, ' '
041C99             0143*   ;     LD (HL), A
041C99             0144*   ;     INC HL
041C99             0145*   ;     DJNZ @loop
041C99             0146*   ; @done:
041C99             0147*   ;     LD HL, _printDecBuffer
041C99             0148*   ;     CALL printString
041C99             0149*   ; ; restore all the things
041C99             0150*   ;     pop hl
041C99             0151*   ;     pop de
041C99             0152*   ;     pop bc
041C99             0153*   ;     pop af
041C99             0154*   ;     RET
041C99             0155*   ; _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
041C99             0156*   
041C99             0157*   ; same as printDec but signed
041C99             0158*   printDecS:
041C99             0159*   ; back up all the things
041C99 F5          0160*       push af
041C9A C5          0161*       push bc
041C9B D5          0162*       push de
041C9C E5          0163*       push hl
041C9D CD 92 1F 04 0164*       call hlu_abs ; abs(hl), sign flag set if negative
041CA1 F5          0165*       push af ; save sign flag
041CA2 11 59 17 04 0166*       LD DE, _printDecBuffer
041CA6 CD 2D 1D 04 0167*       CALL u24_to_ascii
041CAA             0168*   ; replace leading zeroes with spaces
041CAA 21 59 17 04 0169*       LD HL, _printDecBuffer
041CAE 06 07       0170*       ld B, 7 ; if HL was 0, we want to keep the final zero
041CB0 F1          0171*       pop af ; restore sign flag
041CB1 3E 20       0172*       ld a,' ' ; assume positive
041CB3 F2 B9 1C 04 0173*       jp p,@print
041CB7 3E 2D       0174*       ld a,'-'
041CB9             0175*   @print:
041CB9 5B D7       0176*       rst.lil 10h
041CBB             0177*   @loop:
041CBB 7E          0178*       LD A, (HL)
041CBC FE 30       0179*       CP '0'
041CBE C2 C8 1C 04 0180*       JP NZ, @done
041CC2 3E 20       0181*       LD A, ' '
041CC4 77          0182*       LD (HL), A
041CC5 23          0183*       INC HL
041CC6 10 F3       0184*       DJNZ @loop
041CC8             0185*   @done:
041CC8 21 59 17 04 0186*       LD HL, _printDecBuffer
041CCC CD 22 17 04 0187*       CALL printString
041CD0             0188*   ; restore all the things
041CD0 E1          0189*       pop hl
041CD1 D1          0190*       pop de
041CD2 C1          0191*       pop bc
041CD3 F1          0192*       pop af
041CD4 C9          0193*       RET
041CD5             0194*   
041CD5             0195*   printDec8:
041CD5             0196*   ; back up all the things
041CD5 F5          0197*       push af
041CD6 C5          0198*       push bc
041CD7 D5          0199*       push de
041CD8 E5          0200*       push hl
041CD9             0201*   ; initialize hl to 0 and load it with a
041CD9 21 00 00 00 0202*       ld hl,0
041CDD 6F          0203*       ld l,a
041CDE             0204*   ; convert l to ascii
041CDE 11 06 1D 04 0205*       LD DE, _printDec8Buffer
041CE2 CD 4D 1D 04 0206*       CALL u8_to_ascii
041CE6             0207*   ; replace leading zeroes with spaces
041CE6 21 06 1D 04 0208*       LD HL, _printDec8Buffer
041CEA 06 03       0209*       ld B, 3 ; if A was 0, we want to keep the final zero
041CEC             0210*   @loop:
041CEC 7E          0211*       LD A, (HL)
041CED FE 30       0212*       CP '0'
041CEF C2 F9 1C 04 0213*       JP NZ, @done
041CF3 3E 20       0214*       LD A, ' '
041CF5 77          0215*       LD (HL), A
041CF6 23          0216*       INC HL
041CF7 10 F3       0217*       DJNZ @loop
