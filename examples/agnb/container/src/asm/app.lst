04237C             0317*   add_uhl_a_signed:
04237C D5          0318*       push de    ; 4 cycles
04237D EB          0319*       ex de, hl  ; 1 cycle  UDE = UHL
04237E 07          0320*       rlca       ; 1 cycle  CF = signbit(A)
04237F ED 62       0321*       sbc hl, hl ; 2 cycles UHL = -signbit(A)
042381 0F          0322*       rrca       ; 1 cycle  Restore A
042382 6F          0323*       ld l, a    ; 1 cycle  UHL = signext(A)
042383 19          0324*       add hl, de ; 1 cycle  UHL = UDE + signext(A)
042384 D1          0325*       pop de     ; 4 cycles
042385             0326*                  ; 15 cycles total
042385 C9          0327*       ret
042386             0328*   ; end hlu_add_a_signed
