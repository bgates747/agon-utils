0423D1             0076    ; Preload and finalize every image in the container before entering the same
0423D1             0077    ; slideshow loop used by the loose-file harness.
0423D1 CD 73 01 04 0078        call agnb_load_images
0423D5 C2 51 24 04 0079        jp nz,main_end
0423D9 11 00 00 00 0080        ld de, 0
0423DD C3 F9 23 04 0081        jp rendbmp
0423E1             0082    
