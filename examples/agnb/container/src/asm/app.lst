041B4C 00 00 00    0004*   scratch1: dw24 0 ;bit manipulation buffer 1
041B4F 00 00 00    0005*   scratch2: dw24 0 ;bit manipulation buffer 2
041B52             0006*   
041B52             0007*   ; absolute value of hlu
041B52             0008*   ; returns: abs(hlu), flags set according to the incoming sign of hlu:
041B52             0009*   ;         s1,z0,pv0,n1,c0 if hlu was negative
041B52             0010*   ;         s0,z1,pv0,n1,c0 if hlu was zero
041B52             0011*   ;         s0,z0,pv0,n1,c0 if hlu was positive
041B52             0012*   ; destroys: a
041B52             0013*   hlu_abs:
041B52 19          0014*       add hl,de
041B53 B7          0015*       or a
041B54 ED 52       0016*       sbc hl,de
041B56 FA 5B 1B 04 0017*       jp m,@is_neg
041B5A C9          0018*       ret ; hlu is positive or zero so we're done
041B5B             0019*   @is_neg:
041B5B F5          0020*       push af ; otherwise, save current flags for return
041B5C CD 62 1B 04 0021*       call neg_hlu ; negate hlu
041B60 F1          0022*       pop af ; get back flags
041B61 C9          0023*       ret
041B62             0024*   
041B62             0025*   ; flip the sign of hlu
041B62             0026*   ; inputs: hlu
041B62             0027*   ; returns: 0-hlu, flags set appropriately for the result:
041B62             0028*   ;         s1,z0,pv0,n1,c1 if result is negative
041B62             0029*   ;         s0,z1,pv0,n1,c0 if result is zero
041B62             0030*   ;         s0,z0,pv0,n1,c1 if result is positive
041B62             0031*   ; destroys a
041B62             0032*   neg_hlu:
041B62 D5          0033*       push de ; save de
041B63 EB          0034*       ex de,hl ; put hl into de
041B64 21 00 00 00 0035*       ld hl,0 ; clear hl
041B68 AF          0036*       xor a ; clear carry
041B69 ED 52       0037*       sbc hl,de ; 0-hlu = -hlu
041B6B D1          0038*       pop de ; get de back
041B6C C9          0039*       ret ; easy peasy
