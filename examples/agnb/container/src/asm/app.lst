040FDF             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
040FDF 00 00 00    0087*   prt_reload: dl 0x000000
040FE2             0088*   
040FE2             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
040FE2             0090*   ; ;          de = number PRT interrupts during test interval
040FE2             0091*   ; prt_calibrate:
040FE2             0092*   ;     call vdu_vblank
040FE2             0093*   ; ; set a MOS timer
040FE2             0094*   ;     ld hl,120*1 ; 1 second
040FE2             0095*   ;     ld iy,tmr_test
040FE2             0096*   ;     call tmr_set
040FE2             0097*   ; ; set a PRT timer
040FE2             0098*   ;     ; ld hl,prt_reload_hardware
040FE2             0099*   ;     ; ld hl,prt_reload_emulator
040FE2             0100*   ;     ld hl,prt_reload_emulator + prt_reload_hardware / 2
040FE2             0101*   ;     ld (prt_reload),hl
040FE2             0102*   ;     call prt_set
040FE2             0103*   ; @loop:
040FE2             0104*   ; ; check time remaining on MOS timer
040FE2             0105*   ;     call tmr_get
040FE2             0106*   ;     jp z,@done ; time expired,so quit
040FE2             0107*   ;     jp m,@done ; time past expiration (negative),so quit
040FE2             0108*   ;     jr @loop
040FE2             0109*   ; @done:
040FE2             0110*   ;     ld de,(prt_irq_counter)
040FE2             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
040FE2             0112*   ;     ld (prt_reload),bc
040FE2             0113*   ;     ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
040FE2             0114*   ;     xor a ; clear carry,zero is default value for running on hardware
040FE2             0115*   ;     ld (is_emulator),a
040FE2             0116*   ;     sbc hl,de
040FE2             0117*   ;     ld hl,on_hardware ; default message for running on hardware
040FE2             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
040FE2             0119*   ;     ret m ; negative result means we're on hardware
040FE2             0120*   ;     inc a ; we're on emulator
040FE2             0121*   ;     ld (is_emulator),a
040FE2             0122*   ;     ld bc,prt_reload_emulator
040FE2             0123*   ;     ld (prt_reload),bc
040FE2             0124*   ;     ld hl,on_emulator
