042025             0162*   
042025             0163*   ; BCD addition
042025             0164*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
042025             0165*   ;       a is the number of bytes holding each number (number of places/2)
042025             0166*   ; outputs: (hl) + (de) --> (hl)
042025             0167*   ; destroys: a,b,de,hl
042025             0168*   add_bcd:
042025 47          0169*       ld b,a ; loop counter
042026 AF          0170*       xor a ; reset a, clear carry flag
042027             0171*   adcec:
042027 1A          0172*       ld a,(de) ; addend to acc
042028 8E          0173*       adc a,(hl) ; add (hl) to acc
042029 27          0174*       daa ; adjust result to bcd
04202A 77          0175*       ld (hl),a ; store result
04202B 23          0176*       inc hl ; advance memory pointers
04202C 13          0177*       inc de
04202D 10 F8       0178*       djnz adcec ; loop until b == 0
04202F C9          0179*       ret
042030             0180*   
042030             0181*   ; BCD subtraction
042030             0182*   ; inputs: (hl) and (de) point to BCD numbers of equal length (divisible by 2)
042030             0183*   ;       a is the number of bytes holding each number (number of places/2)
042030             0184*   ; outputs: (hl) - (de) --> (hl)
042030             0185*   ; destroys: a,b,de,hl
042030             0186*   sub_bcd:
042030 47          0187*       ld b,a ; loop counter
042031 AF          0188*       xor a ; reset a,clear carry flag
042032             0189*   subdec:
042032 1A          0190*       ld a,(de) ; subtrahend to acc
042033 9E          0191*       sbc a,(hl) ; subtract (hl) from acc
042034 27          0192*       daa ; adjust result to bcd
042035 77          0193*       ld (hl),a ; store result
042036 23          0194*       inc hl ; advance memory pointers
042037 13          0195*       inc de
042038 10 F8       0196*       djnz subdec ; loop until b == 0
04203A C9          0197*       ret
