04158E             0037        include "timer.inc"
04158E             0001*   ; Table 32. Timer Control Registers
04158E             0002*   ; this constant is the base address of the timer control registers
04158E             0003*   ; each timer takes three bytes:
04158E             0004*   ;   0: control register
04158E             0005*   ;   1: low byte of timer reset value
04158E             0006*   ;   2: high byte of timer reset value
04158E             0007*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
04158E             0008*   ; which correctly force the high and upper bytes of the address bus to zero
04158E             0009*   TMR_CTL:     equ 80h
04158E             0010*   
04158E             0011*   ; Timer Control Register Bit Definitions
04158E             0012*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
04158E             0013*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
04158E             0014*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
04158E             0015*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
04158E             0016*                               ; the TMRx_CTL register is read.
04158E             0017*   
04158E             0018*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
04158E             0019*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
04158E             0020*   
04158E             0021*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
04158E             0022*                               ;  0,and counting stops when the end-of-count value is reached.
04158E             0023*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
04158E             0024*                               ; written to the counter when the end-of-count value is reached.
04158E             0025*   
04158E             0026*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
04158E             0027*   CLK_DIV_256:  equ %00001100 ;
04158E             0028*   CLK_DIV_64:   equ %00001000 ;
04158E             0029*   CLK_DIV_16:   equ %00000100 ;
04158E             0030*   CLK_DIV_4:    equ %00000000 ;
04158E             0031*   
04158E             0032*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
04158E             0033*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
04158E             0034*                               ; When a 1 is written to this bit,the values in the reload registers
04158E             0035*                               ;  are loaded into the downcounter when the timer restarts. The
04158E             0036*                               ; programmer must ensure that this bit is set to 1 each time
04158E             0037*                               ; SINGLE-PASS mode is used.
04158E             0038*   
04158E             0039*   ; disable/enable the programmable reload timer
04158E             0040*   PRT_EN_0:     equ %00000000 ;
04158E             0041*   PRT_EN_1:     equ %00000001 ;
04158E             0042*   
04158E             0043*   ; Table 37. Timer Input Source Select Register
04158E             0044*   ; Each of the 4 timers are allocated two bits of the 8-bit register
04158E             0045*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
04158E             0046*   ;   00: System clock / CLK_DIV
04158E             0047*   ;   01: RTC / CLK_DIV
04158E             0048*   ;   NOTE: these are the values given in the manual,but it may be a typo
04158E             0049*   ;   10: GPIO port B pin 1.
04158E             0050*   ;   11: GPIO port B pin 1.
04158E             0051*   TMR_ISS:   equ 92h ; register address
04158E             0052*   
04158E             0053*   ; Table 51. Real-Time Clock Control Register
04158E             0054*   RTC_CTRL: equ EDh ; register address
04158E             0055*   
04158E             0056*   ; alarm interrupt disable/enable
04158E             0057*   RTC_ALARM_0:    equ %00000000
04158E             0058*   RTC_ALARM_1:    equ %10000000
04158E             0059*   
04158E             0060*   ; interrupt on alarm disable/enable
04158E             0061*   RTC_INT_ENT_0:  equ %00000000
04158E             0062*   RTC_INT_ENT_1:  equ %01000000
04158E             0063*   
04158E             0064*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
04158E             0065*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
04158E             0066*   
04158E             0067*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
04158E             0068*                                   ; On-chip 32768 Hz oscillator is enabled.
04158E             0069*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
04158E             0070*                                   ; On-chip 32768 Hz oscillator is disabled.
04158E             0071*   
04158E             0072*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
04158E             0073*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
04158E             0074*   
04158E             0075*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
04158E             0076*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
04158E             0077*   
04158E             0078*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
04158E             0079*                                   ; RTC counter is enabled.
04158E             0080*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
04158E             0081*                                   ; RTC counter is disabled.
04158E             0082*   
04158E             0083*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
04158E             0084*   
04158E             0085*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
04158E             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
04158E 00 00 00    0087*   prt_reload: dl 0x000000
041591             0088*   
041591             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
041591             0090*   ; ;          de = number PRT interrupts during test interval
041591             0091*   ; prt_calibrate:
041591             0092*   ;     call vdu_vblank
041591             0093*   ; ; set a MOS timer
041591             0094*   ;     ld hl,120*1 ; 1 second
041591             0095*   ;     ld iy,tmr_test
041591             0096*   ;     call tmr_set
041591             0097*   ; ; set a PRT timer
041591             0098*   ;     ; ld hl,prt_reload_hardware
041591             0099*   ;     ; ld hl,prt_reload_emulator
041591             0100*   ;     ld hl,prt_reload_emulator + prt_reload_hardware / 2
041591             0101*   ;     ld (prt_reload),hl
041591             0102*   ;     call prt_set
041591             0103*   ; @loop:
041591             0104*   ; ; check time remaining on MOS timer
041591             0105*   ;     call tmr_get
041591             0106*   ;     jp z,@done ; time expired,so quit
041591             0107*   ;     jp m,@done ; time past expiration (negative),so quit
041591             0108*   ;     jr @loop
041591             0109*   ; @done:
041591             0110*   ;     ld de,(prt_irq_counter)
041591             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
041591             0112*   ;     ld (prt_reload),bc
041591             0113*   ;     ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041591             0114*   ;     xor a ; clear carry,zero is default value for running on hardware
041591             0115*   ;     ld (is_emulator),a
041591             0116*   ;     sbc hl,de
041591             0117*   ;     ld hl,on_hardware ; default message for running on hardware
041591             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
041591             0119*   ;     ret m ; negative result means we're on hardware
041591             0120*   ;     inc a ; we're on emulator
041591             0121*   ;     ld (is_emulator),a
041591             0122*   ;     ld bc,prt_reload_emulator
041591             0123*   ;     ld (prt_reload),bc
041591             0124*   ;     ld hl,on_emulator
041591             0125*   ;     ret
041591             0126*   
041591             0127*   ; calibrating_timer: defb "Calibrating timer\r\n",0
041591             0128*   
041591             0129*   ; set PRT timer
041591             0130*   prt_set:
041591 21 00 00 00 0131*       ld hl,0
041595 22 DF 15 04 0132*       ld (prt_irq_counter),hl
041599 2A 8E 15 04 0133*       ld hl,(prt_reload)
04159D ED 29 84    0134*       out0 ($84),l
0415A0 ED 21 85    0135*   	out0 ($85),h
0415A3             0136*   ; disable timer
0415A3 3E 06       0137*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
0415A5 ED 39 83    0138*   	out0 ($83),a
0415A8             0139*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
0415A8 3E 57       0140*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
0415AA ED 39 83    0141*   	out0 ($83),a
0415AD C9          0142*       ret
0415AE             0143*   
0415AE             0144*   ; ===============================================
0415AE             0145*   ; PRT Timer Interrupt Handling
0415AE             0146*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.inc
0415AE             0147*   ; -----------------------------------------------
0415AE             0148*   prt_irq_init:
0415AE             0149*       ; set up interrupt vector table 2
0415AE 21 00 00 00 0150*   	ld hl,0
0415B2 3A 0C 01 00 0151*   	ld a,($10c)
0415B6 6F          0152*   	ld l,a
0415B7 3A 0D 01 00 0153*   	ld a,($10d)
0415BB 67          0154*   	ld h,a
0415BC             0155*   
0415BC             0156*   	; skip over CALL ($c3)
0415BC 23          0157*   	inc hl
0415BD             0158*   	; load address of jump into vector table 2 (in ram)
0415BD ED 27       0159*   	ld hl,(hl)
0415BF             0160*   
0415BF             0161*   	; write CALL prt_irq_handler to vector table 2
0415BF 3E C3       0162*   	ld a,$c3
0415C1 77          0163*   	ld (hl),a
0415C2 23          0164*   	inc hl
0415C3 11 CA 15 04 0165*   	ld de,prt_irq_handler
0415C7 ED 1F       0166*   	ld (hl),de
0415C9             0167*   
0415C9 C9          0168*       ret
0415CA             0169*   
0415CA             0170*   prt_irq_handler:
0415CA F3          0171*   	di
0415CB F5          0172*   	push af
0415CC E5          0173*       push hl
0415CD ED 38 83    0174*   	in0 a,($83)
0415D0 2A DF 15 04 0175*   	ld hl,(prt_irq_counter)
0415D4 23          0176*   	inc hl
0415D5 22 DF 15 04 0177*   	ld (prt_irq_counter),hl
0415D9 E1          0178*       pop hl
0415DA F1          0179*   	pop af
0415DB FB          0180*   	ei
0415DC 5B ED 4D    0181*   	reti.l
0415DF             0182*   
0415DF             0183*   prt_irq_counter:
0415DF 00 00 00    0184*   	.dl 0
0415E2             0185*   prt_irq_counter_saved:
0415E2 00 00 00    0186*       .dl 0
0415E5             0187*   
0415E5             0188*   prt_loop_reset:
0415E5 E5          0189*       push hl
0415E6 21 00 00 00 0190*   	ld hl,0
0415EA 22 DF 15 04 0191*   	ld (prt_irq_counter),hl
0415EE 22 50 16 04 0192*       ld (prt_loop_counter),hl
0415F2 22 53 16 04 0193*       ld (prt_loops),hl
0415F6 CD 91 15 04 0194*       call prt_set
0415FA E1          0195*       pop hl
