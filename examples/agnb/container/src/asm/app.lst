04135A             0374*   
04135A             0375*   ; ------------------
04135A             0376*   ; delay routine
04135A             0377*   ; Author: Richard Turrnidge
04135A             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
04135A             0379*   ; routine waits a fixed time,then returns
04135A             0380*   ; arrive with A =  the delay byte. One bit to be set only.
04135A             0381*   ; eg. ld A,00000100b
04135A             0382*   
04135A             0383*   multiPurposeDelay:
       FF FF FF 
04135A F5          0384*       push af
04135B C5          0385*       push bc
04135C DD E5       0386*       push ix
04135E 47          0387*       ld b,a
04135F 3E 08       0388*       ld a,$08
041361 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
041363             0390*   
041363             0391*   waitLoop:
041363             0392*   
041363 DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
041366             0394*   
041366             0395*                                   ;   we check if bit set is same as last time we checked.
041366             0396*                                   ;   bit 0 - don't use
041366             0397*                                   ;   bit 1 - changes 64 times per second
041366             0398*                                   ;   bit 2 - changes 32 times per second
041366             0399*                                   ;   bit 3 - changes 16 times per second
041366             0400*   
041366             0401*                                   ;   bit 4 - changes 8 times per second
041366             0402*                                   ;   bit 5 - changes 4 times per second
041366             0403*                                   ;   bit 6 - changes 2 times per second
041366             0404*                                   ;   bit 7 - changes 1 times per second
041366 A0          0405*       and b
041367 4F          0406*       ld c,a
041368 3A 79 13 04 0407*       ld a,(oldTimeStamp)
04136C B9          0408*       cp c                        ; is A same as last value?
04136D 28 F4       0409*       jr z,waitLoop              ; loop here if it is
04136F 79          0410*       ld a,c
041370 32 79 13 04 0411*       ld (oldTimeStamp),a        ; set new value
041374             0412*   
041374 DD E1       0413*       pop ix
041376 C1          0414*       pop bc
041377 F1          0415*       pop af
041378 C9          0416*       ret
041379             0417*   
041379 00          0418*   oldTimeStamp:   .db 00h
