                       M1 Args: function=mos_sysvars 
041664 3E 08       0001*M1 			LD	A, function
041666 5B CF       0002*M1 			RST.LIL	08h
041668 DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
04166B FD 27 00    0270*       ld hl,(iy+0)            ; get start time
04166E AF          0271*       xor a                   ; clear carry
04166F ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041671 FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
041674 AF          0274*       xor a                   ; clear carry
041675 ED 5A       0275*       adc hl,de               ; hl = time remaining
041677             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041677 C9          0277*       ret
