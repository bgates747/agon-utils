04184C             0037        include "timer.inc"
04184C             0001*   ; Table 32. Timer Control Registers
04184C             0002*   ; this constant is the base address of the timer control registers
04184C             0003*   ; each timer takes three bytes:
04184C             0004*   ;   0: control register
04184C             0005*   ;   1: low byte of timer reset value
04184C             0006*   ;   2: high byte of timer reset value
04184C             0007*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
04184C             0008*   ; which correctly force the high and upper bytes of the address bus to zero
04184C             0009*   TMR_CTL:     equ 80h
04184C             0010*   
04184C             0011*   ; Timer Control Register Bit Definitions
04184C             0012*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
04184C             0013*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
04184C             0014*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
04184C             0015*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
04184C             0016*                               ; the TMRx_CTL register is read.
04184C             0017*   
04184C             0018*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
04184C             0019*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
04184C             0020*   
04184C             0021*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
04184C             0022*                               ;  0,and counting stops when the end-of-count value is reached.
04184C             0023*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
04184C             0024*                               ; written to the counter when the end-of-count value is reached.
04184C             0025*   
04184C             0026*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
04184C             0027*   CLK_DIV_256:  equ %00001100 ;
04184C             0028*   CLK_DIV_64:   equ %00001000 ;
04184C             0029*   CLK_DIV_16:   equ %00000100 ;
04184C             0030*   CLK_DIV_4:    equ %00000000 ;
04184C             0031*   
04184C             0032*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
04184C             0033*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
04184C             0034*                               ; When a 1 is written to this bit,the values in the reload registers
04184C             0035*                               ;  are loaded into the downcounter when the timer restarts. The
04184C             0036*                               ; programmer must ensure that this bit is set to 1 each time
04184C             0037*                               ; SINGLE-PASS mode is used.
04184C             0038*   
04184C             0039*   ; disable/enable the programmable reload timer
04184C             0040*   PRT_EN_0:     equ %00000000 ;
04184C             0041*   PRT_EN_1:     equ %00000001 ;
04184C             0042*   
04184C             0043*   ; Table 37. Timer Input Source Select Register
04184C             0044*   ; Each of the 4 timers are allocated two bits of the 8-bit register
04184C             0045*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
04184C             0046*   ;   00: System clock / CLK_DIV
04184C             0047*   ;   01: RTC / CLK_DIV
04184C             0048*   ;   NOTE: these are the values given in the manual,but it may be a typo
04184C             0049*   ;   10: GPIO port B pin 1.
04184C             0050*   ;   11: GPIO port B pin 1.
04184C             0051*   TMR_ISS:   equ 92h ; register address
04184C             0052*   
04184C             0053*   ; Table 51. Real-Time Clock Control Register
04184C             0054*   RTC_CTRL: equ EDh ; register address
04184C             0055*   
04184C             0056*   ; alarm interrupt disable/enable
04184C             0057*   RTC_ALARM_0:    equ %00000000
04184C             0058*   RTC_ALARM_1:    equ %10000000
04184C             0059*   
04184C             0060*   ; interrupt on alarm disable/enable
04184C             0061*   RTC_INT_ENT_0:  equ %00000000
04184C             0062*   RTC_INT_ENT_1:  equ %01000000
04184C             0063*   
04184C             0064*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
04184C             0065*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
04184C             0066*   
04184C             0067*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
04184C             0068*                                   ; On-chip 32768 Hz oscillator is enabled.
04184C             0069*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
04184C             0070*                                   ; On-chip 32768 Hz oscillator is disabled.
04184C             0071*   
04184C             0072*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
04184C             0073*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
04184C             0074*   
04184C             0075*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
04184C             0076*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
04184C             0077*   
04184C             0078*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
04184C             0079*                                   ; RTC counter is enabled.
04184C             0080*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
04184C             0081*                                   ; RTC counter is disabled.
04184C             0082*   
04184C             0083*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
04184C             0084*   
04184C             0085*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
04184C             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
04184C 00 00 00    0087*   prt_reload: dl 0x000000
04184F             0088*   
04184F             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
04184F             0090*   ; ;          de = number PRT interrupts during test interval
04184F             0091*   ; prt_calibrate:
04184F             0092*   ;     call vdu_vblank
04184F             0093*   ; ; set a MOS timer
04184F             0094*   ;     ld hl,120*1 ; 1 second
04184F             0095*   ;     ld iy,tmr_test
04184F             0096*   ;     call tmr_set
04184F             0097*   ; ; set a PRT timer
04184F             0098*   ;     ; ld hl,prt_reload_hardware
04184F             0099*   ;     ; ld hl,prt_reload_emulator
04184F             0100*   ;     ld hl,prt_reload_emulator + prt_reload_hardware / 2
04184F             0101*   ;     ld (prt_reload),hl
04184F             0102*   ;     call prt_set
04184F             0103*   ; @loop:
04184F             0104*   ; ; check time remaining on MOS timer
04184F             0105*   ;     call tmr_get
04184F             0106*   ;     jp z,@done ; time expired,so quit
04184F             0107*   ;     jp m,@done ; time past expiration (negative),so quit
04184F             0108*   ;     jr @loop
04184F             0109*   ; @done:
04184F             0110*   ;     ld de,(prt_irq_counter)
04184F             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
04184F             0112*   ;     ld (prt_reload),bc
04184F             0113*   ;     ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
04184F             0114*   ;     xor a ; clear carry,zero is default value for running on hardware
04184F             0115*   ;     ld (is_emulator),a
04184F             0116*   ;     sbc hl,de
04184F             0117*   ;     ld hl,on_hardware ; default message for running on hardware
04184F             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
04184F             0119*   ;     ret m ; negative result means we're on hardware
04184F             0120*   ;     inc a ; we're on emulator
04184F             0121*   ;     ld (is_emulator),a
04184F             0122*   ;     ld bc,prt_reload_emulator
04184F             0123*   ;     ld (prt_reload),bc
04184F             0124*   ;     ld hl,on_emulator
04184F             0125*   ;     ret
04184F             0126*   
04184F             0127*   ; calibrating_timer: defb "Calibrating timer\r\n",0
04184F             0128*   
04184F             0129*   ; set PRT timer
04184F             0130*   prt_set:
04184F 21 00 00 00 0131*       ld hl,0
041853 22 9D 18 04 0132*       ld (prt_irq_counter),hl
041857 2A 4C 18 04 0133*       ld hl,(prt_reload)
04185B ED 29 84    0134*       out0 ($84),l
04185E ED 21 85    0135*   	out0 ($85),h
041861             0136*   ; disable timer
041861 3E 06       0137*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
041863 ED 39 83    0138*   	out0 ($83),a
041866             0139*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
041866 3E 57       0140*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
041868 ED 39 83    0141*   	out0 ($83),a
04186B C9          0142*       ret
04186C             0143*   
04186C             0144*   ; ===============================================
04186C             0145*   ; PRT Timer Interrupt Handling
04186C             0146*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.inc
04186C             0147*   ; -----------------------------------------------
04186C             0148*   prt_irq_init:
04186C             0149*       ; set up interrupt vector table 2
04186C 21 00 00 00 0150*   	ld hl,0
041870 3A 0C 01 00 0151*   	ld a,($10c)
041874 6F          0152*   	ld l,a
041875 3A 0D 01 00 0153*   	ld a,($10d)
041879 67          0154*   	ld h,a
04187A             0155*   
04187A             0156*   	; skip over CALL ($c3)
04187A 23          0157*   	inc hl
04187B             0158*   	; load address of jump into vector table 2 (in ram)
04187B ED 27       0159*   	ld hl,(hl)
04187D             0160*   
04187D             0161*   	; write CALL prt_irq_handler to vector table 2
04187D 3E C3       0162*   	ld a,$c3
04187F 77          0163*   	ld (hl),a
041880 23          0164*   	inc hl
041881 11 88 18 04 0165*   	ld de,prt_irq_handler
041885 ED 1F       0166*   	ld (hl),de
041887             0167*   
041887 C9          0168*       ret
041888             0169*   
041888             0170*   prt_irq_handler:
041888 F3          0171*   	di
041889 F5          0172*   	push af
04188A E5          0173*       push hl
04188B ED 38 83    0174*   	in0 a,($83)
04188E 2A 9D 18 04 0175*   	ld hl,(prt_irq_counter)
041892 23          0176*   	inc hl
041893 22 9D 18 04 0177*   	ld (prt_irq_counter),hl
041897 E1          0178*       pop hl
041898 F1          0179*   	pop af
041899 FB          0180*   	ei
04189A 5B ED 4D    0181*   	reti.l
04189D             0182*   
04189D             0183*   prt_irq_counter:
04189D 00 00 00    0184*   	.dl 0
0418A0             0185*   prt_irq_counter_saved:
0418A0 00 00 00    0186*       .dl 0
0418A3             0187*   
0418A3             0188*   prt_loop_reset:
0418A3 E5          0189*       push hl
0418A4 21 00 00 00 0190*   	ld hl,0
0418A8 22 9D 18 04 0191*   	ld (prt_irq_counter),hl
0418AC 22 0E 19 04 0192*       ld (prt_loop_counter),hl
0418B0 22 11 19 04 0193*       ld (prt_loops),hl
0418B4 CD 4F 18 04 0194*       call prt_set
0418B8 E1          0195*       pop hl
0418B9 C9          0196*       ret
0418BA             0197*   
0418BA             0198*   prt_loop_start:
0418BA E5          0199*       push hl
0418BB 21 00 00 00 0200*   	ld hl,0
0418BF 22 9D 18 04 0201*   	ld (prt_irq_counter),hl
0418C3 E1          0202*       pop hl
0418C4 C9          0203*       ret
0418C5             0204*   
0418C5             0205*   prt_loop_stop:
0418C5 E5          0206*       push hl
0418C6 D5          0207*       push de
0418C7 2A 9D 18 04 0208*       ld hl,(prt_irq_counter)
0418CB ED 5B 0E 19 0209*       ld de,(prt_loop_counter)
       04          
0418D0 19          0210*       add hl,de
0418D1 22 0E 19 04 0211*       ld (prt_loop_counter),hl
0418D5 21 00 00 00 0212*       ld hl,0
0418D9 22 9D 18 04 0213*       ld (prt_irq_counter),hl
0418DD 2A 11 19 04 0214*       ld hl,(prt_loops)
0418E1 23          0215*       inc hl
0418E2 22 11 19 04 0216*       ld (prt_loops),hl
0418E6 D1          0217*       pop de
0418E7 E1          0218*       pop hl
0418E8 C9          0219*       ret
0418E9             0220*   
0418E9             0221*   ; inputs: bc = y,x text coordinates to print
0418E9             0222*   prt_loop_print:
0418E9 F5          0223*       push af
0418EA E5          0224*       push hl
0418EB C5          0225*       push bc
0418EC D5          0226*       push de
0418ED DD E5       0227*       push ix
0418EF FD E5       0228*       push iy
0418F1 CD 43 1A 04 0229*       call vdu_move_cursor
0418F5             0230*   
0418F5 2A 0E 19 04 0231*       ld hl,(prt_loop_counter)
0418F9 CD EB 19 04 0232*       call printDec
0418FD             0233*   
0418FD 2A 11 19 04 0234*       ld hl,(prt_loops)
041901 CD EB 19 04 0235*       call printDec
041905             0236*   
041905 FD E1       0237*       pop iy
041907 DD E1       0238*       pop ix
041909 D1          0239*       pop de
04190A C1          0240*       pop bc
04190B E1          0241*       pop hl
04190C F1          0242*       pop af
04190D C9          0243*       ret
04190E             0244*   
04190E             0245*   prt_loop_counter:
04190E 00 00 00    0246*       .dl 0
041911             0247*   prt_loops:
041911 00 00 00    0248*       .dl 0
041914             0249*   
041914             0250*   ; ===============================================
041914             0251*   ; Timer functions
041914             0252*   ; -----------------------------------------------
041914             0253*   ; set a countdown timer
041914             0254*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041914             0255*   ; returns: hl = current time
041914             0256*   tmr_set:
041914 FD 2F 03    0257*       ld (iy+3),hl            ; set time remaining
041917             0258*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041917 3E 08       0001*M1 			LD	A, function
041919 5B CF       0002*M1 			RST.LIL	08h
04191B DD 27 00    0259*       ld hl,(ix+sysvar_time)  ; get current time
04191E FD 2F 00    0260*       ld (iy+0),hl            ; set start time
041921 C9          0261*       ret
041922             0262*   
041922             0263*   ; gets time remaining on a countdown timer
041922             0264*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041922             0265*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041922             0266*   ;          sign flags: pos = time not expired,zero or neg = time expired
041922             0267*   tmr_get:
041922             0268*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041922 3E 08       0001*M1 			LD	A, function
041924 5B CF       0002*M1 			RST.LIL	08h
041926 DD 17 00    0269*       ld de,(ix+sysvar_time)  ; get current time
041929 FD 27 00    0270*       ld hl,(iy+0)            ; get start time
04192C AF          0271*       xor a                   ; clear carry
04192D ED 52       0272*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
04192F FD 17 03    0273*       ld de,(iy+3)            ; get timer set value
041932 AF          0274*       xor a                   ; clear carry
041933 ED 5A       0275*       adc hl,de               ; hl = time remaining
041935             0276*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041935 C9          0277*       ret
041936             0278*   
041936 00 00 00    0279*   timestamp_now: dl 0
041939 00 00 00    0280*   timestamp_old: dl 0
04193C 00 00 00    0281*   timestamp_chg: dl 0
04193F             0282*   
04193F             0283*   ; update the global timestamp from the system clock
04193F             0284*   ; inputs: none
04193F             0285*   ; returns: hl = time elapsed in 1/120ths of a second
04193F             0286*   ;          de = current time
04193F             0287*   ;          ix = pointer to syvars table
04193F             0288*   ; destroys: af,hl,de,ix
04193F             0289*   timestamp_tick:
04193F ED 5B 36 19 0290*       ld de,(timestamp_now)   ; get previous time
       04          
041944 ED 53 39 19 0291*       ld (timestamp_old),de   ; save previous time
       04          
041949             0292*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041949 3E 08       0001*M1 			LD	A, function
