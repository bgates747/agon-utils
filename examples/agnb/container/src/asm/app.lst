0402D8             0052*   ;     call nz,cycle_dithering
0402D8             0053*   ;     xor a
0402D8             0054*   
0402D8             0055*   ; 26 Left
0402D8 DD CB 03 4E 0056*       bit 1,(ix+3)
0402DC CA EC 02 04 0057*       jp z,@Left
0402E0 ED 5B 8B 02 0058*       ld de,(current_image_index)
       04          
