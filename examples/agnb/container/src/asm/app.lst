0418ED             0252*   ; This routine converts the unsigned 24-bit value in HLU into its ASCII representation,
0418ED             0253*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
0418ED             0254*   ; so it will allways be 8 characters length
0418ED             0255*   ; HL : Value to convert to string
0418ED             0256*   ; DE : pointer to buffer, at least 8 byte + 0
0418ED             0257*   u24_to_ascii:
0418ED 01 80 69 67 0258*       LD BC,-10000000
0418F1 CD 24 19 04 0259*       CALL one_digit
0418F5 01 C0 BD F0 0260*       LD BC,-1000000
0418F9 CD 24 19 04 0261*       CALL one_digit
0418FD 01 60 79 FE 0262*       LD BC,-100000
041901 CD 24 19 04 0263*       CALL one_digit
041905 01 F0 D8 FF 0264*       LD BC,-10000
041909 CD 24 19 04 0265*       CALL one_digit
04190D             0266*   u8_to_ascii: ; same arguments but hl <= 255, uhl and h = 0
04190D 01 18 FC FF 0267*       LD BC,-1000
041911 CD 24 19 04 0268*       CALL one_digit
041915 01 9C FF FF 0269*       LD BC,-100
041919 CD 24 19 04 0270*       CALL one_digit
04191D 0E F6       0271*       LD C,-10
04191F CD 24 19 04 0272*       CALL one_digit
041923 48          0273*       LD C,B
041924             0274*   one_digit:
041924 3E 2F       0275*       LD A,'0'-1
041926             0276*   @divide_me:
041926 3C          0277*       INC A
041927 09          0278*       ADD HL,BC
041928 38 FC       0279*       JR C,@divide_me
04192A ED 42       0280*       SBC HL,BC
04192C 12          0281*       LD (DE),A
04192D 13          0282*       INC DE
04192E C9          0283*       RET
04192F             0284*   
04192F             0285*   print_u24:
04192F D5          0286*       push de
041930 E5          0287*       push hl
