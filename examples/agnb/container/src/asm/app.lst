041FEB             0252*   ; This routine converts the unsigned 24-bit value in HLU into its ASCII representation,
041FEB             0253*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
041FEB             0254*   ; so it will allways be 8 characters length
041FEB             0255*   ; HL : Value to convert to string
041FEB             0256*   ; DE : pointer to buffer, at least 8 byte + 0
041FEB             0257*   u24_to_ascii:
041FEB 01 80 69 67 0258*       LD BC,-10000000
041FEF CD 22 20 04 0259*       CALL one_digit
041FF3 01 C0 BD F0 0260*       LD BC,-1000000
041FF7 CD 22 20 04 0261*       CALL one_digit
041FFB 01 60 79 FE 0262*       LD BC,-100000
041FFF CD 22 20 04 0263*       CALL one_digit
042003 01 F0 D8 FF 0264*       LD BC,-10000
042007 CD 22 20 04 0265*       CALL one_digit
04200B             0266*   u8_to_ascii: ; same arguments but hl <= 255, uhl and h = 0
04200B 01 18 FC FF 0267*       LD BC,-1000
04200F CD 22 20 04 0268*       CALL one_digit
042013 01 9C FF FF 0269*       LD BC,-100
042017 CD 22 20 04 0270*       CALL one_digit
04201B 0E F6       0271*       LD C,-10
04201D CD 22 20 04 0272*       CALL one_digit
042021 48          0273*       LD C,B
