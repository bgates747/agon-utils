0411E6             0037        include "timer.inc"
0411E6             0001*   ; Table 32. Timer Control Registers
0411E6             0002*   ; this constant is the base address of the timer control registers
0411E6             0003*   ; each timer takes three bytes:
0411E6             0004*   ;   0: control register
0411E6             0005*   ;   1: low byte of timer reset value
0411E6             0006*   ;   2: high byte of timer reset value
0411E6             0007*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
0411E6             0008*   ; which correctly force the high and upper bytes of the address bus to zero
0411E6             0009*   TMR_CTL:     equ 80h
0411E6             0010*   
0411E6             0011*   ; Timer Control Register Bit Definitions
0411E6             0012*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
0411E6             0013*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
0411E6             0014*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
0411E6             0015*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
0411E6             0016*                               ; the TMRx_CTL register is read.
0411E6             0017*   
0411E6             0018*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
0411E6             0019*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
0411E6             0020*   
0411E6             0021*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
0411E6             0022*                               ;  0,and counting stops when the end-of-count value is reached.
0411E6             0023*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
0411E6             0024*                               ; written to the counter when the end-of-count value is reached.
0411E6             0025*   
0411E6             0026*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
0411E6             0027*   CLK_DIV_256:  equ %00001100 ;
0411E6             0028*   CLK_DIV_64:   equ %00001000 ;
0411E6             0029*   CLK_DIV_16:   equ %00000100 ;
0411E6             0030*   CLK_DIV_4:    equ %00000000 ;
0411E6             0031*   
0411E6             0032*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
0411E6             0033*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
0411E6             0034*                               ; When a 1 is written to this bit,the values in the reload registers
0411E6             0035*                               ;  are loaded into the downcounter when the timer restarts. The
0411E6             0036*                               ; programmer must ensure that this bit is set to 1 each time
0411E6             0037*                               ; SINGLE-PASS mode is used.
0411E6             0038*   
0411E6             0039*   ; disable/enable the programmable reload timer
0411E6             0040*   PRT_EN_0:     equ %00000000 ;
0411E6             0041*   PRT_EN_1:     equ %00000001 ;
0411E6             0042*   
0411E6             0043*   ; Table 37. Timer Input Source Select Register
0411E6             0044*   ; Each of the 4 timers are allocated two bits of the 8-bit register
0411E6             0045*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
0411E6             0046*   ;   00: System clock / CLK_DIV
0411E6             0047*   ;   01: RTC / CLK_DIV
0411E6             0048*   ;   NOTE: these are the values given in the manual,but it may be a typo
0411E6             0049*   ;   10: GPIO port B pin 1.
0411E6             0050*   ;   11: GPIO port B pin 1.
0411E6             0051*   TMR_ISS:   equ 92h ; register address
0411E6             0052*   
0411E6             0053*   ; Table 51. Real-Time Clock Control Register
0411E6             0054*   RTC_CTRL: equ EDh ; register address
0411E6             0055*   
0411E6             0056*   ; alarm interrupt disable/enable
0411E6             0057*   RTC_ALARM_0:    equ %00000000
0411E6             0058*   RTC_ALARM_1:    equ %10000000
0411E6             0059*   
0411E6             0060*   ; interrupt on alarm disable/enable
0411E6             0061*   RTC_INT_ENT_0:  equ %00000000
0411E6             0062*   RTC_INT_ENT_1:  equ %01000000
0411E6             0063*   
0411E6             0064*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
0411E6             0065*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
0411E6             0066*   
0411E6             0067*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
0411E6             0068*                                   ; On-chip 32768 Hz oscillator is enabled.
0411E6             0069*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
0411E6             0070*                                   ; On-chip 32768 Hz oscillator is disabled.
0411E6             0071*   
0411E6             0072*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
0411E6             0073*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
0411E6             0074*   
0411E6             0075*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
0411E6             0076*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
0411E6             0077*   
0411E6             0078*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
0411E6             0079*                                   ; RTC counter is enabled.
0411E6             0080*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
0411E6             0081*                                   ; RTC counter is disabled.
0411E6             0082*   
0411E6             0083*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
0411E6             0084*   
0411E6             0085*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
0411E6             0086*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
0411E6 00 00 00    0087*   prt_reload: dl 0x000000
0411E9             0088*   
0411E9             0089*   ; ; returns: a = 0 if running on hardware,1 if running on emulator
0411E9             0090*   ; ;          de = number PRT interrupts during test interval
0411E9             0091*   ; prt_calibrate:
0411E9             0092*   ;     call vdu_vblank
0411E9             0093*   ; ; set a MOS timer
0411E9             0094*   ;     ld hl,120*1 ; 1 second
0411E9             0095*   ;     ld iy,tmr_test
0411E9             0096*   ;     call tmr_set
0411E9             0097*   ; ; set a PRT timer
0411E9             0098*   ;     ; ld hl,prt_reload_hardware
0411E9             0099*   ;     ; ld hl,prt_reload_emulator
0411E9             0100*   ;     ld hl,prt_reload_emulator + prt_reload_hardware / 2
0411E9             0101*   ;     ld (prt_reload),hl
0411E9             0102*   ;     call prt_set
0411E9             0103*   ; @loop:
0411E9             0104*   ; ; check time remaining on MOS timer
0411E9             0105*   ;     call tmr_get
0411E9             0106*   ;     jp z,@done ; time expired,so quit
0411E9             0107*   ;     jp m,@done ; time past expiration (negative),so quit
0411E9             0108*   ;     jr @loop
0411E9             0109*   ; @done:
0411E9             0110*   ;     ld de,(prt_irq_counter)
0411E9             0111*   ;     ld bc,prt_reload_hardware ; default value for running on hardware
0411E9             0112*   ;     ld (prt_reload),bc
0411E9             0113*   ;     ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
0411E9             0114*   ;     xor a ; clear carry,zero is default value for running on hardware
0411E9             0115*   ;     ld (is_emulator),a
0411E9             0116*   ;     sbc hl,de
0411E9             0117*   ;     ld hl,on_hardware ; default message for running on hardware
0411E9             0118*   ;     jp z,prt_calibrate ; zero result is indeterminate so we try again
0411E9             0119*   ;     ret m ; negative result means we're on hardware
0411E9             0120*   ;     inc a ; we're on emulator
0411E9             0121*   ;     ld (is_emulator),a
0411E9             0122*   ;     ld bc,prt_reload_emulator
0411E9             0123*   ;     ld (prt_reload),bc
0411E9             0124*   ;     ld hl,on_emulator
0411E9             0125*   ;     ret
0411E9             0126*   
0411E9             0127*   ; calibrating_timer: defb "Calibrating timer\r\n",0
0411E9             0128*   
0411E9             0129*   ; set PRT timer
0411E9             0130*   prt_set:
0411E9 21 00 00 00 0131*       ld hl,0
0411ED 22 37 12 04 0132*       ld (prt_irq_counter),hl
0411F1 2A E6 11 04 0133*       ld hl,(prt_reload)
0411F5 ED 29 84    0134*       out0 ($84),l
0411F8 ED 21 85    0135*   	out0 ($85),h
0411FB             0136*   ; disable timer
0411FB 3E 06       0137*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
0411FD ED 39 83    0138*   	out0 ($83),a
041200             0139*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
041200 3E 57       0140*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
041202 ED 39 83    0141*   	out0 ($83),a
041205 C9          0142*       ret
041206             0143*   
041206             0144*   ; ===============================================
041206             0145*   ; PRT Timer Interrupt Handling
041206             0146*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.inc
041206             0147*   ; -----------------------------------------------
041206             0148*   prt_irq_init:
041206             0149*       ; set up interrupt vector table 2
041206 21 00 00 00 0150*   	ld hl,0
04120A 3A 0C 01 00 0151*   	ld a,($10c)
04120E 6F          0152*   	ld l,a
04120F 3A 0D 01 00 0153*   	ld a,($10d)
041213 67          0154*   	ld h,a
041214             0155*   
041214             0156*   	; skip over CALL ($c3)
041214 23          0157*   	inc hl
041215             0158*   	; load address of jump into vector table 2 (in ram)
041215 ED 27       0159*   	ld hl,(hl)
041217             0160*   
041217             0161*   	; write CALL prt_irq_handler to vector table 2
041217 3E C3       0162*   	ld a,$c3
041219 77          0163*   	ld (hl),a
04121A 23          0164*   	inc hl
04121B 11 22 12 04 0165*   	ld de,prt_irq_handler
04121F ED 1F       0166*   	ld (hl),de
041221             0167*   
041221 C9          0168*       ret
041222             0169*   
041222             0170*   prt_irq_handler:
041222 F3          0171*   	di
041223 F5          0172*   	push af
041224 E5          0173*       push hl
041225 ED 38 83    0174*   	in0 a,($83)
041228 2A 37 12 04 0175*   	ld hl,(prt_irq_counter)
04122C 23          0176*   	inc hl
04122D 22 37 12 04 0177*   	ld (prt_irq_counter),hl
041231 E1          0178*       pop hl
041232 F1          0179*   	pop af
041233 FB          0180*   	ei
041234 5B ED 4D    0181*   	reti.l
041237             0182*   
041237             0183*   prt_irq_counter:
041237 00 00 00    0184*   	.dl 0
04123A             0185*   prt_irq_counter_saved:
04123A 00 00 00    0186*       .dl 0
04123D             0187*   
04123D             0188*   prt_loop_reset:
04123D E5          0189*       push hl
04123E 21 00 00 00 0190*   	ld hl,0
041242 22 37 12 04 0191*   	ld (prt_irq_counter),hl
041246 22 A8 12 04 0192*       ld (prt_loop_counter),hl
04124A 22 AB 12 04 0193*       ld (prt_loops),hl
04124E CD E9 11 04 0194*       call prt_set
041252 E1          0195*       pop hl
041253 C9          0196*       ret
041254             0197*   
041254             0198*   prt_loop_start:
041254 E5          0199*       push hl
041255 21 00 00 00 0200*   	ld hl,0
041259 22 37 12 04 0201*   	ld (prt_irq_counter),hl
04125D E1          0202*       pop hl
04125E C9          0203*       ret
04125F             0204*   
04125F             0205*   prt_loop_stop:
04125F E5          0206*       push hl
041260 D5          0207*       push de
041261 2A 37 12 04 0208*       ld hl,(prt_irq_counter)
041265 ED 5B A8 12 0209*       ld de,(prt_loop_counter)
       04          
04126A 19          0210*       add hl,de
04126B 22 A8 12 04 0211*       ld (prt_loop_counter),hl
04126F 21 00 00 00 0212*       ld hl,0
041273 22 37 12 04 0213*       ld (prt_irq_counter),hl
041277 2A AB 12 04 0214*       ld hl,(prt_loops)
04127B 23          0215*       inc hl
04127C 22 AB 12 04 0216*       ld (prt_loops),hl
041280 D1          0217*       pop de
041281 E1          0218*       pop hl
041282 C9          0219*       ret
041283             0220*   
041283             0221*   ; inputs: bc = y,x text coordinates to print
041283             0222*   prt_loop_print:
041283 F5          0223*       push af
041284 E5          0224*       push hl
041285 C5          0225*       push bc
041286 D5          0226*       push de
041287 DD E5       0227*       push ix
041289 FD E5       0228*       push iy
04128B CD DD 13 04 0229*       call vdu_move_cursor
04128F             0230*   
04128F 2A A8 12 04 0231*       ld hl,(prt_loop_counter)
041293 CD 85 13 04 0232*       call printDec
041297             0233*   
041297 2A AB 12 04 0234*       ld hl,(prt_loops)
04129B CD 85 13 04 0235*       call printDec
04129F             0236*   
04129F FD E1       0237*       pop iy
0412A1 DD E1       0238*       pop ix
0412A3 D1          0239*       pop de
0412A4 C1          0240*       pop bc
0412A5 E1          0241*       pop hl
0412A6 F1          0242*       pop af
0412A7 C9          0243*       ret
0412A8             0244*   
0412A8             0245*   prt_loop_counter:
0412A8 00 00 00    0246*       .dl 0
0412AB             0247*   prt_loops:
0412AB 00 00 00    0248*       .dl 0
