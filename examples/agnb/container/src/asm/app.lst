041134             0357*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041134 3E 08       0001*M1 			LD	A, function
041136 5B CF       0002*M1 			RST.LIL	08h
041138 DD 27 00    0358*       ld hl,(ix+sysvar_time)  ; get current time
04113B 22 50 11 04 0359*       ld (stopwatch_started),hl            ; set start time
04113F C9          0360*       ret
041140             0361*   
041140             0362*   ; gets time elapsed on a stopwatch
041140             0363*   ; returns: hl = time elapsed in 1/120ths of a second
041140             0364*   ; destroys: af,hl,de,ix
