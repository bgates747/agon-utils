041025 23          0176*   	inc hl
041026 22 30 10 04 0177*   	ld (prt_irq_counter),hl
04102A E1          0178*       pop hl
04102B F1          0179*   	pop af
04102C FB          0180*   	ei
04102D 5B ED 4D    0181*   	reti.l
