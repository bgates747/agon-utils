0402C9             0039*   do_input:
0402C9             0040*   ; get user keyboard input
0402C9 DD 21 8E 02 0041*       ld ix,keyboard_masks
       04          
0402CE 3E FF       0042*       ld a,-1 ; anything non-zero to indicates no key pressed
0402D0             0043*   
0402D0             0044*   ; ------ QUIT ------
