042085             0264*   
042085             0265*   ; https://www.omnimaga.org/asm-language/(z80)-32-bit-by-16-bits-division-and-32-bit-square-root/msg406903/#msg406903
042085             0266*   ; This divides HLIX by BC
042085             0267*   ; The result is stored in HLIX, the remainder in DE
042085             0268*   ; BC is unmodified
042085             0269*   ; A is 0
042085             0270*   udiv3216:
042085 11 00 00 00 0271*       ld de,0		; 10
042089 3E 20       0272*       ld a,32		; 7
04208B             0273*   @loop:
04208B 52 DD 29    0274*       add.s ix,ix		; 15
04208E 52 ED 6A    0275*       adc.s hl,hl		; 15
042091 EB          0276*       ex de,hl		; 4
042092 52 ED 6A    0277*       adc.s hl,hl		; 15
042095 B7          0278*       or a			; 4
042096 52 ED 42    0279*       sbc.s hl,bc		; 15
042099 52 DD 23    0280*       inc.s ix		; 10
04209C 30 05       0281*       jr nc,@cansub		; 12/7
04209E 52 09       0282*       add.s hl,bc		; 11
0420A0 52 DD 2B    0283*       dec.s ix		; 10
0420A3             0284*   @cansub:
0420A3 EB          0285*       ex de,hl		; 4
0420A4 3D          0286*       dec a		; 4
0420A5 20 E4       0287*       jr nz,@loop	; 12/7
0420A7 C9          0288*       ret			; 10
0420A8             0289*   ; end udiv3216
0420A8             0290*   
0420A8             0291*   ; https://discord.com/channels/1158535358624039014/1282290921815408681/1329274504022720512
0420A8             0292*   ; calc84maniac's 32-bit by 23-bit division routine
0420A8             0293*   ; This divides AUIX by UDE (maximum 23 bits)
0420A8             0294*   ; The result is stored in AUIX, the remainder in UHL
0420A8             0295*   ; UDE, C are unmodified
0420A8             0296*   ; B is 0
0420A8             0297*   udiv3223:
0420A8 B7          0298*       or a,a         ; 1
0420A9 ED 62       0299*       sbc hl,hl      ; 2
0420AB 06 20       0300*       ld b,32        ; 2
0420AD             0301*   @loop:
0420AD DD 29       0302*       add ix,ix      ; 2
0420AF 8F          0303*       adc a,a        ; 1
0420B0 ED 6A       0304*       adc hl,hl      ; 2
0420B2 ED 52       0305*       sbc hl,de      ; 2
0420B4 DD 23       0306*       inc ix         ; 2
0420B6 30 03       0307*       jr nc,@cansub  ; 2/4
0420B8 19          0308*       add hl,de      ; 1
0420B9 DD 2B       0309*       dec ix         ; 2
0420BB             0310*   @cansub:
0420BB 10 F0       0311*       djnz @loop     ; 2/4
0420BD C9          0312*       ret            ; 10
0420BE             0313*   ; end udiv3223
0420BE             0314*   
0420BE             0315*   ; calc84maniac https://discord.com/channels/1158535358624039014/1282290921815408681/1330991583369101322
0420BE             0316*   ; add uhl to signed integer a
0420BE             0317*   add_uhl_a_signed:
0420BE D5          0318*       push de    ; 4 cycles
0420BF EB          0319*       ex de, hl  ; 1 cycle  UDE = UHL
0420C0 07          0320*       rlca       ; 1 cycle  CF = signbit(A)
0420C1 ED 62       0321*       sbc hl, hl ; 2 cycles UHL = -signbit(A)
0420C3 0F          0322*       rrca       ; 1 cycle  Restore A
0420C4 6F          0323*       ld l, a    ; 1 cycle  UHL = signext(A)
0420C5 19          0324*       add hl, de ; 1 cycle  UHL = UDE + signext(A)
0420C6 D1          0325*       pop de     ; 4 cycles
0420C7             0326*                  ; 15 cycles total
0420C7 C9          0327*       ret
0420C8             0328*   ; end hlu_add_a_signed
