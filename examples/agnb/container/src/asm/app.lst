041709 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
04170B             0390*   
04170B             0391*   waitLoop:
04170B             0392*   
04170B DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04170E             0394*   
04170E             0395*                                   ;   we check if bit set is same as last time we checked.
04170E             0396*                                   ;   bit 0 - don't use
04170E             0397*                                   ;   bit 1 - changes 64 times per second
04170E             0398*                                   ;   bit 2 - changes 32 times per second
04170E             0399*                                   ;   bit 3 - changes 16 times per second
04170E             0400*   
04170E             0401*                                   ;   bit 4 - changes 8 times per second
04170E             0402*                                   ;   bit 5 - changes 4 times per second
04170E             0403*                                   ;   bit 6 - changes 2 times per second
04170E             0404*                                   ;   bit 7 - changes 1 times per second
04170E A0          0405*       and b
04170F 4F          0406*       ld c,a
041710 3A 21 17 04 0407*       ld a,(oldTimeStamp)
041714 B9          0408*       cp c                        ; is A same as last value?
041715 28 F4       0409*       jr z,waitLoop              ; loop here if it is
041717 79          0410*       ld a,c
041718 32 21 17 04 0411*       ld (oldTimeStamp),a        ; set new value
04171C             0412*   
04171C DD E1       0413*       pop ix
04171E C1          0414*       pop bc
04171F F1          0415*       pop af
041720 C9          0416*       ret
