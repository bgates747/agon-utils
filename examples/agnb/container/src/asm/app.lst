040080             0543*   ;
040080             0544*   ; FatFS structures
040080             0545*   ; These mirror the structures contained in src_fatfs/ff.h in the MOS project
040080             0546*   ;
040080             0547*   ; Object ID and allocation information (FFOBJID)
040080             0548*   ;
040080             0549*   ; Indexes into FFOBJID structure
040080             0550*   ffobjid_fs:			EQU	0	; 3: Pointer to the hosting volume of this object
040080             0551*   ffobjid_id:			EQU	3	; 2: Hosting volume mount ID
040080             0552*   ffobjid_attr:		EQU	5	; 1: Object attribute
040080             0553*   ffobjid_stat:		EQU	6	; 1: Object chain status (b1-0: =0:not contiguous, =2:contiguous, =3:fragmented in this session, b2:sub-directory stretched)
040080             0554*   ffobjid_sclust:		EQU	7	; 4: Object data start cluster (0:no cluster or root directory)
040080             0555*   ffobjid_objsize:	EQU	11	; 4: Object size (valid when sclust != 0)
040080             0556*   ;
040080             0557*   ; File object structure (FIL)
040080             0558*   ;
040080             0559*   ; Indexes into FIL structure
040080             0560*   fil_obj:		EQU 0	; 15: Object identifier
040080             0561*   fil_flag:		EQU	15 	;  1: File status flags
040080             0562*   fil_err:		EQU	16	;  1: Abort flag (error code)
040080             0563*   fil_fptr:		EQU	17	;  4: File read/write pointer (Zeroed on file open)
040080             0564*   fil_clust:		EQU	21	;  4: Current cluster of fpter (invalid when fptr is 0)
040080             0565*   fil_sect:		EQU	25	;  4: Sector number appearing in buf[] (0:invalid)
040080             0566*   fil_dir_sect:	EQU	29	;  4: Sector number containing the directory entry
040080             0567*   fil_dir_ptr:	EQU	33	;  3: Pointer to the directory entry in the win[]
040080             0568*   ;
040080             0569*   ; Directory object structure (DIR)
040080             0570*   ; Indexes into DIR structure
040080             0571*   dir_obj:		EQU  0	; 15: Object identifier
040080             0572*   dir_dptr:		EQU	15	;  4: Current read/write offset
040080             0573*   dir_clust:		EQU	19	;  4: Current cluster
040080             0574*   dir_sect:		EQU	23	;  4: Current sector (0:Read operation has terminated)
040080             0575*   dir_dir:		EQU	27	;  3: Pointer to the directory item in the win[]
040080             0576*   dir_fn:			EQU	30	; 12: SFN (in/out) {body[8],ext[3],status[1]}
040080             0577*   dir_blk_ofs:	EQU	42	;  4: Offset of current entry block being processed (0xFFFFFFFF:Invalid)
040080             0578*   ;
040080             0579*   ; File information structure (FILINFO)
040080             0580*   ;
040080             0581*   ; Indexes into FILINFO structure
040080             0582*   filinfo_fsize:		EQU 0	;   4: File size
040080             0583*   filinfo_fdate:		EQU	4	;   2: Modified date
040080             0584*   filinfo_ftime:		EQU	6	;   2: Modified time
040080             0585*   filinfo_fattrib:	EQU	8	;   1: File attribute
040080             0586*   filinfo_altname:	EQU	9	;  13: Alternative file name
040080             0587*   filinfo_fname:		EQU	22	; 256: Primary file name
040080             0033        include "macros.inc" ; needs to be above any other includes that use these macros
040080             0001*   
040080             0002*   ; test the sign of HL
040080             0003*   ; inputs: HL obviously
040080             0004*   ; outputs: sign flag set if HL is negative, zero flag set if HL is zero
040080             0005*   ; destroys: flags
040080             0006*       MACRO SIGN_UHL
040080             0007*       add hl,de ; 1 cycle
040080             0008*       or a ; clear flags ; 1 cycle
040080             0009*       sbc hl,de ; 2 cycles
040080             0010*       ; 4 cycles total
040080             0011*       ENDMACRO
040080             0012*   
040080             0013*   ; put the value in A into HLU
040080             0014*   ; affects: HLU
040080             0015*   ; destroys: nothing
040080             0016*   ; note: $ instead of @@ b/c anon labels deprecated in ez80asm
040080             0017*       MACRO A_TO_HLU
040080             0018*       xor a ; 1 cycle
040080             0019*       ld ($+8+1),hl ; 7 cycles
040080             0020*       ld ($+4+3),a ; 5 cycles
040080             0021*       ld hl,0x000000 ; 4 cycles
040080             0022*       ; 17 cycles total
040080             0023*       ENDMACRO
040080             0024*   
040080             0025*   ; alternative: https://discord.com/channels/1158535358624039014/1282290921815408681/1318315567102300220
040080             0026*   ; one cycle less but burns flags
040080             0027*       MACRO A_TO_HLU_ALT
040080             0028*       push hl ; 4 cycles
040080             0029*       ld hl,2 ; 4 cycles
040080             0030*       add hl,sp ; 1 cycle
040080             0031*       ld (hl),a ; 2 cycles
040080             0032*       pop hl ; 4 cycles
040080             0033*       ; 15 cycles total
040080             0034*       ENDMACRO
040080             0035*   
040080             0036*       MACRO hlu_mul256
040080             0037*       add hl,hl ; * 2
040080             0038*       add hl,hl ; * 4
040080             0039*       add hl,hl ; * 8
040080             0040*       add hl,hl ; * 16
040080             0041*       add hl,hl ; * 32
040080             0042*       add hl,hl ; * 64
040080             0043*       add hl,hl ; * 128
040080             0044*       add hl,hl ; * 256
040080             0045*       ENDMACRO
040080             0046*   
040080             0047*   ; https://discord.com/channels/1158535358624039014/1282290921815408681/1317793870070812715
040080             0048*       MACRO SRL_UHL
040080             0049*       dec sp ; 1 cycle
040080             0050*       push hl ; 4 cycles
040080             0051*       inc sp ; 1 cycle
040080             0052*       pop hl ; 4 cycles
040080             0053*       inc hl ; 1 cycle
040080             0054*       dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
040080             0055*       ; 13 cycles total
040080             0056*       ENDMACRO
040080             0057*   
040080             0058*       MACRO printChar char
040080             0059*       LD A, char
040080             0060*       RST.LIL 10h
040080             0061*       ENDMACRO
040080             0062*   
040080             0063*   ; Simulated call to subroutine at HL
040080             0064*   ; inputs: HL pointing to the subroutine address plus whatever the called function expects
040080             0065*   ; outputs: whatever the subroutine does, including HL and BC
040080             0066*   ; destroys: only what the subroutine does, but always BC
040080             0067*       MACRO CALL_HL
040080             0068*       ld bc,$+6 ; Address of first instruction after the jump
040080             0069*       push bc ; which constitutes the return address
040080             0070*       jp (hl) ; Jump to the address in HL
040080             0071*       ENDMACRO
040080             0072*   
040080             0073*   ; Simulated call to subroutine at IX
040080             0074*   ; inputs: IX pointing to the subroutine address plus whatever the called function expects
040080             0075*   ; outputs: whatever the subroutine does, including IX and BC
040080             0076*   ; destroys: only what the subroutine does, but always BC
040080             0077*       MACRO CALL_IX
040080             0078*       ld bc,$+6 ; Address of first instruction after the jump
040080             0079*       push bc ; which constitutes the return address
040080             0080*       jp (ix) ; Jump to the address in IX
040080             0081*       ENDMACRO
040080             0082*   
040080             0083*   ; Simulated call to soubroutinte at IY
040080             0084*   ; inputs: IY pointing to the subroutine address plus whatever the called function expects
040080             0085*   ; outputs: whatever the subroutine does, including IY and BC
040080             0086*   ; destroys: only what the subroutine does, but always BC
040080             0087*       MACRO CALL_IY
040080             0088*       ld bc,$+6 ; Address of first instruction after the jump
040080             0089*       push bc ; which constitutes the return address
040080             0090*       jp (iy) ; Jump to the address in IY
040080             0091*       ENDMACRO
040080             0092*   
040080             0093*   ; put the value in HLU into A
040080             0094*   ; destroys: af
040080             0095*       MACRO HLU_TO_A
040080             0096*       dec sp ; 1 cycle
040080             0097*       push hl ; 4 cycles
040080             0098*       inc sp ; 1 cycle
040080             0099*       pop af ; 4 cycles
040080             0100*       ; 10 cycles total
040080             0101*       ENDMACRO
040080             0102*   
040080             0103*       MACRO PUSH_ALL
040080             0104*       ex af,af'
040080             0105*       exx
040080             0106*       push af
040080             0107*       push hl
040080             0108*       push bc
040080             0109*       push de
040080             0110*   
040080             0111*       ex af,af'
040080             0112*       exx
040080             0113*       push af
040080             0114*       push hl
040080             0115*       push bc
040080             0116*       push de
040080             0117*       push ix
040080             0118*       push iy
040080             0119*       ENDMACRO
040080             0120*   
040080             0121*       MACRO POP_ALL
040080             0122*       pop iy
040080             0123*       pop ix
040080             0124*       pop de
040080             0125*       pop bc
040080             0126*       pop hl
040080             0127*       pop af
040080             0128*       ex af,af'
040080             0129*       exx
040080             0130*   
040080             0131*       pop de
040080             0132*       pop bc
040080             0133*       pop hl
040080             0134*       pop af
040080             0135*       ex af,af'
040080             0136*       exx
040080             0137*       ENDMACRO
040080             0138*   
040080             0139*       ; load hl with the 16-bit value at addr
040080             0140*       MACRO LD_HL_mn addr
040080             0141*       ld hl,(addr)
040080             0142*       dec hl
040080             0143*       inc.s hl ; zeros hlu
040080             0144*       ENDMACRO
040080             0145*   
040080             0146*       ; load bc with the 16-bit value at addr
040080             0147*       MACRO LD_BC_mn addr
040080             0148*       ld bc,(addr)
040080             0149*       dec bc
040080             0150*       inc.s bc ; zeros bcu
040080             0151*       ENDMACRO
040080             0152*   
040080             0153*       ; load de with the 16-bit value at addr
040080             0154*       MACRO LD_DE_mn addr
040080             0155*       ld de,(addr)
040080             0156*       dec de
040080             0157*       inc.s de ; zeros deu
040080             0158*       ENDMACRO
040080             0159*   
040080             0160*       ; load ix with the 16-bit value at addr
040080             0161*       MACRO LD_IX_mn addr
040080             0162*       ld ix,(addr)
040080             0163*       dec ix
040080             0164*       inc.s ix ; zeros ixu
040080             0165*       ENDMACRO
040080             0166*   
040080             0167*       ; load iy with the 16-bit value at addr
040080             0168*       MACRO LD_IY_mn addr
040080             0169*       ld iy,(addr)
040080             0170*       dec iy
040080             0171*       inc.s iy ; zeros iyu
040080             0172*       ENDMACRO
040080             0034        include "agnb.inc"
040080             0001*   ; AGNB 0.1 image-container layout
040080             0002*   ; ===============================
040080             0003*   ;
040080             0004*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
040080             0005*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
040080             0006*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
040080             0007*   ; The stored chunk size excludes its eight-byte header and alignment padding.
040080             0008*   ;
040080             0009*   ;     RIFF  u32(file size - 8)  AGNB
040080             0010*   ;       VERS  size=2
040080             0011*   ;         u8 major=0
040080             0012*   ;         u8 minor=1
040080             0013*   ;       LIST  type=BUFR
040080             0014*   ;         BHDR  size=2
040080             0015*   ;           u16 bufferId
040080             0016*   ;         IMAG  size=5
040080             0017*   ;           u16 width
040080             0018*   ;           u16 height
040080             0019*   ;           u8  format=1        ; RGBA2222
040080             0020*   ;         DATA  size=width*height
040080             0021*   ;           u8 pixels[]         ; row-major, no row padding
040080             0022*   ;
040080             0023*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
040080             0024*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
040080             0025*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
040080             0026*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
040080             0027*   ; reading or uploading DATA. Chunk traversal advances by:
040080             0028*   ;
040080             0029*   ;     8 + ((payload_size + 3) & ~3)
040080             0030*   ;
040080             0031*   ; The offsets below are indices from the beginning of the named header or
040080             0032*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
040080             0033*   ; 24-bit, so their high byte must not be silently discarded during validation.
040080             0034*   
040080             0035*   ; RIFF file header: "RIFF", u32 size, "AGNB"
040080             0036*   agnb_riff_id:              equ 0
040080             0037*   agnb_riff_size:            equ 4
040080             0038*   agnb_riff_form:            equ 8
040080             0039*   agnb_riff_header_size:     equ 12
040080             0040*   
040080             0041*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
040080             0042*   agnb_chunk_id:             equ 0
040080             0043*   agnb_chunk_size:           equ 4
040080             0044*   agnb_chunk_data:           equ 8
040080             0045*   agnb_chunk_header_size:    equ 8
040080             0046*   
040080             0047*   ; VERS payload
040080             0048*   agnb_vers_major:           equ 0
040080             0049*   agnb_vers_minor:           equ 1
040080             0050*   agnb_vers_payload_size:    equ 2
040080             0051*   
040080             0052*   ; LIST BUFR payload
040080             0053*   agnb_list_type:            equ 0
040080             0054*   agnb_list_chunks:          equ 4
040080             0055*   agnb_list_type_size:       equ 4
040080             0056*   
040080             0057*   ; BHDR payload
040080             0058*   agnb_bhdr_bufferId:        equ 0
040080             0059*   agnb_bhdr_payload_size:    equ 2
040080             0060*   
040080             0061*   ; IMAG payload
040080             0062*   agnb_imag_width:           equ 0
040080             0063*   agnb_imag_height:          equ 2
040080             0064*   agnb_imag_format:          equ 4
040080             0065*   agnb_imag_payload_size:    equ 5
040080             0066*   
040080             0067*   ; DATA payload
040080             0068*   agnb_data_pixels:          equ 0
040080             0069*   
040080             0070*   ; Values supported by the version 0.1 image loader
040080             0071*   agnb_version_major:        equ 0
040080             0072*   agnb_version_minor:        equ 1
040080             0073*   agnb_image_rgba2222:       equ 1
040080             0074*   
040080             0075*   
040080             0076*   ; FourCC constants
040080             0077*   ; ----------------
040080             0078*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
040080             0079*   ; compares one of these tables with four bytes read from the container.
040080             0080*   
040080 52 49 46 46 0081*   agnb_id_riff:              db "RIFF"
040084 41 47 4E 42 0082*   agnb_id_agnb:              db "AGNB"
040088 56 45 52 53 0083*   agnb_id_vers:              db "VERS"
04008C 4C 49 53 54 0084*   agnb_id_list:              db "LIST"
040090 42 55 46 52 0085*   agnb_id_bufr:              db "BUFR"
040094 42 48 44 52 0086*   agnb_id_bhdr:              db "BHDR"
040098 49 4D 41 47 0087*   agnb_id_imag:              db "IMAG"
04009C 44 41 54 41 0088*   agnb_id_data:              db "DATA"
0400A0             0089*   
0400A0             0090*   
0400A0             0091*   ; Reader result codes
0400A0             0092*   ; -------------------
0400A0             0093*   ; Public routines will return A=0 with Z set on success, or one of these
0400A0             0094*   ; nonzero values with NZ set on failure. The same value is stored in
0400A0             0095*   ; agnb_last_error.
0400A0             0096*   
0400A0             0097*   agnb_error_ok:             equ 0
0400A0             0098*   agnb_error_open:           equ 1
0400A0             0099*   agnb_error_read:           equ 2
0400A0             0100*   agnb_error_seek:           equ 3
0400A0             0101*   agnb_error_riff_id:        equ 4
0400A0             0102*   agnb_error_riff_form:      equ 5
0400A0             0103*   agnb_error_version:        equ 6
0400A0             0104*   agnb_error_chunk:          equ 7
0400A0             0105*   agnb_error_bounds:         equ 8
0400A0             0106*   agnb_error_bufferId:       equ 9
0400A0             0107*   agnb_error_metadata:       equ 10
0400A0             0108*   agnb_error_data_size:      equ 11
0400A0             0109*   agnb_error_vdp:            equ 12
0400A0             0110*   agnb_error_eof:            equ 13
0400A0             0111*   agnb_error_not_implemented: equ 255
0400A0             0112*   
0400A0             0113*   
0400A0             0114*   ; FatFS file structure
0400A0             0115*   ; --------------------
0400A0             0116*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
0400A0             0117*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
0400A0             0118*   ; the single known container filename.
0400A0             0119*   
0400A0             0120*   agnb_fil_size:             equ fil_dir_ptr+3
0400A0             0121*   agnb_fil:
0400A0 00 00 00 00 0122*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400C4             0123*   
0400C4             0124*   
0400C4             0125*   ; Reader-state structure
0400C4             0126*   ; ----------------------
0400C4             0127*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
0400C4             0128*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
0400C4             0129*   ; checks and FatFS seeks.
0400C4             0130*   
0400C4             0131*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
0400C4             0132*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
0400C4             0133*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
0400C4             0134*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
0400C4             0135*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
0400C4             0136*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
0400C4             0137*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
0400C4             0138*   agnb_state_size:           equ 28
0400C4             0139*   
0400C4             0140*   agnb_state:
0400C4 00 00 00 00 0141*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0400E0             0142*   
0400E0             0143*   
0400E0             0144*   ; Normalized image metadata
0400E0             0145*   ; -------------------------
0400E0             0146*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
0400E0             0147*   
0400E0             0148*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
0400E0             0149*   agnb_meta_width:           equ 2  ; u16 pixels
0400E0             0150*   agnb_meta_height:          equ 4  ; u16 pixels
0400E0             0151*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
0400E0             0152*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
0400E0             0153*   agnb_meta_size:            equ 11
0400E0             0154*   
0400E0             0155*   agnb_metadata:
0400E0 00 00 00 00 0156*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
0400EB             0157*   
0400EB             0158*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
0400EB             0159*   agnb_record_has_bhdr:      equ 0
0400EB             0160*   agnb_record_has_imag:      equ 1
0400EB             0161*   agnb_record_has_data:      equ 2
0400EB             0162*   
0400EB 00          0163*   agnb_record_flags:         db 0
0400EC 00          0164*   agnb_last_error:           db agnb_error_ok
0400ED 00          0165*   agnb_file_is_open:         db 0
0400EE             0166*   
0400EE             0167*   
0400EE             0168*   ; Reusable I/O storage
0400EE             0169*   ; --------------------
0400EE             0170*   ; The 12-byte buffer is large enough for either the RIFF file header or a
0400EE             0171*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
0400EE             0172*   ; the application's existing 8 KiB SRAM filedata area.
0400EE             0173*   
0400EE             0174*   agnb_header:
0400EE 00 00 00 00 0175*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
0400FA             0176*   
0400FA             0177*   agnb_io_buffer:            equ 0xB7E000 ; same onboard SRAM as app filedata
0400FA             0178*   agnb_io_buffer_size:       equ 8192
0400FA             0179*   
0400FA             0180*   agnb_filename:
0400FA 69 6D 61 67 0181*       asciz "images.agnb"
       65 73 2E 61 
       67 6E 62 00 
040106             0182*   
040106             0183*   
040106             0184*   ; Reader subroutine interface
040106             0185*   ; ---------------------------
040106             0186*   ; These labels establish the intended decomposition and calling contracts.
040106             0187*   ; They deliberately fail with agnb_error_not_implemented until replaced with
040106             0188*   ; real code, preventing an incomplete loader from reporting false success.
040106             0189*   
040106             0190*   ; Compare two FourCC values.
040106             0191*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
040106             0192*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
040106             0193*   ; preserves: BC, DE, HL
040106             0194*   ; destroys: A
040106             0195*   agnb_compare_fourcc:
040106 C5          0196*       push bc
040107 D5          0197*       push de
040108 E5          0198*       push hl
040109 06 04       0199*       ld b,4
04010B             0200*   @loop:
04010B 1A          0201*       ld a,(de)
04010C BE          0202*       cp (hl)
04010D 20 04       0203*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
04010F 13          0204*       inc de
040110 23          0205*       inc hl
040111 10 F8       0206*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
040113             0207*   @done:
040113 E1          0208*       pop hl
040114 D1          0209*       pop de
040115 C1          0210*       pop bc
040116 C9          0211*       ret
040117             0212*   
040117             0213*   ; Open a container for reading.
040117             0214*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
040117             0215*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
040117             0216*   ;          agnb_fil initialized and agnb_file_is_open set on success
040117             0217*   ; destroys: AF, BC, HL
040117             0218*   agnb_open:
040117             0219*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
040117 AF          0220*       xor a
040118 32 ED 00 04 0221*       ld (agnb_file_is_open),a
04011C 32 EC 00 04 0222*       ld (agnb_last_error),a
040120             0223*   
040120             0224*   ; open the caller-supplied filename into our single reader-owned FIL
040120 21 A0 00 04 0225*       ld hl,agnb_fil
040124 0E 01       0226*       ld c,fa_read
040126             0227*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
040126 FD E5       0001*M1 			PUSH IY
040128 3E 80       0002*M1 			LD	A, function
04012A 5B CF       0003*M1 			RST.LIL	08h
04012C FD E1       0004*M1 			POP IY
04012E B7          0228*       or a
04012F 20 08       0229*       jr nz,@error
040131             0230*   
040131             0231*   ; ffs_fopen succeeded
040131 3E 01       0232*       ld a,1
040133 32 ED 00 04 0233*       ld (agnb_file_is_open),a
040137 AF          0234*       xor a
040138 C9          0235*       ret
040139             0236*   
040139             0237*   @error:
040139 3E 01       0238*       ld a,agnb_error_open
04013B 32 EC 00 04 0239*       ld (agnb_last_error),a
04013F B7          0240*       or a
040140 C9          0241*       ret
040141             0242*   
040141             0243*   ; Close agnb_fil if open and clear agnb_file_is_open.
040141             0244*   ; outputs: A=0 and Z set if closed or already closed
040141             0245*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
040141             0246*   ; destroys: HL
040141             0247*   agnb_close:
040141             0248*   ; An unopened file is already in the requested state.
040141 3A ED 00 04 0249*       ld a,(agnb_file_is_open)
040145 B7          0250*       or a
040146 28 14       0251*       jr z,@success
040148             0252*   
040148             0253*   ; Close our single reader-owned FIL.
040148 21 A0 00 04 0254*       ld hl,agnb_fil
04014C             0255*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
04014C FD E5       0001*M1 			PUSH IY
04014E 3E 81       0002*M1 			LD	A, function
040150 5B CF       0003*M1 			RST.LIL	08h
040152 FD E1       0004*M1 			POP IY
040154 B7          0256*       or a
040155 20 0B       0257*       jr nz,agnb_error_close
040157             0258*   
040157             0259*   ; Only clear the open flag after FatFS confirms the close.
040157 AF          0260*       xor a
040158 32 ED 00 04 0261*       ld (agnb_file_is_open),a
04015C             0262*   @success:
04015C AF          0263*       xor a
04015D 32 EC 00 04 0264*       ld (agnb_last_error),a
040161 C9          0265*       ret
040162             0266*   
040162             0267*   agnb_error_close:
040162             0268*   ; Placeholder in case we determine that close failures need a dedicated AGNB
040162             0269*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
040162             0270*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
040162 32 EC 00 04 0271*       ld (agnb_last_error),a
040166 B7          0272*       or a
040167 C9          0273*       ret
040168             0274*   
040168             0275*   ; Top-level image load operation.
040168             0276*   ; inputs:  none; uses agnb_filename
040168             0277*   ; outputs: all valid LIST BUFR image records uploaded to their explicit IDs
040168             0278*   agnb_load_images:
040168 C3 7F 02 04 0279*       jp agnb_not_implemented
04016C             0280*   
04016C             0281*   ; Read exactly BC bytes from agnb_fil into DE.
04016C             0282*   ; inputs:  BC = requested u24 length, DE = destination
04016C             0283*   ; outputs: A=0 and Z set after the complete request is satisfied
04016C             0284*   ;          nonzero error code and NZ set on FatFS error or premature EOF
04016C             0285*   ;          state offset/count updated after every successful FatFS read
04016C             0286*   ; destroys: BC, DE, HL
04016C             0287*   agnb_read_exact:
04016C             0288*   ; A zero-length request is already complete.
04016C 21 00 00 00 0289*       ld hl,0
040170 B7          0290*       or a
040171 ED 42       0291*       sbc hl,bc
040173 28 62       0292*       jr z,@success
040175             0293*   
040175             0294*   @read:
040175             0295*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
040175             0296*   ; remaining request on the stack. It preserves DE, our current destination.
040175 C5          0297*       push bc
040176 21 A0 00 04 0298*       ld hl,agnb_fil
04017A             0299*       FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
04017A FD E5       0001*M1 			PUSH IY
04017C 3E 82       0002*M1 			LD	A, function
04017E 5B CF       0003*M1 			RST.LIL	08h
040180 FD E1       0004*M1 			POP IY
040182 B7          0300*       or a
040183 20 40       0301*       jr nz,@fatfs_error
040185             0302*   
040185             0303*   ; Advance the u32 logical position by the returned u24 byte count.
040185 2A D8 00 04 0304*       ld hl,(agnb_state+agnb_state_file_offset)
040189 09          0305*       add hl,bc
04018A 22 D8 00 04 0306*       ld (agnb_state+agnb_state_file_offset),hl
04018E 3A DB 00 04 0307*       ld a,(agnb_state+agnb_state_file_offset+3)
040192 CE 00       0308*       adc a,0
040194 38 34       0309*       jr c,@offset_overflow
040196 32 DB 00 04 0310*       ld (agnb_state+agnb_state_file_offset+3),a
04019A             0311*   
04019A             0312*   ; Retain the count returned by this individual FatFS read.
04019A ED 43 DC 00 0313*       ld (agnb_state+agnb_state_bytes_read),bc
       04          
04019F AF          0314*       xor a
0401A0 32 DF 00 04 0315*       ld (agnb_state+agnb_state_bytes_read+3),a
0401A4             0316*   
0401A4             0317*   ; Recover the remaining request and reject zero bytes as premature EOF.
0401A4 E1          0318*       pop hl
0401A5 E5          0319*       push hl
0401A6 21 00 00 00 0320*       ld hl,0
0401AA B7          0321*       or a
0401AB ED 42       0322*       sbc hl,bc
0401AD E1          0323*       pop hl
0401AE 28 1F       0324*       jr z,@eof
0401B0             0325*   
0401B0             0326*   ; Subtract the returned count from the remaining request. FatFS must never
0401B0             0327*   ; report more bytes than were requested.
0401B0 B7          0328*       or a
0401B1 ED 42       0329*       sbc hl,bc
0401B3 38 11       0330*       jr c,@read_error
0401B5             0331*   
0401B5             0332*   ; Advance the destination by the returned byte count.
0401B5 EB          0333*       ex de,hl
0401B6 09          0334*       add hl,bc
0401B7 EB          0335*       ex de,hl
0401B8             0336*   
0401B8             0337*   ; Continue after a short read, or return once the request is satisfied.
0401B8 01 00 00 00 0338*       ld bc,0
0401BC B7          0339*       or a
0401BD ED 42       0340*       sbc hl,bc
0401BF 28 16       0341*       jr z,@success
0401C1 E5          0342*       push hl
0401C2 C1          0343*       pop bc
0401C3 18 B0       0344*       jr @read
0401C5             0345*   
0401C5             0346*   @fatfs_error:
0401C5 C1          0347*       pop bc
0401C6             0348*   @read_error:
0401C6 3E 02       0349*       ld a,agnb_error_read
0401C8 18 07       0350*       jr @error
0401CA             0351*   @offset_overflow:
0401CA C1          0352*       pop bc
0401CB 3E 08       0353*       ld a,agnb_error_bounds
0401CD 18 02       0354*       jr @error
0401CF             0355*   @eof:
0401CF 3E 0D       0356*       ld a,agnb_error_eof
0401D1             0357*   @error:
0401D1 32 EC 00 04 0358*       ld (agnb_last_error),a
0401D5 B7          0359*       or a
0401D6 C9          0360*       ret
0401D7             0361*   
0401D7             0362*   @success:
0401D7 AF          0363*       xor a
0401D8 32 EC 00 04 0364*       ld (agnb_last_error),a
0401DC C9          0365*       ret
0401DD             0366*   
0401DD             0367*   ; Seek to a u32 absolute file offset.
0401DD             0368*   ; inputs:  C = most-significant byte, DE = low 24 bits
0401DD             0369*   ; outputs: agnb_state_file_offset updated on success
0401DD             0370*   agnb_seek_absolute:
0401DD C3 7F 02 04 0371*       jp agnb_not_implemented
0401E1             0372*   
0401E1             0373*   ; Read and validate RIFF size/form, establishing physical and RIFF bounds.
0401E1             0374*   ; inputs:  agnb_fil is open and positioned at byte zero
0401E1             0375*   ; outputs: A=0 and Z set on success; nonzero error code and NZ set on failure
0401E1             0376*   ;          file size and RIFF end stored in agnb_state
0401E1             0377*   ; destroys: BC, DE, HL
0401E1             0378*   agnb_read_riff_header:
0401E1             0379*   ; retain the physical u32 file size recorded by FatFS in the FIL object
0401E1 2A AB 00 04 0380*       ld hl,(agnb_fil+fil_obj+ffobjid_objsize)
0401E5 22 C4 00 04 0381*       ld (agnb_state+agnb_state_file_size),hl
0401E9 3A AE 00 04 0382*       ld a,(agnb_fil+fil_obj+ffobjid_objsize+3)
0401ED 32 C7 00 04 0383*       ld (agnb_state+agnb_state_file_size+3),a
0401F1             0384*   
0401F1             0385*   ; read the complete fixed-size RIFF header before inspecting any field
0401F1 01 0C 00 00 0386*       ld bc,agnb_riff_header_size
0401F5 11 EE 00 04 0387*       ld de,agnb_header
0401F9 CD 6C 01 04 0388*       call agnb_read_exact
0401FD C0          0389*       ret nz
0401FE             0390*   
0401FE             0391*   ; validate the RIFF container identifier
0401FE 21 EE 00 04 0392*       ld hl,agnb_header+agnb_riff_id
040202 11 80 00 04 0393*       ld de,agnb_id_riff
040206 CD 06 01 04 0394*       call agnb_compare_fourcc
04020A 20 43       0395*       jr nz,@bad_riff_id
04020C             0396*   
04020C             0397*   ; validate that this RIFF contains the AGNB form
04020C 21 F6 00 04 0398*       ld hl,agnb_header+agnb_riff_form
040210 11 84 00 04 0399*       ld de,agnb_id_agnb
040214 CD 06 01 04 0400*       call agnb_compare_fourcc
040218 20 39       0401*       jr nz,@bad_riff_form
04021A             0402*   
04021A             0403*   ; RIFF stores file size minus eight. Add the omitted bytes as u32, using the
04021A             0404*   ; native 24-bit ALU for the low three bytes and A for the high byte.
04021A 2A F2 00 04 0405*       ld hl,(agnb_header+agnb_riff_size)
04021E 3A F5 00 04 0406*       ld a,(agnb_header+agnb_riff_size+3)
040222 11 08 00 00 0407*       ld de,8
040226 19          0408*       add hl,de
040227 30 03       0409*       jr nc,@riff_end_ready
040229 3C          0410*       inc a
04022A 28 2B       0411*       jr z,@bad_bounds             ; u32 addition overflowed
04022C             0412*   @riff_end_ready:
04022C 22 C8 00 04 0413*       ld (agnb_state+agnb_state_riff_end),hl
040230 32 CB 00 04 0414*       ld (agnb_state+agnb_state_riff_end+3),a
040234             0415*   
040234             0416*   ; Version 0.1 requires RIFF size to equal the physical file size minus eight.
040234 ED 5B C4 00 0417*       ld de,(agnb_state+agnb_state_file_size)
       04          
040239 B7          0418*       or a
04023A ED 52       0419*       sbc hl,de
04023C 20 19       0420*       jr nz,@bad_bounds
04023E 3A CB 00 04 0421*       ld a,(agnb_state+agnb_state_riff_end+3)
040242 21 C7 00 04 0422*       ld hl,agnb_state+agnb_state_file_size+3
040246 BE          0423*       cp (hl)
040247 20 0E       0424*       jr nz,@bad_bounds
040249             0425*   
040249             0426*   ; valid RIFF/AGNB header
040249 AF          0427*       xor a
04024A 32 EC 00 04 0428*       ld (agnb_last_error),a
04024E C9          0429*       ret
04024F             0430*   
04024F             0431*   @bad_riff_id:
04024F 3E 04       0432*       ld a,agnb_error_riff_id
040251 18 06       0433*       jr @error
040253             0434*   @bad_riff_form:
040253 3E 05       0435*       ld a,agnb_error_riff_form
040255 18 02       0436*       jr @error
040257             0437*   @bad_bounds:
040257 3E 08       0438*       ld a,agnb_error_bounds
040259             0439*   @error:
040259 32 EC 00 04 0440*       ld (agnb_last_error),a
04025D B7          0441*       or a
04025E C9          0442*       ret
04025F             0443*   
04025F             0444*   ; Read a generic eight-byte chunk header into agnb_header and compute its
04025F             0445*   ; aligned payload end without crossing the active RIFF/LIST boundary.
04025F             0446*   agnb_read_chunk_header:
04025F C3 7F 02 04 0447*       jp agnb_not_implemented
040263             0448*   
040263             0449*   ; Validate the single VERS payload and supported version.
040263             0450*   agnb_read_vers:
040263 C3 7F 02 04 0451*       jp agnb_not_implemented
040267             0452*   
040267             0453*   ; Parse one LIST BUFR and require BHDR, IMAG, DATA in that order.
040267             0454*   agnb_read_buffer_list:
040267 C3 7F 02 04 0455*       jp agnb_not_implemented
04026B             0456*   
04026B             0457*   ; Read and validate BHDR into agnb_metadata.
04026B             0458*   agnb_read_bhdr:
04026B C3 7F 02 04 0459*       jp agnb_not_implemented
04026F             0460*   
04026F             0461*   ; Read and validate IMAG into agnb_metadata.
04026F             0462*   agnb_read_imag:
04026F C3 7F 02 04 0463*       jp agnb_not_implemented
040273             0464*   
040273             0465*   ; Validate DATA size after BHDR/IMAG, then stream it in filedata-sized blocks
040273             0466*   ; to agnb_meta_bufferId and consolidate/create the RGBA2222 bitmap.
040273             0467*   agnb_stream_data:
040273 C3 7F 02 04 0468*       jp agnb_not_implemented
040277             0469*   
040277             0470*   ; Skip an unknown or deliberately ignored chunk, including alignment padding,
040277             0471*   ; without crossing the active enclosing boundary.
040277             0472*   agnb_skip_chunk:
040277 C3 7F 02 04 0473*       jp agnb_not_implemented
04027B             0474*   
04027B             0475*   ; Round a u32 size or offset up to the next four-byte boundary.
04027B             0476*   ; Calling convention will be finalized with the 32-bit arithmetic helper.
04027B             0477*   agnb_align4:
04027B C3 7F 02 04 0478*       jp agnb_not_implemented
04027F             0479*   
04027F             0480*   ; Common fail-closed body used by every scaffolded routine.
04027F             0481*   agnb_not_implemented:
04027F 3E FF       0482*       ld a,agnb_error_not_implemented
040281 32 EC 00 04 0483*       ld (agnb_last_error),a
040285 B7          0484*       or a ; return NZ
040286 C9          0485*       ret
040287             0035        include "input.inc"
040287 00          0001*   dithering_type: db 0x00 ; 0=none, 1=bayer ordered matrix, 2=floyd-steinberg
040288 00 01 00    0002*   current_image_id: dl 256 ; buffer_id of the current image
04028B 00 00 00    0003*   current_image_index: dl 0 ; index of the current image
04028E             0004*   
