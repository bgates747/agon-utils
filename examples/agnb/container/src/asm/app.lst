042151             0481*   printBin8:
042151 06 08       0482*       ld b,8 ; loop counter for 8 bits
042153 21 6E 21 04 0483*       ld hl,@cmd ; set hl to the low byte of the output string
042157             0484*       ; (which will be the high bit of the value in a)
042157             0485*   @loop:
042157 07          0486*       rlca ; put the next highest bit into carry
042158 38 04       0487*       jr c,@one
04215A 36 30       0488*       ld (hl),'0'
04215C 18 02       0489*       jr @next_bit
04215E             0490*   @one:
04215E 36 31       0491*       ld (hl),'1'
042160             0492*   @next_bit:
042160 23          0493*       inc hl
042161 10 F4       0494*       djnz @loop
042163             0495*   ; print it
042163 21 6E 21 04 0496*       ld hl,@cmd
042167 01 08 00 00 0497*       ld bc,@end-@cmd
04216B 5B DF       0498*       rst.lil $18
04216D C9          0499*       ret
