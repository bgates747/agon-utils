042347 3E 20       0272*       ld a,32		; 7
042349             0273*   @loop:
042349 52 DD 29    0274*       add.s ix,ix		; 15
04234C 52 ED 6A    0275*       adc.s hl,hl		; 15
04234F EB          0276*       ex de,hl		; 4
042350 52 ED 6A    0277*       adc.s hl,hl		; 15
042353 B7          0278*       or a			; 4
042354 52 ED 42    0279*       sbc.s hl,bc		; 15
042357 52 DD 23    0280*       inc.s ix		; 10
04235A 30 05       0281*       jr nc,@cansub		; 12/7
