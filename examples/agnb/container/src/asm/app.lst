04236B DD 29       0302*       add ix,ix      ; 2
04236D 8F          0303*       adc a,a        ; 1
04236E ED 6A       0304*       adc hl,hl      ; 2
042370 ED 52       0305*       sbc hl,de      ; 2
042372 DD 23       0306*       inc ix         ; 2
042374 30 03       0307*       jr nc,@cansub  ; 2/4
