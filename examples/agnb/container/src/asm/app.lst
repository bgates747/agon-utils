041B2F             0585*   ; inputs; none
041B2F             0586*   ; outputs; a=0,f=255
041B2F             0587*   ; destroys: flags, hl
041B2F             0588*   ; preserves: a, because why not
041B2F             0589*   setAllFlags:
041B2F 21 FF 00 00 0590*       ld hl,255
041B33 67          0591*       ld h,a ; four cycles to preserve a is cheap
041B34 E5          0592*       push hl
041B35 F1          0593*       pop af
041B36 C9          0594*       ret
041B37             0595*   
041B37             0596*   ; reset all the bits in the flag register
