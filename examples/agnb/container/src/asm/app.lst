04137A             0004*   ; Print a zero-terminated string
04137A             0005*   ; HL: Pointer to string
04137A             0006*   printString:
04137A C5          0007*       PUSH BC
04137B 01 00 00 00 0008*       LD BC,0
04137F 3E 00       0009*       LD A,0
041381 5B DF       0010*       RST.LIL 18h
041383 C1          0011*       POP BC
041384 C9          0012*       RET
041385             0013*   
041385             0014*   ; Prints the right justified decimal value in HL without leading zeroes
041385             0015*   ; HL : Value to print
041385             0016*   ; preserves all registers and flags
041385             0017*   printDec:
041385             0018*   ; BEGIN MY CODE
041385             0019*   ; back up all the things
041385 F5          0020*       push af
041386 C5          0021*       push bc
041387 D5          0022*       push de
041388 E5          0023*       push hl
041389             0024*   ; END MY CODE
041389 11 B1 13 04 0025*       LD DE, _printDecBuffer
04138D CD ED 18 04 0026*       CALL u24_to_ascii
041391             0027*   ; BEGIN MY CODE
041391             0028*   ; replace leading zeroes with spaces
041391 21 B1 13 04 0029*       LD HL, _printDecBuffer
041395 06 07       0030*       ld B, 7 ; if HL was 0, we want to keep the final zero
041397             0031*   @loop:
041397 7E          0032*       LD A, (HL)
041398 FE 30       0033*       CP '0'
04139A C2 A4 13 04 0034*       JP NZ, @done
04139E 3E 20       0035*       LD A, ' '
0413A0 77          0036*       LD (HL), A
0413A1 23          0037*       INC HL
0413A2             0038*       ; CALL vdu_cursor_forward
0413A2 10 F3       0039*       DJNZ @loop
0413A4             0040*   @done:
0413A4             0041*   ; END MY CODE
0413A4 21 B1 13 04 0042*       LD HL, _printDecBuffer
0413A8 CD 7A 13 04 0043*       CALL printString
0413AC             0044*   ; BEGIN MY CODE
0413AC             0045*   ; restore all the things
0413AC E1          0046*       pop hl
0413AD D1          0047*       pop de
0413AE C1          0048*       pop bc
0413AF F1          0049*       pop af
0413B0             0050*   ; END MY CODE
0413B0 C9          0051*       RET
0413B1 00 00 00 00 0052*   _printDecBuffer: blkb 16,0 ; a few bytes extra just to be sure
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
0413C1             0053*   
0413C1             0054*   ; This routine converts the unsigned 24-bit value in HLU into it's ASCII representation,
0413C1             0055*   ; starting to memory location pointing by DE, in decimal form and with leading zeroes
0413C1             0056*   ; so it will allways be 8 characters length
0413C1             0057*   ; HL : Value to convert to string
0413C1             0058*   ; DE : pointer to buffer, at least 8 byte + 0
0413C1             0059*   ; u24_to_ascii:
0413C1             0060*   ;     LD BC,-10000000
0413C1             0061*   ;     CALL @one_digit
0413C1             0062*   ;     LD BC,-1000000
0413C1             0063*   ;     CALL @one_digit
0413C1             0064*   ;     LD BC,-100000
0413C1             0065*   ;     CALL @one_digit
0413C1             0066*   ;     LD BC,-10000
0413C1             0067*   ;     CALL @one_digit
0413C1             0068*   ;     LD BC,-1000
0413C1             0069*   ;     CALL @one_digit
0413C1             0070*   ;     LD BC,-100
0413C1             0071*   ;     CALL @one_digit
0413C1             0072*   ;     LD C,-10
0413C1             0073*   ;     CALL @one_digit
0413C1             0074*   ;     LD C,B
0413C1             0075*   ; @one_digit:
0413C1             0076*   ;     LD A,'0'-1
0413C1             0077*   ; @divide_me:
0413C1             0078*   ;     INC A
0413C1             0079*   ;     ADD HL,BC
0413C1             0080*   ;     JR C,@divide_me
0413C1             0081*   ;     SBC HL,BC
0413C1             0082*   ;     LD (DE),A
0413C1             0083*   ;     INC DE
0413C1             0084*   ;     RET
0413C1             0085*   
