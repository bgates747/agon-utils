041BCC             0101*   ; Not needed by the AGNB test harness. Retained as comments from AgonVideo.
041BCC             0102*   ; ; floor(value,n)
041BCC             0103*   ; ; inputs: hl = value to floor, de = n
041BCC             0104*   ; ; outputs: hl = value floored to n
041BCC             0105*   ; ; destroys: af, hl, bc, de
041BCC             0106*   ; hlu_floor:
041BCC             0107*   ;     push de ; save n
041BCC             0108*   ;     call udiv24 ; de = quotient, hl = remainder
041BCC             0109*   ;     pop hl ; get n back (was de)
041BCC             0110*   ;     call umul24 ; hl = n * quotient
041BCC             0111*   ;     ret
041BCC             0112*   ; ; end hlu_floor
041BCC             0113*   
041BCC             0114*   ; Not needed by the AGNB test harness. Retained as comments from AgonVideo.
041BCC             0115*   ; ; ceil(value,n)
041BCC             0116*   ; ; inputs: hl = value to ceil, de = n
041BCC             0117*   ; ; outputs: hl = value ceiled to n
041BCC             0118*   ; ; destroys: af, hl, bc, de
041BCC             0119*   ; hlu_ceiling:
041BCC             0120*   ;     push de ; save n
041BCC             0121*   ;     call udiv24 ; de = quotient, hl = remainder
041BCC             0122*   ;     SIGN_UHL ; test remaider for zero
041BCC             0123*   ;     jp z,@F ; if zero, nothing to add
041BCC             0124*   ;     inc de ; add 1 to quotient for the ceiling
041BCC             0125*   ; @@:
041BCC             0126*   ;     pop hl ; get n back (was de)
041BCC             0127*   ;     call umul24 ; hl = n * quotient
041BCC             0128*   ;     ret
041BCC             0129*   ; ; end hlu_ceiling
