041950 22 36 19 04 0294*       ld (timestamp_now),hl   ; save current time
041954 AF          0295*       xor a                   ; clear carry
041955 ED 52       0296*       sbc hl,de               ; hl = time elapsed
041957 22 3C 19 04 0297*       ld (timestamp_chg),hl   ; save elapsed time
04195B C9          0298*       ret
04195C             0299*   
04195C             0300*   ; set a countdown timer
04195C             0301*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04195C             0302*   ; requires: timestamp_tick to be called at least once before this function
04195C             0303*   ; returns: hl = current time
04195C             0304*   ; destroys: hl
04195C             0305*   timestamp_tmr_set:
04195C FD 2F 03    0306*       ld (iy+3),hl            ; set time remaining
04195F 2A 36 19 04 0307*       ld hl,(timestamp_now)   ; get current timestamp
041963 FD 2F 00    0308*       ld (iy+0),hl            ; set start time
041966 C9          0309*       ret
041967             0310*   
041967             0311*   ; gets time remaining on a countdown timer following the global timestamp
041967             0312*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041967             0313*   ; requires: timestamp_tick to be called at least once before this function
041967             0314*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041967             0315*   ;          sign flags: pos = time not expired,zero or neg = time expired
041967             0316*   ; destroys: af,hl,de
041967             0317*   timestamp_tmr_get:
041967 ED 5B 36 19 0318*       ld de,(timestamp_now)   ; get current timestamp
       04          
04196C FD 27 00    0319*       ld hl,(iy+0)            ; get start time
04196F AF          0320*       xor a                   ; clear carry
041970 ED 52       0321*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041972 FD 17 03    0322*       ld de,(iy+3)            ; get timer set value
041975 AF          0323*       xor a                   ; clear carry
041976 ED 5A       0324*       adc hl,de               ; hl = time remaining
041978             0325*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041978 C9          0326*       ret
041979             0327*   
041979             0328*   ; main loop timer functions
