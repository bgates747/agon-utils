041B6D             0044*   hlu_div2:
041B6D 22 4C 1B 04 0045*       ld (scratch1),hl
041B71 21 4E 1B 04 0046*       ld hl,scratch1+2
041B75 CB 1E       0047*       rr (hl)
041B77 2B          0048*       dec hl
041B78 CB 1E       0049*       rr (hl)
041B7A 2B          0050*       dec hl
041B7B CB 1E       0051*       rr (hl)
041B7D 23          0052*       inc hl
041B7E 23          0053*       inc hl
041B7F 2A 4C 1B 04 0054*       ld hl,(scratch1)
041B83 C9          0055*       ret
041B84             0056*   
041B84             0057*   ; this is my little hack to divide by 16
041B84             0058*   hlu_div16:
041B84 AF          0059*       xor a
041B85 29          0060*       add hl,hl
041B86 17          0061*       rla
041B87 29          0062*       add hl,hl
041B88 17          0063*       rla
041B89 29          0064*       add hl,hl
041B8A 17          0065*       rla
041B8B 29          0066*       add hl,hl
041B8C 17          0067*       rla
041B8D 22 9A 1B 04 0068*       ld (@scratch),hl
041B91 32 9D 1B 04 0069*       ld (@scratch+3),a
041B95 2A 9B 1B 04 0070*       ld hl,(@scratch+1)
041B99 C9          0071*       ret
041B9A             0072*   @scratch: ds 4
041B9E             0073*   
041B9E             0074*   ; hlu signed division by 256
041B9E             0075*   ; returns: hlu / 256
041B9E             0076*   ; destroys: af
041B9E             0077*   hlu_sdiv256:
       FF FF FF FF 
041B9E AF          0078*       xor a ; assume hl is positive
