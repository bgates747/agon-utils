041BB9             0089*   ; hlu 1 byte right shift, unsigned
041BB9             0090*   ; returns: hlu / 256, fractional portion in a
041BB9             0091*   ; destroys: af
041BB9             0092*   hlu_udiv256:
       FF FF FF FF 
041BB9 AF          0093*       xor a
041BBA 32 CB 1B 04 0094*       ld (@buffer+3),a
041BBE 7D          0095*       ld a,l ; save the fractional portion
041BBF 22 C8 1B 04 0096*       ld (@buffer),hl
041BC3 2A C9 1B 04 0097*       ld hl,(@buffer+1)
041BC7 C9          0098*       ret
