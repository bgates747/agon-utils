04239F             0043    init:
04239F             0044    ; set screen mode
04239F             0045        ; ld a,0 ; 640x480x16 single-buffered
04239F             0046        ; ld a,19 ; 1024x768x4 single-buffered
04239F             0047        ; ld a,8 ; 320x240x64 single-buffered
04239F 3E 14       0048        ld a,20 ; 512x384x64 single-buffered
0423A1             0049        ; ld a,23 ; 512x384x2 single-buffered
0423A1 CD 5C 1A 04 0050        call vdu_set_screen_mode
0423A5             0051    
0423A5             0052    ; set screen scaling and background colors
0423A5 21 B3 23 04 0053        ld hl,@beg
0423A9 01 09 00 00 0054        ld bc,@end-@beg
0423AD 5B DF       0055        rst.lil $18
0423AF C3 BC 23 04 0056        jp @end
0423B3             0057    @beg:
0423B3             0058    ;   VDU 23, 0, &C0, 0: Normal coordinates
0423B3 17 00 C0 00 0059        db 23,0,$C0,0
0423B7             0060    ;   VDU 17, color : set text background color
0423B7 11 8C       0061        db 17,12+128 ; blue
0423B9             0062    ;   VDU 18, color : set gfx background color
0423B9 12 00 8C    0063        db 18,0,12+128 ; blue
0423BC             0064    @end:
0423BC CD 35 1A 04 0065        call cursor_off
0423C0 CD 57 1A 04 0066        call vdu_cls
0423C4             0067    
0423C4             0068    ; initialize main loop timer
0423C4             0069    main_loop_timer_reset: equ 60 ; 120ths of a second
