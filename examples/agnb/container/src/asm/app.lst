0419C0             0376*   ; delay routine
0419C0             0377*   ; Author: Richard Turrnidge
0419C0             0378*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.inc
0419C0             0379*   ; routine waits a fixed time,then returns
0419C0             0380*   ; arrive with A =  the delay byte. One bit to be set only.
0419C0             0381*   ; eg. ld A,00000100b
0419C0             0382*   
0419C0             0383*   multiPurposeDelay:
       FF FF FF 
0419C0 F5          0384*       push af
0419C1 C5          0385*       push bc
0419C2 DD E5       0386*       push ix
0419C4 47          0387*       ld b,a
0419C5 3E 08       0388*       ld a,$08
0419C7 5B CF       0389*       RST.LIL	08h                 ; get IX pointer to sysvars
0419C9             0390*   
0419C9             0391*   waitLoop:
0419C9             0392*   
0419C9 DD 7E 00    0393*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0419CC             0394*   
0419CC             0395*                                   ;   we check if bit set is same as last time we checked.
0419CC             0396*                                   ;   bit 0 - don't use
0419CC             0397*                                   ;   bit 1 - changes 64 times per second
0419CC             0398*                                   ;   bit 2 - changes 32 times per second
0419CC             0399*                                   ;   bit 3 - changes 16 times per second
0419CC             0400*   
0419CC             0401*                                   ;   bit 4 - changes 8 times per second
0419CC             0402*                                   ;   bit 5 - changes 4 times per second
0419CC             0403*                                   ;   bit 6 - changes 2 times per second
0419CC             0404*                                   ;   bit 7 - changes 1 times per second
0419CC A0          0405*       and b
0419CD 4F          0406*       ld c,a
0419CE 3A DF 19 04 0407*       ld a,(oldTimeStamp)
0419D2 B9          0408*       cp c                        ; is A same as last value?
0419D3 28 F4       0409*       jr z,waitLoop              ; loop here if it is
0419D5 79          0410*       ld a,c
0419D6 32 DF 19 04 0411*       ld (oldTimeStamp),a        ; set new value
0419DA             0412*   
0419DA DD E1       0413*       pop ix
0419DC C1          0414*       pop bc
0419DD F1          0415*       pop af
0419DE C9          0416*       ret
0419DF             0417*   
0419DF 00          0418*   oldTimeStamp:   .db 00h
