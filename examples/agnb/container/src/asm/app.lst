041948             0298*   ; u168_to_ascii: Converts an unsigned 16.8 fixed-point value in HL to an ASCII string.
041948             0299*   ; HL : Value to convert to string (integer part in H, fractional part in L)
041948             0300*   ; DE : Pointer to buffer, requires at least 11 bytes (8 digits, sign, decimal point, and null terminator)
041948             0301*   u168_to_ascii:
041948             0302*   ; add a leading space to make room for sign flag if needed
041948 3E 20       0303*       ld a,' '
04194A 12          0304*       ld (de),a
04194B 13          0305*       inc de
04194C             0306*   ; Convert integer part
04194C E5          0307*       push hl ; Save HL (we’ll need the fractional part later)
04194D             0308*       ; call hlu_udiv256 ; Shift to get integer portion in HL
04194D             0309*       SRL_UHL ; Shift to get integer portion in HL
                       M1 Args: none
04194D 3B          0001*M1     dec sp ; 1 cycle
04194E E5          0002*M1     push hl ; 4 cycles
04194F 33          0003*M1     inc sp ; 1 cycle
041950 E1          0004*M1     pop hl ; 4 cycles
041951 23          0005*M1     inc hl ; 1 cycle
041952 52 2B       0006*M1     dec.s hl ; 2 cycles <-- the .s sets hlu to zero (undocumented)
041954             0007*M1     ; 13 cycles total
041954 01 F0 D8 FF 0310*       ld bc, -10000
041958 CD 7B 19 04 0311*       call @one_int
04195C 01 18 FC FF 0312*       ld bc, -1000
041960 CD 7B 19 04 0313*       call @one_int
041964 01 9C FF FF 0314*       ld bc, -100
041968 CD 7B 19 04 0315*       call @one_int
04196C 0E F6       0316*       ld c, -10
04196E CD 7B 19 04 0317*       call @one_int
041972 48          0318*       ld c, b
041973 CD 7B 19 04 0319*       call @one_int
041977 C3 86 19 04 0320*       jp @frac ; Jump to fractional part conversion
04197B             0321*   @one_int:
04197B 3E 2F       0322*       ld a, '0' - 1 ; Start ASCII character at '0'
04197D             0323*   @divide_me:
04197D 3C          0324*       inc a
04197E 09          0325*       add hl, bc ; Accumulate until overflow
04197F 38 FC       0326*       jr c, @divide_me
041981 ED 42       0327*       sbc hl, bc ; Remove excess after overflow
041983 12          0328*       ld (de), a ; Store ASCII digit
041984 13          0329*       inc de
041985 C9          0330*       ret
041986             0331*   ; Convert fractional part
041986             0332*   @frac:
041986 3E 2E       0333*       ld a, '.' ; Decimal point
041988 12          0334*       ld (de), a
041989 13          0335*       inc de
04198A E1          0336*       pop hl ; Restore HL with original fraction
04198B 06 03       0337*       ld b, 3 ; Loop counter for 3 fractional digits
04198D             0338*   @frac_loop:
04198D 26 0A       0339*       ld h, 10 ; Load multiplier for fractional part
04198F ED 6C       0340*       mlt hl ; Multiply by 10, result in HL (H holds the integer part)
041991 3E 30       0341*       ld a, '0'
041993 84          0342*       add a, h ; Convert integer part to ASCII
041994 12          0343*       ld (de), a
041995 13          0344*       inc de
041996 10 F5       0345*       djnz @frac_loop ; Repeat for each fractional digit
041998             0346*   ; Add null terminator
041998 AF          0347*       xor a ; Null terminator
041999 12          0348*       ld (de), a
04199A C9          0349*       ret
