#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
REPO=$(CDPATH= cd -- "$ROOT/../.." && pwd)
PYTHON="$REPO/.venv/bin/python"
command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
  help|--help|-h) printf '%s\n' 'Usage: human/mos-tests COMMAND [options]' '  build       Build the existing C++ smoke binary' '  plan        Save selection only; no execution (--output DIR --backend emulator SELECTOR...)' '  runner-build Build the Agon catalogue/selector foundation' '  report      Decode evidence (--run DIR --output FRESH_DIR)' '  report-check Qualify decoder/report (--output FRESH_DIR)' '  recording-check Qualify binary recording/checkpoints (--output FRESH_DIR)' '  capture-check Qualify synthetic register capture (--output FRESH_DIR)' '  image       Prepare a fresh raw image (--output PATH, optional --binary PATH)' '  smoke       Run C++/assembly headlessly and save evidence (--output FRESH_DIR)' '  debug       Launch headless interactive debugger (--image PATH)' '  hardware    Show hardware support status' ;;
  build) exec make -C "$ROOT" "$@" ;;
  report) exec "$PYTHON" "$ROOT/scripts/report_results.py" "$@" ;;
  report-check) exec "$PYTHON" "$ROOT/tests/reporting/check.py" "$@" ;;
  recording-check) exec "$PYTHON" "$ROOT/agents/check_recording.py" "$@" ;;
  capture-check) exec "$PYTHON" "$ROOT/agents/check_capture.py" "$@" ;;
  plan) exec "$PYTHON" "$ROOT/scripts/plan_run.py" "$@" ;;
  runner-build) "$PYTHON" "$ROOT/scripts/plan_run.py" --list >/dev/null; exec make -C "$ROOT/apps/runner" "$@" ;;
  image) exec "$PYTHON" "$ROOT/scripts/prepare_sd_image.py" "$@" ;;
  smoke) exec "$PYTHON" "$ROOT/scripts/run_smoke.py" "$@" ;;
  debug) exec "$PYTHON" "$ROOT/scripts/run_emulator.py" "$@" -d -b 0 ;;
  hardware) printf '%s\n' 'Hardware full-suite bundle/reporting is not implemented. See human/hardware.md.'; exit 2 ;;
  *) printf '%s\n' "Unknown command: $command" >&2; exit 2 ;;
esac
